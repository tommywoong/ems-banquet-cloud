        // -------------------------------------------------------------
        // MASTER DATA VIEWS & RENDERERS
        // -------------------------------------------------------------
        let masterEventTypes = [];
        async function loadMasterEventTypes() {
            try {
                const res = await fetch('/api/master/event-types');
                if (res.ok) {
                    masterEventTypes = await res.json();
                    const sel = document.getElementById('beoEventType');
                    if (sel && masterEventTypes.length > 0) {
                        const curVal = sel.value;
                        sel.innerHTML = '';
                        masterEventTypes.forEach(et => {
                            const opt = document.createElement('option');
                            opt.value = et.name;
                            opt.textContent = et.note ? `${et.name} (${et.note})` : et.name;
                            sel.appendChild(opt);
                        });
                        if (curVal) {
                            const exists = Array.from(sel.options).some(o => o.value.toLowerCase() === curVal.toLowerCase());
                            if (!exists) {
                                const customOpt = document.createElement('option');
                                customOpt.value = curVal;
                                customOpt.textContent = curVal;
                                sel.appendChild(customOpt);
                            }
                            sel.value = curVal;
                        }
                    }
                }
            } catch (e) {
                console.error("Failed to load master event types:", e);
            }
        }

        async function initMasters() {
            try {
                loadMasterEventTypes();
                const [roomsRes, menusRes, chargesRes] = await Promise.all([
                    fetch('/api/master/rooms'),
                    fetch('/api/master/menus'),
                    fetch('/api/master/charges')
                ]);
                masterRooms = await roomsRes.json();
                masterMenus = await menusRes.json();
                masterCharges = await chargesRes.json();

                const nbRoom = document.getElementById('nbRoom');
                const ebRoom = document.getElementById('ebRoom');
                const selFilterRoom = document.getElementById('selBkFilterRoom');

                nbRoom.innerHTML = '';
                ebRoom.innerHTML = '';
                masterRooms.forEach(r => {
                    const opt1 = document.createElement('option');
                    opt1.value = r.code;
                    opt1.textContent = `${r.name} (${r.floor} - ${r.area}m²)`;
                    nbRoom.appendChild(opt1);

                    const opt2 = document.createElement('option');
                    opt2.value = r.code;
                    opt2.textContent = `${r.name} (${r.floor})`;
                    ebRoom.appendChild(opt2);

                    const opt3 = document.createElement('option');
                    opt3.value = r.code;
                    opt3.textContent = r.name;
                    selFilterRoom.appendChild(opt3);
                });
            } catch (err) {
                console.error("Init masters error:", err);
            }
        }

        function renderMasterRooms() {
            const container = document.getElementById('cardsRooms');
            container.innerHTML = '';
            masterRooms.forEach(r => {
                const div = document.createElement('div');
                div.className = 'p-4 rounded-xl border border-slate-200 bg-white hover:border-blue-400 transition shadow-sm space-y-2';
                div.innerHTML = `
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold font-mono px-2 py-0.5 bg-blue-50 text-blue-700 rounded">${r.code}</span>
                        <span class="text-xs font-semibold text-slate-500">${r.floor}</span>
                    </div>
                    <h4 class="font-bold text-sm text-slate-800">${r.name}</h4>
                    <div class="grid grid-cols-2 gap-2 text-xs text-slate-600 pt-2 border-t border-slate-100">
                        <div>Diện tích: <strong>${r.area} m²</strong></div>
                        <div>Bàn tối đa: <strong>${r.max_tables} bàn</strong></div>
                    </div>
                    <button onclick="quickBookRoomDate('${r.code}', '2026-11-10')" class="w-full mt-2 py-1.5 bg-slate-100 hover:bg-blue-600 hover:text-white rounded text-xs font-bold text-slate-700 transition">
                        Đặt Sảnh Này
                    </button>
                `;
                container.appendChild(div);
            });
            lucide.createIcons();
        }

        function debounceSearchCust() {
            clearTimeout(debounceCustTimer);
            debounceCustTimer = setTimeout(searchCust, 300);
        }

        async function searchCust() {
            try {
                const q = document.getElementById('txtSearchCust').value.trim();
                const res = await fetch(`/api/master/customers?q=${encodeURIComponent(q)}&limit=100`);
                const data = await res.json();
                const tbody = document.getElementById('tblMasterCust');
                tbody.innerHTML = '';

                if (data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="7" class="p-8 text-center text-slate-400">Không tìm thấy khách hàng nào phù hợp.</td></tr>';
                    return;
                }

                                data.forEach(c => {
                    const tr = document.createElement('tr');
                    tr.className = 'hover:bg-slate-50 transition border-b border-slate-100';
                    const safeName = (c.name || '').replace(/'/g, "\'");
                    const mstBadge = c.tax_code 
                        ? `<span class="bg-amber-50 text-amber-800 font-mono font-bold px-2 py-0.5 rounded border border-amber-200 text-[11px]">${c.tax_code}</span>` 
                        : `<span class="text-slate-300 italic">-</span>`;
                    tr.innerHTML = `
                        <td class="p-3.5 font-mono font-bold text-blue-600">${c.code}</td>
                        <td class="p-3.5 font-bold text-slate-800">${c.name}</td>
                        <td class="p-3.5">${mstBadge}</td>
                        <td class="p-3.5 text-slate-600 font-semibold font-mono text-xs">${c.phone || '-'}</td>
                        <td class="p-3.5 text-slate-500 text-xs">${c.email || '-'}</td>
                        <td class="p-3.5 text-slate-600 text-xs">${c.address || '-'}</td>
                        <td class="p-3.5 text-center font-bold text-blue-700">${c.total_bookings} tiệc</td>
                        <td class="p-3.5 text-center">
                            <div class="flex items-center justify-center gap-1.5">
                                <button onclick="bookForCustomer('${c.code}', '${safeName}', '${c.phone}')" class="px-2.5 py-1 bg-emerald-50 text-emerald-700 hover:bg-emerald-600 hover:text-white rounded text-xs font-bold transition">
                                    Đặt Tiệc
                                </button>
                                <button onclick="openMergeCustomerModal('${c.code}', '${safeName}', '${c.tax_code || ''}')" title="Gộp mã khách hàng này nếu bị trùng" class="px-2 py-1 bg-indigo-50 text-indigo-700 hover:bg-indigo-600 hover:text-white rounded text-xs font-bold transition flex items-center gap-1">
                                    <i data-lucide="git-merge" class="w-3 h-3"></i>
                                    <span>Gộp</span>
                                </button>
                            </div>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });
                lucide.createIcons();
            } catch (err) {
                console.error("Search cust error:", err);
            }
        }

        function bookForCustomer(code, name, phone) {
            openNewBookingModal();
            document.getElementById('nbGuestName').value = name;
            document.getElementById('nbGuestPhone').value = phone;
        }

        function renderMasterMenus() {
            const tbody = document.getElementById('tblMasterMenus');
