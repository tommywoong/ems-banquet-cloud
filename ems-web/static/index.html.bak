        function formatVND(val) {
            return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(val || 0);
        }
    

        // -------------------------------------------------------------
        // HORIZONTAL SCROLL & VIEW SPAN CONTROLS
        // -------------------------------------------------------------
        function scrollMatrixSmooth(amount) {
            const el = document.getElementById('schedScrollContainer');
            if (el) el.scrollBy({ left: amount, behavior: 'smooth' });
        }

        function shiftSchedulerDays(days) {
            const fromInput = document.getElementById('txtSchedFrom');
            const toInput = document.getElementById('txtSchedTo');
            if (!fromInput.value || !toInput.value) return;
            const d1 = new Date(fromInput.value);
            const d2 = new Date(toInput.value);
            d1.setDate(d1.getDate() + days);
            d2.setDate(d2.getDate() + days);
            fromInput.value = d1.toISOString().split('T')[0];
            toInput.value = d2.toISOString().split('T')[0];
            loadSchedulerData();
            initScrollListeners();
            loadCancelReasons();
        }

        function setMatrixSpan(numDays) {
            const fromInput = document.getElementById('txtSchedFrom');
            const toInput = document.getElementById('txtSchedTo');
            const start = fromInput.value ? new Date(fromInput.value) : new Date('2026-11-10');
            const end = new Date(start);
            end.setDate(end.getDate() + numDays - 1);
            toInput.value = end.toISOString().split('T')[0];

            ['3','7','14','30'].forEach(s => {
                const b = document.getElementById('btnSpan' + s);
                if (b) {
                    if (parseInt(s) === numDays) {
                        b.className = 'px-2 py-0.5 rounded bg-white text-blue-700 shadow-xs font-bold';
                    } else {
                        b.className = 'px-2 py-0.5 rounded hover:bg-white text-slate-600 font-medium';
                    }
                }
            });
            loadSchedulerData();
            initScrollListeners();
            loadCancelReasons();
        }

        function initScrollListeners() {
            const container = document.getElementById('schedScrollContainer');
            if (!container) return;
            let isDown = false;
            let startX, startScrollLeft;
            container.addEventListener('mousedown', (e) => {
                if (e.target.closest('.booking-badge') || e.target.closest('button') || e.target.closest('input') || e.target.closest('a')) return;
                isDown = true;
                startX = e.pageX - container.offsetLeft;
                startScrollLeft = container.scrollLeft;
                container.style.cursor = 'grabbing';
            });
            window.addEventListener('mouseup', () => {
                isDown = false;
                if (container) container.style.cursor = 'default';
            });
            container.addEventListener('mousemove', (e) => {
                if (!isDown) return;
                e.preventDefault();
                const x = e.pageX - container.offsetLeft;
                const walk = (x - startX) * 1.5;
                container.scrollLeft = startScrollLeft - walk;
            });
            container.addEventListener('wheel', (e) => {
                if (e.deltaY !== 0 && !e.shiftKey) {
                    if (container.scrollWidth > container.clientWidth) {
                        container.scrollLeft += e.deltaY;
                    }
                }
            }, { passive: true });
        }

        // -------------------------------------------------------------
        // CANCEL MODAL & REASONS (stReasonCancel)
        // -------------------------------------------------------------
        let cancelReasonsList = [];
        async function loadCancelReasons() {
            try {
                const res = await fetch('/api/master/reasons-cancel');
                cancelReasonsList = await res.json();
                const sel = document.getElementById('selCancelReason');
                if (sel) {
                    sel.innerHTML = cancelReasonsList.map(r => `<option value="${r.code}">${r.code} - ${r.name} ${r.note ? '(' + r.note + ')' : ''}</option>`).join('');
                }
            } catch (err) {
                console.error("Error loading cancel reasons:", err);
            }
        }

        function quickCancelCurrentBooking() {
            if (!currentActiveBookingId) return;
            document.getElementById('lblCancelBookId').textContent = `Mã đơn tiệc: ${currentActiveBookingId}`;
            document.getElementById('txtCancelNote').value = '';
            document.getElementById('cancelBookingModal').classList.remove('hidden');
        }

        function openCancelBookingModal(bookId, title) {
            currentActiveBookingId = bookId;
            const lbl = document.getElementById('lblCancelBookId');
            if (lbl) lbl.textContent = `Mã đơn tiệc: ${bookId}${title ? ' - ' + title : ''}`;
            const txt = document.getElementById('txtCancelNote');
            if (txt) txt.value = '';
            const modal = document.getElementById('cancelBookingModal');
            if (modal) modal.classList.remove('hidden');
        }

        async function submitCancelBooking() {
            if (!currentActiveBookingId) return;
            const sel = document.getElementById('selCancelReason');
            const reasonCode = sel ? sel.value : '';
            const reasonObj = cancelReasonsList.find(x => x.code === reasonCode);
            const reasonName = reasonObj ? reasonObj.name : '';
            const note = document.getElementById('txtCancelNote').value.trim();

            try {
                const res = await fetch(`/api/bookings/${currentActiveBookingId}/cancel`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ reason_code: reasonCode, reason_name: reasonName, note: note })
                });
                const data = await res.json();
                alert(data.message || 'Đã hủy đơn tiệc!');
                closeModal('cancelBookingModal');
                closeModal('editBookingModal');
                loadSchedulerData();
            initScrollListeners();
            loadCancelReasons();
                loadBookingsList();
            } catch (err) {
                alert('Lỗi hủy đơn tiệc!');
            }
        }

        // -------------------------------------------------------------
        // CHARGES BREAKDOWN (stBooking_Charges)
        // -------------------------------------------------------------
        async function loadBookingCharges(bookId) {
            const tbody = document.getElementById('ebChargesBody');
            const totalLbl = document.getElementById('ebChargesTotal');
            tbody.innerHTML = '<tr><td colspan="6" class="p-3 text-center text-slate-400">Đang tải phụ thu...</td></tr>';
            try {
                const res = await fetch(`/api/bookings/${bookId}/charges`);
                const data = await res.json();
                totalLbl.textContent = formatVND(data.total || 0);

                if (!data.items || data.items.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="p-3 text-center text-slate-400">Đơn tiệc chưa có hạng mục phụ thu nào.</td></tr>';
                    return;
                }

                tbody.innerHTML = data.items.map(c => `
                    <tr class="hover:bg-slate-50 transition">
                        <td class="p-2 font-semibold text-slate-800">${c.charge_name}</td>
                        <td class="p-2 text-center font-bold">${c.quantity}</td>
                        <td class="p-2 text-right font-mono">${formatVND(c.price)}</td>
                        <td class="p-2 text-center">${c.vat}%</td>
                        <td class="p-2 text-right font-mono font-bold text-emerald-700">${formatVND(c.amount)}</td>
                        <td class="p-2 text-slate-500">${c.note || '-'}</td>
                    </tr>
                `).join('');
            } catch (err) {
                tbody.innerHTML = '<tr><td colspan="6" class="p-3 text-center text-rose-500">Lỗi khi tải bảng kê phụ thu.</td></tr>';
            }
        }

        // -------------------------------------------------------------
        // AUDIT TRAIL LOGIC
        // -------------------------------------------------------------
        async function loadAuditLogs() {
            const deniedBox = document.getElementById('auditAccessDenied');
            const contentBox = document.getElementById('auditContent');

            if (deniedBox) deniedBox.classList.add('hidden');
            if (contentBox) contentBox.classList.remove('hidden');

            try {
                const userSel = document.getElementById('selAuditUser');
                const actionSel = document.getElementById('selAuditAction');
                const searchTxt = document.getElementById('txtAuditSearch');

                const p = new URLSearchParams();
                if (userSel && userSel.value && userSel.value !== 'ALL') p.append('user_name', userSel.value);
                if (actionSel && actionSel.value && actionSel.value !== 'ALL') p.append('action_type', actionSel.value);
                if (searchTxt && searchTxt.value.trim()) p.append('book_id', searchTxt.value.trim());

                const res = await fetch('/api/audit-logs?' + p.toString());
                const data = await res.json();

                // Populate selAuditUser if empty
                if (userSel && userSel.options.length <= 1) {
                    const currentVal = userSel.value || 'ALL';
                    const uniqueUsers = {};
                    data.forEach(l => {
                        if (l.user_name) {
                            uniqueUsers[l.user_name] = l.user_full_name || l.user_name;
                        }
                    });
                    userSel.innerHTML = '<option value="ALL">-- Tất cả nhân viên --</option>';
                    Object.keys(uniqueUsers).sort().forEach(u => {
                        const opt = document.createElement('option');
                        opt.value = u;
                        opt.textContent = `${uniqueUsers[u]} (${u})`;
                        if (u === currentVal) opt.selected = true;
                        userSel.appendChild(opt);
                    });
                }

                document.getElementById('lblAuditTotalCount').textContent = `${data.length} bản ghi`;
                const tbody = document.getElementById('tblAuditBody');
                tbody.innerHTML = '';

                if (!data || data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="p-8 text-center text-slate-400">Chưa có nhật ký thao tác nào phù hợp bộ lọc.</td></tr>';
                    return;
                }

                data.forEach(log => {
                    let actionBadge = '<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-700">Khác</span>';
                    if (log.action_type === 'LOGIN') {
                        actionBadge = '<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-100 text-indigo-700">Đăng Nhập</span>';
                    } else if (log.action_type === 'CREATE_BOOKING') {
                        actionBadge = '<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-blue-100 text-blue-700">Tạo Tiệc Mới</span>';
                    } else if (log.action_type === 'UPDATE_BOOKING') {
                        actionBadge = '<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-700">Chỉnh Sửa</span>';
                    } else if (log.action_type === 'CANCEL_BOOKING') {
                        actionBadge = '<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-rose-100 text-rose-700">Hủy Tiệc</span>';
                    } else if (log.action_type === 'CONFIRM_BOOKING') {
                        actionBadge = '<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-700">Khóa Chốt</span>';
                    } else if (log.action_type === 'SAVE_BEO') {
                        actionBadge = '<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-purple-100 text-purple-700">Lập BEO</span>';
                    }

                    const tr = document.createElement('tr');
                    tr.className = 'hover:bg-slate-50 transition border-b border-slate-100';
                    tr.innerHTML = `
                        <td class="p-3 font-mono text-[11px] text-slate-600">${log.timestamp}</td>
                        <td class="p-3">
                            <span class="font-bold text-slate-800">${log.user_full_name || log.user_name}</span>
                            <span class="text-[10px] font-mono text-slate-400 block">${log.user_name}</span>
                        </td>
                        <td class="p-3 text-center">${actionBadge}</td>
                        <td class="p-3 font-mono font-bold text-blue-600">${log.book_id || '-'}</td>
                        <td class="p-3 font-semibold text-slate-700">${log.room || '-'}</td>
                        <td class="p-3 text-slate-700">${log.details || '-'}</td>
                    `;
                    tbody.appendChild(tr);
                });
                lucide.createIcons();
            } catch (err) {
                console.error("Error loading audit logs:", err);
            }
        }

        // Hook audit view in navTo
        const origNavTo = navTo;
        navTo = function(viewName) {
            origNavTo(viewName);
            if (viewName === 'audit') {
                loadAuditLogs();
            }
        };



// -------------------------------------------------------------
        // 3. ITEMS (A - T) MASTER DATA MANAGEMENT JAVASCRIPT ENGINE
        // -------------------------------------------------------------
        let itemsConfig = null;
        let currentItemCategory = 'revenue'; // default to F. Revenue (Loại biểu phí / doanh thu)
        let currentLoadedCategoryData = [];
        let editingItemCode = null;
        let itemsDataCache = {};

        async function initItemsModule() {
            try {
                if (!itemsConfig) {
                    const res = await fetch('/api/items/config');
                    itemsConfig = await res.json();
                }
                renderItemsCategoryGrid();
                delete itemsDataCache[currentItemCategory]; await loadItemsCategory(currentItemCategory, true);
            } catch (err) {
                console.error("initItemsModule error:", err);
            }
        }

        let currentActiveGroupFilter = 'all';

        const ITEM_GROUPS = {
            'rooms': ['function_room', 'room_type', 'sale_type', 'room_night'],
            'revenue': ['revenue', 'department', 'set_menu', 'charge_type'],
            'customers': ['customer', 'nation', 'province', 'campaign'],
            'finance': ['event', 'color', 'currency', 'rate', 'payment_method', 'booking_status', 'event_status', 'reason_cancel']
        };

        let currentOpenSubmenu = null;

        function toggleItemSubmenu(parentLetter, event) {
            if (event) event.stopPropagation();
            const menu = document.getElementById(`dropdownSubmenu_${parentLetter}`);
            if (!menu) return;
            
            // If already open, close it
            if (currentOpenSubmenu === parentLetter && !menu.classList.contains('hidden')) {
                menu.classList.add('hidden');
                currentOpenSubmenu = null;
                return;
            }
            
            // Close all other submenus first
            ['A', 'B'].forEach(l => {
                const m = document.getElementById(`dropdownSubmenu_${l}`);
                if (m) m.classList.add('hidden');
            });
            
            menu.classList.remove('hidden');
            currentOpenSubmenu = parentLetter;
        }

        // Close submenus when clicking outside
        document.addEventListener('click', function(e) {
            if (currentOpenSubmenu) {
                const currentMenu = document.getElementById(`dropdownSubmenu_${currentOpenSubmenu}`);
                const currentBtn = document.getElementById(`cardParent_${currentOpenSubmenu}`);
                if (currentMenu && !currentMenu.contains(e.target) && currentBtn && !currentBtn.contains(e.target)) {
                    currentMenu.classList.add('hidden');
                    currentOpenSubmenu = null;
                }
            }
        });

        function filterItemsGroup(grpKey) {
            currentActiveGroupFilter = grpKey;
            ['all', 'rooms', 'revenue', 'customers', 'finance'].forEach(k => {
                const tab = document.getElementById(`tabGrp_${k}`);
                if (tab) {
                    if (k === grpKey) {
                        tab.className = 'px-2.5 py-1 rounded-lg bg-amber-400 text-slate-950 font-black shadow-sm transition';
                    } else {
                        tab.className = 'px-2 py-1 rounded-lg text-white/80 hover:bg-white/15 transition';
                    }
                }
            });
            renderItemsCategoryGrid();
        }

        function renderItemsCategoryGrid() {
            const container = document.getElementById('itemsCategoryGrid');
            const drop = document.getElementById('selItemsCategoryQuickDropdown');
            if (!container || !itemsConfig) return;
            container.innerHTML = '';

            // Populate Quick Dropdown with optgroups
            if (drop) {
                drop.innerHTML = '<option value="">-- Bấm chọn nhanh danh mục Item --</option>';
                
                // Group A
                const grpA = document.createElement('optgroup');
                grpA.label = 'A. Customer (Khách Hàng - 3 menu con)';
                ['customer_guest', 'customer_kind', 'customer_segment'].forEach(k => {
                    if (itemsConfig[k]) {
                        const opt = document.createElement('option');
                        opt.value = k;
                        opt.textContent = itemsConfig[k].title;
                        grpA.appendChild(opt);
                    }
                });
                drop.appendChild(grpA);

                // Group B
                const grpB = document.createElement('optgroup');
                grpB.label = 'B. Function Room (Sảnh Tiệc - 3 menu con)';
                ['function_room_room', 'function_room_kind', 'function_room_setup'].forEach(k => {
                    if (itemsConfig[k]) {
                        const opt = document.createElement('option');
                        opt.value = k;
                        opt.textContent = itemsConfig[k].title;
                        grpB.appendChild(opt);
                    }
                });
                drop.appendChild(grpB);

                // Single items C to T
                const grpOther = document.createElement('optgroup');
                grpOther.label = 'Các danh mục đơn (C -> T)';
                Object.keys(itemsConfig).forEach(k => {
                    const cfg = itemsConfig[k];
                    if (!cfg.parent && !cfg.has_sub && k !== 'customer' && k !== 'function_room') {
                        const opt = document.createElement('option');
                        opt.value = k;
                        opt.textContent = cfg.title;
                        grpOther.appendChild(opt);
                    }
                });
                drop.appendChild(grpOther);
            }

            // Check if group filter matches
            const allowGroup = (grp) => {
                if (currentActiveGroupFilter === 'all') return true;
                const list = ITEM_GROUPS[currentActiveGroupFilter] || [];
                return list.includes(grp);
            };

            // Helper to render luxury dark parent card (Exactly 1 slot in the grid!)
            function renderLuxuryDarkParentSlot(letter, mainTitle, vnDesc, subKeys) {
                const isAnySubActive = subKeys.includes(currentItemCategory);
                let currentSubTitle = '';
                if (isAnySubActive && itemsConfig[currentItemCategory]) {
                    const subCfg = itemsConfig[currentItemCategory];
                    currentSubTitle = `${subCfg.sub_letter || ''}. ${subCfg.title.split('(')[0].replace(/^.*?\.\s*/, '').trim()}`;
                }

                const wrapper = document.createElement('div');
                wrapper.className = 'relative';

                let subButtonsHtml = '';
                subKeys.forEach(sk => {
                    const scfg = itemsConfig[sk];
                    if (!scfg) return;
                    const isSubActive = sk === currentItemCategory;
                    subButtonsHtml += `
                        <button type="button" onclick="loadItemsCategory('${sk}'); document.getElementById('dropdownSubmenu_${letter}').classList.add('hidden'); currentOpenSubmenu=null;" 
                            class="w-full text-left px-3 py-2 text-xs transition flex items-center justify-between rounded-lg border ${
                                isSubActive 
                                ? 'bg-amber-400 text-slate-950 font-black border-amber-300 shadow-md ring-1 ring-amber-300' 
                                : 'text-slate-200 hover:bg-white/10 hover:text-white border-white/5 font-medium'
                            }">
                            <div class="flex items-center gap-2 min-w-0">
                                <span class="w-5 h-5 rounded-md flex items-center justify-center text-[10px] font-black shrink-0 ${
                                    isSubActive ? 'bg-slate-950 text-amber-300' : 'bg-white/20 text-amber-300'
                                }">${scfg.sub_letter || ''}</span>
                                <span class="truncate">${scfg.title}</span>
                            </div>
                            ${isSubActive ? '<i data-lucide="check" class="w-3.5 h-3.5 text-slate-950 shrink-0"></i>' : ''}
                        </button>
                    `;
                });

                wrapper.innerHTML = `
                    <button type="button" id="cardParent_${letter}" onclick="toggleItemSubmenu('${letter}', event)" 
                        class="w-full p-2.5 rounded-xl text-left transition flex items-center gap-2.5 border text-xs shadow-sm relative ${
                            isAnySubActive 
                            ? 'bg-amber-400 text-slate-950 font-bold border-amber-300 shadow-lg ring-2 ring-amber-400/50' 
                            : 'bg-white/10 hover:bg-white/20 text-white border-white/10'
                        }">
                        <span class="w-6 h-6 rounded-lg flex items-center justify-center text-xs font-black shrink-0 ${
                            isAnySubActive ? 'bg-slate-950 text-amber-300' : 'bg-white/20 text-amber-300'
                        }">${letter}</span>
                        <div class="min-w-0 flex-1">
                            <div class="text-[11px] font-black tracking-wide truncate leading-tight flex items-center justify-between">
                                <span>${mainTitle}</span>
                                <i data-lucide="chevron-down" class="w-3 h-3 ml-1 ${isAnySubActive ? 'text-slate-950' : 'text-amber-300'}"></i>
                            </div>
                            <div class="text-[9px] ${isAnySubActive ? 'text-slate-900 font-bold' : 'text-blue-200/80'} truncate leading-tight mt-0.5">
                                ${currentSubTitle ? `Đang chọn: ${currentSubTitle}` : `${vnDesc} (3 menu con ▾)`}
                            </div>
                        </div>
                    </button>

                    <!-- Luxury Dark Glass Dropdown (Popup noi khong chiem dien tich luoi) -->
                    <div id="dropdownSubmenu_${letter}" class="hidden absolute left-0 top-full mt-2 w-72 bg-slate-900/98 backdrop-blur-md rounded-xl shadow-2xl border border-amber-400/50 z-50 p-2 space-y-1 animate-in fade-in zoom-in-95 duration-100">
                        <div class="px-2 py-1 text-[10px] font-black uppercase text-amber-300 tracking-wider border-b border-white/10 mb-1 flex items-center justify-between">
                            <span>Chọn menu con (${letter})</span>
                            <span class="px-1.5 py-0.2 rounded bg-amber-400/20 text-amber-300 border border-amber-400/30">3 mục</span>
                        </div>
                        ${subButtonsHtml}
                    </div>
                `;

                container.appendChild(wrapper);
            }

            // Render A. Customer (1 ô lưới chuẩn màu tối)
            if (allowGroup('customer')) {
                renderLuxuryDarkParentSlot('A', 'Customer', 'Khách Hàng', ['customer_guest', 'customer_kind', 'customer_segment']);
            }

            // Render B. Function Room (1 ô lưới chuẩn màu tối)
            if (allowGroup('function_room')) {
                renderLuxuryDarkParentSlot('B', 'Function Room', 'Sảnh Tiệc', ['function_room_room', 'function_room_kind', 'function_room_setup']);
            }

            // Render single items C to T as standard luxury dark cards (1 ô lưới)
            Object.keys(itemsConfig).forEach(key => {
                const cfg = itemsConfig[key];
                if (cfg.parent || cfg.has_sub || key === 'customer' || key === 'function_room') return;

                if (!allowGroup(key)) return;

                const rawTitle = cfg.title || '';
                const parts = rawTitle.split('. ');
                const letter = parts[0] || '';
                const rest = parts.slice(1).join('. ');
                let eng = rest;
                let vn = '';
                if (rest.includes('(') && rest.includes(')')) {
                    const m = rest.match(/^(.*?)\s*\((.*?)\)$/);
                    if (m) {
                        eng = m[1].trim();
                        vn = m[2].trim();
                    }
                }

                const btn = document.createElement('button');
                btn.type = 'button';
                btn.id = `pill-item-${key}`;
                const isActive = key === currentItemCategory;

                btn.className = `w-full p-2.5 rounded-xl text-left transition flex items-center gap-2.5 border text-xs shadow-sm ${
                    isActive 
                    ? 'bg-amber-400 text-slate-950 font-bold border-amber-300 shadow-lg ring-2 ring-amber-400/50' 
                    : 'bg-white/10 hover:bg-white/20 text-white border-white/10'
                }`;

                btn.innerHTML = `
                    <span class="w-6 h-6 rounded-lg flex items-center justify-center text-xs font-black shrink-0 ${
                        isActive ? 'bg-slate-950 text-amber-300' : 'bg-white/20 text-amber-300'
                    }">${letter}</span>
                    <div class="min-w-0 flex-1">
                        <div class="text-[11px] font-black tracking-wide truncate leading-tight">${eng}</div>
                        <div class="text-[9px] ${isActive ? 'text-slate-900 font-bold' : 'text-blue-200/80'} truncate leading-tight mt-0.5">${vn || eng}</div>
                    </div>
                `;

                btn.onclick = () => loadItemsCategory(key);
                container.appendChild(btn);
            });

            lucide.createIcons();
        }

        async function loadItemsCategory(catKey, forceReload = false) {
            const viewContainer = document.querySelector('.overflow-y-auto');
            if (viewContainer) viewContainer.scrollTop = 0;
            window.scrollTo(0, 0);

            if (!itemsConfig) await initItemsModule();

            // Support both internal key ('room_night') or letter ('E')
            if (itemsConfig && !itemsConfig[catKey]) {
                const upper = String(catKey).toUpperCase();
                for (const [k, v] of Object.entries(itemsConfig)) {
                    if (v.letter === upper || (v.title && v.title.startsWith(upper + '.'))) {
                        catKey = k;
                        break;
                    }
                }
            }

            currentItemCategory = catKey;
            editingItemCode = null;

            // Re-render grid to update highlight cleanly
            renderItemsCategoryGrid();

            // Sync quick dropdown
            const drop = document.getElementById('selItemsCategoryQuickDropdown');
            if (drop) drop.value = catKey;

            const cfg = itemsConfig[catKey];
            const lblTitle = document.getElementById('lblCurrentItemTitle');
            if (lblTitle) lblTitle.textContent = cfg.title;
            const lblAct = document.getElementById('lblItemsActiveCategoryName');
            if (lblAct) lblAct.textContent = cfg.title;

            // Build Table Header (Put Thao Tac as Column 2 for immediate visibility)
            const thead = document.getElementById('tblItemsHead');
            let thHtml = '<tr>';
            cfg.fields.forEach((f, idx) => {
                thHtml += `<th class="p-3 whitespace-nowrap">${f.label}</th>`;
                if (idx === 0) {
                    thHtml += '<th class="p-3 text-center w-28 whitespace-nowrap bg-blue-50/80 text-blue-900 border-x border-slate-200">Thao Tác</th>';
                }
            });
            thHtml += '</tr>';
            thead.innerHTML = thHtml;

            // Fetch Data
            const tbody = document.getElementById('tblItemsBody');
            if (!forceReload && itemsDataCache[catKey]) {
                currentLoadedCategoryData = itemsDataCache[catKey];
                document.getElementById('lblItemCountBadge').textContent = `${currentLoadedCategoryData.length} mục`;
                filterCurrentItems();
                return;
            }

            tbody.innerHTML = '<tr><td colspan="8" class="p-8 text-center text-slate-400">Đang tải dữ liệu từ SQL Server...</td></tr>';

            try {
                const res = await fetch(`/api/items/${catKey}`);
                const data = await res.json();
                currentLoadedCategoryData = data.items || [];
                itemsDataCache[catKey] = currentLoadedCategoryData;
                document.getElementById('lblItemCountBadge').textContent = `${currentLoadedCategoryData.length} mục`;
                filterCurrentItems();
            } catch (err) {
                tbody.innerHTML = `<tr><td colspan="8" class="p-8 text-center text-rose-500">Lỗi nạp dữ liệu: ${err.message}</td></tr>`;
            }
        }

        let customerLookupOptions = null;
        async function ensureCustomerLookups() {
            if (!customerLookupOptions) {
                try {
                    const res = await fetch('/api/customers/lookup-options');
                    if (res.ok) customerLookupOptions = await res.json();
                } catch (e) {
                    console.error("Lookup fetch err:", e);
                }
            }
            return customerLookupOptions || { sources: [], segments: [], provinces: [], nations: [] };
        }

        function formatLookupDisplay(key, val) {
            if (!val || !customerLookupOptions) return val || '';
            if (key === 'fcLoaiKhach' && customerLookupOptions.sources) {
                const found = customerLookupOptions.sources.find(s => s.code === val);
                return found ? `${found.name} (${found.note || found.group || ''})` : val;
            }
            if (key === 'fcLinhVuc' && customerLookupOptions.segments) {
                const found = customerLookupOptions.segments.find(s => s.code === val);
                return found ? `${found.name} (${found.note || ''})` : val;
            }
            if (key === 'fcTinh_TP' && customerLookupOptions.provinces) {
                const found = customerLookupOptions.provinces.find(p => p.code === val);
                return found ? found.name : val;
            }
            if (key === 'fcQuocGia' && customerLookupOptions.nations) {
                const found = customerLookupOptions.nations.find(n => n.code === val);
                return found ? found.name : val;
            }
            return val || '';
        }

        function renderItemsTableRows(items) {
            const tbody = document.getElementById('tblItemsBody');
            tbody.innerHTML = '';
            const cfg = itemsConfig[currentItemCategory];

            if (!items || items.length === 0) {
                tbody.innerHTML = '<tr><td colspan="14" class="p-8 text-center text-slate-400">Không có bản ghi nào trong danh mục này. Bấm "+ Thêm Mới" để tạo!</td></tr>';
                return;
            }

            items.forEach(item => {
                const code = item[cfg.pk];
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-blue-50/40 transition border-b border-slate-100 cursor-pointer group';
                tr.title = 'Nhấp đúp chuột vào bất kỳ vị trí nào để Sửa thông tin';
                tr.setAttribute('ondblclick', `openEditItemModal('${encodeURIComponent(code)}')`);

                let tdHtml = '';
                cfg.fields.forEach((f, idx) => {
                    let val = item[f.key] || '';
                    if (f.type === 'select') {
                        val = formatLookupDisplay(f.key, val);
                    }
                    if (idx === 0) {
                        tdHtml += `<td class="p-3 font-mono font-bold text-blue-700 whitespace-nowrap">${val}</td>`;
                        // Insert Thao Tac at Column 2
                        tdHtml += `
                            <td class="p-2.5 text-center whitespace-nowrap bg-slate-50/70 border-x border-slate-100" onclick="event.stopPropagation()">
                                <div class="flex items-center justify-center gap-1.5">
                                    <button type="button" onclick="openEditItemModal('${encodeURIComponent(code)}')" class="px-2.5 py-1 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-bold transition flex items-center gap-1 shadow-sm shadow-blue-500/20" title="Chỉnh sửa thông tin">
                                        <i data-lucide="edit-2" class="w-3 h-3"></i> Sửa
                                    </button>
                                    <button type="button" onclick="confirmDeleteItem('${encodeURIComponent(code)}')" class="px-2 py-1 bg-rose-50 text-rose-600 hover:bg-rose-600 hover:text-white rounded-lg text-xs font-bold transition flex items-center gap-1" title="Xóa">
                                        <i data-lucide="trash" class="w-3 h-3"></i> Xóa
                                    </button>
                                </div>
                            </td>
                        `;
                    } else if (idx === 1) {
                        tdHtml += `<td class="p-3 font-bold text-slate-800 min-w-[220px]">${val}</td>`;
                    } else {
                        tdHtml += `<td class="p-3 text-slate-600 max-w-xs truncate" title="${val}">${val}</td>`;
                    }
                });

                tr.innerHTML = tdHtml;
                tbody.appendChild(tr);
            });
            lucide.createIcons();
        }

        let currentSortMode = 'default';

        function applySorting(items) {
            if (!items || items.length === 0) return [];
            const sorted = [...items];
            const cfg = itemsConfig[currentItemCategory];
            const pk = cfg ? cfg.pk : 'fcMa';

            if (currentSortMode === 'newest') {
                sorted.sort((a, b) => {
                    const da = a.fdNgayNhap || a.fdUpdate || '';
                    const db = b.fdNgayNhap || b.fdUpdate || '';
                    if (da && db && da !== db) return db.localeCompare(da);
                    return String(b[pk]).localeCompare(String(a[pk]), undefined, { numeric: true });
                });
            } else if (currentSortMode === 'oldest') {
                sorted.sort((a, b) => {
                    const da = a.fdNgayNhap || a.fdUpdate || '';
                    const db = b.fdNgayNhap || b.fdUpdate || '';
                    if (da && db && da !== db) return da.localeCompare(db);
                    return String(a[pk]).localeCompare(String(b[pk]), undefined, { numeric: true });
                });
            } else if (currentSortMode === 'name_asc') {
                sorted.sort((a, b) => {
                    const na = a.fcTen || a.fcName || a.fcMenuName || a.fcDescription1 || '';
                    const nb = b.fcTen || b.fcName || b.fcMenuName || b.fcDescription1 || '';
                    return na.localeCompare(nb, 'vi', { sensitivity: 'base' });
                });
            } else if (currentSortMode === 'name_desc') {
                sorted.sort((a, b) => {
                    const na = a.fcTen || a.fcName || a.fcMenuName || a.fcDescription1 || '';
                    const nb = b.fcTen || b.fcName || b.fcMenuName || b.fcDescription1 || '';
                    return nb.localeCompare(na, 'vi', { sensitivity: 'base' });
                });
            } else {
                // 'default': Bảo toàn 100% thứ tự gốc từ SQL Server (phần mềm Desktop gốc)
                return sorted;
            }
            return sorted;
        }

        function handleSortChange(sortMode) {
            currentSortMode = sortMode;
            filterCurrentItems();
        }

        function filterCurrentItems() {
            const q = document.getElementById('txtItemSearch').value.trim().toLowerCase();
            let data = applySorting(currentLoadedCategoryData);
            if (q) {
                data = data.filter(item => {
                    return Object.values(item).some(val => String(val).toLowerCase().includes(q));
                });
            }
            renderItemsTableRows(data);
        }

        async function openCreateItemModal() {
            editingItemCode = null;
            const cfg = itemsConfig[currentItemCategory];
            const isCustomer = currentItemCategory.startsWith('customer_guest') || currentItemCategory === 'customer';
            
            const modalBox = document.getElementById('modalItemCrudContainer');
            if (modalBox) {
                if (isCustomer) {
                    modalBox.classList.remove('max-w-lg');
                    modalBox.classList.add('max-w-4xl');
                } else {
                    modalBox.classList.remove('max-w-4xl');
                    modalBox.classList.add('max-w-lg');
                }
            }

            document.getElementById('lblItemModalTitle').textContent = `TẠO MỚI ITEM: ${cfg.title.toUpperCase()}`;
            document.getElementById('lblItemModalSubtitle').textContent = `Thêm mới bản ghi vào bảng ${cfg.table} trong SQL Server.`;

            const container = document.getElementById('itemModalFieldsContainer');
            container.innerHTML = '';

            let lookups = { sources: [], segments: [], provinces: [], nations: [] };
            if (isCustomer) {
                lookups = await ensureCustomerLookups();
            }

            const todayStr = new Date().toISOString().split('T')[0];

            if (isCustomer) {
                // Professional 2-Column Desktop layout for Customer
                let html = `
                    <div class="bg-blue-50/80 border border-blue-200 rounded-xl p-3 flex items-center justify-between text-blue-900 font-bold mb-3 shadow-sm">
                        <div class="flex items-center gap-2">
                            <i data-lucide="building-2" class="w-4 h-4 text-blue-600"></i>
                            <span class="text-xs uppercase tracking-wide">Company Information (Thông Tin Khách Hàng / Đơn Vị)</span>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
                        <div>
                            <label class="block font-bold text-slate-700 mb-1">Mã Khách Hàng <span class="text-slate-400 font-normal text-[10px]">(Để trống sẽ tự sinh theo chuẩn hệ thống)</span></label>
                            <input type="text" id="fld_fcMa" placeholder="Tự sinh mã khách hàng..." class="w-full p-2 border border-slate-200 rounded-lg text-xs font-mono font-medium focus:ring-2 focus:ring-blue-500 bg-slate-50" />
                        </div>
                        <div>
                            <label class="block font-bold text-slate-700 mb-1">Mã Số Thuế (Tax code)</label>
                            <input type="text" id="fld_fcMST" placeholder="VD: 0317293073..." class="w-full p-2 border border-slate-200 rounded-lg text-xs font-medium focus:ring-2 focus:ring-blue-500" />
                        </div>
                        <div class="md:col-span-2">
                            <label class="block font-bold text-slate-700 mb-1">Tên Khách Hàng / Đơn Vị (Company Name) <span class="text-rose-500">*</span></label>
                            <input type="text" id="fld_fcTen" placeholder="VD: CÔNG TY TNHH DU LỊCH VÀ SỰ KIỆN GOLA..." class="w-full p-2 border border-slate-200 rounded-lg text-xs font-bold text-slate-800 focus:ring-2 focus:ring-blue-500" required />
                        </div>
                        <div>
                            <label class="block font-bold text-slate-700 mb-1">Số Điện Thoại (Telephone)</label>
                            <input type="text" id="fld_fcTelephone" placeholder="VD: 0918 234 518..." class="w-full p-2 border border-slate-200 rounded-lg text-xs font-medium focus:ring-2 focus:ring-blue-500" />
                        </div>
                        <div>
                            <label class="block font-bold text-slate-700 mb-1">Fax</label>
                            <input type="text" id="fld_fcFax" placeholder="Nhập số fax..." class="w-full p-2 border border-slate-200 rounded-lg text-xs font-medium focus:ring-2 focus:ring-blue-500" />
                        </div>
                        <div>
                            <label class="block font-bold text-slate-700 mb-1">Email</label>
                            <input type="email" id="fld_fcEmail" placeholder="VD: contact@company.com..." class="w-full p-2 border border-slate-200 rounded-lg text-xs font-medium focus:ring-2 focus:ring-blue-500" />
                        </div>
                        <div>
                            <label class="block font-bold text-slate-700 mb-1">Province (Tỉnh Thành Phố)</label>
                            <select id="fld_fcTinh_TP" class="w-full p-2 border border-slate-200 rounded-lg text-xs font-medium focus:ring-2 focus:ring-blue-500 bg-white">
                                <option value="">-- Chọn Tỉnh / Thành Phố --</option>
                                ${lookups.provinces.map(p => `<option value="${p.code}">${p.name} ${p.note ? '('+p.note+')' : ''}</option>`).join('')}
                            </select>
                        </div>
                        <div class="md:col-span-2">
                            <label class="block font-bold text-slate-700 mb-1">Địa Chỉ (Address)</label>
                            <input type="text" id="fld_fcDiaChi" placeholder="Số nhà, đường, phường/xã, quận/huyện..." class="w-full p-2 border border-slate-200 rounded-lg text-xs font-medium focus:ring-2 focus:ring-blue-500" />
                        </div>
                        <div>
                            <label class="block font-bold text-slate-700 mb-1">Nation (Quốc Gia)</label>
                            <select id="fld_fcQuocGia" class="w-full p-2 border border-slate-200 rounded-lg text-xs font-medium focus:ring-2 focus:ring-blue-500 bg-white">
                                <option value="">-- Chọn Quốc Gia --</option>
                                ${lookups.nations.map(n => `<option value="${n.code}" ${n.code === 'VIE' ? 'selected' : ''}>${n.name} (${n.code})</option>`).join('')}
                            </select>
                        </div>
                        <div>
                            <label class="block font-bold text-slate-700 mb-1">Source Codes (Nguồn / Loại Khách Hàng) <span class="text-rose-500">*</span></label>
                            <select id="fld_fcLoaiKhach" class="w-full p-2 border border-slate-200 rounded-lg text-xs font-bold text-blue-900 focus:ring-2 focus:ring-blue-500 bg-white">
                                <option value="">-- Chọn Nguồn Khách Hàng --</option>
                                ${lookups.sources.map(s => `<option value="${s.code}">${s.name} - ${s.note || s.group || ''}</option>`).join('')}
                            </select>
                        </div>
                        <div class="md:col-span-2">
                            <label class="block font-bold text-slate-700 mb-1">Market Segmentation (Phân Khúc Thị Trường) <span class="text-rose-500">*</span></label>
                            <select id="fld_fcLinhVuc" class="w-full p-2 border border-slate-200 rounded-lg text-xs font-bold text-emerald-900 focus:ring-2 focus:ring-blue-500 bg-white">
                                <option value="">-- Chọn Phân Khúc Thị Trường --</option>
                                ${lookups.segments.map(sg => `<option value="${sg.code}">${sg.name} - ${sg.note || ''}</option>`).join('')}
                            </select>
                        </div>
                        <div class="md:col-span-2">
                            <label class="block font-bold text-slate-700 mb-1">Ghi Chú (Note)</label>
                            <textarea id="fld_fcGhiChu" rows="2" placeholder="Ghi chú thêm về khách hàng..." class="w-full p-2 border border-slate-200 rounded-lg text-xs focus:ring-2 focus:ring-blue-500"></textarea>
                        </div>
                    </div>
                    <div class="mt-4 pt-3 border-t border-slate-100 text-[11px] text-slate-500 italic flex items-center gap-1.5">
                        <i data-lucide="info" class="w-4 h-4 text-blue-500"></i>
                        <span>Sau khi bấm "Lưu Vào SQL Server" để tạo mới khách hàng, bạn có thể bấm Sửa để bổ sung Danh sách người liên hệ (List of Contact Persons).</span>
                    </div>
                `;
                container.innerHTML = html;
            } else {
                // Standard Item layout
                cfg.fields.forEach(f => {
                    const div = document.createElement('div');
                    const reqAsterisk = f.required ? ' <span class="text-rose-500">*</span>' : '';
                    const maxInfo = f.max_length ? ` <span class="text-slate-400 font-normal text-[10px]">(Tối đa ${f.max_length} ký tự)</span>` : '';
                    div.innerHTML = `<label class="block font-bold text-slate-700 mb-1">${f.label}${reqAsterisk}${maxInfo}</label>`;

                    if (f.type === 'textarea') {
                        const txt = document.createElement('textarea');
                        txt.id = `fld_${f.key}`;
                        txt.rows = 3;
                        txt.className = 'w-full p-2 border border-slate-200 rounded-lg text-xs focus:ring-2 focus:ring-blue-500';
                        txt.placeholder = `Nhập ${f.label.toLowerCase()}...`;
                        div.appendChild(txt);
                    } else {
                        const inp = document.createElement('input');
                        inp.type = f.type || 'text';
                        inp.id = `fld_${f.key}`;
                        inp.className = 'w-full p-2 border border-slate-200 rounded-lg text-xs font-medium focus:ring-2 focus:ring-blue-500';
                        inp.placeholder = `Nhập ${f.label.toLowerCase()}...`;
                        if (f.max_length) inp.maxLength = f.max_length;
                        if (f.type === 'date') inp.value = todayStr;
                        div.appendChild(inp);
                    }
                    container.appendChild(div);
                });
            }

            document.getElementById('modalItemCrud').classList.remove('hidden');
            lucide.createIcons();
        }

        async function openEditItemModal(encodedCode) {
            const code = decodeURIComponent(encodedCode);
            editingItemCode = code;
            const cfg = itemsConfig[currentItemCategory];
            const item = currentLoadedCategoryData.find(x => x[cfg.pk] === code);
            if (!item) return;

            const isCustomer = currentItemCategory.startsWith('customer_guest') || currentItemCategory === 'customer';
            const modalBox = document.getElementById('modalItemCrudContainer');
            if (modalBox) {
                if (isCustomer) {
                    modalBox.classList.remove('max-w-lg');
                    modalBox.classList.add('max-w-4xl');
                } else {
                    modalBox.classList.remove('max-w-4xl');
                    modalBox.classList.add('max-w-lg');
                }
            }

            document.getElementById('lblItemModalTitle').textContent = `CHỈNH SỬA ITEM: [${code}]`;
            document.getElementById('lblItemModalSubtitle').textContent = `Cập nhật thông tin trong bảng ${cfg.table} (SQL Server).`;

            const container = document.getElementById('itemModalFieldsContainer');
            container.innerHTML = '';

            let lookups = { sources: [], segments: [], provinces: [], nations: [] };
            if (isCustomer) {
                lookups = await ensureCustomerLookups();
            }

            if (isCustomer) {
                // Desktop Guest Info Replica Form
                let html = `
                    <div class="bg-blue-50/80 border border-blue-200 rounded-xl p-3 flex items-center justify-between text-blue-900 font-bold mb-3 shadow-sm">
                        <div class="flex items-center gap-2">
                            <i data-lucide="building-2" class="w-4 h-4 text-blue-600"></i>
                            <span class="text-xs uppercase tracking-wide">Company Information (Thông Tin Khách Hàng / Đơn Vị)</span>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
                        <div>
                            <label class="block font-bold text-slate-700 mb-1">Mã Khách Hàng</label>
                            <input type="text" id="fld_fcMa" value="${item.fcMa || code}" readonly class="w-full p-2 border border-slate-200 rounded-lg text-xs font-mono font-bold bg-slate-100 text-slate-600 cursor-not-allowed" />
                        </div>
                        <div>
                            <label class="block font-bold text-slate-700 mb-1">Mã Số Thuế (Tax code)</label>
                            <input type="text" id="fld_fcMST" value="${item.fcMST || ''}" placeholder="VD: 0317293073..." class="w-full p-2 border border-slate-200 rounded-lg text-xs font-medium focus:ring-2 focus:ring-blue-500" />
                        </div>
                        <div class="md:col-span-2">
                            <label class="block font-bold text-slate-700 mb-1">Tên Khách Hàng / Đơn Vị (Company Name) <span class="text-rose-500">*</span></label>
                            <input type="text" id="fld_fcTen" value="${item.fcTen || ''}" placeholder="VD: CÔNG TY TNHH DU LỊCH VÀ SỰ KIỆN GOLA..." class="w-full p-2 border border-slate-200 rounded-lg text-xs font-bold text-slate-800 focus:ring-2 focus:ring-blue-500" required />
                        </div>
                        <div>
                            <label class="block font-bold text-slate-700 mb-1">Số Điện Thoại (Telephone)</label>
                            <input type="text" id="fld_fcTelephone" value="${item.fcTelephone || ''}" placeholder="VD: 0918 234 518..." class="w-full p-2 border border-slate-200 rounded-lg text-xs font-medium focus:ring-2 focus:ring-blue-500" />
                        </div>
                        <div>
                            <label class="block font-bold text-slate-700 mb-1">Fax</label>
                            <input type="text" id="fld_fcFax" value="${item.fcFax || ''}" placeholder="Nhập số fax..." class="w-full p-2 border border-slate-200 rounded-lg text-xs font-medium focus:ring-2 focus:ring-blue-500" />
                        </div>
                        <div>
                            <label class="block font-bold text-slate-700 mb-1">Email</label>
                            <input type="email" id="fld_fcEmail" value="${item.fcEmail || ''}" placeholder="VD: contact@company.com..." class="w-full p-2 border border-slate-200 rounded-lg text-xs font-medium focus:ring-2 focus:ring-blue-500" />
                        </div>
                        <div>
                            <label class="block font-bold text-slate-700 mb-1">Province (Tỉnh Thành Phố)</label>
                            <select id="fld_fcTinh_TP" class="w-full p-2 border border-slate-200 rounded-lg text-xs font-medium focus:ring-2 focus:ring-blue-500 bg-white">
                                <option value="">-- Chọn Tỉnh / Thành Phố --</option>
                                ${lookups.provinces.map(p => `<option value="${p.code}" ${item.fcTinh_TP === p.code ? 'selected' : ''}>${p.name} ${p.note ? '('+p.note+')' : ''}</option>`).join('')}
                                ${item.fcTinh_TP && !lookups.provinces.some(p => p.code === item.fcTinh_TP) ? `<option value="${item.fcTinh_TP}" selected>Mã cũ: ${item.fcTinh_TP}</option>` : ''}
                            </select>
                        </div>
                        <div class="md:col-span-2">
                            <label class="block font-bold text-slate-700 mb-1">Địa Chỉ (Address)</label>
                            <input type="text" id="fld_fcDiaChi" value="${item.fcDiaChi || ''}" placeholder="Số nhà, đường, phường/xã, quận/huyện..." class="w-full p-2 border border-slate-200 rounded-lg text-xs font-medium focus:ring-2 focus:ring-blue-500" />
                        </div>
                        <div>
                            <label class="block font-bold text-slate-700 mb-1">Nation (Quốc Gia)</label>
                            <select id="fld_fcQuocGia" class="w-full p-2 border border-slate-200 rounded-lg text-xs font-medium focus:ring-2 focus:ring-blue-500 bg-white">
                                <option value="">-- Chọn Quốc Gia --</option>
                                ${lookups.nations.map(n => `<option value="${n.code}" ${(item.fcQuocGia === n.code || (!item.fcQuocGia && n.code === 'VIE')) ? 'selected' : ''}>${n.name} (${n.code})</option>`).join('')}
                                ${item.fcQuocGia && !lookups.nations.some(n => n.code === item.fcQuocGia) ? `<option value="${item.fcQuocGia}" selected>Mã cũ: ${item.fcQuocGia}</option>` : ''}
                            </select>
                        </div>
                        <div>
                            <label class="block font-bold text-slate-700 mb-1">Source Codes (Nguồn / Loại Khách Hàng) <span class="text-rose-500">*</span></label>
                            <select id="fld_fcLoaiKhach" class="w-full p-2 border border-slate-200 rounded-lg text-xs font-bold text-blue-900 focus:ring-2 focus:ring-blue-500 bg-white">
                                <option value="">-- Chọn Nguồn Khách Hàng --</option>
                                ${lookups.sources.map(s => `<option value="${s.code}" ${item.fcLoaiKhach === s.code ? 'selected' : ''}>${s.name} - ${s.note || s.group || ''}</option>`).join('')}
                                ${item.fcLoaiKhach && !lookups.sources.some(s => s.code === item.fcLoaiKhach) ? `<option value="${item.fcLoaiKhach}" selected>Mã cũ: ${item.fcLoaiKhach}</option>` : ''}
                            </select>
                        </div>
                        <div class="md:col-span-2">
                            <label class="block font-bold text-slate-700 mb-1">Market Segmentation (Phân Khúc Thị Trường) <span class="text-rose-500">*</span></label>
                            <select id="fld_fcLinhVuc" class="w-full p-2 border border-slate-200 rounded-lg text-xs font-bold text-emerald-900 focus:ring-2 focus:ring-blue-500 bg-white">
                                <option value="">-- Chọn Phân Khúc Thị Trường --</option>
                                ${lookups.segments.map(sg => `<option value="${sg.code}" ${item.fcLinhVuc === sg.code ? 'selected' : ''}>${sg.name} - ${sg.note || ''}</option>`).join('')}
                                ${item.fcLinhVuc && !lookups.segments.some(sg => sg.code === item.fcLinhVuc) ? `<option value="${item.fcLinhVuc}" selected>Mã cũ: ${item.fcLinhVuc}</option>` : ''}
                            </select>
                        </div>
                        <div class="md:col-span-2">
                            <label class="block font-bold text-slate-700 mb-1">Ghi Chú (Note)</label>
                            <textarea id="fld_fcGhiChu" rows="2" placeholder="Ghi chú thêm về khách hàng..." class="w-full p-2 border border-slate-200 rounded-lg text-xs focus:ring-2 focus:ring-blue-500">${item.fcGhiChu || ''}</textarea>
                        </div>
                    </div>

                    <!-- LIST OF CONTACT PERSONS SUB-TABLE (REPLICATE DESKTOP FORM) -->
                    <div class="mt-5 pt-4 border-t border-slate-200">
                        <div class="flex items-center justify-between mb-2">
                            <h4 class="font-bold text-slate-800 text-xs flex items-center gap-1.5 uppercase tracking-wide">
                                <i data-lucide="users" class="w-4 h-4 text-blue-600"></i>
                                <span>List of Contact Persons (Danh Sách Người Liên Hệ)</span>
                            </h4>
                            <span id="lblContactCount" class="text-[11px] text-blue-600 font-bold bg-blue-50 px-2 py-0.5 rounded-full"></span>
                        </div>
                        <div class="border border-slate-200 rounded-xl overflow-hidden mb-3 shadow-sm">
                            <table class="w-full text-left text-[11px]">
                                <thead class="bg-slate-50 border-b border-slate-200 text-slate-700 font-bold">
                                    <tr>
                                        <th class="p-2.5">Người liên hệ</th>
                                        <th class="p-2.5">Di động</th>
                                        <th class="p-2.5">ĐT Cơ quan</th>
                                        <th class="p-2.5">Email</th>
                                        <th class="p-2.5">Chức vụ / Ghi chú</th>
                                        <th class="p-2.5 text-center w-16">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody id="tblCustomerContactsBody">
                                    <tr><td colspan="6" class="p-4 text-center text-slate-400">Đang tải danh sách người liên hệ...</td></tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Quick Add Contact Inline Row -->
                        <div class="bg-slate-50/80 border border-slate-200 rounded-xl p-3 flex flex-wrap items-center gap-2">
                            <input id="newContactName" placeholder="Tên người liên hệ *" class="p-2 border border-slate-200 rounded-lg text-xs flex-1 min-w-[140px] font-bold focus:ring-2 focus:ring-blue-500" />
                            <input id="newContactPhone" placeholder="Di động" class="p-2 border border-slate-200 rounded-lg text-xs w-28 font-mono focus:ring-2 focus:ring-blue-500" />
                            <input id="newContactOffice" placeholder="ĐT Cơ quan" class="p-2 border border-slate-200 rounded-lg text-xs w-28 font-mono focus:ring-2 focus:ring-blue-500" />
                            <input id="newContactEmail" placeholder="Email" class="p-2 border border-slate-200 rounded-lg text-xs w-40 focus:ring-2 focus:ring-blue-500" />
                            <input id="newContactRole" placeholder="Chức vụ" class="p-2 border border-slate-200 rounded-lg text-xs w-28 focus:ring-2 focus:ring-blue-500" />
                            <button type="button" onclick="handleAddContactPerson()" class="px-3 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-bold text-xs flex items-center gap-1 shadow-md shadow-blue-500/20 transition">
                                <i data-lucide="plus" class="w-3.5 h-3.5"></i> Thêm NLH
                            </button>
                        </div>
                    </div>
                `;
                container.innerHTML = html;
                loadCustomerContactsForModal(code);
            } else {
                // Standard Item edit form
                cfg.fields.forEach(f => {
                    const div = document.createElement('div');
                    const reqAsterisk = f.required ? ' <span class="text-rose-500">*</span>' : '';
                    const maxInfo = f.max_length ? ` <span class="text-slate-400 font-normal text-[10px]">(Tối đa ${f.max_length} ký tự)</span>` : '';
                    div.innerHTML = `<label class="block font-bold text-slate-700 mb-1">${f.label}${reqAsterisk}${maxInfo}</label>`;

                    if (f.type === 'textarea') {
                        const txt = document.createElement('textarea');
                        txt.id = `fld_${f.key}`;
                        txt.rows = 3;
                        txt.value = item[f.key] || '';
                        txt.className = 'w-full p-2 border border-slate-200 rounded-lg text-xs focus:ring-2 focus:ring-blue-500';
                        div.appendChild(txt);
                    } else {
                        const inp = document.createElement('input');
                        inp.type = f.type || 'text';
                        inp.id = `fld_${f.key}`;
                        inp.value = item[f.key] || '';
                        if (f.key === cfg.pk) {
                            inp.readOnly = true;
                            inp.className = 'w-full p-2 border border-slate-200 rounded-lg text-xs font-mono font-bold bg-slate-100 text-slate-600 cursor-not-allowed';
                        } else {
                            inp.className = 'w-full p-2 border border-slate-200 rounded-lg text-xs font-medium focus:ring-2 focus:ring-blue-500';
                            if (f.max_length) inp.maxLength = f.max_length;
                        }
                        div.appendChild(inp);
                    }
                    container.appendChild(div);
                });
            }

            document.getElementById('modalItemCrud').classList.remove('hidden');
            lucide.createIcons();
        }

        async function loadCustomerContactsForModal(custId) {
            const tbody = document.getElementById('tblCustomerContactsBody');
            if (!tbody) return;
            try {
                const res = await fetch(`/api/customers/${encodeURIComponent(custId)}/contacts`);
                const contacts = await res.json();
                const lbl = document.getElementById('lblContactCount');
                if (lbl) lbl.textContent = `${contacts.length} người liên hệ`;
                if (!contacts || contacts.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="p-4 text-center text-slate-400">Chưa có người liên hệ nào. Hãy nhập thông tin vào hàng bên dưới để thêm!</td></tr>';
                    return;
                }
                let html = '';
                contacts.forEach(c => {
                    html += `
                        <tr class="border-b border-slate-100 hover:bg-slate-50">
                            <td class="p-2.5 font-bold text-slate-800">${c.name || '--'}</td>
                            <td class="p-2.5 font-mono text-blue-600">${c.phone || '--'}</td>
                            <td class="p-2.5 font-mono text-slate-600">${c.office_phone || '--'}</td>
                            <td class="p-2.5 text-slate-600">${c.email || '--'}</td>
                            <td class="p-2.5 text-slate-500">${c.role || '--'}</td>
                            <td class="p-2.5 text-center">
                                <button type="button" onclick="handleDeleteContactPerson('${encodeURIComponent(custId)}', '${encodeURIComponent(c.id)}')" class="p-1 text-rose-500 hover:text-rose-700 hover:bg-rose-50 rounded" title="Xóa người liên hệ">
                                    <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                </button>
                            </td>
                        </tr>
                    `;
                });
                tbody.innerHTML = html;
                lucide.createIcons();
            } catch (e) {
                tbody.innerHTML = `<tr><td colspan="6" class="p-4 text-center text-rose-500">Lỗi tải người liên hệ: ${e.message}</td></tr>`;
            }
        }

        async function handleAddContactPerson() {
            if (!editingItemCode) return;
            const nameEl = document.getElementById('newContactName');
            const phoneEl = document.getElementById('newContactPhone');
            const officeEl = document.getElementById('newContactOffice');
            const emailEl = document.getElementById('newContactEmail');
            const roleEl = document.getElementById('newContactRole');

            const name = nameEl.value.trim();
            if (!name) {
                alert('Vui lòng nhập tên người liên hệ!');
                nameEl.focus();
                return;
            }

            try {
                const res = await fetch(`/api/customers/${encodeURIComponent(editingItemCode)}/contacts`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        name: name,
                        phone: phoneEl.value.trim(),
                        office_phone: officeEl.value.trim(),
                        email: emailEl.value.trim(),
                        role: roleEl.value.trim()
                    })
                });
                if (res.ok) {
                    nameEl.value = '';
                    phoneEl.value = '';
                    officeEl.value = '';
                    emailEl.value = '';
                    roleEl.value = '';
                    loadCustomerContactsForModal(editingItemCode);
                } else {
                    const err = await res.json();
                    alert(err.detail || 'Không thể thêm người liên hệ!');
                }
            } catch (e) {
                alert('Lỗi: ' + e.message);
            }
        }

        async function handleDeleteContactPerson(custId, contactId) {
            if (!confirm('Bạn có chắc chắn muốn xóa người liên hệ này?')) return;
            try {
                const res = await fetch(`/api/customers/${encodeURIComponent(custId)}/contacts/${encodeURIComponent(contactId)}`, {
                    method: 'DELETE'
                });
                if (res.ok) {
                    loadCustomerContactsForModal(custId);
                } else {
                    const err = await res.json();
                    alert(err.detail || 'Không thể xóa người liên hệ!');
                }
            } catch (e) {
                alert('Lỗi: ' + e.message);
            }
        }

                async function handleSaveItem(e) {
            e.preventDefault();
            const cfg = itemsConfig[currentItemCategory];
            const payload = {};

            // Client-side validation for required fields
            for (let f of cfg.fields) {
                const el = document.getElementById(`fld_${f.key}`);
                if (el) {
                    const val = el.value.trim();
                    if (f.required && !val && !editingItemCode && f.key !== cfg.pk) {
                        alert(`Vui lòng nhập trường bắt buộc: [${f.label}]`);
                        el.focus();
                        return;
                    }
                    payload[f.key] = val;
                }
            }

            const btn = document.getElementById('btnSaveItemSubmit');
            const orig = btn.innerHTML;
            btn.innerHTML = '<i class="lucide-loader-2 animate-spin w-4 h-4 mr-1 inline-block"></i> Đang lưu...';
            btn.disabled = true;

            try {
                let url = `/api/items/${currentItemCategory}`;
                let method = 'POST';

                if (editingItemCode) {
                    url += `/${encodeURIComponent(editingItemCode)}`;
                    method = 'PUT';
                }

                const res = await fetch(url, {
                    method: method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();

                if (!res.ok) {
                    alert(data.detail || 'Lỗi khi lưu dữ liệu vào SQL Server!');
                    btn.innerHTML = orig;
                    btn.disabled = false;
                    return;
                }

                alert(data.message || 'Lưu thành công!');
                closeModal('modalItemCrud');
                btn.innerHTML = orig;
                btn.disabled = false;

                // Reload category data
                delete itemsDataCache[currentItemCategory]; await loadItemsCategory(currentItemCategory, true);
                // Also reload master data in other views
                await initMasters();
            } catch (err) {
                alert('Lỗi kết nối khi lưu item: ' + err.message);
                btn.innerHTML = orig;
                btn.disabled = false;
            }
        }

        async function confirmDeleteItem(encodedCode) {
            const code = decodeURIComponent(encodedCode);
            const cfg = itemsConfig[currentItemCategory];
            if (!confirm(`Bạn có chắc chắn muốn XÓA item '${code}' khỏi danh mục ${cfg.title}?\n\nLƯU Ý: Thao tác sẽ xóa trực tiếp trong SQL Server.`)) {
                return;
            }

            try {
                const res = await fetch(`/api/items/${currentItemCategory}/${encodeURIComponent(code)}`, {
                    method: 'DELETE'
                });
                const data = await res.json();
                if (!res.ok) {
                    alert(data.detail || 'Lỗi khi xóa item!');
                    return;
                }
                alert(data.message || 'Xóa thành công!');
                delete itemsDataCache[currentItemCategory]; await loadItemsCategory(currentItemCategory, true);
                await initMasters();
            } catch (err) {
                alert('Lỗi kết nối khi xóa item!');
            }
        }

// ==================== COMPREHENSIVE BOOKING DETAIL MODAL LOGIC ====================
let currentBookingDetail = null;

function switchDetailTab(tabId) {
    ['tabDtl1', 'tabDtl2', 'tabDtl3', 'tabDtl4'].forEach(t => {
        const el = document.getElementById(t);
        if (el) el.classList.toggle('hidden', t !== tabId);
    });
    ['tabBtnDtl1', 'tabBtnDtl2', 'tabBtnDtl3', 'tabBtnDtl4'].forEach(b => {
        const el = document.getElementById(b);
        if (el) {
            const isActive = b === ('tabBtn' + tabId.replace('tab', ''));
            el.className = isActive 
                ? 'px-4 py-2.5 rounded-t-lg border-b-2 border-blue-600 text-blue-600 bg-white font-bold flex items-center gap-2'
                : 'px-4 py-2.5 rounded-t-lg border-b-2 border-transparent text-slate-500 hover:text-slate-800 flex items-center gap-2 font-bold';
        }
    });
}

async function openBookingDetailModal(bookingId) {
    if (!bookingId) return;
    const modal = document.getElementById('modalBookingDetail');
    if (!modal) return;

    modal.classList.remove('hidden');
    switchDetailTab('tabDtl1');

    // Reset fields to loading state
    document.getElementById('dtlBookingId').textContent = bookingId;
    document.getElementById('dtlTitle').textContent = 'Đang tải dữ liệu chi tiết từ SQL Server...';

    try {
        const res = await fetch(`/api/booking-detail/${encodeURIComponent(bookingId)}`);
        if (!res.ok) throw new Error('Không thể tải chi tiết booking');
        const data = await res.json();
        currentBookingDetail = data;

        // Header
        document.getElementById('dtlBookingId').textContent = data.booking_id;
        document.getElementById('dtlTitle').textContent = data.title || (data.customer_name + ' - Tiệc ' + (data.event_date || ''));
        
        const badge = document.getElementById('dtlStatusBadge');
        if (data.status_code === 'D') {
            badge.className = 'px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
            badge.textContent = 'ĐÃ CHỐT (DEFINITE)';
        } else if (data.status_code === 'T') {
            badge.className = 'px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30';
            badge.textContent = 'GIỮ CHỖ (TENTATIVE)';
        } else if (data.status_code === 'C') {
            badge.className = 'px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-rose-500/20 text-rose-300 border border-rose-500/30';
            badge.textContent = 'ĐÃ HỦY (CANCELLED)';
        } else {
            badge.className = 'px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-slate-500/20 text-slate-300 border border-slate-500/30';
            badge.textContent = data.status_name || 'KHÁC';
        }

        const eoBadge = document.getElementById('dtlMasterEoBadge');
        if (data.master_eo) {
            eoBadge.textContent = 'EO: ' + data.master_eo;
            eoBadge.classList.remove('hidden');
        } else {
            eoBadge.classList.add('hidden');
        }

        // Tab 1: Customer CRM
        document.getElementById('dtlGuestCode').textContent = data.guest_code ? 'Mã KH: ' + data.guest_code : '';
        document.getElementById('dtlCustomerName').textContent = data.customer_name || '-';
        document.getElementById('dtlContactPerson').textContent = data.contact_person || '-';
        document.getElementById('dtlPhone').textContent = data.phone || '-';
        document.getElementById('dtlPhoneOffice').textContent = data.phone_office || '-';
        document.getElementById('dtlEmail').textContent = data.email || '-';
        document.getElementById('dtlAddress').textContent = data.address || '-';
        document.getElementById('dtlMst').textContent = data.mst || '-';
        document.getElementById('dtlSegmentChannel').textContent = `${data.segment || '-'} • Nguồn: ${data.channel || '-'}`;

        // Tab 1: Booking & Contract
        document.getElementById('dtlEventDateBadge').textContent = 'Ngày tiệc: ' + (data.event_date || '-');
        document.getElementById('dtlEventDate').textContent = data.event_date || '-';
        document.getElementById('dtlBookingDate').textContent = data.booking_date || '-';
        document.getElementById('dtlPax').textContent = (data.pax || 0).toLocaleString('vi-VN') + ' khách';
        document.getElementById('dtlExpPax').textContent = (data.exp_pax || 0).toLocaleString('vi-VN') + ' khách';
        document.getElementById('dtlDeposit').textContent = formatVND(data.deposit);
        document.getElementById('dtlDepositNote').textContent = data.deposit_note || 'Không có';
        document.getElementById('dtlLockUser').textContent = data.lock_user_name ? `${data.lock_user_name} (${data.lock_user_code})` : (data.lock_user_code || '-');
        document.getElementById('dtlBeoUser').textContent = data.beo_user_name ? `${data.beo_user_name} (${data.beo_user_code})` : (data.beo_user_code || '-');
        document.getElementById('dtlInternalNote').textContent = data.internal_note || 'Không có ghi chú nội bộ.';

        // Financial snapshot cards
        document.getElementById('dtlBanquetRev').textContent = formatVND(data.banquet_revenue);
        document.getElementById('dtlTotalRev').textContent = formatVND(data.total_revenue);
        document.getElementById('dtlDepositBanner').textContent = formatVND(data.deposit);
        document.getElementById('dtlRemainingBalance').textContent = formatVND(data.remaining_balance);

        // Tab 2: Rooms schedule
        const roomTbody = document.getElementById('dtlRoomsTableBody');
        roomTbody.innerHTML = '';
        document.getElementById('dtlRoomCountBadge').textContent = (data.rooms || []).length;
        if (!data.rooms || data.rooms.length === 0) {
            roomTbody.innerHTML = '<tr><td colspan="6" class="p-6 text-center text-slate-400">Không có lịch sử dụng sảnh tiệc.</td></tr>';
        } else {
            data.rooms.forEach(r => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-50 transition border-b border-slate-100';
                tr.innerHTML = `
                    <td class="p-3 font-bold text-slate-800">${r.room_name} <span class="text-[10px] text-slate-400 font-mono">(${r.room_code})</span></td>
                    <td class="p-3 font-semibold text-slate-700">${r.date}</td>
                    <td class="p-3 font-mono text-blue-600 font-semibold">${r.time_in || '-'}</td>
                    <td class="p-3 font-mono text-slate-600 font-semibold">${r.time_out || '-'}</td>
                    <td class="p-3 text-center font-bold text-slate-800">${(r.pax || 0).toLocaleString('vi-VN')}</td>
                    <td class="p-3 text-slate-600"><span class="px-2 py-0.5 rounded bg-slate-100 text-slate-700 text-[11px] font-medium">${r.function_type || 'Tiệc'}</span></td>
                `;
                roomTbody.appendChild(tr);
            });
        }

        // Tab 3: Itemized charges breakdown
        const chargeTbody = document.getElementById('dtlChargesTableBody');
        chargeTbody.innerHTML = '';
        document.getElementById('dtlChargeCountBadge').textContent = (data.charges || []).length;
        if (!data.charges || data.charges.length === 0) {
            chargeTbody.innerHTML = '<tr><td colspan="6" class="p-6 text-center text-slate-400">Không có bảng kê chi phí chi tiết.</td></tr>';
        } else {
            data.charges.forEach(ch => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-50 transition border-b border-slate-100';
                tr.innerHTML = `
                    <td class="p-3 font-mono font-bold text-slate-500">${ch.charge_code}</td>
                    <td class="p-3 font-bold text-slate-800">${ch.service_name}</td>
                    <td class="p-3 text-right font-mono text-slate-600">${formatVND(ch.price)}</td>
                    <td class="p-3 text-center font-semibold text-slate-700">${(ch.quantity || 0).toLocaleString('vi-VN')}</td>
                    <td class="p-3 text-right font-mono font-bold text-emerald-600">${formatVND(ch.amount)}</td>
                    <td class="p-3 text-slate-500 italic text-[11px]">${ch.note || '-'}</td>
                `;
                chargeTbody.appendChild(tr);
            });
        }
        document.getElementById('dtlChargesTotalFoot').textContent = formatVND(data.total_revenue);

        // Tab 4: BEO & Dept notes
        document.getElementById('dtlBeoPreparedBy').textContent = data.prepared_by ? `Prepared: ${data.prepared_by}` : (data.beo_user_name ? `Lập BEO: ${data.beo_user_name}` : 'Chưa lập BEO');
        document.getElementById('dtlPttt').textContent = data.payment_method || '-';
        document.getElementById('dtlBillTo').textContent = data.bill_to || data.customer_name || '-';
        document.getElementById('dtlMenuDetail').textContent = data.menu_detail || 'Chưa cập nhật chi tiết thực đơn.';
        document.getElementById('dtlBeverage').textContent = data.beverage || 'Chưa cập nhật chi tiết thức uống.';
        document.getElementById('dtlRoomSetup').textContent = data.room_setup || 'Chưa cập nhật layout xếp sảnh.';

        const deptContainer = document.getElementById('dtlDeptNotesContainer');
        deptContainer.innerHTML = '';
        if (!data.department_notes || data.department_notes.length === 0) {
            deptContainer.innerHTML = '<p class="col-span-2 text-slate-400 italic">Không có chỉ đạo bộ phận riêng biệt.</p>';
        } else {
            data.department_notes.forEach(dn => {
                const card = document.createElement('div');
                card.className = 'p-3 rounded-lg border border-slate-200 bg-slate-50 space-y-1';
                card.innerHTML = `
                    <div class="flex items-center justify-between font-bold text-slate-800">
                        <span class="text-blue-700">${dn.dept_name}</span>
                        <span class="text-[10px] text-slate-400 font-mono">${dn.dept_code}</span>
                    </div>
                    <p class="text-slate-600 whitespace-pre-line text-[11px]">${dn.note || 'Không có chỉ đạo'}</p>
                `;
                deptContainer.appendChild(card);
            });
        }

    } catch (err) {
        console.error(err);
        document.getElementById('dtlTitle').textContent = 'Lỗi: ' + err.message;
    }
}

function closeBookingDetailModal() {
    const modal = document.getElementById('modalBookingDetail');
    if (modal) modal.classList.add('hidden');
}

function printModalBookingDetail() {
    if (!currentBookingDetail) return;
    window.print();
}


// ==================== STICKY HORIZONTAL SCROLL SYNC & DRAG FOR WEB ====================
function initStickyTableScrollWeb() {
    const tableWrapper = document.getElementById('webBookingsTableWrapper');
    const scrollTrack = document.getElementById('webSyncedScrollTrack');
    const scrollDummy = document.getElementById('webSyncedScrollDummy');
    const controller = document.getElementById('stickyWebBookingsScrollController');

    if (!tableWrapper) return;

    // 1. Mouse Drag to Scroll (Giữ chuột trái để kéo trượt ngang bảng)
    if (!tableWrapper._dragInit) {
        tableWrapper._dragInit = true;
        let isDown = false;
        let startX = 0;
        let scrollStart = 0;
        let hasMoved = false;

        tableWrapper.style.cursor = 'grab';

        tableWrapper.addEventListener('mousedown', (e) => {
            // Chỉ nhận chuột trái (button 0)
            if (e.button !== 0) return;
            // Bỏ qua nếu bấm vào button, link, thẻ input, select
            if (e.target.closest('button, a, input, select, textarea, [onclick]')) return;

            isDown = true;
            hasMoved = false;
            tableWrapper.style.cursor = 'grabbing';
            tableWrapper.style.userSelect = 'none';
            startX = e.pageX - tableWrapper.offsetLeft;
            scrollStart = tableWrapper.scrollLeft;
        });

        window.addEventListener('mouseup', () => {
            if (!isDown) return;
            isDown = false;
            tableWrapper.style.cursor = 'grab';
            tableWrapper.style.removeProperty('user-select');
        });

        tableWrapper.addEventListener('mousemove', (e) => {
            if (!isDown) return;
            e.preventDefault();
            const x = e.pageX - tableWrapper.offsetLeft;
            const walk = (x - startX) * 1.6; // Hệ số cuộn nhanh mượt
            if (Math.abs(walk) > 4) {
                hasMoved = true;
            }
            tableWrapper.scrollLeft = scrollStart - walk;
        });

        // Ngăn click nhầm khi vừa kéo chuột
        tableWrapper.addEventListener('click', (e) => {
            if (hasMoved) {
                e.preventDefault();
                e.stopPropagation();
                hasMoved = false;
            }
        }, true);
    }

    if (!scrollTrack || !scrollDummy) return;

    function syncDimensions() {
        const scrollW = tableWrapper.scrollWidth;
        const clientW = tableWrapper.clientWidth;
        scrollDummy.style.width = scrollW + 'px';
        if (scrollW <= clientW + 10) {
            if (controller) controller.classList.add('hidden');
        } else {
            if (controller) controller.classList.remove('hidden');
        }
    }

    let isSyncingLeft = false;
    let isSyncingRight = false;

    tableWrapper.addEventListener('scroll', () => {
        if (!isSyncingLeft) {
            isSyncingRight = true;
            scrollTrack.scrollLeft = tableWrapper.scrollLeft;
            setTimeout(() => { isSyncingRight = false; }, 50);
        }
    });

    scrollTrack.addEventListener('scroll', () => {
        if (!isSyncingRight) {
            isSyncingLeft = true;
            tableWrapper.scrollLeft = scrollTrack.scrollLeft;
            setTimeout(() => { isSyncingLeft = false; }, 50);
        }
    });

    window.addEventListener('resize', syncDimensions);
    setTimeout(syncDimensions, 300);
}

function scrollWebBookingsTable(dir) {
    const tableWrapper = document.getElementById('webBookingsTableWrapper');
    if (!tableWrapper) return;
    if (dir === 'left') {
        tableWrapper.scrollTo({ left: 0, behavior: 'smooth' });
    } else if (dir === 'right') {
        tableWrapper.scrollTo({ left: tableWrapper.scrollWidth, behavior: 'smooth' });
    }
}

