                            <button type="submit" id="btnSaveItemSubmit" class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-bold shadow-md shadow-blue-500/20 transition flex items-center gap-1.5">
                                <i data-lucide="save" class="w-4 h-4"></i>
                                <span>Lưu Vào SQL Server</span>
