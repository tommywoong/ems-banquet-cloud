                <div class="bg-gradient-to-r from-slate-950 via-indigo-950 to-blue-950 rounded-2xl p-4 text-white shadow-xl border border-blue-900/40 space-y-2.5">
                    <!-- Top Ribbon: Title, Active Badge, Tabs & Create Button -->
                    <div class="flex flex-wrap items-center justify-between gap-3 pb-2.5 border-b border-white/10">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-xl bg-amber-500/20 border border-amber-400/40 flex items-center justify-center text-amber-300 shadow-sm shrink-0">
                                <i data-lucide="layers" class="w-5 h-5"></i>
                            </div>
                            <div>
                                <div class="flex items-center gap-2">
                                    <span class="px-2 py-0.5 rounded text-[10px] font-extrabold bg-amber-400 text-slate-950 uppercase tracking-wide">CHUẨN EMS GỐC</span>
                                    <h3 class="text-sm font-black text-white tracking-wide">3. ITEMS - QUẢN LÝ TẤT CẢ DANH MỤC HỆ THỐNG</h3>
                                    <span id="lblItemsActiveCategoryName" class="text-white font-extrabold px-2.5 py-0.5 rounded-full bg-amber-500/25 border border-amber-400/40 text-[11px] shadow-sm"></span>
                                </div>
                                <p class="text-[11px] text-blue-200/90 mt-0.5">20 danh mục (A. Customer &rarr; T. Campaign) đồng bộ trực tiếp SQL Server.</p>
                            </div>
                        </div>

                        <div class="flex items-center gap-2.5">
                            <!-- Fast Group Tabs -->
                            <div class="inline-flex p-1 bg-black/50 rounded-xl text-[11px] font-bold gap-1 border border-white/10" id="itemsGroupTabs">
                                <button type="button" onclick="filterItemsGroup('all')" id="tabGrp_all" class="px-2.5 py-1 rounded-lg bg-amber-400 text-slate-950 font-black shadow-sm transition">Tất cả (20 mục)</button>
                                <button type="button" onclick="filterItemsGroup('rooms')" id="tabGrp_rooms" class="px-2 py-1 rounded-lg text-white/80 hover:bg-white/15 transition">Sảnh & Phòng (B,C,D,E)</button>
                                <button type="button" onclick="filterItemsGroup('revenue')" id="tabGrp_revenue" class="px-2 py-1 rounded-lg text-white/80 hover:bg-white/15 transition">Doanh Thu (F,G,Q,S)</button>
                                <button type="button" onclick="filterItemsGroup('customers')" id="tabGrp_customers" class="px-2 py-1 rounded-lg text-white/80 hover:bg-white/15 transition">Khách Hàng (A,O,P,T)</button>
                                <button type="button" onclick="filterItemsGroup('finance')" id="tabGrp_finance" class="px-2 py-1 rounded-lg text-white/80 hover:bg-white/15 transition">Khác (H&rarr;N,R)</button>
                            </div>

                            <button onclick="openCreateItemModal()" class="px-3.5 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-xs font-bold transition flex items-center gap-1.5 shadow-lg shadow-emerald-600/30 shrink-0">
                                <i data-lucide="plus-circle" class="w-4 h-4"></i>
                                <span>Thêm Mới</span>
                            </button>
                        </div>
                    </div>

                    <!-- 20 Standard Items Grid (4 rows x 5 cols on desktop, responsive for laptops) -->
                    <!-- Customer & Function Room occupy exactly 1 standard slot, clicking reveals luxury dark popup menu -->
                    <div id="itemsCategoryGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2 relative">
                        <!-- Populated dynamically -->
                    </div>
                </div>

                <!-- Active Category Workspace -->
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden space-y-0">
                    <div class="p-4 border-b border-slate-100 flex flex-wrap items-center justify-between gap-3 bg-slate-50">
                        <div class="flex flex-wrap items-center gap-3">
                            <span class="font-bold text-slate-800 text-sm flex items-center gap-2">
                                <span id="lblCurrentItemTitle" class="text-slate-900 font-extrabold">Đang tải...</span>
                                <span id="lblItemCountBadge" class="text-xs px-2.5 py-0.5 rounded-full bg-blue-100 text-blue-800 font-bold">0 mục</span>
                            </span>
                            <div class="flex items-center gap-1.5 ml-2">
                                <label class="text-[11px] font-bold text-slate-500 uppercase tracking-wide">Menu nhanh:</label>
                                <select id="selItemsCategoryQuickDropdown" onchange="loadItemsCategory(this.value)" class="p-1.5 border border-slate-300 rounded-lg text-xs font-bold text-blue-700 bg-white focus:ring-2 focus:ring-blue-500 shadow-xs">
                                    <!-- Populated dynamically -->
                                </select>
                            </div>
                        </div>
                        <div class="flex flex-wrap items-center gap-2">
                            <!-- Nút / Dropdown Sắp Xếp Tùy Chọn (Bảo tồn mặc định gốc) -->
                            <div class="flex items-center gap-1.5 bg-white border border-slate-200 rounded-lg px-2.5 py-1.5 shadow-xs">
                                <i data-lucide="arrow-up-down" class="w-3.5 h-3.5 text-slate-500"></i>
                                <label for="selItemSortOrder" class="text-[11px] font-bold text-slate-600 whitespace-nowrap">Sắp xếp:</label>
                                <select id="selItemSortOrder" onchange="handleSortChange(this.value)" class="text-xs font-semibold text-slate-800 bg-transparent focus:outline-none cursor-pointer">
                                    <option value="default">Thứ tự mặc định gốc (Theo Mã)</option>
                                    <option value="newest">Khách hàng mới tạo gần nhất (Mới nhất trước)</option>
                                    <option value="oldest">Cũ nhất trước</option>
                                    <option value="name_asc">Tên (A → Z)</option>
                                    <option value="name_desc">Tên (Z → A)</option>
                                </select>
                            </div>
                            <div class="relative w-64">
                                <i data-lucide="search" class="w-3.5 h-3.5 absolute left-3 top-2.5 text-slate-400"></i>
                                <input type="text" id="txtItemSearch" oninput="filterCurrentItems()" placeholder="Tìm kiếm nhanh mã, tên, ghi chú..." class="w-full pl-8 pr-3 py-1.5 text-xs border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
                            </div>
                            <button onclick="openCreateItemModal()" class="px-3.5 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-bold transition flex items-center gap-1.5 shadow-sm">
                                <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                                <span>Thêm Mới</span>
                            </button>
                        </div>
                    </div>

                    <!-- Table of Items (Sticky Header & Viewport Scrollbar) -->
                    <div class="overflow-x-auto overflow-y-auto max-h-[calc(100vh-280px)] border border-slate-200 rounded-xl shadow-sm relative">
                        <table class="w-full text-left border-collapse text-xs">
                            <thead id="tblItemsHead" class="bg-slate-100/95 backdrop-blur-sm sticky top-0 z-20 font-bold text-slate-700 uppercase text-[11px] border-b border-slate-200 shadow-sm">
                                <!-- Populated dynamically -->
                            </thead>
                            <tbody id="tblItemsBody" class="divide-y divide-slate-100">
                                <tr><td colspan="6" class="p-8 text-center text-slate-400">Đang tải danh mục...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- ==================== VIEW: CUTOFF MANAGEMENT ==================== -->
            <section id="viewCutoff" class="hidden space-y-4">
                <!-- Top Header Banner -->
                <div class="bg-gradient-to-r from-amber-900 via-amber-800 to-slate-900 rounded-2xl p-6 text-white shadow-lg flex flex-wrap items-center justify-between gap-4">
                    <div class="space-y-1">
                        <div class="flex items-center gap-2">
                            <span class="p-2 rounded-xl bg-amber-500/20 text-amber-300 border border-amber-500/30">
                                <i data-lucide="bell-ring" class="w-5 h-5"></i>
                            </span>
                            <h2 class="text-lg font-black tracking-wide">QUẢN LÝ HẠN KHÓA SẢNH & CẢNH BÁO CUTOFF</h2>
                        </div>
                        <p class="text-xs text-amber-200/80 max-w-2xl">
                            Theo dõi các đơn tiệc đang Giữ chỗ (Tentative) để tránh quên mở khóa sảnh khi khách không deal thành công. 
                            Hệ thống tự động bật cảnh báo Popup trước 1 ngày cho tất cả tài khoản.
                        </p>
                    </div>
                    <div class="flex items-center gap-2">
                        <button onclick="checkCutoffAlerts(true)" class="px-4 py-2 bg-amber-600 hover:bg-amber-500 text-white font-bold rounded-xl text-xs shadow-md transition flex items-center gap-2 cursor-pointer">
                            <i data-lucide="bell" class="w-4 h-4"></i>
                            <span>Bật Xem Cảnh Báo Khẩn Cấp</span>
                        </button>
                        <button onclick="loadCutoffManagement()" class="p-2 bg-white/10 hover:bg-white/20 text-white rounded-xl text-xs transition cursor-pointer" title="Tải lại">
                            <i data-lucide="refresh-cw" class="w-4 h-4"></i>
                        </button>
                    </div>
                </div>

                <!-- Stats Cards (4 Thẻ thống kê) -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-xs flex items-center justify-between">
                        <div>
                            <span class="text-[11px] font-bold text-slate-500 uppercase">Tổng Giữ Sảnh Có Hạn</span>
                            <div class="text-2xl font-black text-slate-800 mt-0.5" id="statCutoffTotal">0</div>
                            <span class="text-[10px] text-slate-400">Đơn tiệc Tentative</span>
                        </div>
                        <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold">
                            <i data-lucide="calendar" class="w-5 h-5"></i>
                        </div>
                    </div>

                    <div class="bg-white p-4 rounded-xl border border-amber-200 shadow-xs flex items-center justify-between bg-amber-50/20">
                        <div>
                            <span class="text-[11px] font-bold text-amber-800 uppercase">Sắp Hết Hạn (1 Ngày)</span>
                            <div class="text-2xl font-black text-amber-600 mt-0.5" id="statCutoffUrgent">0</div>
                            <span class="text-[10px] text-amber-700 font-medium">Cần liên hệ khách gấp</span>
                        </div>
                        <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center font-bold">
                            <i data-lucide="alert-triangle" class="w-5 h-5"></i>
                        </div>
                    </div>

                    <div class="bg-white p-4 rounded-xl border border-rose-200 shadow-xs flex items-center justify-between bg-rose-50/20">
                        <div>
                            <span class="text-[11px] font-bold text-rose-800 uppercase">Đã Quá Hạn Khóa Sảnh</span>
                            <div class="text-2xl font-black text-rose-600 mt-0.5" id="statCutoffOverdue">0</div>
                            <span class="text-[10px] text-rose-700 font-medium">Nên mở khóa hoặc gia hạn</span>
                        </div>
                        <div class="w-10 h-10 rounded-xl bg-rose-100 text-rose-700 flex items-center justify-center font-bold">
                            <i data-lucide="alert-circle" class="w-5 h-5"></i>
                        </div>
                    </div>

                    <div class="bg-white p-4 rounded-xl border border-emerald-200 shadow-xs flex items-center justify-between bg-emerald-50/20">
                        <div>
                            <span class="text-[11px] font-bold text-emerald-800 uppercase">Còn Hạn An Toàn</span>
                            <div class="text-2xl font-black text-emerald-600 mt-0.5" id="statCutoffSafe">0</div>
                            <span class="text-[10px] text-emerald-700 font-medium">Hạn trên 1 ngày</span>
                        </div>
                        <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold">
                            <i data-lucide="shield-check" class="w-5 h-5"></i>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
                    <!-- Left: Table of Cutoffs (2 Cols) -->
                    <div class="lg:col-span-2 bg-white rounded-xl border border-slate-200 shadow-xs p-4 space-y-3">
                        <div class="flex flex-wrap items-center justify-between gap-3 pb-2 border-b border-slate-100">
                            <div class="flex items-center gap-2">
                                <i data-lucide="list" class="w-4 h-4 text-blue-600"></i>
                                <span class="text-xs font-bold text-slate-800">Danh Sách Đơn Đang Khóa Sảnh (Cutoff)</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <select id="selCutoffFilter" onchange="filterCutoffTable()" class="border border-slate-300 rounded-lg px-2.5 py-1 text-xs font-bold text-slate-700">
                                    <option value="ALL">Tất cả trạng thái</option>
                                    <option value="URGENT">⚠️ Sắp hết hạn (<= 1 ngày)</option>
                                    <option value="OVERDUE">🚨 Đã quá hạn</option>
                                    <option value="SAFE">🛡️ Còn hạn an toàn</option>
                                </select>
                                <input type="text" id="txtCutoffSearch" oninput="filterCutoffTable()" placeholder="Tìm mã booking, tên khách..." class="border border-slate-300 rounded-lg px-2.5 py-1 text-xs focus:ring-1 focus:ring-blue-500 w-44" />
                            </div>
                        </div>

                        <!-- Table -->
                        <div class="overflow-x-auto max-h-[500px]">
                            <table class="w-full text-left border-collapse text-xs">
                                <thead>
                                    <tr class="bg-slate-50 border-b border-slate-200 text-[11px] font-bold text-slate-500 uppercase tracking-wider sticky top-0 z-10">
                                        <th class="p-2.5 whitespace-nowrap">MÃ BOOKING</th>
                                        <th class="p-2.5 whitespace-nowrap">SẢNH / NGÀY TIỆC</th>
                                        <th class="p-2.5 min-w-[160px]">KHÁCH HÀNG</th>
                                        <th class="p-2.5 whitespace-nowrap">SALES LOCK</th>
                                        <th class="p-2.5 whitespace-nowrap">HẠN CUTOFF</th>
                                        <th class="p-2.5 text-center whitespace-nowrap">TRẠNG THÁI</th>
                                        <th class="p-2.5 text-center whitespace-nowrap">THAO TÁC</th>
                                    </tr>
                                </thead>
                                <tbody id="tblCutoffListBody" class="divide-y divide-slate-100">
                                    <tr><td colspan="7" class="p-6 text-center text-slate-400">Đang nạp danh sách hạn khóa sảnh...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Right: Notification & Email Settings (1 Col) -->
                    <div class="bg-white rounded-xl border border-slate-200 shadow-xs p-4 space-y-4">
                        <div class="pb-2 border-b border-slate-100 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <i data-lucide="settings" class="w-4 h-4 text-amber-600"></i>
                                <span class="text-xs font-bold text-slate-800">Cấu Hình Thông Báo & Email</span>
                            </div>
                            <span class="text-[10px] bg-amber-100 text-amber-800 font-bold px-2 py-0.5 rounded">Tự Động</span>
                        </div>

                        <form onsubmit="handleSaveCutoffConfig(event)" class="space-y-3 text-xs">
                            <div>
                                <label class="block font-bold text-slate-700 mb-1">Danh Sách Email Nhận Cảnh Báo</label>
                                <textarea id="cfgCutoffEmails" rows="3" placeholder="sales@merperle.vn, quanly@merperle.vn..." class="w-full p-2 border border-slate-300 rounded-lg text-xs leading-relaxed font-mono focus:ring-2 focus:ring-blue-500 outline-none"></textarea>
                                <p class="text-[10px] text-slate-400 mt-0.5">Nhập các địa chỉ email nhân viên hoặc quản lý, ngăn cách bởi dấu phẩy (,).</p>
                            </div>

                            <div class="grid grid-cols-2 gap-2">
                                <div>
                                    <label class="block font-bold text-slate-700 mb-1">Giờ Bật Nhắc Hàng Ngày</label>
                                    <input type="time" id="cfgCutoffAlertTime" value="08:00" class="w-full p-2 border border-slate-300 rounded-lg font-bold text-slate-800 focus:ring-2 focus:ring-blue-500" />
                                </div>
                                <div>
                                    <label class="block font-bold text-slate-700 mb-1">Trạng Thái Thông Báo</label>
                                    <select id="cfgCutoffActive" class="w-full p-2 border border-slate-300 rounded-lg font-bold text-slate-800">
                                        <option value="1">🟢 Đang Kích Hoạt</option>
                                        <option value="0">⚪ Tạm Tắt</option>
                                    </select>
                                </div>
                            </div>

                            <div class="p-3 bg-slate-50 border border-slate-200 rounded-lg space-y-1.5 text-[11px] text-slate-600">
                                <div class="font-bold text-slate-800 flex items-center gap-1.5">
                                    <i data-lucide="info" class="w-3.5 h-3.5 text-blue-600"></i>
                                    <span>Cơ Chế Cảnh Báo Hoạt Động:</span>
                                </div>
                                <ul class="list-disc pl-4 space-y-1 text-slate-500">
                                    <li><strong>Popup Dashboard:</strong> Tự động hiển thị cho mọi tài khoản đăng nhập khi có đơn tiệc còn &le; 1 ngày.</li>
                                    <li><strong>Email Tự Động:</strong> Sẵn sàng gửi đến danh bạ cấu hình trên (khi kích hoạt SMTP giai đoạn tiếp theo).</li>
                                </ul>
                            </div>

                            <button type="submit" id="btnSaveCutoffConfig" class="w-full py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-bold transition flex items-center justify-center gap-1.5 shadow-sm cursor-pointer">
                                <i data-lucide="save" class="w-4 h-4"></i>
                                <span>Lưu Cấu Hình Thông Báo</span>
                            </button>
                        </form>
                    </div>
                </div>
            </section>
        </div>

            <!-- MODAL: CREATE / EDIT MASTER ITEM -->
            <div id="modalItemCrud" class="hidden fixed inset-0 z-50 bg-slate-900/75 backdrop-blur-sm flex items-center justify-center p-4">
