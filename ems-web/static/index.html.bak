                </div>
            </div>

    </main>

    <!-- EDIT / DETAIL BOOKING MODAL (CHỈNH SỬA, KHÓA CHỐT, HỦY TIỆC) -->
    <div id="editBookingModal" class="hidden fixed inset-0 z-50 bg-slate-900/70 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 max-w-2xl w-full max-h-[92vh] overflow-y-auto">
            <div class="p-5 border-b border-slate-100 flex items-center justify-between bg-slate-50">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center shadow-sm">
                        <i data-lucide="edit-3" class="w-4 h-4"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold text-slate-800 flex items-center gap-2">
                            <span>CHI TIẾT & CHỈNH SỬA ĐƠN TIỆC:</span>
                            <span id="ebBookIdBadge" class="font-mono text-blue-700 bg-blue-100 px-2 py-0.5 rounded text-xs"></span>
                        </h3>
                        <p class="text-[11px] text-slate-500">Cập nhật thông tin sảnh, dời ngày tiệc, chỉnh sửa số khách, đổi trạng thái và liên kết BEO.</p>
                    </div>
                </div>
                <button onclick="closeModal('editBookingModal')" class="p-1.5 text-slate-400 hover:text-slate-600 rounded-lg">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <form onsubmit="handleUpdateBooking(event)" class="p-6 space-y-4 text-xs">
                <!-- Status & User attribution ribbon -->
                <div class="p-3 bg-slate-50 border border-slate-200 rounded-xl flex items-center justify-between">
                    <div class="space-y-0.5">
                        <div class="text-[11px] text-slate-500">Người lock ban đầu: <strong id="ebLockUserDisplay" class="text-slate-700"></strong></div>
                        <div class="text-[11px] text-slate-500">Người lập BEO (Hưởng doanh thu): <strong id="ebBeoUserDisplay" class="text-blue-700"></strong></div>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-bold text-slate-600">Trạng thái:</span>
                        <select id="ebStatus" onchange="toggleEbCutoffField()" class="p-1.5 border border-slate-300 rounded-lg font-bold text-xs focus:ring-2 focus:ring-blue-500">
                            <option value="T">Giữ Chỗ (Tentative - T)</option>
                            <option value="D">Đã Chốt (Definite - D)</option>
                            <option value="C">Đã Hủy (Cancelled - C)</option>
                        </select>
                    </div>
                </div>

                <!-- Cutoff Date input in Edit Booking -->
                <div id="ebCutoffGroup" class="p-3 bg-amber-50/50 border border-amber-300 rounded-xl">
                    <div class="flex items-center justify-between mb-1">
                        <label for="ebCutoffDate" class="font-bold text-amber-950 text-xs flex items-center gap-1.5 cursor-pointer">
                            <i data-lucide="clock" class="w-4 h-4 text-amber-600"></i>
                            <span>Hạn Khóa Sảnh (Cutoff Date) - Nhắc mở sảnh trước 1 ngày</span>
                        </label>
                        <span id="ebCutoffRemainingBadge" class="text-[10px] px-2 py-0.5 rounded font-bold"></span>
                    </div>
                    <input type="date" id="ebCutoffDate" class="w-full p-2 border border-amber-300 rounded-lg font-semibold text-amber-950 bg-white focus:ring-2 focus:ring-amber-500 text-xs" />
                </div>

                <!-- BEO LIFECYCLE BADGE (HIỂN THỊ RÕ TIỆC ĐÃ CÓ BEO / ĐÃ HOÀN TẤT HAY CHƯA) -->
                <div id="ebBeoStatusBadge" class="p-2.5 rounded-xl border flex items-center justify-between text-xs font-semibold"></div>

                <!-- Event Details -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="md:col-span-2">
                        <label class="block font-bold text-slate-700 mb-1">Tên Tiệc / Sự Kiện *</label>
                        <input type="text" id="ebTitle" required class="w-full p-2.5 border border-slate-200 rounded-lg font-bold text-slate-800" />
                    </div>

                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Sảnh Tiệc *</label>
                        <select id="ebRoom" class="w-full p-2.5 border border-slate-200 rounded-lg font-bold text-blue-700"></select>
                    </div>

                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Ngày Tổ Chức (Event Date) *</label>
                        <input type="date" id="ebEventDate" required class="w-full p-2.5 border border-slate-200 rounded-lg font-semibold" />
                    </div>

                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Giờ Vào (Time In) *</label>
                        <input type="time" id="ebTimeIn" required class="w-full p-2.5 border border-slate-200 rounded-lg" />
                    </div>

                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Giờ Ra (Time Out) *</label>
                        <input type="time" id="ebTimeOut" required class="w-full p-2.5 border border-slate-200 rounded-lg" />
                    </div>

                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Số Lượng Khách (Pax) *</label>
                        <input type="number" id="ebPax" min="1" required class="w-full p-2.5 border border-slate-200 rounded-lg font-bold text-emerald-600" />
                    </div>

                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Tiền Đặt Cọc (VNĐ)</label>
                        <input type="number" id="ebDeposit" step="any" class="w-full p-2.5 border border-slate-200 rounded-lg font-mono font-bold text-emerald-600" />
                    </div>
                </div>

                <!-- Customer Details -->
                <div class="border-t border-slate-100 pt-3 space-y-3">
                    <h4 class="font-bold text-slate-700 uppercase tracking-wider text-[11px]">Thông Tin Khách Hàng</h4>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-slate-600 mb-1 font-semibold">Tên Khách Hàng *</label>
                            <input type="text" id="ebGuestName" required class="w-full p-2 border border-slate-200 rounded-lg" />
                        </div>
                        <div>
                            <label class="block text-slate-600 mb-1 font-semibold">Số Điện Thoại</label>
                            <input type="tel" id="ebGuestPhone" class="w-full p-2 border border-slate-200 rounded-lg" />
                        </div>
                        <div>
                            <label class="block text-slate-600 mb-1 font-semibold">Email</label>
                            <input type="email" id="ebGuestEmail" class="w-full p-2 border border-slate-200 rounded-lg" />
                        </div>
                        <div>
                            <label class="block text-slate-600 mb-1 font-semibold">Địa Chỉ</label>
                            <input type="text" id="ebGuestAddress" class="w-full p-2 border border-slate-200 rounded-lg" />
                        </div>
                    </div>
                </div>

                
                <!-- BẢNG KÊ DOANH THU & DỊCH VỤ PHỤ THU CHI TIẾT (stBooking_Charges) -->
                <div class="border-t border-slate-100 pt-3 space-y-2">
                    <div class="flex items-center justify-between">
                        <h4 class="font-bold text-slate-700 uppercase tracking-wider text-[11px] flex items-center gap-1.5">
                            <i data-lucide="receipt" class="w-3.5 h-3.5 text-blue-600"></i>
                            <span>Bảng Kê Chi Tiết Phụ Thu & Dịch Vụ (stBooking_Charges)</span>
                        </h4>
                        <span id="ebChargesTotal" class="text-xs font-bold font-mono text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 rounded">0 đ</span>
                    </div>
                    <div class="max-h-36 overflow-y-auto border border-slate-200 rounded-lg">
                        <table class="w-full text-left border-collapse text-[11px]">
                            <thead class="bg-slate-50 text-slate-500 font-bold border-b border-slate-200 sticky top-0">
                                <tr>
                                    <th class="p-2">Dịch Vụ / Hạng Mục</th>
                                    <th class="p-2 text-center w-14">SL</th>
                                    <th class="p-2 text-right w-24">Đơn Giá</th>
                                    <th class="p-2 text-center w-14">VAT %</th>
                                    <th class="p-2 text-right w-28">Thành Tiền</th>
                                    <th class="p-2">Ghi Chú</th>
                                </tr>
                            </thead>
                            <tbody id="ebChargesBody" class="divide-y divide-slate-100">
                                <tr><td colspan="6" class="p-4 text-center text-slate-400">Chưa có phụ thu hoặc đang tải...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Notes -->
                <div>
                    <label class="block text-slate-600 mb-1 font-semibold">Ghi Chú Đơn Tiệc</label>
                    <textarea id="ebNotes" rows="2" class="w-full p-2 border border-slate-200 rounded-lg"></textarea>
                </div>

                <!-- Modal Actions Toolbar -->
                <div class="pt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3">
                    <!-- Left: Quick Action Buttons -->
                    <div class="flex items-center gap-2">
                        <button type="button" onclick="quickConfirmCurrentBooking()" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg font-bold flex items-center gap-1 transition shadow-sm">
                            <i data-lucide="check-check" class="w-3.5 h-3.5"></i>
                            <span>Khóa Chốt (Definite)</span>
                        </button>
                        <button type="button" onclick="quickCancelCurrentBooking()" class="px-3 py-1.5 bg-rose-50 text-rose-700 hover:bg-rose-100 border border-rose-200 rounded-lg font-bold flex items-center gap-1 transition">
                            <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                            <span>Hủy Tiệc & Nhả Sảnh</span>
                        </button>
                        <button type="button" id="btnModalOpenBeo" onclick="openBeoFromEditModal()" class="px-3 py-1.5 bg-indigo-50 text-indigo-700 hover:bg-indigo-100 border border-indigo-200 rounded-lg font-bold flex items-center gap-1 transition">
                            <i data-lucide="file-text" class="w-3.5 h-3.5"></i>
                            <span>Soạn Lệnh BEO &rarr;</span>
                        </button>
                    </div>

                    <!-- Right: Save & Close -->
                    <div class="flex items-center gap-2">
                        <button type="button" onclick="closeModal('editBookingModal')" class="px-3.5 py-1.5 border border-slate-200 text-slate-600 rounded-lg hover:bg-slate-50 transition">Đóng</button>
                        <button type="submit" class="px-4 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-bold shadow-md shadow-blue-500/20 transition flex items-center gap-1.5">
                            <i data-lucide="save" class="w-3.5 h-3.5"></i>
                            <span>Lưu Cập Nhật</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- NEW BOOKING MODAL -->
    <div id="newBookingModal" class="hidden fixed inset-0 z-50 bg-slate-900/70 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 max-w-2xl w-full max-h-[90vh] overflow-y-auto">
            <div class="p-5 border-b border-slate-100 flex items-center justify-between bg-slate-50">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center">
                        <i data-lucide="calendar-plus" class="w-4 h-4"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold text-slate-800">TẠO ĐƠN ĐẶT TIỆC MỚI (EMS BOOKING)</h3>
                        <p class="text-[11px] text-slate-500">Tự động kiểm tra xung đột sảnh và sinh mã Booking chuẩn EMS.</p>
                    </div>
                </div>
                <button onclick="closeModal('newBookingModal')" class="p-1.5 text-slate-400 hover:text-slate-600 rounded-lg">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <form onsubmit="handleCreateBooking(event)" class="p-6 space-y-4 text-xs">
                <div class="p-3 bg-blue-50 border border-blue-200 rounded-xl flex items-center justify-between">
                    <div>
                        <span class="text-slate-500 text-[11px]">Nhân viên thực hiện (Lock User):</span>
                        <span id="nbCurrentUserDisplay" class="font-bold text-blue-700 text-xs ml-1">Administrator (ADMIN)</span>
                    </div>
                    <span class="px-2 py-0.5 bg-blue-600 text-white rounded text-[10px] font-bold">Tự Động Gán</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="md:col-span-2">
                        <label class="block font-bold text-slate-700 mb-1">Tên Tiệc / Sự Kiện *</label>
                        <input type="text" id="nbTitle" required placeholder="VD: TIỆC CƯỚI NGUYỄN VĂN A & TRẦN THỊ B..." class="w-full p-2.5 border border-slate-200 rounded-lg font-bold" />
                    </div>

                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Sảnh Tiệc *</label>
                        <select id="nbRoom" onchange="checkConflictAuto()" class="w-full p-2.5 border border-slate-200 rounded-lg font-bold text-blue-700"></select>
                    </div>

                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Ngày Tổ Chức (Event Date) *</label>
                        <input type="date" id="nbEventDate" required onchange="checkConflictAuto()" class="w-full p-2.5 border border-slate-200 rounded-lg font-semibold" />
                    </div>

                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Giờ Bắt Đầu (Time In) *</label>
                        <input type="time" id="nbTimeIn" value="18:00" required onchange="checkConflictAuto()" class="w-full p-2.5 border border-slate-200 rounded-lg" />
                    </div>

                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Giờ Kết Thúc (Time Out) *</label>
                        <input type="time" id="nbTimeOut" value="22:00" required onchange="checkConflictAuto()" class="w-full p-2.5 border border-slate-200 rounded-lg" />
                    </div>

                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Số Lượng Khách Dự Kiến (Pax) *</label>
                        <input type="number" id="nbPax" value="100" min="1" required class="w-full p-2.5 border border-slate-200 rounded-lg font-bold text-emerald-600" />
                    </div>

                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Trạng Thái Đặt Chỗ</label>
                        <select id="nbStatus" onchange="toggleNbCutoffField()" class="w-full p-2.5 border border-slate-200 rounded-lg font-bold">
                            <option value="T">Giữ Chỗ (Tentative - T)</option>
                            <option value="D">Đã Chốt (Definite - D)</option>
                        </select>
                    </div>

                    <div id="nbCutoffGroup" class="md:col-span-2 p-3 bg-amber-50/60 border border-amber-300 rounded-xl">
                        <div class="flex items-center justify-between mb-1">
                            <label for="nbCutoffDate" class="font-bold text-amber-950 text-xs flex items-center gap-1.5 cursor-pointer">
                                <i data-lucide="clock" class="w-4 h-4 text-amber-600"></i>
                                <span>* Hạn Khóa Sảnh (Cutoff Date) - Cảnh báo trước 1 ngày</span>
                            </label>
                            <span class="text-[10px] text-amber-800 bg-amber-100 px-2 py-0.5 rounded font-bold">Chỉ áp dụng khi Giữ chỗ (T)</span>
                        </div>
                        <input type="date" id="nbCutoffDate" class="w-full p-2 border border-amber-300 rounded-lg font-semibold text-amber-950 bg-white focus:ring-2 focus:ring-amber-500 text-xs" />
                        <p class="text-[11px] text-slate-500 mt-1">Chỉ được chọn ngày tương lai. Hệ thống sẽ tự động bật cảnh báo Popup trước 1 ngày để liên hệ khách hoặc mở khóa sảnh.</p>
                    </div>
                </div>

                <div id="nbConflictAlert" class="hidden p-3 rounded-xl border"></div>

                <div class="border-t border-slate-100 pt-3 space-y-3">
                    <div class="flex items-center justify-between">
                        <h4 class="font-bold text-slate-700 uppercase tracking-wider text-[11px] flex items-center gap-1.5">
                            <i data-lucide="user" class="w-3.5 h-3.5 text-blue-600"></i>
                            <span>Thông Tin Khách Hàng</span>
                        </h4>
                        <button type="button" onclick="openBookingCustomerSearchModal()" class="px-2.5 py-1 bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white rounded-lg text-xs font-bold transition flex items-center gap-1 shadow-2xs border border-blue-200 cursor-pointer">
                            <i data-lucide="search" class="w-3.5 h-3.5"></i>
                            <span>Tìm / Chọn Khách Hàng Có Sẵn</span>
                        </button>
                    </div>

                    <!-- Hidden input to store chosen customer ID -->
                    <input type="hidden" id="nbCustomerID" value="" />

                    <!-- Badge when a customer is chosen -->
                    <div id="nbCustomerSelectedBadge" class="hidden p-2 bg-emerald-50 border border-emerald-200 rounded-lg text-emerald-800 text-xs font-medium flex items-center justify-between">
                        <span class="flex items-center gap-1.5 truncate">
                            <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-600 shrink-0"></i>
                            <span id="nbCustomerSelectedText" class="truncate font-bold"></span>
                        </span>
                        <button type="button" onclick="clearSelectedBookingCustomer()" class="text-rose-600 hover:text-rose-800 text-[11px] font-bold px-2 py-0.5 hover:bg-rose-100/50 rounded shrink-0 ml-2">
                            Bỏ chọn
                        </button>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-slate-600 mb-1 font-semibold">Tên Khách Hàng / Đơn Vị *</label>
                            <input type="text" id="nbGuestName" required placeholder="Họ tên hoặc tên công ty..." class="w-full p-2 border border-slate-200 rounded-lg text-xs font-bold text-slate-800" />
                        </div>
                        <div>
                            <label class="block text-slate-600 mb-1 font-semibold">Số Điện Thoại *</label>
                            <input type="tel" id="nbGuestPhone" required placeholder="0901234567..." class="w-full p-2 border border-slate-200 rounded-lg text-xs font-mono font-bold text-blue-800" />
                        </div>
                        <div>
                            <label class="block text-slate-600 mb-1 font-semibold">Email</label>
                            <input type="email" id="nbGuestEmail" placeholder="khachhang@gmail.com..." class="w-full p-2 border border-slate-200 rounded-lg text-xs" />
                        </div>
                        <div>
                            <label class="block text-slate-600 mb-1 font-semibold">Tiền Đặt Cọc (VNĐ)</label>
                            <input type="number" id="nbDeposit" value="0" step="any" class="w-full p-2 border border-slate-200 rounded-lg font-mono font-bold text-emerald-600 text-xs" />
                        </div>
                        <div class="md:col-span-2">
                            <label class="block text-slate-600 mb-1 font-semibold">Địa Chỉ Khách Hàng / Công Ty</label>
                            <input type="text" id="nbGuestAddress" placeholder="Địa chỉ trụ sở công ty hoặc khách hàng..." class="w-full p-2 border border-slate-200 rounded-lg text-xs" />
                        </div>
                        <div class="md:col-span-2 p-2.5 bg-slate-50 border border-slate-200 rounded-xl space-y-2">
                            <div class="font-bold text-slate-700 text-[11px] uppercase tracking-wider flex items-center gap-1.5">
                                <i data-lucide="receipt" class="w-3.5 h-3.5 text-blue-600"></i>
                                <span>Thông Tin Xuất Hóa Đơn (VAT Invoice)</span>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                                <div>
                                    <label class="block text-slate-500 text-[10px] mb-0.5">Tên Đơn Vị Xuất Hóa Đơn</label>
                                    <input type="text" id="nbBillCompany" placeholder="Tên công ty xuất hóa đơn VAT..." class="w-full p-1.5 border border-slate-200 rounded text-xs font-medium" />
                                </div>
                                <div>
                                    <label class="block text-slate-500 text-[10px] mb-0.5">Mã Số Thuế (MST)</label>
                                    <input type="text" id="nbBillTaxCode" placeholder="0400412819-001..." class="w-full p-1.5 border border-slate-200 rounded text-xs font-mono font-bold" />
                                </div>
                                <div class="md:col-span-2">
                                    <label class="block text-slate-500 text-[10px] mb-0.5">Địa Chỉ Xuất Hóa Đơn</label>
                                    <input type="text" id="nbBillAddress" placeholder="Địa chỉ in trên hóa đơn VAT..." class="w-full p-1.5 border border-slate-200 rounded text-xs font-medium" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="pt-3 flex items-center justify-end gap-3">
                    <button type="button" onclick="closeModal('newBookingModal')" class="px-4 py-2 border border-slate-200 text-slate-600 rounded-lg hover:bg-slate-50 transition">Hủy</button>
                    <button type="submit" id="btnSubmitBooking" class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-bold shadow-md shadow-blue-500/20 transition flex items-center gap-1.5">
                        <i data-lucide="check" class="w-4 h-4"></i>
                        <span>Lưu & Khóa Sảnh (Lock)</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

        <!-- MODAL: SEARCH & SELECT EXISTING CUSTOMER FOR BOOKING -->
    <div id="modalBookingCustomerSearch" class="hidden fixed inset-0 z-50 bg-slate-900/75 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 max-w-3xl w-full max-h-[85vh] flex flex-col overflow-hidden animate-in fade-in zoom-in-95 duration-150">
            <div class="p-4 border-b border-slate-100 flex items-center justify-between bg-slate-50">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center">
                        <i data-lucide="user-check" class="w-4 h-4"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold text-slate-800 uppercase tracking-wide">Tra Cứu & Chọn Khách Hàng Có Sẵn</h3>
                        <p class="text-[11px] text-slate-500">Tìm kiếm từ danh mục 780 khách hàng trong SQL Server stKhachHang.</p>
                    </div>
                </div>
                <button type="button" onclick="closeModal('modalBookingCustomerSearch')" class="p-1.5 text-slate-400 hover:text-slate-600 rounded-lg">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
            </div>
            <div class="p-3 border-b border-slate-100 bg-white">
                <div class="relative">
                    <i data-lucide="search" class="w-4 h-4 absolute left-3 top-2.5 text-slate-400"></i>
                    <input type="text" id="txtBookingCustomerSearch" oninput="debounceSearchBookingCustomers()" placeholder="Gõ tên khách hàng, công ty, số điện thoại, mã số thuế hoặc mã KH để tìm..." class="w-full pl-9 pr-3 py-2 text-xs border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 bg-slate-50 focus:bg-white font-medium" />
                </div>
            </div>
            <div class="flex-1 overflow-y-auto p-3">
                <div class="border border-slate-200 rounded-xl overflow-hidden shadow-2xs">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-slate-50 border-b border-slate-200 text-slate-700 font-bold uppercase text-[10px] sticky top-0 bg-slate-50">
                            <tr>
                                <th class="p-2.5 w-16">Mã KH</th>
                                <th class="p-2.5">Tên Khách Hàng / Đơn Vị</th>
                                <th class="p-2.5 w-32">Số Điện Thoại</th>
                                <th class="p-2.5 w-28">Mã Số Thuế</th>
                                <th class="p-2.5 text-center w-20">Chọn</th>
                            </tr>
                        </thead>
                        <tbody id="tblBookingCustomersSearchBody" class="divide-y divide-slate-100">
                            <tr><td colspan="5" class="p-6 text-center text-slate-400">Đang tải danh sách khách hàng...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="p-3 border-t border-slate-100 bg-slate-50 flex items-center justify-between text-xs">
                <span id="lblBookingCustomerCount" class="text-slate-500 text-[11px]">Đang hiển thị...</span>
                <button type="button" onclick="closeModal('modalBookingCustomerSearch')" class="px-4 py-1.5 border border-slate-200 text-slate-600 rounded-lg hover:bg-slate-100 font-medium">Đóng</button>
            </div>
        </div>
    </div>

    <!-- LOGIN MODAL -->
    <div id="loginModal" class="hidden fixed inset-0 z-50 bg-slate-900/80 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 max-w-md w-full overflow-hidden">
            <div class="p-6 bg-gradient-to-tr from-slate-900 via-blue-950 to-indigo-900 text-white text-center relative">
                <div class="w-14 h-14 mx-auto mb-3 rounded-2xl bg-gradient-to-tr from-blue-500 to-indigo-500 flex items-center justify-center shadow-lg shadow-blue-500/30">
                    <i data-lucide="hotel" class="w-8 h-8 text-white"></i>
                </div>
                <h3 class="text-base font-bold tracking-wide">MERPERLE / KHẢI VY EMS</h3>
                <p class="text-xs text-blue-300 font-medium mt-0.5">Hệ Thống Quản Lý Tiệc Cưới & Hội Nghị</p>
                <div class="mt-2 inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-blue-500/20 text-blue-200 border border-blue-400/30">
                    Xác Thực SQL Server stUser (frmLogin)
                </div>
                <button type="button" id="btnCloseLoginModal" onclick="if(currentUser) document.getElementById('loginModal').classList.add('hidden')" class="absolute top-3 right-3 p-1.5 text-white/70 hover:text-white rounded-lg hover:bg-white/10 transition">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
            </div>

            <form onsubmit="handleLoginSubmit(event)" class="p-6 space-y-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Tên Đăng Nhập / Mã Nhân Viên *</label>
                    <input type="text" id="txtLoginUser" autocomplete="off" required placeholder="Nhập tên tài khoản..." class="w-full p-2.5 border border-slate-200 rounded-xl text-xs font-bold text-slate-800 uppercase focus:outline-none focus:ring-2 focus:ring-blue-500" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Mật Khẩu (Password)</label>
                    <div class="relative">
                        <input type="password" id="txtLoginPass" placeholder="Nhập mật khẩu..." class="w-full p-2.5 pr-10 border border-slate-200 rounded-xl text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                        <button type="button" onclick="togglePasswordVisibility()" class="absolute right-3 top-2.5 text-slate-400 hover:text-slate-600">
                            <i data-lucide="eye" id="iconEye" class="w-4 h-4"></i>
                        </button>
                    </div>
                </div>

                <div id="loginError" class="hidden p-3 bg-rose-50 border border-rose-200 text-rose-700 rounded-xl text-xs"></div>

                <button type="submit" class="w-full py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-bold shadow-lg shadow-blue-500/25 transition flex items-center justify-center gap-2">
                    <i data-lucide="log-in" class="w-4 h-4"></i>
                    <span>ĐĂNG NHẬP HỆ THỐNG</span>
                </button>
            </form>
        </div>
    </div>

    <!-- PRINTABLE BEO AREA -->
    <div id="beoPrintArea" class="print-only"></div>

    <!-- MODAL LỊCH SỬ SỬA ĐỔI BEO (AMENDMENT HISTORY) -->
    <div id="modalBeoAmendHistory" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-2xl border border-slate-200 w-full max-w-lg overflow-hidden flex flex-col max-h-[85vh]">
            <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50">
                <div class="flex items-center gap-2">
                    <span class="text-lg">📜</span>
                    <div>
                        <h3 class="text-sm font-bold text-slate-800">Lịch Sử Sửa Đổi BEO (Amendment History)</h3>
                        <p class="text-xs text-slate-500">Nhật ký các lần điều chỉnh tiệc theo chuẩn quản lý EMS</p>
                    </div>
                </div>
                <button type="button" onclick="closeBeoAmendHistoryModal()" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>
            <div class="p-5 overflow-y-auto flex-1">
                <div id="beoAmendHistoryList" class="space-y-3">
                    <!-- Dynamic history rows -->
                </div>
            </div>
            <div class="px-5 py-3 border-t border-slate-100 bg-slate-50 flex items-center justify-between">
                <span class="text-xs text-slate-500">Dữ liệu được lưu trữ an toàn, độc lập với Cana.</span>
                <button type="button" onclick="closeBeoAmendHistoryModal()" class="px-3.5 py-1.5 bg-slate-800 text-white rounded-lg text-xs font-bold hover:bg-slate-700">Đóng</button>
            </div>
        </div>
    </div>

    <!-- JAVASCRIPT APPLICATION LOGIC -->
    
    <!-- ==================== MODAL: TÌM KIẾM & NẠP LỆNH BEO ==================== -->
    <div id="modalSearchLoadBeo" class="hidden fixed inset-0 z-50 bg-slate-900/70 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-5xl max-h-[90vh] flex flex-col overflow-hidden animate-in fade-in zoom-in-95 duration-200">
            <!-- Header Modal -->
            <div class="px-6 py-4 bg-gradient-to-r from-blue-900 via-indigo-900 to-slate-900 text-white flex items-center justify-between border-b border-indigo-700/50 shrink-0">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-lg bg-amber-400 text-slate-950 flex items-center justify-center font-bold">
                        <i data-lucide="search" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-black text-amber-300 uppercase tracking-wide">CỬA SỔ TÌM KIẾM & NẠP LỆNH BEO</h3>
                        <p class="text-[11px] text-blue-200 mt-0.5">Tìm theo Ngày, Tên Booking, Khách Hàng, Sảnh Tiệc rồi bấm nút Chọn Nạp BEO</p>
                    </div>
                </div>
                <button type="button" onclick="closeModal('modalSearchLoadBeo')" class="p-1.5 text-slate-400 hover:text-white hover:bg-white/10 rounded-lg transition text-xl leading-none cursor-pointer">
                    &times;
                </button>
            </div>

            <!-- Filter Controls Bar -->
            <div class="p-4 bg-slate-50 border-b border-slate-200 shrink-0 space-y-3">
                <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-end">
                    <!-- Ô tìm kiếm từ khóa -->
                    <div class="md:col-span-5">
                        <label class="block text-[11px] font-bold text-slate-700 uppercase mb-1">Tên Booking / Khách Hàng / SĐT / Mã ID:</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                                <i data-lucide="search" class="w-4 h-4"></i>
                            </span>
                            <input type="text" id="modalBeoSearchText" placeholder="Tìm theo Tên Booking, Khách hàng, Tên Sale (NLMT, Lam, Hải...), SĐT, Mã ID..." 
                                   class="w-full pl-9 pr-3 py-2 bg-white border border-slate-300 rounded-lg text-xs font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500"
                                   oninput="filterBeoModalTable()" onkeydown="if(event.key === 'Enter') filterBeoModalTable()" />
                        </div>
                    </div>

                    <!-- Lọc Ngày Tiệc -->
                    <div class="md:col-span-3">
                        <label class="block text-[11px] font-bold text-slate-700 uppercase mb-1">Ngày Tiệc (Event Date):</label>
                        <input type="date" id="modalBeoSearchDate" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-lg text-xs font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500"
                               onchange="filterBeoModalTable()" />
                    </div>

                    <!-- Lọc Sảnh Tiệc -->
                    <div class="md:col-span-2">
                        <label class="block text-[11px] font-bold text-slate-700 uppercase mb-1">Sảnh Tiệc:</label>
                        <select id="modalBeoSearchRoom" class="w-full px-2.5 py-2 bg-white border border-slate-300 rounded-lg text-xs font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500 cursor-pointer"
                                onchange="filterBeoModalTable()">
                            <option value="ALL">Tất cả sảnh</option>
                        </select>
                    </div>

                    <!-- Nút thao tác -->
                    <div class="md:col-span-2 flex items-center gap-1.5">
                        <button type="button" onclick="filterBeoModalTable()" class="flex-1 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-bold transition flex items-center justify-center gap-1 shadow-sm cursor-pointer">
                            <i data-lucide="filter" class="w-3.5 h-3.5"></i>
                            <span>Lọc</span>
                        </button>
                        <button type="button" onclick="resetBeoModalFilters()" class="p-2 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-lg text-xs font-bold transition cursor-pointer" title="Xem tất cả đơn tiệc">
                            <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i>
                        </button>
                    </div>
                </div>

                <!-- Cụm nút chọn nhanh trạng thái & Thông tin đếm -->
                <div class="flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-slate-200">
                    <div class="flex items-center gap-2">
                        <span class="text-[11px] font-bold text-slate-700 uppercase">Trạng Thái:</span>
                        <div class="inline-flex rounded-lg border border-slate-300 p-0.5 bg-slate-200/70 text-xs">
                            <button type="button" id="btnBeoFilterStatusAll" onclick="setBeoModalStatusFilter('ALL')" 
                                    class="px-3 py-1 rounded-md font-bold text-xs transition bg-white text-blue-700 shadow-sm cursor-pointer flex items-center gap-1.5">
                                <span>Tất cả</span>
                                <span id="cntBeoStatusAll" class="px-1.5 py-0.2 bg-slate-200 text-slate-700 rounded-full text-[10px]">0</span>
                            </button>
                            <button type="button" id="btnBeoFilterStatusD" onclick="setBeoModalStatusFilter('D')" 
                                    class="px-3 py-1 rounded-md font-bold text-xs transition text-slate-600 hover:text-slate-900 cursor-pointer flex items-center gap-1.5">
                                <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span>
                                <span>Đã Chốt (Definite)</span>
                                <span id="cntBeoStatusD" class="px-1.5 py-0.2 bg-emerald-100 text-emerald-800 rounded-full text-[10px]">0</span>
                            </button>
                            <button type="button" id="btnBeoFilterStatusT" onclick="setBeoModalStatusFilter('T')" 
                                    class="px-3 py-1 rounded-md font-bold text-xs transition text-slate-600 hover:text-slate-900 cursor-pointer flex items-center gap-1.5">
                                <span class="w-2 h-2 rounded-full bg-amber-500 inline-block"></span>
                                <span>Chưa Chốt (Giữ Chỗ)</span>
                                <span id="cntBeoStatusT" class="px-1.5 py-0.2 bg-amber-100 text-amber-800 rounded-full text-[10px]">0</span>
                            </button>
                        </div>
                    </div>
                    <div class="flex items-center gap-4 text-[11px] text-slate-500 font-medium">
                        <span id="modalBeoResultCount">Đang nạp danh sách tiệc...</span>
                        <span class="hidden md:inline-block text-blue-600 font-semibold italic">💡 Nhấp đúp chuột (Double click) vào dòng để nạp BEO ngay tức thì</span>
                    </div>
                </div>
            </div>

            <!-- Table Container (Scrollable) -->
            <div class="flex-1 overflow-y-auto p-4 custom-scrollbar">
                <table class="w-full text-left border-collapse text-xs">
                    <thead class="sticky top-0 bg-slate-100 z-10 border-b border-slate-200 text-[10px] font-bold text-slate-600 uppercase tracking-wider">
                        <tr>
                            <th class="p-2.5">Ngày Tiệc</th>
                            <th class="p-2.5">Sảnh</th>
                            <th class="p-2.5">Tên Booking / Khách Hàng</th>
                            <th class="p-2.5 text-center">Khách (Pax)</th>
                            <th class="p-2.5 text-center">Trạng Thái</th>
                            <th class="p-2.5 text-center">Số Lệnh EO</th>
                            <th class="p-2.5 text-center">Mã Booking</th>
                            <th class="p-2.5 text-center">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody id="tblModalBeoListBody" class="divide-y divide-slate-100">
                        <tr>
                            <td colspan="8" class="p-8 text-center text-slate-400">Đang tải danh sách đơn tiệc...</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Footer Modal -->
            <div class="px-6 py-3 bg-slate-100 border-t border-slate-200 flex items-center justify-between shrink-0">
                <span class="text-[11px] text-slate-500">Danh sách hiển thị các đơn tiệc Đã Chốt & Giữ Chỗ trên hệ thống</span>
                <button type="button" onclick="closeModal('modalSearchLoadBeo')" class="px-4 py-1.5 border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 rounded-lg text-xs font-bold transition cursor-pointer">
                    Đóng cửa sổ
                </button>
            </div>
        </div>
    </div>


    <script>
        // State
        let currentUser = null;
        let masterUsers = [];
        let masterRooms = [];
        let masterMenus = [];
        let masterCharges = [];
        let schedulerViewType = 'multiday'; // 'multiday' (matrix) or 'singleday' (3 shifts)
        let currentLoadedBookings = [];
        let currentLoadedDays = [];
        let currentActiveBookingId = null;
        let debounceTimer = null;
        let debounceCustTimer = null;

        document.addEventListener('DOMContentLoaded', async () => {
            lucide.createIcons();
            
            // Check auth: require explicit login
            const savedUser = sessionStorage.getItem('ems_user') || localStorage.getItem('ems_user');
            if (savedUser) {
                try {
                    currentUser = JSON.parse(savedUser);
                } catch (e) {
                    currentUser = null;
                }
            }
            
            await loadMasterUsers();
            await initMasters();
            loadBeoBookingsList();

            // Set default dates
            document.getElementById('txtSchedFrom').value = '2026-11-10';
            document.getElementById('txtSchedTo').value = '2026-11-16';
            document.getElementById('txtBkDateFrom').value = '2026-01-01';
            document.getElementById('txtBkDateTo').value = '2026-12-31';

            // If user has old default ADMIN without explicit login, force login prompt
            if (!currentUser || (currentUser.username === 'ADMIN' && !sessionStorage.getItem('ems_logged_in'))) {
                currentUser = null;
                localStorage.removeItem('ems_user');
                sessionStorage.removeItem('ems_user');
                sessionStorage.removeItem('ems_logged_in');
                updateHeaderUser();
                openLoginModal(true); // Force login
            } else {
                updateHeaderUser();
                await loadSchedulerData();
                initScrollListeners();
                loadCancelReasons();
                loadBookingsList();
            }
        });

        // -------------------------------------------------------------
        // AUTHENTICATION & LOGIN (frmLogin)
        // -------------------------------------------------------------
        async function loadMasterUsers() {
            try {
                const res = await fetch('/api/auth/users');
                const rawUsers = await res.json();
                
                // Lọc bỏ tài khoản đã nghỉ hoặc không hoạt động/không tạo booking (LNC, NQP, NVT, NTTHA, TVT, VNT)
                const excludedCodes = ['LNC', 'NQP', 'NVT', 'NTTHA', 'TVT', 'VNT'];
                masterUsers = Array.isArray(rawUsers) ? rawUsers.filter(u => !excludedCodes.includes(u.username ? u.username.toUpperCase().trim() : '')) : [];
                
                // Populate sales filter
                const selBkSales = document.getElementById('selBkFilterSales');
                if (selBkSales) {
                    selBkSales.innerHTML = '<option value="ALL">Tất cả nhân viên</option>';
                    masterUsers.forEach(u => {
                        const opt2 = document.createElement('option');
                        opt2.value = u.username;
                        opt2.textContent = `${u.full_name} (${u.username})`;
                        selBkSales.appendChild(opt2);
                    });
                }

                // Populate quick user select in Login Modal
                populateLoginUserSelect();
            } catch (err) {
                console.error("Error loading auth users:", err);
            }
        }

        function populateLoginUserSelect() {
            const cbo = document.getElementById('cboQuickUser');
            const dlist = document.getElementById('userDatalist');
            if (cbo && masterUsers && masterUsers.length > 0) {
                cbo.innerHTML = '<option value="">-- Bấm chọn nhanh tài khoản nhân viên --</option>';
                if (dlist) dlist.innerHTML = '';
                masterUsers.forEach(u => {
                    const opt = document.createElement('option');
                    opt.value = u.username;
                    opt.textContent = `${u.username} - ${u.full_name} (${u.group_name || u.dept || 'Nhân Viên'})`;
                    cbo.appendChild(opt);

                    if (dlist) {
                        const dlOpt = document.createElement('option');
                        dlOpt.value = u.username;
                        dlOpt.label = `${u.full_name} (${u.username})`;
                        dlist.appendChild(dlOpt);
                    }
                });
            }
        }

        function openLoginModal(isForced = false) {
            const modal = document.getElementById('loginModal');
            modal.classList.remove('hidden');
            document.getElementById('loginError').classList.add('hidden');
            const btnClose = document.getElementById('btnCloseLoginModal');
            if (btnClose) {
                btnClose.style.display = (isForced || !currentUser) ? 'none' : 'block';
            }
            populateLoginUserSelect();
            setTimeout(() => {
                const u = document.getElementById('txtLoginUser');
                if (u) {
                    u.focus();
                    if (!currentUser) u.value = '';
                }
            }, 100);
        }

        function togglePasswordVisibility() {
            const inp = document.getElementById('txtLoginPass');
            inp.type = inp.type === 'password' ? 'text' : 'password';
        }

        async function handleLoginSubmit(e) {
            e.preventDefault();
            const username = document.getElementById('txtLoginUser').value.trim();
            const password = document.getElementById('txtLoginPass').value;
            const errBox = document.getElementById('loginError');

            if (!username) {
                errBox.textContent = 'Vui lòng nhập mã tài khoản hoặc chọn từ danh sách!';
                errBox.classList.remove('hidden');
                return;
            }

            try {
                const res = await fetch('/api/auth/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username, password })
                });

                const data = await res.json();
                if (!res.ok) {
                    errBox.textContent = data.detail || 'Tài khoản hoặc mật khẩu không đúng!';
                    errBox.classList.remove('hidden');
                    return;
                }

                currentUser = data.user;
                localStorage.setItem('ems_user', JSON.stringify(currentUser));
                sessionStorage.setItem('ems_user', JSON.stringify(currentUser));
                sessionStorage.setItem('ems_logged_in', 'true');
                updateHeaderUser();
                document.getElementById('loginModal').classList.add('hidden');
                
                // Load data
                loadSchedulerData();
                initScrollListeners();
                loadCancelReasons();
                loadBookingsList();
            } catch (err) {
                errBox.textContent = 'Lỗi kết nối máy chủ xác thực!';
                errBox.classList.remove('hidden');
            }
        }

        function handleLogout() {
            localStorage.removeItem('ems_user');
            sessionStorage.removeItem('ems_user');
            sessionStorage.removeItem('ems_logged_in');
            currentUser = null;
            updateHeaderUser();
            openLoginModal(true);
        }

        function updateHeaderUser() {
            if (!currentUser) {
                document.getElementById('userName').textContent = 'Chưa Đăng Nhập';
                document.getElementById('userCodeBadge').textContent = 'GUEST';
                document.getElementById('userDeptRole').textContent = 'Vui lòng đăng nhập';
                const av = document.getElementById('userAvatar');
                if (av) av.textContent = '--';
                return;
            }
            document.getElementById('userName').textContent = currentUser.full_name;
            document.getElementById('userCodeBadge').textContent = currentUser.username;
            const deptText = currentUser.dept || currentUser.role || 'Sales';
            const groupText = currentUser.group_name || 'DORS';
            document.getElementById('userDeptRole').textContent = `${groupText} / ${deptText}`;
            
            const names = (currentUser.full_name || currentUser.username).trim().split(' ');
            const initials = names.length > 1 ? names[0][0] + names[names.length - 1][0] : currentUser.username.slice(0, 2);
            const av = document.getElementById('userAvatar');
            if (av) av.textContent = initials.toUpperCase();

            const disp = document.getElementById('nbCurrentUserDisplay');
            if (disp) disp.textContent = `${currentUser.full_name} (${currentUser.username})`;

            const beoDisp = document.getElementById('beoUserDisplay');
            if (beoDisp) beoDisp.value = `${currentUser.full_name} (${currentUser.username})`;
        }

        // -------------------------------------------------------------
        // NAVIGATION
        // -------------------------------------------------------------
        function navTo(viewName) {
            const webBottomCtrl = document.getElementById('stickyWebBookingsScrollController');
            if (webBottomCtrl) {
                if (viewName === 'bookings') {
                    webBottomCtrl.classList.remove('hidden');
                    setTimeout(initStickyTableScrollWeb, 100);
                } else {
                    webBottomCtrl.classList.add('hidden');
                }
            }
            document.querySelectorAll('.sidebar-item').forEach(el => el.classList.remove('active'));
            const activeNav = document.getElementById(`nav-${viewName}`);
            if (activeNav) activeNav.classList.add('active');

            const viewContainer = document.querySelector('.overflow-y-auto');
            if (viewContainer) viewContainer.scrollTop = 0;
            window.scrollTo(0, 0);

            ['viewScheduler', 'viewBookings', 'viewBEO', 'viewRooms', 'viewCustomers', 'viewMenus', 'viewCharges', 'viewSegments', 'viewAudit', 'viewItems', 'viewCutoff'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.classList.add('hidden');
            });

            const titles = {
                'scheduler': 'Lịch Sảnh Tiệc & Điều Phối Sự Kiện',
                'bookings': 'Quản Lý Danh Sách Đơn Đặt Tiệc (Bookings)',
                'beo': 'Lập & In Lệnh BEO (Banquet Event Order)',
                'rooms': 'Danh Mục Sảnh Tiệc & Phòng Hội Nghị',
                'customers': 'Danh Bạ Khách Hàng CRM (774 Khách Hàng)',
                'menus': 'Danh Mục Thực Đơn & Set Menu',
                'charges': 'Danh Mục Dịch Vụ Phụ Thu & Bảng Giá',
                'segments': 'Phân Khúc Khách Hàng & Nguồn Tiếp Thị',
                'items': '3. Items - Quản Lý Danh Mục Hệ Thống (A - T)',
                'cutoff': 'Quản Lý Hạn Khóa Sảnh & Cảnh Báo Cutoff (Tentative Lock)',
                'audit': '4. Nhật Ký Thao Tác Hệ Thống (Audit Trail)'
            };
            document.getElementById('pageTitle').textContent = titles[viewName] || 'EMS Banquet';

            if (viewName === 'scheduler') {
                document.getElementById('viewScheduler').classList.remove('hidden');
                loadSchedulerData();
            initScrollListeners();
            loadCancelReasons();
            } else if (viewName === 'bookings') {
                document.getElementById('viewBookings').classList.remove('hidden');
                loadBookingsList();
            } else if (viewName === 'items') {
                document.getElementById('viewItems').classList.remove('hidden');
                initItemsModule();
            } else if (viewName === 'beo') {
                document.getElementById('viewBEO').classList.remove('hidden');
                loadBeoBookingsList();
                if (currentUser) {
                    const ud = document.getElementById('beoUserDisplay');
                    if (ud) ud.value = `${currentUser.full_name} (${currentUser.username})`;
                }
            } else if (viewName === 'rooms') {
                document.getElementById('viewRooms').classList.remove('hidden');
                renderMasterRooms();
            } else if (viewName === 'customers') {
                document.getElementById('viewCustomers').classList.remove('hidden');
                searchCust();
            } else if (viewName === 'menus') {
                document.getElementById('viewMenus').classList.remove('hidden');
                renderMasterMenus();
            } else if (viewName === 'charges') {
                document.getElementById('viewCharges').classList.remove('hidden');
                renderMasterCharges();
            } else if (viewName === 'segments') {
                document.getElementById('viewSegments').classList.remove('hidden');
                renderMasterSegments();
            } else if (viewName === 'cutoff') {
                document.getElementById('viewCutoff').classList.remove('hidden');
                loadCutoffManagement();
            } else if (viewName === 'audit') {
                document.getElementById('viewAudit').classList.remove('hidden');
                loadAuditLogs();
            }
            lucide.createIcons();
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
        }

        // -------------------------------------------------------------
        // SCHEDULER: MULTI-DAY TIMELINE MATRIX (GỘP CHUNG TẤT CẢ NGÀY VÀO 1 BẢNG DUY NHẤT)
        // -------------------------------------------------------------
        function setSchedulerViewType(type) {
            schedulerViewType = type;
            if (type === 'multiday') {
                document.getElementById('btnViewMultiDay').className = 'px-3 py-1.5 rounded-md bg-white text-blue-600 font-bold shadow-sm transition flex items-center gap-1.5';
                document.getElementById('btnViewSingleDay').className = 'px-3 py-1.5 rounded-md text-slate-600 hover:text-slate-900 transition flex items-center gap-1.5';
                document.getElementById('tblMultiDay').classList.remove('hidden');
                document.getElementById('tblSingleDay').classList.add('hidden');
            } else {
                document.getElementById('btnViewSingleDay').className = 'px-3 py-1.5 rounded-md bg-white text-blue-600 font-bold shadow-sm transition flex items-center gap-1.5';
                document.getElementById('btnViewMultiDay').className = 'px-3 py-1.5 rounded-md text-slate-600 hover:text-slate-900 transition flex items-center gap-1.5';
                document.getElementById('tblSingleDay').classList.remove('hidden');
                document.getElementById('tblMultiDay').classList.add('hidden');
            }
            renderScheduler();
        }

        function setSchedPreset(type) {
            if (type === 'today') {
                document.getElementById('txtSchedFrom').value = '2026-11-10';
                document.getElementById('txtSchedTo').value = '2026-11-10';
            } else if (type === '7days') {
                document.getElementById('txtSchedFrom').value = '2026-11-10';
                document.getElementById('txtSchedTo').value = '2026-11-16';
            } else if (type === 'm11_2026') {
                document.getElementById('txtSchedFrom').value = '2026-11-01';
                document.getElementById('txtSchedTo').value = '2026-11-15';
            } else if (type === 'm12_2026') {
                document.getElementById('txtSchedFrom').value = '2026-12-01';
                document.getElementById('txtSchedTo').value = '2026-12-15';
            }
            loadSchedulerData();
            initScrollListeners();
            loadCancelReasons();
        }

        async function loadSchedulerData() {
            const fromDate = document.getElementById('txtSchedFrom').value;
            const toDate = document.getElementById('txtSchedTo').value;
            if (!fromDate || !toDate) return;

            try {
                const res = await fetch(`/api/scheduler?from_date=${fromDate}&to_date=${toDate}`);
                const data = await res.json();
                currentLoadedBookings = data.bookings;
                if ((!masterRooms || masterRooms.length === 0) && data.rooms) {
                    masterRooms = data.rooms;
                }

                // Build list of dates in range
                currentLoadedDays = [];
                const start = new Date(fromDate);
                const end = new Date(toDate);
                let d = new Date(start);
                while (d <= end) {
                    currentLoadedDays.push(d.toISOString().split('T')[0]);
                    d.setDate(d.getDate() + 1);
                }

                // Update Banner
                const fParts = fromDate.split('-');
                const tParts = toDate.split('-');
                document.getElementById('lblSchedHeaderTitle').textContent = `Ma Trận Lịch Sảnh Tiệc (${fParts[2]}/${fParts[1]} - ${tParts[2]}/${tParts[1]}/${tParts[0]})`;
                document.getElementById('lblSchedHeaderCount').textContent = `${data.bookings.length} đơn tiệc`;

                renderScheduler();
            } catch (err) {
                console.error("Error loading scheduler data:", err);
            }
        }

        function renderScheduler() {
            if (schedulerViewType === 'multiday') {
                renderMultiDayMatrix();
            } else {
                renderSingleDay3Shifts();
            }
            lucide.createIcons();
        }

        // RENDER 1: GỘP CHUNG TẤT CẢ CÁC NGÀY VÀO 1 BẢNG DUY NHẤT (DÀN HÀNG NGANG)
        function renderMultiDayMatrix() {
            const thead = document.getElementById('tblMultiDayHead');
            const tbody = document.getElementById('tblMultiDayBody');

            // 1. Build Header Row: Ô góc (Top + Left Sticky) + Các cột Ngày (Top Sticky)
            let headerHtml = `
                <tr class="text-[11px] font-bold uppercase tracking-wider">
                    <th class="p-3.5 w-60 min-w-[200px] border-r border-b-2 border-slate-300 sticky top-0 left-0 bg-slate-100 text-slate-700 z-30 shadow-sm">
                        <div class="flex items-center justify-between">
                            <span>Sảnh Tiệc & Vị Trí</span>
                            <i data-lucide="building-2" class="w-4 h-4 text-slate-400"></i>
                        </div>
                    </th>
            `;

            currentLoadedDays.forEach(dateStr => {
                const d = new Date(dateStr);
                const dayNames = ['CN', 'Thứ 2', 'Thứ 3', 'Thứ 4', 'Thứ 5', 'Thứ 6', 'Thứ 7'];
                const dayName = dayNames[d.getDay()];
                const parts = dateStr.split('-');
                const displayDate = `${parts[2]}/${parts[1]}`;
                const isToday = dateStr === '2026-11-10';

                // Count events for this day
                const dayCount = currentLoadedBookings.filter(b => b.event_date === dateStr).length;

                headerHtml += `
                    <th class="p-3 min-w-[220px] border-r border-b-2 border-slate-300 text-center sticky top-0 z-20 font-bold ${isToday ? 'bg-blue-100/90 text-blue-900 border-b-blue-600' : 'bg-slate-100 text-slate-700'}">
                        <div class="flex items-center justify-center gap-1.5">
                            <span class="text-xs font-bold">${dayName} (${displayDate})</span>
                            <span class="px-1.5 py-0.2 rounded-full text-[10px] ${dayCount > 0 ? 'bg-blue-600 text-white font-extrabold shadow-xs' : 'bg-slate-200 text-slate-600'}">${dayCount}</span>
                        </div>
                    </th>
                `;
            });
            headerHtml += '</tr>';
            thead.innerHTML = headerHtml;

            // 2. Build 12 Room Rows x N Day Cells (với vạch phân cách sảnh rõ ràng & Dải màu Accent nhận diện)
            tbody.innerHTML = '';
            
            const ROOM_ACCENTS = {
                '01': 'bg-amber-500',   // Romance
                '02': 'bg-blue-600',    // Classic
                '03': 'bg-purple-600',  // Gothic
                '04': 'bg-rose-500',    // Diamond
                '05': 'bg-emerald-600', // Rustic
                '06': 'bg-cyan-500',    // Sapphire 1
                '07': 'bg-teal-500',    // Sapphire 2
                '08': 'bg-indigo-500',  // Sapphire 3
                '09': 'bg-sky-500',     // Bida Area
                '10': 'bg-orange-500',  // Sảnh khác
            };

            const filteredRooms = masterRooms.filter(room => {
                if (currentFloorFilter === 'ALL') return true;
                if (currentFloorFilter === 'G') return (room.floor || '').includes('G') || ['Romance', 'Classic', 'Gothic'].includes(room.name);
                if (currentFloorFilter === 'M') return (room.floor || '').includes('M') || room.name.includes('Sapphire') || room.name === 'Diamond' || room.name === 'Rustic';
                if (currentFloorFilter === '10') return (room.floor || '').includes('10') || room.name.includes('Bida') || room.name === 'Room';
                return true;
            });

            filteredRooms.forEach(room => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-50/70 transition border-b-2 border-slate-300';

                const accentColor = ROOM_ACCENTS[room.code] || 'bg-slate-400';

                // Room info cell (Fixed Sticky Left + Dải màu nhận diện)
                let rowHtml = `
                    <td class="p-3.5 border-r border-b-2 border-slate-300 bg-white sticky left-0 z-10 shadow-sm relative">
                        <div class="absolute left-0 top-0 bottom-0 w-1.5 ${accentColor}"></div>
                        <div class="pl-1.5">
                            <div class="font-bold text-slate-900 text-xs flex items-center gap-1.5">
                                <span>${room.name}</span>
                            </div>
                            <div class="text-[11px] text-slate-500 font-medium mt-0.5">${room.floor} &bull; ${room.area} m²</div>
                        </div>
                    </td>
                `;

                // Day Cells
                currentLoadedDays.forEach(dateStr => {
                    const roomDayBks = currentLoadedBookings.filter(b => b.room === room.code && b.event_date === dateStr);
                    const isToday = dateStr === '2026-11-10';

                    rowHtml += `
                        <td class="p-2 border-r border-b-2 border-slate-300 timeline-cell align-top transition ${isToday ? 'bg-blue-50/25' : 'bg-white'}"
                        ondragover="handleDragOverCell(event)"
                        ondragenter="handleDragEnterCell(event, this)"
                        ondragleave="handleDragLeaveCell(event, this)"
                        ondrop="handleDropBooking(event, '${room.code}', '${dateStr}')"
                        onclick="handleCellClick(event, '${room.code}', '${dateStr}')">
                            ${renderDayCellBookings(room.code, dateStr, roomDayBks)}
                        </td>
                    `;
                });

                tr.innerHTML = rowHtml;
                tbody.appendChild(tr);
            });
        }

        // -------------------------------------------------------------
        // FLOOR FILTERING STATE
        // -------------------------------------------------------------
        let currentFloorFilter = 'ALL';

        function setFloorFilter(floor) {
            currentFloorFilter = floor;
            ['ALL', 'G', 'M', '10'].forEach(f => {
                const b = document.getElementById('btnFloor' + f);
                if (b) {
                    if (f === floor) {
                        b.className = 'px-2.5 py-0.5 rounded bg-blue-600 text-white shadow-xs font-bold';
                    } else {
                        b.className = 'px-2.5 py-0.5 rounded hover:bg-slate-100 text-slate-600 font-medium';
                    }
                }
            });
            renderScheduler();
        }

        // -------------------------------------------------------------
        // DRAG & DROP LOGIC WITH AUTOMATIC CONFLICT CHECKING & REVERT
        // -------------------------------------------------------------
        let draggedBooking = null;

        function handleDragStart(e, bookId, room, eventDate, timeIn, timeOut, title, pax) {
            draggedBooking = { bookId, room, eventDate, timeIn, timeOut, title, pax };
            e.dataTransfer.setData('text/plain', bookId);
            e.dataTransfer.effectAllowed = 'move';
            e.target.classList.add('opacity-40', 'scale-95');
        }

        function handleDragEnd(e) {
            e.target.classList.remove('opacity-40', 'scale-95');
        }

        function handleDragOverCell(e) {
            e.preventDefault();
            e.dataTransfer.dropEffect = 'move';
        }

        function handleDragEnterCell(e, el) {
            el.classList.add('bg-blue-100/70', 'ring-2', 'ring-blue-400');
        }

        function handleDragLeaveCell(e, el) {
            el.classList.remove('bg-blue-100/70', 'ring-2', 'ring-blue-400');
        }

        async function handleDropBooking(e, targetRoom, targetDate) {
            e.preventDefault();
            e.currentTarget.classList.remove('bg-blue-100/70', 'ring-2', 'ring-blue-400');
            if (!draggedBooking) return;

            const b = draggedBooking;
            draggedBooking = null;

            if (b.room === targetRoom && b.eventDate === targetDate) {
                return;
            }

            // 1. Check Conflict on the target room and target date
            try {
                const p = new URLSearchParams();
                p.append('room', targetRoom);
                p.append('date', targetDate);
                p.append('time_in', b.timeIn);
                p.append('time_out', b.timeOut);
                p.append('exclude_book_id', b.bookId);

                const res = await fetch('/api/bookings/check-conflict?' + p.toString());
                const data = await res.json();

                if (data.has_conflict) {
                    let conflictMsg = `XUNG ĐỘT SẢNH! Không thể dời đơn tiệc sang Sảnh ${targetRoom} ngày ${targetDate}!\n\n`;
                    conflictMsg += `Khung giờ ${b.timeIn} - ${b.timeOut} đã có tiệc đang giữ sảnh:\n`;
                    data.conflicts.forEach(c => {
                        conflictMsg += `• [${c.book_id}] ${c.title} (${c.time_in} - ${c.time_out}) - Người giữ sảnh: ${c.sales_user}\n`;
                    });

                    const freeRooms = masterRooms.filter(r => {
                        if (r.code === targetRoom) return false;
                        const hasOver = currentLoadedBookings.some(x => x.room === r.code && x.event_date === targetDate && x.status_code !== 'C' && x.time_in < b.timeOut && x.time_out > b.timeIn);
                        return !hasOver;
                    }).map(r => r.name);

                    if (freeRooms.length > 0) {
                        conflictMsg += `\nGỢI Ý: Trong ngày ${targetDate} (${b.timeIn} - ${b.timeOut}), các sảnh sau đang CÒN TRỐNG hoàn toàn:\n👉 ` + freeRooms.slice(0, 4).join(', ');
                    }

                    alert(conflictMsg);
                    return;
                }

                const msg = `XÁC NHẬN DỜI TIỆC:\n\nĐơn tiệc: "${b.title}" (Mã: ${b.bookId})\nTừ: Sảnh ${b.room} ngày ${b.eventDate}\nSang: Sảnh ${targetRoom} ngày ${targetDate}\nKhung giờ: ${b.timeIn} - ${b.timeOut}\n\nBạn có chắc chắn muốn dời đơn tiệc này?`;
                if (!confirm(msg)) {
                    return;
                }

                const detailRes = await fetch(`/api/bookings/${b.bookId}`);
                const detailData = await detailRes.json();

                const updatePayload = {
                    title: detailData.title,
                    event_date: targetDate,
                    time_in: b.timeIn,
                    time_out: b.timeOut,
                    room: targetRoom,
                    pax: detailData.pax,
                    deposit: detailData.deposit,
                    status: detailData.status,
                    guest_name: detailData.customer ? detailData.customer.name : '',
                    guest_phone: detailData.customer ? detailData.customer.phone : '',
                    guest_email: detailData.customer ? detailData.customer.email : '',
                    guest_address: detailData.customer ? detailData.customer.address : '',
                    notes: detailData.notes + ` [Đã dời từ sảnh ${b.room} ngày ${b.eventDate}]`
                };

                const updateRes = await fetch(`/api/bookings/${b.bookId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(updatePayload)
                });
                const updateResData = await updateRes.json();

                if (!updateRes.ok) {
                    alert(updateResData.detail || 'Lỗi dời đơn tiệc!');
                    return;
                }

                alert(`DỜI TIỆC THÀNH CÔNG!\nĐơn tiệc ${b.bookId} đã được chuyển sang Sảnh ${targetRoom} ngày ${targetDate}.`);
                loadSchedulerData();
            initScrollListeners();
            loadCancelReasons();
                loadBookingsList();
            } catch (err) {
                console.error("Error during drag & drop move:", err);
                alert("Lỗi kết nối khi dời đơn tiệc!");
            }
        }

        function handleCellClick(e, roomCode, dateStr) {
            if (e.target.closest('.booking-badge') || e.target.closest('button') || e.target.closest('input')) return;
            quickBookRoomDate(roomCode, dateStr);
        }

        // -------------------------------------------------------------
        // INTELLIGENT SHIFT CELL RENDERING (TỰ HIỆN NÚT CHO CA CÒN TRỐNG & CHỐNG TRÙNG LẶP TIỆC CẢ NGÀY)
        // -------------------------------------------------------------
        function renderDayCellBookings(roomCode, dateStr, bks) {
            const validBks = (bks || []).filter(b => b.status_code !== 'C');
            const cancelledBks = (bks || []).filter(b => b.status_code === 'C');

            // 1. Phân loại tiệc Cả Ngày (Full Day: bắt đầu buổi sáng < 12h và kết thúc chiều tối >= 17h, ví dụ 08:00 - 18:00)
            const allDayBks = validBks.filter(b => {
                const tIn = b.time_in || '08:00';
                const tOut = b.time_out || '18:00';
                return (tIn < '12:00' && tOut >= '17:00');
            });

            // 2. Ca Sáng (chỉ lấy các tiệc buổi sáng không phải tiệc cả ngày)
            const morningBks = validBks.filter(b => !allDayBks.includes(b) && ((b.time_in && b.time_in < '14:00') || b.shift === 'morning'));

            // 3. Ca Tối (chỉ lấy các tiệc buổi chiều/tối, không trùng với ca sáng và tiệc cả ngày)
            const eveningBks = validBks.filter(b => !allDayBks.includes(b) && !morningBks.includes(b) && ((b.time_in && b.time_in >= '14:00') || (b.time_out && b.time_out > '16:00') || b.shift === 'evening'));

            // 4. Các tiệc khác
            const otherBks = validBks.filter(b => !allDayBks.includes(b) && !morningBks.includes(b) && !eveningBks.includes(b));

            let html = '';

            // Nếu có tiệc Cả Ngày -> Render tiệc Cả Ngày DUY NHẤT 1 CARD (không nhân đôi ca sáng / ca tối)
            if (allDayBks.length > 0) {
                html += allDayBks.map(b => renderBookingBadgeHtml(b, true)).join('');
            } else {
                // Ca Sáng
                if (morningBks.length > 0) {
                    html += morningBks.map(b => renderBookingBadgeHtml(b, false)).join('');
                } else {
                    html += `
                        <button type="button" onclick="event.stopPropagation(); quickBookRoomDateShift('${roomCode}', '${dateStr}', 'morning')" title="Bấm để đặt Ca Sáng (08:00 - 14:00)" class="w-full py-1 mb-1.5 rounded border border-dashed border-emerald-300 hover:border-emerald-500 bg-emerald-50/40 hover:bg-emerald-100 text-[10px] font-bold text-emerald-700 transition flex items-center justify-center gap-1 shadow-xs">
                            <i data-lucide="sun" class="w-3 h-3 text-emerald-600"></i>
                            <span>+ Trống Ca Sáng (08:00-14:00)</span>
                        </button>
                    `;
                }

                // Ca Tối
                if (eveningBks.length > 0) {
                    html += eveningBks.map(b => renderBookingBadgeHtml(b, false)).join('');
                } else {
                    html += `
                        <button type="button" onclick="event.stopPropagation(); quickBookRoomDateShift('${roomCode}', '${dateStr}', 'evening')" title="Bấm để đặt Ca Tối (17:00 - 22:00)" class="w-full py-1 mt-1 rounded border border-dashed border-blue-300 hover:border-blue-500 bg-blue-50/40 hover:bg-blue-100 text-[10px] font-bold text-blue-700 transition flex items-center justify-center gap-1 shadow-xs">
                            <i data-lucide="moon" class="w-3 h-3 text-blue-600"></i>
                            <span>+ Trống Ca Tối (17:00-22:00)</span>
                        </button>
                    `;
                }
            }

            // Các tiệc khác và tiệc đã hủy
            if (otherBks.length > 0) html += otherBks.map(b => renderBookingBadgeHtml(b, false)).join('');
            if (cancelledBks.length > 0) html += cancelledBks.map(b => renderBookingBadgeHtml(b, false)).join('');

            return html;
        }

        function renderBookingBadgeHtml(b, isAllDay = false) {
            let colorClass = 'bg-slate-100 border-slate-300 text-slate-800';
            let tagText = 'Khác';
            if (b.status_code === 'D') {
                colorClass = 'bg-emerald-50 border-emerald-300 text-emerald-950 shadow-sm';
                tagText = 'Definite';
            } else if (b.status_code === 'T') {
                colorClass = 'bg-amber-50 border-amber-300 text-amber-950 shadow-sm';
                tagText = 'Tentative';
            } else if (b.status_code === 'C') {
                colorClass = 'bg-rose-50 border-rose-300 text-rose-900 opacity-70 line-through';
                tagText = 'Hủy';
            }

            const allDayBadge = isAllDay ? '<span class="bg-indigo-600 text-white font-extrabold text-[8px] px-1.5 py-0.5 rounded ml-1 tracking-wider uppercase">CẢ NGÀY</span>' : '';
            const displayTitle = b.title || b.guest_name || 'Khách Đặt Tiệc';
            const safeTitle = (displayTitle || '').replace(/'/g, "\\'");

            return `
                <div draggable="${b.status_code !== 'C'}" 
                     id="badge-${b.book_id}"
                     data-bookid="${b.book_id}"
                     ondragstart="handleDragStart(event, '${b.book_id}', '${b.room}', '${b.event_date}', '${b.time_in}', '${b.time_out}', '${safeTitle}', '${b.pax}')"
                     ondragend="handleDragEnd(event)"
                     onclick="event.stopPropagation(); openEditBookingModal('${b.book_id}')" 
                     class="booking-badge p-2 mb-1 rounded-lg border ${colorClass} cursor-grab active:cursor-grabbing text-left transition select-none hover:shadow-md">
                    <div class="flex items-center justify-between text-[10px] font-mono mb-1">
                        <div class="flex items-center gap-1">
                            <span class="font-extrabold text-blue-800 bg-white/80 px-1 rounded shadow-xs">${b.time_in}-${b.time_out}</span>
                            ${allDayBadge}
                        </div>
                        <span class="font-bold uppercase text-[9px] px-1 py-0.2 rounded ${b.status_code === 'D' ? 'bg-emerald-600 text-white' : (b.status_code === 'T' ? 'bg-amber-600 text-white' : 'bg-rose-600 text-white')}">${tagText}</span>
                    </div>
                    <div class="font-bold text-xs truncate text-slate-900 flex items-center gap-1" title="${displayTitle}">
                        <i data-lucide="grip-vertical" class="w-3 h-3 text-slate-400 cursor-grab flex-shrink-0"></i>
                        <span class="truncate">${displayTitle}</span>
                    </div>
                    <div class="flex items-center justify-between text-[11px] mt-1 text-slate-600">
                        <span class="font-medium">${b.pax} khách</span>
                        <span class="font-bold text-blue-700">BEO: ${b.sales_user}</span>
                    </div>
                </div>
            `;
        }

        function renderSingleDay3Shifts() {
            const tbody = document.getElementById('tblSingleDayBody');
            tbody.innerHTML = '';

            const targetDate = currentLoadedDays[0] || '2026-11-10';
            const dayBks = currentLoadedBookings.filter(b => b.event_date === targetDate);

            masterRooms.forEach(room => {
                const roomBks = dayBks.filter(b => b.room === room.code);
                const morningBks = roomBks.filter(b => b.shift === 'morning');
                const eveningBks = roomBks.filter(b => b.shift === 'evening');
                const otherBks = roomBks.filter(b => b.shift === 'other');

                const tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-50 transition border-b border-slate-100';

                tr.innerHTML = `
                    <td class="p-3.5 border-r border-slate-100 bg-slate-50/50">
                        <div class="font-bold text-slate-800 text-xs">${room.name}</div>
                        <div class="text-[11px] text-slate-500 font-medium">${room.floor} &bull; ${room.area} m²</div>
                    </td>
                    <td class="p-2 border-r border-slate-100 timeline-cell align-top" onclick="quickBookRoomDateShift('${room.code}', '${targetDate}', 'morning')">
                        ${renderSingleShiftBadges(morningBks)}
                    </td>
                    <td class="p-2 border-r border-slate-100 timeline-cell align-top" onclick="quickBookRoomDateShift('${room.code}', '${targetDate}', 'evening')">
                        ${renderSingleShiftBadges(eveningBks)}
                    </td>
                    <td class="p-2 timeline-cell align-top" onclick="quickBookRoomDateShift('${room.code}', '${targetDate}', 'other')">
                        ${renderSingleShiftBadges(otherBks)}
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function renderSingleShiftBadges(bks) {
            if (!bks || bks.length === 0) {
                return '<div class="text-[11px] text-slate-300 font-medium py-3 text-center hover:text-blue-500 transition cursor-pointer">+ Trống</div>';
            }
            return bks.map(b => {
                let colorClass = b.status_code === 'D' ? 'bg-emerald-50 border-emerald-300 text-emerald-950' : 'bg-amber-50 border-amber-300 text-amber-950';
                return `
                    <div onclick="event.stopPropagation(); openEditBookingModal('${b.book_id}')" class="booking-badge p-2 mb-1 rounded-lg border ${colorClass} cursor-pointer">
                        <div class="flex items-center justify-between text-[10px] font-mono mb-0.5">
                            <span class="font-bold">${b.time_in} - ${b.time_out}</span>
                            <span class="font-bold uppercase">${b.status_code === 'D' ? 'Definite' : 'Tentative'}</span>
                        </div>
                        <div class="font-bold text-xs truncate">${b.title}</div>
                        <div class="flex items-center justify-between text-[11px] mt-1 text-slate-600">
                            <span>${b.pax} khách</span>
                            <span class="font-bold text-blue-700">BEO: ${b.sales_user}</span>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function quickBookRoomDate(roomCode, dateStr) {
            openNewBookingModal();
            document.getElementById('nbRoom').value = roomCode;
            document.getElementById('nbEventDate').value = dateStr;
            checkConflictAuto();
        }

        function quickBookRoomDateShift(roomCode, dateStr, shift) {
            openNewBookingModal();
            document.getElementById('nbRoom').value = roomCode;
            document.getElementById('nbEventDate').value = dateStr;
            if (shift === 'morning') {
                document.getElementById('nbTimeIn').value = '08:00';
                document.getElementById('nbTimeOut').value = '14:00';
            } else if (shift === 'evening') {
                document.getElementById('nbTimeIn').value = '17:00';
                document.getElementById('nbTimeOut').value = '22:00';
            }
            checkConflictAuto();
        }

        // -------------------------------------------------------------
        // EDIT / DETAIL BOOKING MODAL (CHỈNH SỬA, KHÓA CHỐT, HỦY TIỆC)
        // -------------------------------------------------------------
        async function openEditBookingModal(bookId) {
            currentActiveBookingId = bookId;
            try {
                const res = await fetch(`/api/bookings/${bookId}`);
                const b = await res.json();

                document.getElementById('ebBookIdBadge').textContent = b.book_id;
                document.getElementById('ebTitle').value = b.title;
                document.getElementById('ebRoom').value = b.room_booking.room;
                document.getElementById('ebEventDate').value = b.room_booking.event_date;
                document.getElementById('ebTimeIn').value = b.room_booking.time_in;
                document.getElementById('ebTimeOut').value = b.room_booking.time_out;
                document.getElementById('ebPax').value = b.pax;
                document.getElementById('ebDeposit').value = b.deposit;
                document.getElementById('ebStatus').value = b.status;
                document.getElementById('ebNotes').value = b.notes;
                const ebCut = document.getElementById('ebCutoffDate');
                if (ebCut) {
                    ebCut.min = new Date().toISOString().split('T')[0];
                    ebCut.value = b.cutoff_date || '';
                    const badge = document.getElementById('ebCutoffRemainingBadge');
                    if (badge) {
                        if (b.cutoff_date) {
                            const cDate = new Date(b.cutoff_date);
                            const tDate = new Date();
                            tDate.setHours(0,0,0,0);
                            cDate.setHours(0,0,0,0);
                            const dDiff = Math.round((cDate - tDate) / (1000*60*60*24));
                            if (dDiff < 0) {
                                badge.className = 'text-[10px] px-2 py-0.5 rounded font-extrabold bg-rose-100 text-rose-800';
                                badge.textContent = `🚨 Quá hạn ${Math.abs(dDiff)} ngày`;
                            } else if (dDiff <= 1) {
                                badge.className = 'text-[10px] px-2 py-0.5 rounded font-extrabold bg-amber-100 text-amber-800';
                                badge.textContent = `⚠️ Còn ${dDiff} ngày`;
                            } else {
                                badge.className = 'text-[10px] px-2 py-0.5 rounded font-bold bg-emerald-100 text-emerald-800';
                                badge.textContent = `🛡️ Còn ${dDiff} ngày`;
                            }
                        } else {
                            badge.textContent = '';
                        }
                    }
                }
                toggleEbCutoffField();

                document.getElementById('ebGuestName').value = b.customer.name;
                document.getElementById('ebGuestPhone').value = b.customer.phone;
                document.getElementById('ebGuestEmail').value = b.customer.email;
                document.getElementById('ebGuestAddress').value = b.customer.address;

                document.getElementById('ebLockUserDisplay').textContent = b.lock_user;
                document.getElementById('ebBeoUserDisplay').textContent = `${b.effective_sales} ${b.beo_user ? '(Đã có BEO)' : '(Chưa lập BEO)'}`;

                // Update BEO Status Badge & Button
                const todayStr = '2026-11-10';
                const eventDate = (b.room_booking && b.room_booking.event_date) ? b.room_booking.event_date : '';
                const isPast = eventDate && eventDate < todayStr;
                const hasBeo = !!(b.master_eo || b.beo_user);
                const beoBtn = document.getElementById('btnModalOpenBeo');
                const beoBadge = document.getElementById('ebBeoStatusBadge');

                if (hasBeo) {
                    if (isPast) {
                        beoBadge.className = 'p-3 rounded-xl border bg-emerald-50 border-emerald-300 text-emerald-900 flex items-center justify-between text-xs font-semibold';
                        beoBadge.innerHTML = `
                            <div class="flex items-center gap-2.5">
                                <div class="w-8 h-8 rounded-lg bg-emerald-600 text-white flex items-center justify-center font-bold">
                                    <i data-lucide="check-check" class="w-4 h-4"></i>
                                </div>
                                <div>
                                    <span class="font-bold text-emerald-950 block">TIỆC ĐÃ DIỄN RA & BEO ĐÃ HOÀN TẤT</span>
                                    <span class="text-[11px] text-emerald-700">Mã Lệnh BEO: <strong>#${b.master_eo || 'Đã lập'}</strong> &bull; Người lập: <strong>${b.effective_sales}</strong></span>
                                </div>
                            </div>
                            <span class="px-2.5 py-1 rounded-full bg-emerald-600 text-white font-extrabold text-[10px] tracking-wide">ĐÃ HOÀN TẤT</span>
                        `;
                    } else {
                        beoBadge.className = 'p-3 rounded-xl border bg-blue-50 border-blue-300 text-blue-900 flex items-center justify-between text-xs font-semibold';
                        beoBadge.innerHTML = `
                            <div class="flex items-center gap-2.5">
                                <div class="w-8 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center font-bold">
                                    <i data-lucide="file-check" class="w-4 h-4"></i>
                                </div>
                                <div>
                                    <span class="font-bold text-blue-950 block">ĐÃ PHÁT HÀNH LỆNH BEO (CHỜ TỔ CHỨC)</span>
                                    <span class="text-[11px] text-blue-700">Mã Lệnh BEO: <strong>#${b.master_eo || 'Đã lập'}</strong> &bull; Người lập: <strong>${b.effective_sales}</strong></span>
                                </div>
                            </div>
                            <span class="px-2.5 py-1 rounded-full bg-blue-600 text-white font-extrabold text-[10px] tracking-wide">ĐÃ RA BEO</span>
                        `;
                    }
                    if (beoBtn) {
                        beoBtn.innerHTML = `<i data-lucide="file-text" class="w-3.5 h-3.5"></i><span>Xem & In Lệnh BEO (${b.master_eo ? '#' + b.master_eo : 'Đã có'}) &rarr;</span>`;
                        beoBtn.className = 'px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-bold flex items-center gap-1 transition shadow-sm';
                    }
                } else {
                    beoBadge.className = 'p-3 rounded-xl border bg-amber-50 border-amber-300 text-amber-900 flex items-center justify-between text-xs font-semibold';
                    beoBadge.innerHTML = `
                        <div class="flex items-center gap-2.5">
                            <div class="w-8 h-8 rounded-lg bg-amber-500 text-white flex items-center justify-center font-bold">
                                <i data-lucide="alert-circle" class="w-4 h-4"></i>
                            </div>
                            <div>
                                <span class="font-bold text-amber-950 block">ĐƠN TIỆC CHƯA LẬP LỆNH BEO</span>
                                <span class="text-[11px] text-amber-700">Cần chốt thực đơn, số bàn và các dịch vụ để phát hành BEO</span>
                            </div>
                        </div>
                        <span class="px-2.5 py-1 rounded-full bg-amber-500 text-white font-extrabold text-[10px] tracking-wide">CHƯA CÓ BEO</span>
                    `;
                    if (beoBtn) {
                        beoBtn.innerHTML = `<i data-lucide="file-plus" class="w-3.5 h-3.5"></i><span>+ Soạn Lệnh BEO Mới &rarr;</span>`;
                        beoBtn.className = 'px-3 py-1.5 bg-indigo-50 text-indigo-700 hover:bg-indigo-100 border border-indigo-200 rounded-lg font-bold flex items-center gap-1 transition';
                    }
                }

                loadBookingCharges(bookId);
                document.getElementById('editBookingModal').classList.remove('hidden');
                lucide.createIcons();
            } catch (err) {
                alert('Không thể tải thông tin đơn tiệc!');
            }
        }

        async function handleUpdateBooking(e) {
            e.preventDefault();
            if (!currentActiveBookingId) return;

            const payload = {
                title: document.getElementById('ebTitle').value.trim(),
                event_date: document.getElementById('ebEventDate').value,
                time_in: document.getElementById('ebTimeIn').value,
                time_out: document.getElementById('ebTimeOut').value,
                room: document.getElementById('ebRoom').value,
                pax: parseInt(document.getElementById('ebPax').value) || 0,
                deposit: parseFloat(document.getElementById('ebDeposit').value) || 0,
                status: document.getElementById('ebStatus').value,
                cutoff_date: document.getElementById('ebCutoffDate') ? (document.getElementById('ebCutoffDate').value || null) : null,
                guest_name: document.getElementById('ebGuestName').value.trim(),
                guest_phone: document.getElementById('ebGuestPhone').value.trim(),
                guest_email: document.getElementById('ebGuestEmail').value.trim(),
                guest_address: document.getElementById('ebGuestAddress').value.trim(),
                notes: document.getElementById('ebNotes').value
            };

            try {
                const res = await fetch(`/api/bookings/${currentActiveBookingId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (!res.ok) {
                    alert(data.detail || 'Lỗi cập nhật!');
                    return;
                }

                alert(`CẬP NHẬT THÀNH CÔNG!
Đơn tiệc: ${currentActiveBookingId}`);
                closeModal('editBookingModal');
                loadSchedulerData();
            initScrollListeners();
            loadCancelReasons();
                loadBookingsList();
            } catch (err) {
                alert('Lỗi kết nối khi cập nhật đơn tiệc!');
            }
        }

        async function quickConfirmCurrentBooking() {
            if (!currentActiveBookingId) return;
            if (!confirm(`Xác nhận KHÓA CHỐT (Definite) đơn tiệc ${currentActiveBookingId}?`)) return;

            try {
                const res = await fetch(`/api/bookings/${currentActiveBookingId}/confirm`, { method: 'POST' });
                const data = await res.json();
                alert(data.message || 'Đã chốt chính thức đơn tiệc!');
                document.getElementById('ebStatus').value = 'D';
                loadSchedulerData();
            initScrollListeners();
            loadCancelReasons();
                loadBookingsList();
            } catch (err) {
                alert('Lỗi chốt đơn tiệc!');
            }
        }

        async function quickCancelCurrentBooking() {
            if (!currentActiveBookingId) return;
            if (!confirm(`CẢNH BÁO: Bạn có chắc chắn muốn HỦY đơn tiệc ${currentActiveBookingId} và giải phóng sảnh?`)) return;

            try {
                const res = await fetch(`/api/bookings/${currentActiveBookingId}/cancel`, { method: 'POST' });
                const data = await res.json();
                alert(data.message || 'Đã hủy đơn tiệc!');
                closeModal('editBookingModal');
                loadSchedulerData();
            initScrollListeners();
            loadCancelReasons();
                loadBookingsList();
            } catch (err) {
                alert('Lỗi hủy đơn tiệc!');
            }
        }

        function openBeoFromEditModal() {
            if (!currentActiveBookingId) return;
            closeModal('editBookingModal');
            openBeoForBooking(currentActiveBookingId);
        }

        // -------------------------------------------------------------
        // BOOKING CREATION & CONFLICT CHECKING
        // -------------------------------------------------------------
        function openNewBookingModal() {
            if (!currentUser) {
                openLoginModal();
                return;
            }
            clearSelectedBookingCustomer();
            document.getElementById('newBookingModal').classList.remove('hidden');
            document.getElementById('nbCurrentUserDisplay').textContent = `${currentUser.full_name} (${currentUser.username})`;
            document.getElementById('nbEventDate').value = document.getElementById('txtSchedFrom').value || '2026-11-10';
            checkConflictAuto();
        }

        async function checkConflictAuto() {
            const room = document.getElementById('nbRoom').value;
            const date = document.getElementById('nbEventDate').value;
            const timeIn = document.getElementById('nbTimeIn').value;
            const timeOut = document.getElementById('nbTimeOut').value;
            const alertBox = document.getElementById('nbConflictAlert');
            const submitBtn = document.getElementById('btnSubmitBooking');

            if (!room || !date || !timeIn || !timeOut) return;

            try {
                const res = await fetch(`/api/bookings/check-conflict?room=${encodeURIComponent(room)}&date=${date}&time_in=${timeIn}&time_out=${timeOut}`);
                const data = await res.json();

                if (data.has_conflict) {
                    alertBox.className = 'p-3 rounded-xl border bg-rose-50 border-rose-300 text-rose-800 text-xs space-y-1';
                    alertBox.innerHTML = `
                        <div class="font-bold flex items-center gap-1.5 text-rose-700">
                            <i data-lucide="alert-triangle" class="w-4 h-4"></i>
                            <span>CẢNH BÁO XUNG ĐỘT SẢNH!</span>
                        </div>
                        <p>Sảnh <strong>${room}</strong> vào khung giờ này đã có đơn đặt:</p>
                        <ul class="list-disc list-inside font-medium text-[11px]">
                            ${data.conflicts.map(c => `<li>Mã: <strong>${c.book_id}</strong> &bull; Tiệc: ${c.title} (${c.time_in}-${c.time_out}) &bull; Người phụ trách: ${c.sales_user}</li>`).join('')}
                        </ul>
                    `;
                    alertBox.classList.remove('hidden');
                    submitBtn.classList.add('opacity-50');
                } else {
                    alertBox.className = 'p-2.5 rounded-xl border bg-emerald-50 border-emerald-300 text-emerald-800 text-xs flex items-center gap-2';
                    alertBox.innerHTML = `
                        <i data-lucide="check-circle" class="w-4 h-4 text-emerald-600"></i>
                        <span>Sảnh <strong>${room}</strong> hoàn toàn trống trong khung giờ này. Có thể khóa sảnh!</span>
                    `;
                    alertBox.classList.remove('hidden');
                    submitBtn.classList.remove('opacity-50');
                }
                lucide.createIcons();
            } catch (err) {
                console.error("Conflict check error:", err);
            }
        }


        function renderBeoChargesTable() {
            const tblCharges = document.getElementById('beoTblCharges');
            if (!tblCharges) return;
            tblCharges.innerHTML = '';
            const list = (currentBeoData && currentBeoData.charges_detail) ? currentBeoData.charges_detail : [];
            let total = 0;
            if (list.length > 0) {
                list.forEach((ch, idx) => {
                    const amt = parseFloat(ch.amount) || 0;
                    total += amt;
                    const tr = document.createElement('tr');
                    tr.className = 'hover:bg-slate-50 transition border-b border-slate-100';
                    tr.innerHTML = `
                        <td class="p-2 font-bold text-slate-800">${ch.item}</td>
                        <td class="p-2 text-slate-600 font-mono text-[11px]">${ch.desc || (formatVND(ch.price) + ' x ' + (ch.quantity || 1))}</td>
                        <td class="p-2 text-right font-mono font-bold text-emerald-700">${formatVND(amt)}</td>
                        <td class="p-2 text-center no-print">
                            <button type="button" onclick="removeBeoCharge(${idx})" class="p-1 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded transition" title="Xóa dịch vụ">
                                <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                            </button>
                        </td>
                    `;
                    tblCharges.appendChild(tr);
                });
            } else {
                tblCharges.innerHTML = `<tr><td colspan="4" class="p-4 text-center text-slate-400 italic">Chưa có chi tiết giá dịch vụ. Bạn có thể thêm dịch vụ ở khung bên dưới.</td></tr>`;
            }
            if (currentBeoData) currentBeoData.total_charges = total;
            const lblTotal = document.getElementById('beoTotalCharges');
            if (lblTotal) lblTotal.textContent = formatVND(total);
            lucide.createIcons();
        }

        function removeBeoCharge(index) {
            if (!currentBeoData || !currentBeoData.charges_detail) return;
            currentBeoData.charges_detail.splice(index, 1);
            renderBeoChargesTable();
        }

        async function populateBeoMasterCharges() {
            const sel = document.getElementById('beoAddChargeLoai');
            if (!sel) return;
            if (!masterCharges || masterCharges.length === 0) {
                try {
                    const res = await fetch('/api/master/charges');
                    if (res.ok) masterCharges = await res.json();
                } catch (e) {
                    console.error("Failed to load master charges:", e);
                }
            }
            if (!masterCharges || masterCharges.length === 0) return;

            sel.innerHTML = '<option value="">-- Bấm chọn dịch vụ từ CSDL (87 loại) --</option>';

            const groupNames = {
                '02': 'Nước uống & Freeflow (Drinks)',
                '03': 'Phụ thu, Âm thanh, Ánh sáng & Trang trí',
                '04': 'Ẩm thực & Tiệc (Food & Teabreak)',
                '05': 'Phòng lưu trú & Phụ thu phòng',
                '06': 'Gói hội nghị trọn gói (Packages)'
            };

            const groups = {};
            masterCharges.forEach(ch => {
                const g = ch.group || 'OTHER';
                if (!groups[g]) groups[g] = [];
                groups[g].push(ch);
            });

            Object.keys(groups).sort().forEach(gKey => {
                const grpLabel = groupNames[gKey] || `Nhóm dịch vụ ${gKey}`;
                const optGroup = document.createElement('optgroup');
                optGroup.label = grpLabel;
                groups[gKey].forEach(ch => {
                    const opt = document.createElement('option');
                    opt.value = ch.code;
                    const priceTag = (ch.price && ch.price > 0) ? ` -- [${formatVND(ch.price)} / ${ch.unit || 'mục'}]` : '';
                    opt.textContent = `${ch.name}${priceTag}`;
                    optGroup.appendChild(opt);
                });
                sel.appendChild(optGroup);
            });
        }

        function onSelectBeoChargeMaster(sel) {
            if (!sel || !sel.value) return;
            const ch = masterCharges.find(x => x.code === sel.value);
            if (ch) {
                document.getElementById('beoAddChargeName').value = ch.name;
                
                // TỰ ĐỘNG GÁN ĐƠN GIÁ TỪ CSDL SQL SERVER
                const priceEl = document.getElementById('beoAddChargePrice');
                if (priceEl) {
                    priceEl.value = (ch.price && ch.price > 0) ? ch.price : '';
                }

                // TỰ ĐỘNG GÁN SỐ LƯỢNG THEO LOẠI DỊCH VỤ
                const qtyEl = document.getElementById('beoAddChargeQty');
                if (qtyEl) {
                    if (ch.per_pax) {
                        const pax = (currentBeoData && (currentBeoData.gua_pax || currentBeoData.pax)) || 1;
                        qtyEl.value = pax;
                    } else {
                        qtyEl.value = 1;
                    }
                }
            }
        }

        function quickSelectCharge(itemName, unitPrice, fixedQty = null) {
            document.getElementById('beoAddChargeName').value = itemName;
            document.getElementById('beoAddChargePrice').value = unitPrice;
            const qtyEl = document.getElementById('beoAddChargeQty');
            if (fixedQty !== null) {
                qtyEl.value = fixedQty;
            } else if (currentBeoData && (currentBeoData.gua_pax || currentBeoData.pax)) {
                qtyEl.value = currentBeoData.gua_pax || currentBeoData.pax;
            } else {
                qtyEl.value = 1;
            }
        }
        function addBeoCharge() {
            if (!currentBeoData) {
                alert('Vui lòng chọn hoặc nạp một đơn tiệc trước khi thêm dịch vụ!');
                return;
            }
            const itemInput = document.getElementById('beoAddChargeName');
            const qtyInput = document.getElementById('beoAddChargeQty');
            const priceInput = document.getElementById('beoAddChargePrice');
            const selLoai = document.getElementById('beoAddChargeLoai');

            const item = itemInput.value.trim() || (selLoai.options[selLoai.selectedIndex] ? selLoai.options[selLoai.selectedIndex].text : 'Dịch vụ tiệc');
            const qty = parseFloat(qtyInput.value) || 1;
            const price = parseFloat(priceInput.value) || 0;
            const amount = qty * price;
            const chargeCode = selLoai.value || '03';

            if (!item) {
                alert('Vui lòng nhập tên dịch vụ / hạng mục!');
                return;
            }

            if (!currentBeoData.charges_detail) currentBeoData.charges_detail = [];
            currentBeoData.charges_detail.push({
                charge_code: chargeCode,
                item: item,
                desc: `${formatVND(price)} x ${qty}`,
                quantity: qty,
                price: price,
                amount: amount,
                note: item
            });

            renderBeoChargesTable();

            // Clear inputs
            itemInput.value = '';
            priceInput.value = '';
            qtyInput.value = (currentBeoData.gua_pax || currentBeoData.pax || 1);
        }

        
        let allBookingCustomersCache = null;
        let searchCustomerDebounceTimer = null;

        async function openBookingCustomerSearchModal() {
            document.getElementById('modalBookingCustomerSearch').classList.remove('hidden');
            const searchInput = document.getElementById('txtBookingCustomerSearch');
            searchInput.value = '';
            searchInput.focus();

            const tbody = document.getElementById('tblBookingCustomersSearchBody');
            if (allBookingCustomersCache && allBookingCustomersCache.length > 0) {
                renderBookingCustomerSearchResults(allBookingCustomersCache);
                return;
            }

            tbody.innerHTML = '<tr><td colspan="5" class="p-6 text-center text-slate-400"><i class="lucide-loader-2 animate-spin w-4 h-4 mr-1 inline-block"></i> Đang nạp danh sách khách hàng từ SQL Server...</td></tr>';
            try {
                const res = await fetch('/api/master/customers?limit=1000');
                if (res.ok) {
                    allBookingCustomersCache = await res.json();
                    renderBookingCustomerSearchResults(allBookingCustomersCache);
                } else {
                    tbody.innerHTML = '<tr><td colspan="5" class="p-6 text-center text-rose-500">Lỗi khi tải danh sách khách hàng!</td></tr>';
                }
            } catch (err) {
                tbody.innerHTML = `<tr><td colspan="5" class="p-6 text-center text-rose-500">Lỗi kết nối: ${err.message}</td></tr>`;
            }
        }

        function debounceSearchBookingCustomers() {
            clearTimeout(searchCustomerDebounceTimer);
            searchCustomerDebounceTimer = setTimeout(() => {
                const q = document.getElementById('txtBookingCustomerSearch').value.trim().toLowerCase();
                if (!allBookingCustomersCache) return;
                if (!q) {
                    renderBookingCustomerSearchResults(allBookingCustomersCache);
                    return;
                }
                const filtered = allBookingCustomersCache.filter(c => {
                    return (c.name && c.name.toLowerCase().includes(q)) ||
                           (c.phone && c.phone.toLowerCase().includes(q)) ||
                           (c.code && c.code.toLowerCase().includes(q)) ||
                           (c.tax_code && c.tax_code.toLowerCase().includes(q)) ||
                           (c.email && c.email.toLowerCase().includes(q));
                });
                renderBookingCustomerSearchResults(filtered);
            }, 150);
        }

        function renderBookingCustomerSearchResults(list) {
            const tbody = document.getElementById('tblBookingCustomersSearchBody');
            const lblCount = document.getElementById('lblBookingCustomerCount');
            if (lblCount) lblCount.textContent = `Tìm thấy ${list.length} khách hàng`;

            if (!list || list.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" class="p-6 text-center text-slate-400">Không tìm thấy khách hàng nào phù hợp!</td></tr>';
                return;
            }

            const displayList = list.slice(0, 100);
            let html = '';
            displayList.forEach(c => {
                const rawJson = encodeURIComponent(JSON.stringify(c));
                html += `
                    <tr class="hover:bg-blue-50/50 transition border-b border-slate-100 cursor-pointer" onclick="selectBookingCustomer('${rawJson}')">
                        <td class="p-2.5 font-mono font-bold text-blue-700 whitespace-nowrap">${c.code || '--'}</td>
                        <td class="p-2.5 font-bold text-slate-800">${c.name || '--'}</td>
                        <td class="p-2.5 font-mono text-slate-600 whitespace-nowrap">${c.phone || '--'}</td>
                        <td class="p-2.5 font-mono text-slate-500 whitespace-nowrap">${c.tax_code || '--'}</td>
                        <td class="p-2.5 text-center whitespace-nowrap" onclick="event.stopPropagation()">
                            <button type="button" onclick="selectBookingCustomer('${rawJson}')" class="px-2.5 py-1 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-bold transition flex items-center gap-1 shadow-xs mx-auto">
                                <i data-lucide="check" class="w-3 h-3"></i> Chọn
                            </button>
                        </td>
                    </tr>
                `;
            });

            if (list.length > 100) {
                html += `<tr><td colspan="5" class="p-2 text-center text-slate-400 text-[11px] italic bg-slate-50">Đang hiển thị 100 kết quả đầu tiên. Hãy gõ từ khóa để thu hẹp tìm kiếm.</td></tr>`;
            }

            tbody.innerHTML = html;
            lucide.createIcons();
        }

        function selectBookingCustomer(encodedCust) {
            try {
                const cust = JSON.parse(decodeURIComponent(encodedCust));
                document.getElementById('nbGuestName').value = cust.name || '';
                document.getElementById('nbGuestPhone').value = cust.phone || '';
                if (document.getElementById('nbGuestEmail')) document.getElementById('nbGuestEmail').value = cust.email || '';
                if (document.getElementById('nbGuestAddress')) document.getElementById('nbGuestAddress').value = cust.address || '';
                if (document.getElementById('nbBillCompany')) document.getElementById('nbBillCompany').value = cust.name || '';
                if (document.getElementById('nbBillTaxCode')) document.getElementById('nbBillTaxCode').value = cust.tax_code || '';
                if (document.getElementById('nbBillAddress')) document.getElementById('nbBillAddress').value = cust.address || '';
                document.getElementById('nbCustomerID').value = cust.code || '';

                const badge = document.getElementById('nbCustomerSelectedBadge');
                const badgeText = document.getElementById('nbCustomerSelectedText');
                if (badge && badgeText) {
                    badgeText.textContent = `Đã chọn: [Mã ${cust.code}] ${cust.name}`;
                    badge.classList.remove('hidden');
                }

                closeModal('modalBookingCustomerSearch');
            } catch (e) {
                console.error("Select customer err:", e);
            }
        }

        function clearSelectedBookingCustomer() {
            document.getElementById('nbCustomerID').value = '';
            const badge = document.getElementById('nbCustomerSelectedBadge');
            if (badge) badge.classList.add('hidden');
        }

        async function handleCreateBooking(e) {
            e.preventDefault();
            if (!currentUser) {
                currentUser = { username: "ADMIN", full_name: "Administrator", dept: "DORS / Ban Quản Trị" };
                localStorage.setItem('ems_user', JSON.stringify(currentUser));
                updateHeaderUser();
            }

            const btn = document.getElementById('btnSubmitBooking');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<span>Đang lưu & khóa sảnh...</span>';
            btn.disabled = true;

            const payload = {
                title: document.getElementById('nbTitle').value.trim() || 'Tiệc MerPerle',
                event_date: document.getElementById('nbEventDate').value,
                time_in: document.getElementById('nbTimeIn').value,
                time_out: document.getElementById('nbTimeOut').value,
                room: document.getElementById('nbRoom').value,
                pax: parseInt(document.getElementById('nbPax').value) || 100,
                status: document.getElementById('nbStatus').value || 'T',
                cutoff_date: document.getElementById('nbCutoffDate') ? (document.getElementById('nbCutoffDate').value || null) : null,
                sales_user: currentUser.username,
                customer_id: document.getElementById('nbCustomerID') ? (document.getElementById('nbCustomerID').value || null) : null,
                guest_name: document.getElementById('nbGuestName').value.trim() || 'Khách Đặt Tiệc',
                guest_phone: document.getElementById('nbGuestPhone').value.trim(),
                guest_email: document.getElementById('nbGuestEmail') ? document.getElementById('nbGuestEmail').value.trim() : '',
                guest_address: document.getElementById('nbGuestAddress') ? document.getElementById('nbGuestAddress').value.trim() : '',
                tax_code: document.getElementById('nbBillTaxCode') ? document.getElementById('nbBillTaxCode').value.trim() : '',
                bill_to: document.getElementById('nbBillCompany') ? document.getElementById('nbBillCompany').value.trim() : '',
                bill_address: document.getElementById('nbBillAddress') ? document.getElementById('nbBillAddress').value.trim() : '',
                deposit: parseFloat(document.getElementById('nbDeposit').value) || 0
            };

            try {
                const res = await fetch('/api/bookings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (!res.ok) {
                    alert(data.detail || 'Lỗi khi lưu đơn tiệc!');
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                    return;
                }

                alert(`ĐẶT TIỆC THÀNH CÔNG!

Mã Booking: ${data.book_id}
Sảnh: ${payload.room}
Người giữ sảnh: ${currentUser.full_name} (${currentUser.username})`);
                closeModal('newBookingModal');
                btn.innerHTML = originalText;
                btn.disabled = false;
                await loadSchedulerData();
                initScrollListeners();
                await loadBookingsList();
                await loadBeoBookingsList();
            } catch (err) {
                alert('Lỗi kết nối khi tạo booking!');
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        }

        // -------------------------------------------------------------
        // BOOKINGS LIST VIEW
        // -------------------------------------------------------------
        function setBkPreset(type) {
            if (type === 'all') {
                document.getElementById('txtBkDateFrom').value = '';
                document.getElementById('txtBkDateTo').value = '';
            } else if (type === '2026') {
                document.getElementById('txtBkDateFrom').value = '2026-01-01';
                document.getElementById('txtBkDateTo').value = '2026-12-31';
            } else if (type === 'm11_2026') {
                document.getElementById('txtBkDateFrom').value = '2026-11-01';
                document.getElementById('txtBkDateTo').value = '2026-11-30';
            } else if (type === 'q4_2026') {
                document.getElementById('txtBkDateFrom').value = '2026-10-01';
                document.getElementById('txtBkDateTo').value = '2026-12-31';
            }
            loadBookingsList();
        }

        function debounceSearchBookings() {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(loadBookingsList, 300);
        }

        // -------------------------------------------------------------
        // MULTI-SELECT STATUS & ROW SELECTION LOGIC FOR WEB BOOKINGS
        // -------------------------------------------------------------
        function syncWebStatusSelectToChips() {
            const selVal = document.getElementById('selBkFilterStatus').value;
            const chkD = document.getElementById('chkWebStatusD');
            const chkT = document.getElementById('chkWebStatusT');
            const chkC = document.getElementById('chkWebStatusC');

            if (selVal === 'ALL') {
                if (chkD) chkD.checked = true;
                if (chkT) chkT.checked = true;
                if (chkC) chkC.checked = true;
            } else if (selVal === 'D,T') {
                if (chkD) chkD.checked = true;
                if (chkT) chkT.checked = true;
                if (chkC) chkC.checked = false;
            } else if (selVal === 'D') {
                if (chkD) chkD.checked = true;
                if (chkT) chkT.checked = false;
                if (chkC) chkC.checked = false;
            } else if (selVal === 'T') {
                if (chkD) chkD.checked = false;
                if (chkT) chkT.checked = true;
                if (chkC) chkC.checked = false;
            } else if (selVal === 'C') {
                if (chkD) chkD.checked = false;
                if (chkT) chkT.checked = false;
                if (chkC) chkC.checked = true;
            }
            updateWebStatusChipsVisual();
            loadBookingsList();
        }

        function toggleWebStatusFilter(code) {
            let chk = null;
            if (code === 'D') chk = document.getElementById('chkWebStatusD');
            else if (code === 'T') chk = document.getElementById('chkWebStatusT');
            else if (code === 'C') chk = document.getElementById('chkWebStatusC');

            if (chk) {
                chk.checked = !chk.checked;
            }

            // Đồng bộ ngược lại dropdown
            const isD = document.getElementById('chkWebStatusD') ? document.getElementById('chkWebStatusD').checked : false;
            const isT = document.getElementById('chkWebStatusT') ? document.getElementById('chkWebStatusT').checked : false;
            const isC = document.getElementById('chkWebStatusC') ? document.getElementById('chkWebStatusC').checked : false;

            const selStatus = document.getElementById('selBkFilterStatus');
            if (selStatus) {
                if (isD && isT && isC) selStatus.value = 'ALL';
                else if (isD && isT && !isC) selStatus.value = 'D,T';
                else if (isD && !isT && !isC) selStatus.value = 'D';
                else if (!isD && isT && !isC) selStatus.value = 'T';
                else if (!isD && !isT && isC) selStatus.value = 'C';
                else selStatus.value = 'ALL';
            }

            updateWebStatusChipsVisual();
            loadBookingsList();
        }

        function updateWebStatusChipsVisual() {
            const isD = document.getElementById('chkWebStatusD') ? document.getElementById('chkWebStatusD').checked : false;
            const isT = document.getElementById('chkWebStatusT') ? document.getElementById('chkWebStatusT').checked : false;
            const isC = document.getElementById('chkWebStatusC') ? document.getElementById('chkWebStatusC').checked : false;

            const chipD = document.getElementById('btnFilterChipD');
            const chipT = document.getElementById('btnFilterChipT');
            const chipC = document.getElementById('btnFilterChipC');

            if (chipD) {
                chipD.className = isD 
                    ? 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-300 hover:bg-emerald-200 transition cursor-pointer shadow-xs'
                    : 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-400 border border-slate-200 hover:bg-emerald-50 hover:text-emerald-700 transition cursor-pointer opacity-70';
            }
            if (chipT) {
                chipT.className = isT
                    ? 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-100 text-amber-800 border border-amber-300 hover:bg-amber-200 transition cursor-pointer shadow-xs'
                    : 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-400 border border-slate-200 hover:bg-amber-50 hover:text-amber-700 transition cursor-pointer opacity-70';
            }
            if (chipC) {
                chipC.className = isC
                    ? 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-rose-100 text-rose-800 border border-rose-300 hover:bg-rose-200 transition cursor-pointer shadow-xs'
                    : 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-400 border border-slate-200 hover:bg-rose-50 hover:text-rose-700 transition cursor-pointer opacity-70';
            }
        }

        function getEffectiveWebStatusFilter() {
            const isD = document.getElementById('chkWebStatusD') ? document.getElementById('chkWebStatusD').checked : true;
            const isT = document.getElementById('chkWebStatusT') ? document.getElementById('chkWebStatusT').checked : true;
            const isC = document.getElementById('chkWebStatusC') ? document.getElementById('chkWebStatusC').checked : false;

            const selected = [];
            if (isD) selected.push('D');
            if (isT) selected.push('T');
            if (isC) selected.push('C');

            if (selected.length === 0 || selected.length === 3) return 'ALL';
            return selected.join(',');
        }

        function toggleSelectAllWebBookings(masterCb) {
            const cbs = document.querySelectorAll('.chk-web-booking');
            cbs.forEach(cb => {
                cb.checked = masterCb.checked;
            });
            updateWebBookingsSelectedUI();
        }

        function updateWebBookingsSelectedUI() {
            const checkedBoxes = Array.from(document.querySelectorAll('.chk-web-booking:checked'));
            const count = checkedBoxes.length;

            const bar = document.getElementById('barWebSelectedBookings');
            const lblCount = document.getElementById('lblWebSelectedCount');
            const btnCount = document.getElementById('btnExportSelectedCount');
            const btnText = document.getElementById('lblExportExcelBtnText');
            const masterCb = document.getElementById('chkSelectAllWebBookings');

            if (lblCount) lblCount.textContent = count;
            if (btnCount) btnCount.textContent = count;

            if (count > 0) {
                if (bar) bar.classList.remove('hidden');
                if (btnText) btnText.textContent = `Xuất Excel (${count} đơn chọn)`;
            } else {
                if (bar) bar.classList.add('hidden');
                if (btnText) btnText.textContent = 'Xuất File Excel';
            }

            const totalRows = document.querySelectorAll('.chk-web-booking').length;
            if (masterCb) {
                masterCb.checked = (totalRows > 0 && count === totalRows);
                masterCb.indeterminate = (count > 0 && count < totalRows);
            }
        }

        function clearWebBookingsSelection() {
            const cbs = document.querySelectorAll('.chk-web-booking');
            cbs.forEach(cb => cb.checked = false);
            const masterCb = document.getElementById('chkSelectAllWebBookings');
            if (masterCb) masterCb.checked = false;
            updateWebBookingsSelectedUI();
        }

                const CANCEL_REASONS_VI = {
            'Speaker cancelled': 'Diễn giả hủy / đổi lịch',
            'Weather': 'Thời tiết xấu / mưa bão',
            'Cancelled Meeting Plan': 'Sự kiện bị hủy kế hoạch',
            'Change Location': 'Thay đổi địa điểm',
            'Changed requirements': 'Khách thay đổi yêu cầu',
            'Entry Error': 'Nhập sai thông tin booking',
            'Postponed Meeting': 'Gia hạn / Dời ngày sự kiện',
            'Agency Transfer': 'Chuyển booking qua đại lý',
            'AT - Agency Transfer': 'Chuyển booking qua đại lý (AT)',
            'Force Majeure': 'Trường hợp bất khả kháng',
            'No Response': 'Khách không phản hồi',
            'Act of God': 'Thiên tai / Sự cố tự nhiên'
        };

        function formatCancelReason(note) {
            if (!note) return 'Chưa cập nhật lý do';
            let s = String(note).trim();

            // 1. Tag [HỦY TIỆC: ...]
            const match = s.match(/\[HỦY TIỆC:\s*([^\]]+)\]/i);
            if (match) {
                return match[1].trim();
            }

            // 2. Lọc bỏ các tag kỹ thuật [Đã dời...]
            s = s.replace(/\[Đã dời[^\]]*\]/gi, '').trim();

            // 3. Tra cứu từ điển tiếng Việt chuẩn nếu là mã tiếng Anh từ phần mềm Desktop cũ
            for (const [enKey, viText] of Object.entries(CANCEL_REASONS_VI)) {
                if (s.toLowerCase().startsWith(enKey.toLowerCase())) {
                    const extra = s.slice(enKey.length).replace(/^[\s\-–—:]+/, '').trim();
                    return extra ? `${viText} (${extra})` : `${viText} (${enKey})`;
                }
            }

            // 4. Lấy dòng đầu tiên nếu có nhiều dòng
            const lines = s.split('\n').map(l => l.trim()).filter(Boolean);
            return lines[0] || s || 'Chưa cập nhật lý do';
        }

        async function loadBookingsList() {
            try {
                const p = new URLSearchParams();
                const dType = document.getElementById('selBkDateType').value;
                const dFrom = document.getElementById('txtBkDateFrom').value;
                const dTo = document.getElementById('txtBkDateTo').value;
                const r = document.getElementById('selBkFilterRoom').value;
                const st = getEffectiveWebStatusFilter();
                const sl = document.getElementById('selBkFilterSales').value;
                const q = document.getElementById('txtBkSearch').value.trim();

                // Dynamic Header: Đổi tiêu đề sang LÝ DO HỦY TIỆC khi xem danh sách đơn hủy
                const thCust = document.getElementById('thBkCustomerCol');
                const isOnlyCancelled = (st === 'C') || (document.getElementById('selBkFilterStatus') && document.getElementById('selBkFilterStatus').value === 'C');
                if (thCust) {
                    if (isOnlyCancelled) {
                        thCust.className = 'px-2.5 py-2.5 text-rose-700 bg-rose-50 border-b border-rose-200 transition font-bold whitespace-nowrap min-w-[200px] max-w-[260px]';
                        thCust.innerHTML = '<span class="flex items-center gap-1.5"><i data-lucide="alert-triangle" class="w-3.5 h-3.5 text-rose-600"></i> LÝ DO HỦY TIỆC</span>';
                    } else {
                        thCust.className = 'px-2.5 py-2.5 min-w-[170px] max-w-[210px] font-bold text-slate-500 uppercase tracking-wider whitespace-nowrap transition';
                        thCust.textContent = 'KHÁCH HÀNG / ĐƠN VỊ';
                    }
                }

                p.append('date_type', dType);
                if (dFrom) p.append('from_date', dFrom);
                if (dTo) p.append('to_date', dTo);
                if (r && r !== 'ALL') p.append('room', r);
                if (st && st !== 'ALL') p.append('status', st);
                if (sl && sl !== 'ALL') p.append('sales_user', sl);
                if (q) p.append('search', q);
                p.append('limit', '100');

                const res = await fetch('/api/bookings/list?' + p.toString());
                const data = await res.json();

                const totalCount = (data.total !== undefined) ? data.total : (data.items ? data.items.length : 0);
                document.getElementById('lblBkCount').textContent = `${totalCount} đơn tiệc`;
                if (document.getElementById('lblBkConfirmedCount')) document.getElementById('lblBkConfirmedCount').textContent = (data.confirmed_count || 0);
                if (document.getElementById('lblBkCancelledCount')) document.getElementById('lblBkCancelledCount').textContent = (data.cancelled_count || 0);
                if (document.getElementById('lblBkTentativeCount')) document.getElementById('lblBkTentativeCount').textContent = (data.tentative_count || 0);
                const tbody = document.getElementById('tblBkBody') || document.getElementById('tblWebBookingsList');
                tbody.innerHTML = '';

                // Reset selection
                clearWebBookingsSelection();

                if (!data.items || data.items.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="14" class="p-8 text-center text-slate-400">Không tìm thấy đơn tiệc nào phù hợp bộ lọc.</td></tr>';
                    return;
                }

                data.items.forEach(b => {
                    let statusBadge = '<span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-100 text-slate-700">Khác</span>';
                    if (b.status_code === 'D') statusBadge = '<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-700">Đã chốt (Definite)</span>';
                    else if (b.status_code === 'T') statusBadge = '<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-700">Giữ chỗ (Tentative)</span>';
                    else if (b.status_code === 'C') statusBadge = '<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-rose-100 text-rose-700">Đã hủy (Cancelled)</span>';

                    const tr = document.createElement('tr');
                    tr.className = 'hover:bg-slate-50 transition border-b border-slate-100';
                    tr.innerHTML = `
                        <!-- 0. CHỌN DÒNG -->
                        <td class="px-2.5 py-2 text-center whitespace-nowrap">
                            <input type="checkbox" class="chk-web-booking w-4 h-4 text-blue-600 rounded border-slate-300 focus:ring-blue-500 cursor-pointer" value="${b.book_id}" onchange="updateWebBookingsSelectedUI()" />
                        </td>
                        <!-- 1. MÃ BOOKING -->
                        <td class="px-2.5 py-2 font-mono font-bold whitespace-nowrap">
                            <button type="button" onclick="openBookingDetailModal('${b.book_id}')" class="text-blue-600 hover:text-blue-800 hover:underline flex items-center gap-1.5 font-bold group text-left cursor-pointer">
                                <span>${b.book_id}</span>
                                <svg class="w-3.5 h-3.5 opacity-60 group-hover:opacity-100 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                            </button>
                        </td>
                        <!-- 2. NGÀY TIỆC -->
                        <td class="px-2.5 py-2 whitespace-nowrap">
                            <div class="font-bold text-slate-800">${b.event_date || '-'}</div>
                            ${b.time_in ? `<div class="text-[10px] font-mono text-slate-500">${b.time_in} - ${b.time_out}</div>` : ''}
                        </td>
                        <!-- 3. NGÀY ĐẶT -->
                        <td class="px-2.5 py-2 font-mono text-slate-600 whitespace-nowrap text-[11px]">${b.booking_date || '-'}</td>
                        <!-- 4. KHÁCH HÀNG / LÝ DO HỦY TIỆC -->
                        ${b.status_code === 'C' ? `
                        <td class="px-2.5 py-2 min-w-[200px] max-w-[260px]">
                            <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200/90 shadow-2xs group cursor-default" title="Lý do hủy: ${formatCancelReason(b.note).replace(/"/g, '&quot;')}">
                                <i data-lucide="alert-circle" class="w-3.5 h-3.5 text-rose-500 shrink-0"></i>
                                <span class="truncate">${formatCancelReason(b.note)}</span>
                            </div>
                            <div class="text-[10px] text-slate-500 truncate mt-0.5">${b.guest_name || b.title || 'Đơn tiệc đã hủy'}</div>
                        </td>
                        ` : `
                        <td class="px-2.5 py-2 min-w-[170px] max-w-[210px]">
                            <div class="font-bold text-slate-800 leading-snug">${b.guest_name || b.title || 'Khách Đặt Tiệc'}</div>
                            <div class="text-[10px] text-slate-500 truncate">${b.phone ? 'SĐT: ' + b.phone : ''}${b.title && b.title !== b.guest_name ? ' • ' + b.title : ''}</div>
                        </td>
                        `}
                        <!-- 5. SẢNH TIỆC (Co nhỏ, tự xuống dòng khi nhiều sảnh) -->
                        <td class="px-2.5 py-2 font-bold text-slate-700 max-w-[110px] break-words whitespace-normal text-[11px] leading-tight">${b.room || '-'}</td>
                        <!-- 6. PHÂN KHÚC (Co nhỏ, tự ngắt dòng trường dài) -->
                        <td class="px-2.5 py-2 text-slate-600 max-w-[130px] break-words whitespace-normal text-[11px] leading-tight">${b.segment || '-'}</td>
                        <!-- 7. NGƯỜI LÀM BEO -->
                        <td class="px-2.5 py-2 max-w-[115px]">
                            <div class="font-bold text-blue-800 text-[11px] truncate">${b.sales_user || '-'}</div>
                            ${(b.beo_user && b.lock_user && b.beo_user !== b.lock_user) 
                                ? `<span class="inline-block text-[9px] font-semibold bg-amber-50 text-amber-700 border border-amber-200 px-1 py-0.2 rounded mt-0.5">BEO (Lock: ${b.lock_user})</span>` 
                                : (b.beo_user 
                                    ? '<span class="text-[9px] bg-blue-100 text-blue-700 px-1.5 py-0.5 rounded ml-1 font-bold">BEO</span>' 
                                    : '<span class="text-[9px] text-slate-400 font-normal ml-1">(Lock)</span>')}
                        </td>
                        <!-- 8. TRẠNG THÁI -->
                        <td class="px-2.5 py-2 text-center whitespace-nowrap">${statusBadge}</td>
                        <!-- 9. KHÁCH -->
                        <td class="px-2.5 py-2 text-right font-semibold whitespace-nowrap text-[11px]">${Number(b.pax || 0).toLocaleString('vi-VN')}</td>
                        <!-- 10. CỌC (VNĐ) -->
                        <td class="px-2.5 py-2 text-right text-slate-600 whitespace-nowrap text-[11px]">${formatVND(b.deposit)}</td>
                        <!-- 11. DT TIỆC -->
                        <td class="px-2.5 py-2 text-right font-mono font-bold text-emerald-700 whitespace-nowrap text-[11px]">${formatVND(b.banquet_revenue !== undefined ? b.banquet_revenue : b.revenue)}</td>
                        <!-- 12. TỔNG DT -->
                        <td class="px-2.5 py-2 text-right font-mono font-black text-slate-900 whitespace-nowrap text-[11px]">${formatVND(b.total_revenue !== undefined ? b.total_revenue : b.revenue)}</td>
                        <!-- 13. THAO TÁC -->
                        <td class="px-2.5 py-2 text-center whitespace-nowrap pr-3">
                            <div class="flex items-center justify-center gap-1">
                                <button onclick="openEditBookingModal('${b.book_id}')" class="px-2 py-1 bg-slate-100 hover:bg-blue-600 hover:text-white text-slate-700 rounded text-xs font-semibold transition cursor-pointer">
                                    Sửa
                                </button>
                                <button onclick="openBeoForBooking('${b.book_id}')" class="px-2 py-1 bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white rounded text-xs font-semibold transition cursor-pointer">
                                    BEO
                                </button>
                            </div>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });
                lucide.createIcons();
                setTimeout(initStickyTableScrollWeb, 150);
            } catch (err) {
                console.error("Error loading bookings list:", err);
            }
        }

        // XUẤT DANH SÁCH ĐƠN TIỆC RA FILE EXCEL (.XLSX) - HỖ TRỢ XUẤT CÁC ĐƠN ĐÃ CHECK CHỌN CỤ THỂ
        function exportWebBookingsToExcel(forceOnlySelected = false) {
            try {
                const checkedBoxes = Array.from(document.querySelectorAll('.chk-web-booking:checked'));
                const hasSelected = checkedBoxes.length > 0;

                const p = new URLSearchParams();

                if (forceOnlySelected || hasSelected) {
                    // Xuất danh sách các đơn đã tick chọn cụ thể
                    const bookIds = checkedBoxes.map(cb => cb.value.trim()).filter(id => id);
                    if (bookIds.length === 0) {
                        alert('Vui lòng tick chọn ít nhất một đơn tiệc trong bảng để xuất!');
                        return;
                    }
                    p.append('book_ids', bookIds.join(','));
                } else {
                    // Xuất theo toàn bộ bộ lọc hiện tại
                    const dType = document.getElementById('selBkDateType') ? document.getElementById('selBkDateType').value : 'event';
                    const dFrom = document.getElementById('txtBkDateFrom') ? document.getElementById('txtBkDateFrom').value : '';
                    const dTo = document.getElementById('txtBkDateTo') ? document.getElementById('txtBkDateTo').value : '';
                    const r = document.getElementById('selBkFilterRoom') ? document.getElementById('selBkFilterRoom').value : 'ALL';
                    const st = getEffectiveWebStatusFilter();
                    const sl = document.getElementById('selBkFilterSales') ? document.getElementById('selBkFilterSales').value : 'ALL';
                    const q = document.getElementById('txtBkSearch') ? document.getElementById('txtBkSearch').value.trim() : '';

                    p.append('date_type', dType);
                    if (dFrom) p.append('from_date', dFrom);
                    if (dTo) p.append('to_date', dTo);
                    if (r && r !== 'ALL') p.append('room', r);
                    if (st && st !== 'ALL') p.append('status', st);
                    if (sl && sl !== 'ALL') p.append('sales_user', sl);
                    if (q) p.append('search', q);
                }

                const exportUrl = '/api/bookings/export?' + p.toString();
                window.open(exportUrl, '_blank');
            } catch (err) {
                console.error("Lỗi xuất Excel:", err);
                alert('Không thể xuất file Excel: ' + (err.message || err));
            }
        }

                // -------------------------------------------------------------
        // BEO LOGIC & AUTHENTIC MERPERLE STANDARD PRINT ENGINE
        // -------------------------------------------------------------
        let currentBeoData = null;
        let beoBookingsList = [];

        function autoResizeTextarea(el) {
            if (!el) return;
            el.style.height = 'auto';
            el.style.height = Math.max(96, el.scrollHeight + 4) + 'px';
        }

        async function loadBeoBookingsList(forceReload = false) {
            try {
                const badge = document.getElementById('beoBookingsCountBadge');
                if (badge) badge.textContent = 'Đang tải tiệc...';
                const res = await fetch('/api/beo/bookings-list');
                if (!res.ok) return;
                beoBookingsList = await res.json();
                if (badge) badge.textContent = `${beoBookingsList.length} đơn tiệc sẵn sàng`;

                const sel = document.getElementById('cboBeoBookingSelect');
                if (sel) {
                    sel.innerHTML = '<option value="">-- Bấm chọn tiệc để nạp BEO (Đã chốt & Giữ chỗ) --</option>';
                    beoBookingsList.forEach(b => {
                        const opt = document.createElement('option');
                        opt.value = b.book_id;
                        const stTag = b.status === 'D' ? '[ĐÃ CHỐT]' : '[GIỮ CHỖ]';
                        const eoTag = b.master_eo ? `(#EO:${b.master_eo})` : '[Chưa có BEO]';
                        const paxTag = b.pax ? `${b.pax} Khách` : '';
                        const fType = b.function_type ? `[${b.function_type}]` : '';
                        opt.textContent = `${stTag} ${b.event_date} - ${b.title} (${b.book_id}) ${paxTag} ${fType} ${eoTag}`;
                        sel.appendChild(opt);
                    });
                }

                // Auto-load first booking if no booking is currently loaded or forceReload
                const currentId = document.getElementById('beoBookId').value.trim();
                if (!currentId && beoBookingsList.length > 0) {
                    const firstBk = beoBookingsList[0].book_id;
                    document.getElementById('beoBookId').value = firstBk;
                    if (sel) sel.value = firstBk;
                    const qInp = document.getElementById('beoQuickSearchInput');
                    if (qInp) qInp.value = firstBk;
                    await loadBeoData(firstBk);
                } else if (currentId && sel) {
                    sel.value = currentId;
                }
            } catch (err) {
                console.error("loadBeoBookingsList error:", err);
            }
        }

        
        // =========================================================================
        // CỬA SỔ TÌM KIẾM & NẠP LỆNH BEO (MODAL SEARCH & LOAD BEO)
        // =========================================================================
        beoBookingsList = beoBookingsList || [];

        async function loadBeoBookingsList() {
            try {
                const res = await fetch('/api/beo/bookings-list');
                if (res.ok) {
                    beoBookingsList = await res.json();
                }
            } catch (err) {
                console.error("loadBeoBookingsList error:", err);
            }
        }

        async function openSearchBeoModal() {
            document.getElementById('modalSearchLoadBeo').classList.remove('hidden');

            // Nạp sảnh vào dropdown nếu chưa có
            const selRoom = document.getElementById('modalBeoSearchRoom');
            if (selRoom && selRoom.options.length <= 1 && typeof masterRooms !== 'undefined' && masterRooms.length > 0) {
                masterRooms.forEach(r => {
                    const opt = document.createElement('option');
                    opt.value = r.code;
                    opt.textContent = `${r.name} (${r.floor || ''})`;
                    selRoom.appendChild(opt);
                });
            }

            // Đảm bảo có dữ liệu
            if (!beoBookingsList || beoBookingsList.length === 0) {
                const tbody = document.getElementById('tblModalBeoListBody');
                if (tbody) tbody.innerHTML = '<tr><td colspan="8" class="p-8 text-center text-slate-400"><i class="lucide-loader-2 animate-spin w-5 h-5 inline-block mr-1"></i> Đang tải dữ liệu đơn tiệc...</td></tr>';
                await loadBeoBookingsList();
            }

            // Hiển thị danh sách tiệc vào bảng
            filterBeoModalTable();

            // Focus vào ô tìm kiếm
            setTimeout(() => {
                const inp = document.getElementById('modalBeoSearchText');
                if (inp) inp.focus();
                lucide.createIcons();
            }, 100);
        }

        let currentBeoModalStatus = 'ALL';

        function setBeoModalStatusFilter(status) {
            currentBeoModalStatus = status;
            
            // Cập nhật giao diện nút
            const btnAll = document.getElementById('btnBeoFilterStatusAll');
            const btnD = document.getElementById('btnBeoFilterStatusD');
            const btnT = document.getElementById('btnBeoFilterStatusT');
            
            const activeClass = ['bg-white', 'text-blue-700', 'shadow-sm'];
            const inactiveClass = ['text-slate-600', 'hover:text-slate-900'];

            [btnAll, btnD, btnT].forEach(b => {
                if (b) {
                    b.classList.remove(...activeClass);
                    b.classList.add(...inactiveClass);
                }
            });

            if (status === 'ALL' && btnAll) {
                btnAll.classList.remove(...inactiveClass);
                btnAll.classList.add(...activeClass);
            } else if (status === 'D' && btnD) {
                btnD.classList.remove(...inactiveClass);
                btnD.classList.add('bg-white', 'text-emerald-700', 'shadow-sm');
            } else if (status === 'T' && btnT) {
                btnT.classList.remove(...inactiveClass);
                btnT.classList.add('bg-white', 'text-amber-700', 'shadow-sm');
            }

            filterBeoModalTable();
        }

        function normalizeBeoStr(s) {
            return (s || '').toString().normalize("NFD").replace(/[̀-ͯ]/g, "").replace(/đ/g, "d").replace(/Đ/g, "D").trim().toUpperCase();
        }

        function filterBeoModalTable() {
            const rawTxt = (document.getElementById('modalBeoSearchText') ? document.getElementById('modalBeoSearchText').value : '').trim();
            const txt = normalizeBeoStr(rawTxt);
            const date = document.getElementById('modalBeoSearchDate') ? document.getElementById('modalBeoSearchDate').value : '';
            const room = document.getElementById('modalBeoSearchRoom') ? document.getElementById('modalBeoSearchRoom').value : 'ALL';

            // Cập nhật số lượng đếm trên các nút trạng thái
            const allItems = beoBookingsList || [];
            const cntAll = allItems.length;
            const cntD = allItems.filter(b => b.status === 'D').length;
            const cntT = allItems.filter(b => b.status !== 'D').length;

            const elAll = document.getElementById('cntBeoStatusAll');
            const elD = document.getElementById('cntBeoStatusD');
            const elT = document.getElementById('cntBeoStatusT');
            if (elAll) elAll.textContent = cntAll.toLocaleString('vi-VN');
            if (elD) elD.textContent = cntD.toLocaleString('vi-VN');
            if (elT) elT.textContent = cntT.toLocaleString('vi-VN');

            const filtered = allItems.filter(b => {
                // Lọc theo nút trạng thái Đã Chốt / Chưa Chốt
                if (currentBeoModalStatus === 'D' && b.status !== 'D') return false;
                if (currentBeoModalStatus === 'T' && b.status === 'D') return false;

                // Lọc theo ngày
                if (date && b.event_date !== date) return false;

                // Lọc theo sảnh
                if (room && room !== 'ALL' && b.room_code !== room && b.room !== room) return false;

                // Lọc theo từ khóa: Khớp Tên Booking, Khách hàng, Tên Sale, Mã Sale, Mã ID, SĐT, Số Lệnh EO
                if (txt) {
                    const bId = normalizeBeoStr(b.book_id);
                    const bTitle = normalizeBeoStr(b.title);
                    const bGuest = normalizeBeoStr(b.guest_name);
                    const bPhone = normalizeBeoStr(b.phone);
                    const bEo = normalizeBeoStr(b.master_eo);
                    const bSaleUser = normalizeBeoStr(b.sales_user);
                    const bSaleName = normalizeBeoStr(b.sales_name);
                    const bRoom = normalizeBeoStr(b.room);
                    if (!bId.includes(txt) && !bTitle.includes(txt) && !bGuest.includes(txt) && 
                        !bPhone.includes(txt) && !bEo.includes(txt) && !bSaleUser.includes(txt) && 
                        !bSaleName.includes(txt) && !bRoom.includes(txt)) {
                        return false;
                    }
                }
                return true;
            });

            renderBeoModalTable(filtered);
        }

        function resetBeoModalFilters() {
            if (document.getElementById('modalBeoSearchText')) document.getElementById('modalBeoSearchText').value = '';
            if (document.getElementById('modalBeoSearchDate')) document.getElementById('modalBeoSearchDate').value = '';
            if (document.getElementById('modalBeoSearchRoom')) document.getElementById('modalBeoSearchRoom').value = 'ALL';
            setBeoModalStatusFilter('ALL');
        }

        function renderBeoModalTable(list) {
            const tbody = document.getElementById('tblModalBeoListBody');
            const countEl = document.getElementById('modalBeoResultCount');
            if (!tbody) return;

            if (countEl) {
                countEl.innerHTML = `Tìm thấy <strong class="text-blue-700">${list.length.toLocaleString('vi-VN')}</strong> đơn tiệc phù hợp`;
            }

            if (list.length === 0) {
                tbody.innerHTML = '<tr><td colspan="8" class="p-8 text-center text-slate-400">Không tìm thấy đơn tiệc nào phù hợp với bộ lọc tìm kiếm.</td></tr>';
                return;
            }

            let html = '';
            list.forEach(b => {
                const stBadge = b.status === 'D' 
                    ? '<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-300">ĐÃ CHỐT</span>' 
                    : '<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-800 border border-amber-300">GIỮ CHỖ</span>';

                const eoBadge = b.master_eo 
                    ? `<span class="text-blue-700 font-mono font-bold text-[11px] bg-blue-50 px-1.5 py-0.5 rounded border border-blue-200">#${b.master_eo}</span>` 
                    : '<span class="text-slate-400 text-[10px] italic">Chưa có EO</span>';

                const timeStr = (b.time_in && b.time_out) ? `<span class="text-[10px] text-slate-500 font-mono block">${b.time_in} - ${b.time_out}</span>` : '';
                const guestStr = b.phone ? `<span class="text-[10px] text-slate-500 block">SĐT: ${b.phone}</span>` : '';
                
                const saleDisplay = (b.sales_name || b.sales_user) 
                    ? `<span class="inline-flex items-center gap-1 text-[10px] font-bold text-indigo-700 bg-indigo-50 px-1.5 py-0.5 rounded border border-indigo-200 mt-0.5" title="Nhân viên Sale phụ trách">
                        <i data-lucide="user" class="w-3 h-3 text-indigo-600"></i> ${b.sales_user ? b.sales_user + ' - ' : ''}${b.sales_name || ''}
                       </span>` 
                    : '';

                html += `
                    <tr class="hover:bg-blue-50/60 cursor-pointer transition border-b border-slate-100 group" 
                        ondblclick="selectBeoFromModal('${b.book_id}')" title="Nhấp đúp chuột để nạp BEO ngay">
                        <td class="p-2.5 font-bold text-slate-800 whitespace-nowrap">
                            ${b.event_date || '-'}
                            ${timeStr}
                        </td>
                        <td class="p-2.5 font-bold text-slate-800 whitespace-nowrap">
                            <span class="px-2 py-1 rounded bg-slate-100 text-slate-700 font-bold border border-slate-200">${b.room || '-'}</span>
                        </td>
                        <td class="p-2.5 min-w-[220px]">
                            <div class="font-bold text-slate-900 group-hover:text-blue-700 transition">${b.title || b.guest_name || 'Khách đặt tiệc'}</div>
                            <div class="flex flex-wrap items-center gap-1.5 mt-0.5">
                                ${guestStr}
                                ${saleDisplay}
                            </div>
                        </td>
                        <td class="p-2.5 text-center font-bold text-slate-700 whitespace-nowrap">${b.pax ? Number(b.pax).toLocaleString('vi-VN') : '-'}</td>
                        <td class="p-2.5 text-center whitespace-nowrap">${stBadge}</td>
                        <td class="p-2.5 text-center whitespace-nowrap">${eoBadge}</td>
                        <td class="p-2.5 text-center font-mono font-bold text-slate-600 whitespace-nowrap">${b.book_id}</td>
                        <td class="p-2.5 text-center whitespace-nowrap">
                            <button type="button" onclick="selectBeoFromModal('${b.book_id}')" 
                                    class="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-bold transition flex items-center gap-1 shadow-sm mx-auto cursor-pointer">
                                <i data-lucide="check" class="w-3.5 h-3.5"></i>
                                <span>Chọn Nạp BEO</span>
                            </button>
                        </td>
                    </tr>
                `;
            });

            tbody.innerHTML = html;
            lucide.createIcons();
        }

        async function selectBeoFromModal(bookId) {
            if (!bookId) return;
            // Cập nhật ngay tức thì trên thanh top bar từ danh sách đã nạp
            const item = (beoBookingsList || []).find(b => b.book_id === bookId);
            if (item) {
                updateBeoCurrentDisplay(item);
            }
            closeModal('modalSearchLoadBeo');
            document.getElementById('beoBookId').value = bookId;
            await loadBeoData(bookId);
            notifyBeoLoaded(bookId);
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        async function openBeoForBooking(bookId) {
            navTo('beo');
            document.getElementById('beoBookId').value = bookId;
            closeModal('modalSearchLoadBeo');
            await loadBeoData(bookId);
            notifyBeoLoaded(bookId);
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        async function loadBeoByInput() {
            const bookId = document.getElementById('beoBookId').value.trim();
            if (bookId) {
                await loadBeoData(bookId);
                notifyBeoLoaded(bookId);
            }
        }

        function notifyBeoLoaded(bookId) {
            const noti = document.getElementById('beoStatusNotification');
            const notiText = document.getElementById('beoStatusNotificationText');
            if (noti && notiText) {
                notiText.textContent = `Đã nạp thành công BEO: ${bookId}`;
                noti.classList.remove('hidden');
                noti.classList.add('flex');
                
                if (window.beoNotiTimer) clearTimeout(window.beoNotiTimer);
                window.beoNotiTimer = setTimeout(() => {
                    noti.classList.add('hidden');
                    noti.classList.remove('flex');
                }, 4000);
            }
        }

        function updateBeoCurrentDisplay(b) {
            const titleEl = document.getElementById('beoCurrentBookingTitle');
            const idEl = document.getElementById('beoCurrentBookingId');
            const extraEl = document.getElementById('beoCurrentBookingExtra');
            if (titleEl && b) {
                titleEl.textContent = (b.customer && b.customer.name) || b.title || b.display_title || 'Đơn Tiệc';
                if (idEl) idEl.textContent = b.book_id || '';
                if (extraEl) {
                    const rName = (b.room_booking && b.room_booking.room) || 
                                  (b.room_schedules && b.room_schedules[0] && b.room_schedules[0].room) || 
                                  b.room || '';
                    const rDate = (b.room_booking && b.room_booking.event_date) || b.event_date || '';
                    const sName = b.sales_name || b.sales_user || (b.prepared_by_name || b.prepared_by) || '';
                    extraEl.textContent = `• Ngày: ${rDate || '-'} • Sảnh: ${rName || '-'} ${sName ? '• Sale: ' + sName : ''}`;
                }
            }
        }

        

        // =========================================================================
        // MẪU IN BEO SỰ KIỆN TỪNG BUỔI (CHUẨN CSV MỚI - SESSION GRID BEO)
        // =========================================================================
                // MẪU IN BEO SỰ KIỆN TỪNG BUỔI (CHUẨN CSV MỚI - SESSION GRID BEO)
        // =========================================================================
        function renderSessionGridBEO(b) {
            const printArea = document.getElementById('beoPrintArea');
            const dNotes = b.department_notes || {};

            // Helper format ngày DD.MM.YYYY
            const formatDateDMY = (dateStr) => {
                if (!dateStr) return '';
                const parts = dateStr.split('-');
                if (parts.length === 3) {
                    return `${parts[2]}.${parts[1]}.${parts[0]}`;
                }
                return dateStr;
            };

            // Helper format ghi chú tự động xuống hàng sau mỗi dấu '-' hoặc '*'
            function formatBulletNotes(text) {
                if (!text) return '-';
                let str = String(text).trim();
                str = str.replace(/([^\n\r])\s+-\s+/g, '$1\n- ');
                str = str.replace(/([^\n\r])\s+\*\s+/g, '$1\n* ');
                return str;
            }

            // 1. Trích xuất Đặt cọc lần 1, lần 2 và còn lại
            let deposit1 = 0;
            let deposit2 = 0;
            const pNotes = b.payment_notes || '';
            const m1 = pNotes.match(/(?:lần|đợt|thanh toán|cọc)\s*1\s*[:\-\s]+([0-9\.,]+)/i);
            const m2 = pNotes.match(/(?:lần|đợt|thanh toán|cọc)\s*2\s*[:\-\s]+([0-9\.,]+)/i);

            if (m1 && m2) {
                deposit1 = parseFloat(m1[1].replace(/[\.,]/g, '')) || 0;
                deposit2 = parseFloat(m2[1].replace(/[\.,]/g, '')) || 0;
            } else if (m1 && !m2) {
                deposit1 = parseFloat(m1[1].replace(/[\.,]/g, '')) || 0;
                deposit2 = 0;
            } else {
                deposit1 = parseFloat(b.deposit) || 0;
                deposit2 = 0;
            }

            const totalAmt = parseFloat(b.total_charges) || 0;
            const remainAmt = totalAmt - deposit1 - deposit2;

            // 2. Schedules & helper bóc tách Menu thông minh theo từng ca
            const schedules = (b.room_schedules && b.room_schedules.length > 0) 
                ? b.room_schedules 
                : [{ date: b.event_date, time_in: '08:00', time_out: '22:00', room: 'Sảnh Chính', function_type: b.event_type, pax: b.gua_pax }];

            function extractMenuForSession(menuText, functionType, sessionIdx, totalSessions) {
                if (!menuText) return 'Chi tiết thực đơn đính kèm hợp đồng';
                if (totalSessions <= 1) return formatBulletNotes(menuText);

                if (sessionIdx > 0) {
                    const prevS = schedules[sessionIdx - 1];
                    const currS = schedules[sessionIdx];
                    if (prevS && currS && prevS.function_type === currS.function_type && prevS.time_in === currS.time_in) {
                        return `Thực đơn áp dụng như ${prevS.room || 'sảnh trước'}`;
                    }
                }

                const fn = (functionType || '').toLowerCase();
                const rawParts = menuText.split(/(?=(?:^|\n)\s*(?:MENU MẶN - TRƯA|CƠM TRƯA|ĂN TRƯA|THỰC ĐƠN ĂN TRƯA|LUNCH|TEA-BREAK|TEABREAK|MENU TEABREAK|MENU MẶN - TỐI|TIỆC TỐI|ĂN TỐI|THỰC ĐƠN ĂN TỐI|DINNER|GALA)[\s\:\-])/i);
                const parts = rawParts.map(p => p.trim()).filter(p => p.length > 0);

                if (fn.includes('meeting') || fn.includes('hội nghị') || fn.includes('họp')) {
                    const tea = parts.find(p => /tea|break|giải lao/i.test(p));
                    if (tea) return formatBulletNotes(tea);
                    return 'Nước suối, trà, kẹo theo tiêu chuẩn phòng họp';
                }
                if (fn.includes('dinner') || fn.includes('tối') || fn.includes('gala')) {
                    const dinnerParts = parts.filter(p => /tối|dinner|gala|chay/i.test(p));
                    if (dinnerParts.length > 0) return formatBulletNotes(dinnerParts.join('\n\n'));
                }
                if (fn.includes('lunch') || fn.includes('trưa')) {
                    const lunch = parts.find(p => /trưa|lunch/i.test(p));
                    if (lunch) return formatBulletNotes(lunch);
                    return 'Chi tiết thực đơn ăn trưa đính kèm hợp đồng';
                }
                if (fn.includes('dinner') || fn.includes('tối') || fn.includes('gala')) {
                    const dinnerParts = parts.filter(p => /tối|dinner|gala|chay/i.test(p));
                    if (dinnerParts.length > 0) return formatBulletNotes(dinnerParts.join('\n\n'));
                    return 'Chi tiết thực đơn ăn tối đính kèm hợp đồng';
                }
                return (sessionIdx < parts.length) ? formatBulletNotes(parts[sessionIdx]) : formatBulletNotes(menuText);
            }

            // 3. Header Trang 1 (GÓC PHẢI CỐ ĐỊNH 100% LÀ BANQUET EVENT ORDER)
            function renderHeaderPage1Html() {
                return `
                    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1.5px solid #111; padding-bottom: 4px; margin-bottom: 5px;">
                        <div style="width: 48%; display: flex; align-items: center; gap: 8px;">
                            <img src="data:image/png;base64," style="height: 48px; width: auto; object-fit: contain;" alt="Logo MerPerle" />
                            <div>
                                <h2 style="margin: 0; font-size: 18.5px; font-weight: bold; color: #002060; font-family: 'Times New Roman', Times, serif; white-space: nowrap; line-height: 1.15;">MerPerle DaLat Hotel</h2>
                                <div style="font-size: 11px; color: #475569; font-style: italic;">Banquet Event Order</div>
                            </div>
                        </div>
                        <div style="width: 50%; text-align: right;">
                            <h1 style="margin: 0; font-size: 19px; font-weight: bold; color: #111; letter-spacing: 0.8px; font-family: 'Times New Roman', Times, serif; line-height: 1.15;">BANQUET EVENT ORDER</h1>
                            <div style="font-size: 12px; color: #444; margin-top: 1px;">
                                <span>Số E.O: <b>${b.master_eo || 'TỰ ĐỘNG'}</b></span>
                                <span style="margin-left: 10px;">Ngày lập: <b>${b.order_date || ''}</b></span>
                            </div>
                            <div style="font-size: 11.5px; color: #b91c1c; font-weight: bold; margin-top: 1px;">
                                Điều chỉnh: <span>${b.amendment || '-'}</span>
                            </div>
                        </div>
                    </div>
                `;
            }

            // 4. Header các trang tiếp theo (Chuẩn nhận diện gọn gàng)
            function renderSubHeaderHtml(pageNo, totalPages) {
                return `
                    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1.5px solid #111; padding-bottom: 3px; margin-bottom: 5px; font-family: 'Times New Roman', Times, serif;">
                        <div style="font-size: 13px; font-weight: bold; color: #002060;">
                            MerPerle DaLat Hotel <span style="color: #475569; font-weight: normal; font-size: 12px;">| BANQUET EVENT ORDER (Trang ${pageNo}/${totalPages})</span>
                        </div>
                        <div style="font-size: 12px; color: #222;">
                            <span>Số E.O: <b>${b.master_eo || ''}</b></span>
                            <span style="margin-left: 10px;">Ngày lập: <b>${b.order_date || ''}</b></span>
                            ${b.amendment && b.amendment !== '-' ? `<span style="color: #b91c1c; margin-left: 10px;">(ĐC: ${b.amendment})</span>` : ''}
                        </div>
                    </div>
                `;
            }

                                    // 5. Bảng Khách Hàng (ĐỘNG CƠ DÀN TRANG THÍCH ỨNG TỰ ĐỘNG - ADAPTIVE DYNAMIC)
            const formatNumber = (val) => new Intl.NumberFormat('vi-VN').format(val || 0);
            const eventNameText = b.eo_title || b.clean_event_name || b.event_name || b.event_type || '-';
            const hasVAT = Boolean((b.tax_code && b.tax_code.trim()) || (b.bill_address && b.bill_address.trim()) || (b.bill_to && b.bill_to.trim() && b.bill_to.trim().toLowerCase() !== (b.company || '').trim().toLowerCase()));
            const billInfoHtml = hasVAT ? `
                <div style="font-weight: bold; text-transform: uppercase;">${b.bill_to || b.company || b.customer_name || '-'}</div>
                ${b.tax_code ? `<div style="margin-top: 1px;">Mã số thuế: <b style="color: #000;">${b.tax_code}</b></div>` : ''}
                ${b.bill_address ? `<div style="margin-top: 1px;">Địa chỉ: ${b.bill_address}</div>` : (b.address && b.tax_code ? `<div style="margin-top: 1px;">Địa chỉ: ${b.address}</div>` : '')}
            ` : `
                <div style="font-weight: bold; text-transform: uppercase;">${b.company || b.customer_name || '-'}</div>
                <div style="font-size: 11px; color: #555; font-style: italic; margin-top: 1px;">(NGƯỜI MUA KHÔNG LẤY HÓA ĐƠN VAT)</div>
            `;

            function getCustomerTableHtml(padY = 4, padX = 6, lineH = 1.35, mb = 8, fs = 12.5) {
                return `
                <table style="width: 100%; table-layout: fixed; border-collapse: collapse; border: 1.5px solid #111; font-size: ${fs}px; font-family: 'Times New Roman', Times, serif; margin-bottom: ${mb}px; line-height: ${lineH};">
                    <tr>
                        <td style="width: 170px; font-weight: bold; padding: ${padY}px ${padX}px; border: 1px solid #111; background-color: #f8fafc;">COMPANY</td>
                        <td style="padding: ${padY}px ${padX}px; border: 1px solid #111; font-weight: bold; text-transform: uppercase;">${b.company || b.customer_name}</td>
                    </tr>
                    <tr>
                        <td style="font-weight: bold; padding: ${padY}px ${padX}px; border: 1px solid #111; background-color: #f8fafc;">TÊN TIỆC / SỰ KIỆN</td>
                        <td style="padding: ${padY}px ${padX}px; border: 1px solid #111; font-weight: bold; color: #002060; text-transform: uppercase; font-size: ${fs + 0.5}px;">${eventNameText}</td>
                    </tr>
                    <tr>
                        <td style="font-weight: bold; padding: ${padY}px ${padX}px; border: 1px solid #111; background-color: #f8fafc;">NGƯỜI LIÊN HỆ</td>
                        <td style="padding: ${padY}px ${padX}px; border: 1px solid #111; font-weight: bold;">${b.contact_person || '-'}</td>
                    </tr>
                    <tr>
                        <td style="font-weight: bold; padding: ${padY}px ${padX}px; border: 1px solid #111; background-color: #f8fafc;">ĐỊA CHỈ</td>
                        <td style="padding: ${padY}px ${padX}px; border: 1px solid #111;">${b.address || '-'}</td>
                    </tr>
                    <tr>
                        <td style="font-weight: bold; padding: ${padY}px ${padX}px; border: 1px solid #111; background-color: #f8fafc;">ĐIỆN THOẠI</td>
                        <td style="padding: ${padY}px ${padX}px; border: 1px solid #111;">${b.phone || '-'} ${b.office_phone ? ' • ĐT VP: ' + b.office_phone : ''}</td>
                    </tr>
                    <tr>
                        <td style="font-weight: bold; padding: ${padY}px ${padX}px; border: 1px solid #111; background-color: #f8fafc;">NGƯỜI DÙNG CUỐI</td>
                        <td style="padding: ${padY}px ${padX}px; border: 1px solid #111; font-weight: bold;">${b.end_user || b.company || '-'}</td>
                    </tr>
                    <tr>
                        <td style="font-weight: bold; padding: ${padY}px ${padX}px; border: 1px solid #111; background-color: #f8fafc; vertical-align: top;">THÔNG TIN XUẤT HÓA ĐƠN</td>
                        <td style="padding: ${padY}px ${padX}px; border: 1px solid #111;">${billInfoHtml}</td>
                    </tr>
                    <tr>
                        <td style="font-weight: bold; padding: ${padY}px ${padX}px; border: 1px solid #111; background-color: #f8fafc;">MÃ ĐẶT PHÒNG/BOOKING</td>
                        <td style="padding: ${padY}px ${padX}px; border: 1px solid #111; font-family: monospace; font-weight: bold; color: #002060;">${b.book_code || b.book_id}</td>
                    </tr>
                    <tr>
                        <td style="font-weight: bold; padding: ${padY}px ${padX}px; border: 1px solid #111; background-color: #f8fafc;">Sales phụ trách</td>
                        <td style="padding: ${padY}px ${padX}px; border: 1px solid #111; font-weight: bold;">${b.prepared_by_name || '-'}</td>
                    </tr>
                    <tr>
                        <td style="font-weight: bold; padding: ${padY}px ${padX}px; border: 1px solid #111; background-color: #f8fafc;">Sales onsite</td>
                        <td style="padding: ${padY}px ${padX}px; border: 1px solid #111;">${b.endorsed_by_name || '-'}</td>
                    </tr>
                    <tr>
                        <td style="font-weight: bold; padding: ${padY}px ${padX}px; border: 1px solid #111; background-color: #f8fafc;">Ghi chú</td>
                        <td style="padding: ${padY}px ${padX}px; border: 1px solid #111; font-style: italic; font-size: ${fs - 1}px;">${b.charge_notes || b.remark || 'Prices are in VND and inclusive VAT and service charge.'}</td>
                    </tr>
                </table>
                `;
            }

            // 6. Bảng Lịch Trình (# Shift)
            let scheduleRowsHtml = '';
            schedules.forEach((rs, idx) => {
                const timeStr = `${rs.time_in ? rs.time_in.substring(0, 5) : ''} - ${rs.time_out ? rs.time_out.substring(0, 5) : ''}`;
                scheduleRowsHtml += `
                    <tr style="text-align: center;">
                        <td style="padding: 3px 5px; border: 1px solid #111; font-weight: bold; color: #b91c1c;">Shift ${idx + 1}</td>
                        <td style="padding: 3px 5px; border: 1px solid #111;">${timeStr}</td>
                        <td style="padding: 3px 5px; border: 1px solid #111; font-weight: bold; text-transform: uppercase;">${rs.room || 'Sảnh'}</td>
                        <td style="padding: 3px 5px; border: 1px solid #111;">${rs.function_type || b.event_type || 'Tiệc'}</td>
                        <td style="padding: 3px 5px; border: 1px solid #111; font-weight: bold;">${rs.pax || b.gua_pax || '-'}</td>
                    </tr>
                `;
            });

            function getScheduleTableHtml(padY = 3, padX = 5, mb = 8, fs = 12.5) {
                return `
                <table style="width: 100%; table-layout: fixed; border-collapse: collapse; border: 1.5px solid #111; font-size: ${fs}px; font-family: 'Times New Roman', Times, serif; margin-bottom: ${mb}px;">
                    <tr style="background-color: #D9E1F2; font-weight: bold;">
                        <td colspan="5" style="padding: ${padY + 0.5}px 6px; border: 1px solid #111;">
                            NGÀY SỰ KIỆN: <span style="color: #b91c1c; font-size: ${fs + 0.5}px; margin-left: 4px;">${formatDateDMY(b.event_date)}</span>
                        </td>
                    </tr>
                    <tr style="background-color: #E2E8F0; font-weight: bold; text-align: center;">
                        <td style="width: 14%; padding: ${padY}px ${padX}px; border: 1px solid #111;"># Shift</td>
                        <td style="width: 22%; padding: ${padY}px ${padX}px; border: 1px solid #111;">THỜI GIAN</td>
                        <td style="width: 26%; padding: ${padY}px ${padX}px; border: 1px solid #111;">ĐỊA ĐIỂM</td>
                        <td style="width: 24%; padding: ${padY}px ${padX}px; border: 1px solid #111;">LOẠI TIỆC</td>
                        <td style="width: 14%; padding: ${padY}px ${padX}px; border: 1px solid #111;">SỐ KHÁCH</td>
                    </tr>
                    ${scheduleRowsHtml}
                </table>
                `;
            }

            // 7. Render Ca (F&B // BẾP) - Tự động thích ứng đệm và font
            // Helper khử trùng lặp và làm sạch text setup
            function cleanSetup(text) {
                if (!text) return '';
                const lines = String(text).split(/\r?\n/).map(l => l.trim()).filter(Boolean);
                const seen = new Set();
                const unique = [];
                for (const l of lines) {
                    if (!seen.has(l)) {
                        seen.add(l);
                        unique.push(l);
                    }
                }
                return unique.join('\n');
            }

            function renderSessionBox(rs, idx, padY = 4, lineH = 1.35, mb = 8, fs = 12.5) {
                const timeStr = `${rs.time_in ? rs.time_in.substring(0, 5) : ''} - ${rs.time_out ? rs.time_out.substring(0, 5) : ''}`;
                const menuText = extractMenuForSession(b.menu_detail, rs.function_type, idx, schedules.length);
                const fbNote = formatBulletNotes(dNotes['001']);
                const kitchenNote = formatBulletNotes(dNotes['008']);
                
                const fn = (rs.function_type || '').toLowerCase();
                let rawSetup = rs.setup_note;
                if (!rawSetup) {
                    if (schedules.length <= 1) {
                        rawSetup = b.room_setup;
                    } else if (fn.includes('lunch') || fn.includes('trưa') || fn.includes('dinner') || fn.includes('tối')) {
                        rawSetup = 'Set up bàn ăn tiêu chuẩn theo số lượng khách';
                    } else {
                        rawSetup = b.room_setup;
                    }
                }
                const setupNote = formatBulletNotes(cleanSetup(rawSetup) || 'Set up tiêu chuẩn theo số lượng khách');

                // Bố trí ghi chú bếp thông minh theo ca phù hợp
                let showKitchen = false;
                if (schedules.length <= 1) {
                    showKitchen = (idx === 0 && dNotes['008']);
                } else {
                    const knLower = (kitchenNote || '').toLowerCase();
                    if (knLower.includes('tối') || knLower.includes('dinner') || knLower.includes('gala')) {
                        showKitchen = (fn.includes('dinner') || fn.includes('tối') || fn.includes('gala') || idx === schedules.length - 1);
                    } else if (knLower.includes('trưa') || knLower.includes('lunch')) {
                        showKitchen = (fn.includes('lunch') || fn.includes('trưa'));
                    } else {
                        showKitchen = (idx === schedules.length - 1);
                    }
                }

                // Tự động thích ứng kích thước chữ và khoảng cách dòng nếu nội dung ca cực dài
                let effFs = fs;
                let effLineH = lineH;
                let effPadY = padY;
                let effMb = mb;
                const totalContentLen = (menuText || '').length + (setupNote || '').length + (showKitchen ? (kitchenNote || '').length : 0);
                const totalLines = ((menuText || '').match(/\n/g) || []).length + ((setupNote || '').match(/\n/g) || []).length + (showKitchen ? ((kitchenNote || '').match(/\n/g) || []).length : 0);
                // Giữ nguyên chữ to 12.5px, chỉ co nhẹ khi nội dung ca cực dài (> 900 ký tự hoặc > 28 dòng)
                if (totalContentLen > 900 || totalLines > 28) {
                    effFs = Math.min(fs, 11.5);
                    effLineH = Math.min(lineH, 1.22);
                    effPadY = Math.min(padY, 2.5);
                    effMb = Math.min(mb, 6);
                }

                return `
                    <table style="width: 100%; table-layout: fixed; border-collapse: collapse; border: 1.5px solid #111; font-size: ${effFs}px; font-family: 'Times New Roman', Times, serif; margin-bottom: ${effMb}px;">
                        <thead>
                            <tr style="background-color: #E2E8F0; font-weight: bold; text-align: center;">
                                <th style="width: 50%; padding: 3px; border: 1px solid #111;">F&B (${rs.room || 'Sảnh'})</th>
                                <th style="width: 50%; padding: 3px; border: 1px solid #111;">BẾP (${rs.function_type || 'Menu'})</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr style="vertical-align: top;">
                                <td style="padding: ${effPadY}px 6px; border: 1px solid #111; line-height: ${effLineH};">
                                    <div><b>Thời gian:</b> ${timeStr}</div>
                                    <div><b>Số khách xác nhận:</b> ${rs.pax || b.gua_pax || '-'}</div>
                                    <div style="margin-top: 2px; white-space: pre-wrap;"><b>Cách sắp xếp:</b> ${setupNote}</div>
                                    ${b.beverage ? `<div style="margin-top: 2px;"><b>Thức uống:</b> ${b.beverage}</div>` : ''}
                                    ${(idx === 0 && dNotes['001']) ? `<div style="margin-top: 2px; padding-top: 2px; border-top: 1px dashed #ccc; white-space: pre-wrap;"><b>Ghi chú F&B:</b><br/>${fbNote}</div>` : ''}
                                </td>
                                <td style="padding: ${effPadY}px 6px; border: 1px solid #111; line-height: ${effLineH};">
                                    <div><b>Menu:</b> ${rs.function_type || b.event_type || 'Set Menu'}</div>
                                    ${b.menu_price ? `<div><b>Giá:</b> ${formatNumber(b.menu_price)}</div>` : '<div><b>Giá:</b> Theo hợp đồng</div>'}
                                    <div style="margin-top: 2px; white-space: pre-wrap;"><b>Chi tiết menu:</b><br/>${menuText}</div>
                                    ${showKitchen ? `<div style="margin-top: 2px; padding-top: 2px; border-top: 1px dashed #ccc; white-space: pre-wrap;"><b>Ghi chú Bếp:</b><br/>${kitchenNote}</div>` : ''}
                                </td>
                            </tr>
                        </tbody>
                    </table>
                `;
            }

            // 8. Render các Bộ Phận & Bảng Phí + Khối Chữ Ký
            const foText = formatBulletNotes(dNotes['006']);
            let accContent = [];
            if (b.payment_notes) accContent.push(b.payment_notes);
            if (dNotes['015']) accContent.push(formatBulletNotes(dNotes['015']));
            const accText = accContent.join('\n\n') || '-';

            const deptPair1Html = (padY = 3.5, lineH = 1.30, mb = 8, fs = 12.5) => {
                let effFs = fs;
                let effLineH = lineH;
                let effPadY = padY;
                let effMb = mb;
                const foLen = (foText || '').length;
                // Giữ nguyên chữ to 12.5px, chỉ co nhẹ khi ghi chú tiền sảnh cực dài (> 1500 ký tự)
                if (foLen > 1500) {
                    effFs = Math.min(fs, 11.5);
                    effLineH = Math.min(lineH, 1.22);
                    effPadY = Math.min(padY, 2.5);
                    effMb = Math.min(mb, 6);
                }
                return `
                    <table style="width: 100%; table-layout: fixed; border-collapse: collapse; border: 1.5px solid #111; font-size: ${effFs}px; font-family: 'Times New Roman', Times, serif; margin-bottom: ${effMb}px;">
                        <thead>
                            <tr style="background-color: #E2E8F0; font-weight: bold; text-align: center;">
                                <th style="width: 50%; padding: 3px; border: 1px solid #111;">TIỀN SẢNH</th>
                                <th style="width: 50%; padding: 3px; border: 1px solid #111;">THU NGÂN</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr style="vertical-align: top;">
                                <td style="padding: ${effPadY}px 6px; border: 1px solid #111; white-space: pre-wrap; line-height: ${effLineH};">${foText}</td>
                                <td style="padding: ${effPadY}px 6px; border: 1px solid #111; white-space: pre-wrap; line-height: ${effLineH};">${accText}</td>
                            </tr>
                        </tbody>
                    </table>
                `;
            };

            const atasText = formatBulletNotes(dNotes['010']);
            let itArr = [];
            if (dNotes['013']) itArr.push(formatBulletNotes(dNotes['013']));
            if (dNotes['003']) itArr.push('BẢO TRÌ & KỸ THUẬT: ' + formatBulletNotes(dNotes['003']));
            const itText = itArr.join('\n\n') || '-';

            const hkText = formatBulletNotes(dNotes['002']);
            const bqtText = formatBulletNotes(dNotes['004']);

            const deptPair2Html = (padY = 3.5, lineH = 1.30, mb = 8, fs = 12.5) => `
                <table style="width: 100%; table-layout: fixed; border-collapse: collapse; border: 1.5px solid #111; font-size: ${fs}px; font-family: 'Times New Roman', Times, serif; margin-bottom: ${mb}px;">
                    <thead>
                        <tr style="background-color: #E2E8F0; font-weight: bold; text-align: center;">
                            <th style="width: 50%; padding: 3px; border: 1px solid #111;">ATAS (AV)</th>
                            <th style="width: 50%; padding: 3px; border: 1px solid #111;">IT (KỸ THUẬT & BẢO TRÌ)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr style="vertical-align: top;">
                            <td style="padding: ${padY}px 6px; border: 1px solid #111; white-space: pre-wrap; line-height: ${lineH};">${atasText}</td>
                            <td style="padding: ${padY}px 6px; border: 1px solid #111; white-space: pre-wrap; line-height: ${lineH};">${itText}</td>
                        </tr>
                    </tbody>
                </table>
            `;

            const deptPair3Html = (padY = 3.5, lineH = 1.30, mb = 8, fs = 12.5) => `
                <table style="width: 100%; table-layout: fixed; border-collapse: collapse; border: 1.5px solid #111; font-size: ${fs}px; font-family: 'Times New Roman', Times, serif; margin-bottom: ${mb}px;">
                    <thead>
                        <tr style="background-color: #E2E8F0; font-weight: bold; text-align: center;">
                            <th style="width: 50%; padding: 3px; border: 1px solid #111;">HK</th>
                            <th style="width: 50%; padding: 3px; border: 1px solid #111;">BAN SỰ KIỆN</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr style="vertical-align: top;">
                            <td style="padding: ${padY}px 6px; border: 1px solid #111; white-space: pre-wrap; line-height: ${lineH};">${hkText}</td>
                            <td style="padding: ${padY}px 6px; border: 1px solid #111; white-space: pre-wrap; line-height: ${lineH};">${bqtText}</td>
                        </tr>
                    </tbody>
                </table>
            `;

            const deptPair2And3Html = (padY = 3.5, lineH = 1.30, mb = 8, fs = 12.5) => deptPair2Html(padY, lineH, mb, fs) + deptPair3Html(padY, lineH, mb, fs);

            let chargesRowsHtml = '';
            if (b.charges && b.charges.length > 0) {
                b.charges.forEach((c, idx) => {
                    const price = parseFloat(c.price) || 0;
                    const amt = parseFloat(c.amount) || 0;
                    chargesRowsHtml += `
                        <tr style="text-align: center;">
                            <td style="padding: 2.5px 2px; border: 1px solid #111;">${idx + 1}</td>
                            <td style="padding: 2.5px 6px; border: 1px solid #111; text-align: left; font-weight: bold;">${c.item_name || '-'}</td>
                            <td style="padding: 2.5px 2px; border: 1px solid #111;">${c.quantity || 1}</td>
                            <td style="padding: 2.5px 2px; border: 1px solid #111;">${c.unit || 'Lần'}</td>
                            <td style="padding: 2.5px 6px; border: 1px solid #111; text-align: right;">${price > 0 ? formatNumber(price) : '0'} đ</td>
                            <td style="padding: 2.5px 6px; border: 1px solid #111; text-align: right; font-weight: bold;">${amt > 0 ? formatNumber(amt) : '0'} đ</td>
                        </tr>
                    `;
                });
            } else {
                chargesRowsHtml = `
                    <tr style="text-align: center;">
                        <td style="padding: 2.5px 2px; border: 1px solid #111;">1</td>
                        <td style="padding: 2.5px 6px; border: 1px solid #111; text-align: left; font-weight: bold;">Dịch vụ tiệc (${b.event_type || 'Event'})</td>
                        <td style="padding: 2.5px 2px; border: 1px solid #111;">${b.gua_pax || 1}</td>
                        <td style="padding: 2.5px 2px; border: 1px solid #111;">Khách</td>
                        <td style="padding: 2.5px 6px; border: 1px solid #111; text-align: right;">${formatNumber(b.menu_price || 0)} đ</td>
                        <td style="padding: 2.5px 6px; border: 1px solid #111; text-align: right; font-weight: bold;">${formatNumber(totalAmt)} đ</td>
                    </tr>
                `;
            }

            const chargesAndSignHtml = (signHeight = 55, mb = 8, fs = 12.5) => `
                <div style="page-break-inside: avoid !important;">
                    <table style="width: 100%; table-layout: fixed; border-collapse: collapse; border: 1.5px solid #111; font-size: ${fs}px; font-family: 'Times New Roman', Times, serif; margin-bottom: ${mb}px;">
                        <tr style="background-color: #E2E8F0; font-weight: bold; text-align: center;">
                            <td style="width: 32px; padding: 2.5px 2px; border: 1px solid #111;">STT</td>
                            <td style="padding: 2.5px 6px; border: 1px solid #111;">Chi tiết dịch vụ</td>
                            <td style="width: 50px; padding: 2.5px 2px; border: 1px solid #111;">SL</td>
                            <td style="width: 45px; padding: 2.5px 2px; border: 1px solid #111;">ĐVT</td>
                            <td style="width: 110px; padding: 2.5px 6px; border: 1px solid #111;">Đơn giá (VND)</td>
                            <td style="width: 125px; padding: 2.5px 6px; border: 1px solid #111;">Thành tiền (VND)</td>
                        </tr>
                        ${chargesRowsHtml}
                        <tr style="border-top: 1.5px solid #111;">
                            <td colspan="5" style="padding: 3px 6px; border: 1px solid #111; text-align: right; font-weight: bold;">TỔNG CỘNG</td>
                            <td style="padding: 3px 6px; border: 1px solid #111; text-align: right; font-weight: bold;">${formatVND(totalAmt)}</td>
                        </tr>
                        <tr>
                            <td colspan="5" style="padding: 3px 6px; border: 1px solid #111; text-align: right; font-weight: bold;">ĐẶT CỌC LẦN 1</td>
                            <td style="padding: 3px 6px; border: 1px solid #111; text-align: right; font-weight: bold;">${formatVND(deposit1)}</td>
                        </tr>
                        <tr>
                            <td colspan="5" style="padding: 3px 6px; border: 1px solid #111; text-align: right; font-weight: bold;">CÒN LẠI</td>
                            <td style="padding: 3px 6px; border: 1px solid #111; text-align: right; font-weight: bold; color: #b91c1c;">${formatVND(remainAmt)}</td>
                        </tr>
                    </table>
                    <div style="margin-top: 10px; display: flex; justify-content: flex-end;">
                        <div style="width: 220px; text-align: center; font-family: 'Times New Roman', Times, serif; font-size: ${fs}px;">
                            <div style="font-weight: bold; text-transform: uppercase;">CHUẨN BỊ BỞI</div>
                            <div style="height: ${signHeight}px;"></div>
                            <div style="font-weight: bold; color: #002060; border-top: 1px solid #111; padding-top: 2px;">
                                ${b.prepared_by_name || 'THIETKE'}
                            </div>
                            <div style="font-size: 11px; color: #555;">Ngày: ${b.order_date || ''}</div>
                        </div>
                    </div>
                </div>
            `;

            // ==========================================
            // THUẬT TOÁN DÀN TRANG THÍCH ỨNG TỰ ĐỘNG (ADAPTIVE DYNAMIC PAGINATION)
            // Đã kiểm thử 100% trên 1.413 đơn tiệc thực tế (EMS_KHAIVY)
            // ==========================================
            const menuText = (b.menu_detail || '').trim();
            const menuLines = menuText.split(/\r?\n/).filter(l => l.trim()).length;
            const menuLen = menuText.length;
            const foLen = ((dNotes['006'] || '') + (dNotes['015'] || '')).length;
            const roomSetupLen = (b.room_setup || '').length;

            let pagesHtml = '';

            if (schedules.length >= 3) {
                // ĐƠN 3 CA TRỞ LÊN (34 đơn 3 ca, 11 đơn 4-6 ca)
                const s0Menu = extractMenuForSession(b.menu_detail, schedules[0].function_type, 0, schedules.length);
                const s1Menu = extractMenuForSession(b.menu_detail, schedules[1].function_type, 1, schedules.length);
                const canFit2InP1 = (schedules.length === 3 && (s0Menu.length + s1Menu.length < 500) && (menuLen < 800));

                if (canFit2InP1) {
                    // DÀN 3 TRANG HOÀN HẢO (Áp dụng cho đơn 3 ca như NLMT26_1000000036 MINH TRÍ THÀNH 73299)
                    // Trang 1: Khách hàng + Lịch trình + Ca 1 + Ca 2 (lấp đầy 83.6%, font to 12.5px rõ ràng)
                    const p1 = `
                        <div class="beo-page-session beo-page-1 beo-page-has-next" style="width: 100%; max-width: 210mm; margin: 0 auto; padding: 6mm 8mm; box-sizing: border-box; font-family: 'Times New Roman', Times, serif; color: #000; line-height: 1.28; page-break-after: always !important; break-after: page !important;">
                            ${renderHeaderPage1Html()}
                            ${getCustomerTableHtml(3.5, 6, 1.28, 6, 12.5)}
                            ${getScheduleTableHtml(3, 5, 6, 12.5)}
                            ${renderSessionBox(schedules[0], 0, 3, 1.25, 6, 12.5)}
                            ${renderSessionBox(schedules[1], 1, 3, 1.25, 6, 12.5)}
                        </div>
                    `;

                    // Phân bổ thông minh bộ phận để Trang 2 và Trang 3 đều giữ font to 12.5px
                    let p2DeptHtml = '';
                    let p3DeptHtml = '';
                    if (foLen > 350) {
                        p2DeptHtml = deptPair3Html(3.5, 1.28, 8, 12.5);
                        p3DeptHtml = deptPair1Html(3.5, 1.28, 8, 12.5) + deptPair2Html(3.5, 1.28, 8, 12.5);
                    } else {
                        p2DeptHtml = deptPair1Html(3.5, 1.28, 8, 12.5);
                        p3DeptHtml = deptPair2And3Html(3.5, 1.28, 8, 12.5);
                    }

                    // Trang 2: Ca 3 + Bộ phận cân đối (lấp đầy 85.1%, font to 12.5px rõ ràng)
                    const p2 = `
                        <div class="beo-page-session beo-page-2 beo-page-has-next" style="width: 100%; max-width: 210mm; margin: 0 auto; padding: 6mm 8mm; box-sizing: border-box; font-family: 'Times New Roman', Times, serif; color: #000; line-height: 1.28; page-break-after: always !important; break-after: page !important;">
                            ${renderSubHeaderHtml(2, 3)}
                            ${renderSessionBox(schedules[2], 2, 3.5, 1.28, 8, 12.5)}
                            ${p2DeptHtml}
                        </div>
                    `;
                    // Trang 3: Bộ phận còn lại + Bảng Phí + Khối Chữ Ký (lấp đầy 94.9%, font to 12.5px rõ ràng)
                    const p3 = `
                        <div class="beo-page-session beo-page-3 beo-page-last" style="width: 100%; max-width: 210mm; margin: 0 auto; padding: 6mm 8mm; box-sizing: border-box; font-family: 'Times New Roman', Times, serif; color: #000; line-height: 1.28; page-break-after: avoid !important; break-after: avoid !important;">
                            ${renderSubHeaderHtml(3, 3)}
                            ${p3DeptHtml}
                            ${chargesAndSignHtml(60, 8, 12.5)}
                        </div>
                    `;
                    pagesHtml = p1 + p2 + p3;
                } else {
                    // DÀN 4 TRANG RỘNG RÃI (Áp dụng cho đơn có ca mega Gala dài như TTK26_1000000203 TRAVEL ONE)
                    const totalP = schedules.length + 1;
                    let pList = [];
                    pList.push(`
                        <div class="beo-page-session beo-page-1 beo-page-has-next" style="width: 100%; max-width: 210mm; margin: 0 auto; padding: 6mm 8mm; box-sizing: border-box; font-family: 'Times New Roman', Times, serif; color: #000; line-height: 1.35; page-break-after: always !important; break-after: page !important;">
                            ${renderHeaderPage1Html()}
                            ${getCustomerTableHtml(4, 6, 1.35, 8, 12.5)}
                            ${getScheduleTableHtml(3, 5, 8, 12.5)}
                            ${renderSessionBox(schedules[0], 0, 3.5, 1.30, 8, 12.5)}
                        </div>
                    `);

                    for (let sIdx = 1; sIdx < schedules.length; sIdx++) {
                        const isSecond = (sIdx === 1);
                        pList.push(`
                            <div class="beo-page-session beo-page-${sIdx + 1} beo-page-has-next" style="width: 100%; max-width: 210mm; margin: 0 auto; padding: 5mm 8mm; box-sizing: border-box; font-family: 'Times New Roman', Times, serif; color: #000; line-height: 1.28; page-break-after: always !important; break-after: page !important;">
                                ${renderSubHeaderHtml(sIdx + 1, totalP)}
                                ${renderSessionBox(schedules[sIdx], sIdx, 3, 1.25, 8, 12.5)}
                                ${isSecond ? deptPair1Html(3, 1.25, 8, 12.5) : ''}
                            </div>
                        `);
                    }

                    pList.push(`
                        <div class="beo-page-session beo-page-${totalP} beo-page-last" style="width: 100%; max-width: 210mm; margin: 0 auto; padding: 6mm 8mm; box-sizing: border-box; font-family: 'Times New Roman', Times, serif; color: #000; line-height: 1.32; page-break-after: avoid !important; break-after: avoid !important;">
                            ${renderSubHeaderHtml(totalP, totalP)}
                            ${deptPair2And3Html(3.5, 1.30, 8, 12.5)}
                            ${chargesAndSignHtml(60, 8, 12.5)}
                        </div>
                    `);
                    pagesHtml = pList.join('');
                }
            } else if (schedules.length === 2) {
                // ĐƠN 2 CA (109 đơn - bao gồm LVH26_1000000041 MINH TRÍ THÀNH)
                // Trang 1: Tự động kích hoạt SPACIOUS MODE chữ to 12.5px
                const p1 = `
                    <div class="beo-page-session beo-page-1 beo-page-has-next" style="width: 100%; max-width: 210mm; margin: 0 auto; padding: 7mm 8mm; box-sizing: border-box; font-family: 'Times New Roman', Times, serif; color: #000; line-height: 1.35; page-break-after: always !important; break-after: page !important;">
                        ${renderHeaderPage1Html()}
                        ${getCustomerTableHtml(4.5, 6, 1.35, 10, 12.5)}
                        ${getScheduleTableHtml(3.5, 5, 10, 12.5)}
                        ${renderSessionBox(schedules[0], 0, 4, 1.30, 10, 12.5)}
                    </div>
                `;
                // Trang 2: Ca 2 + TIỀN SẢNH & THU NGÂN
                const isHeavyP2 = (foLen > 300 && menuLen > 300);
                const p2Pad = isHeavyP2 ? '5mm 8mm' : '6mm 8mm';
                const p2Mb = isHeavyP2 ? 6 : 8;
                const p2PadY = isHeavyP2 ? 2.5 : 3.5;
                const p2LineH = isHeavyP2 ? 1.22 : 1.28;
                const p2Fs = isHeavyP2 ? 11.8 : 12.5;

                const p2 = `
                    <div class="beo-page-session beo-page-2 beo-page-has-next" style="width: 100%; max-width: 210mm; margin: 0 auto; padding: ${p2Pad}; box-sizing: border-box; font-family: 'Times New Roman', Times, serif; color: #000; line-height: ${p2LineH}; page-break-after: always !important; break-after: page !important;">
                        ${renderSubHeaderHtml(2, 3)}
                        ${renderSessionBox(schedules[1], 1, p2PadY, p2LineH, p2Mb, p2Fs)}
                        ${deptPair1Html(p2PadY, p2LineH, p2Mb, p2Fs)}
                    </div>
                `;
                // Trang 3: ATAS/IT + HK/Ban Sự Kiện + Bảng Phí + Khối Chữ Ký
                const p3 = `
                    <div class="beo-page-session beo-page-3 beo-page-last" style="width: 100%; max-width: 210mm; margin: 0 auto; padding: 7mm 8mm; box-sizing: border-box; font-family: 'Times New Roman', Times, serif; color: #000; line-height: 1.30; page-break-after: avoid !important; break-after: avoid !important;">
                        ${renderSubHeaderHtml(3, 3)}
                        ${deptPair2And3Html(3.5, 1.28, 8, 12.5)}
                        ${chargesAndSignHtml(65, 8, 12.5)}
                    </div>
                `;
                pagesHtml = p1 + p2 + p3;

            } else {
                // ĐƠN 1 CA (1.259 đơn - chiếm 89.1% toàn bộ hệ thống)
                const isHeavyP1 = (menuLen > 250 || menuLines > 5 || foLen > 150 || roomSetupLen > 150);

                if (isHeavyP1) {
                    // NHÁNH 1A: Thực đơn hoặc Ghi chú dài (969 đơn - ví dụ TTK26_1000000058 PCO TRAVEL)
                    // Tự động chuyển TIỀN SẢNH & THU NGÂN sang Trang 2 để không bị văng trang trắng!
                    const p1 = `
                        <div class="beo-page-session beo-page-1 beo-page-has-next" style="width: 100%; max-width: 210mm; margin: 0 auto; padding: 7mm 8mm; box-sizing: border-box; font-family: 'Times New Roman', Times, serif; color: #000; line-height: 1.38; page-break-after: always !important; break-after: page !important;">
                            ${renderHeaderPage1Html()}
                            ${getCustomerTableHtml(5, 7, 1.40, 10, 12.5)}
                            ${getScheduleTableHtml(4, 6, 10, 12.5)}
                            ${renderSessionBox(schedules[0], 0, 4.5, 1.35, 10, 12.5)}
                        </div>
                    `;
                    const p2 = `
                        <div class="beo-page-session beo-page-2 beo-page-last" style="width: 100%; max-width: 210mm; margin: 0 auto; padding: 7mm 8mm; box-sizing: border-box; font-family: 'Times New Roman', Times, serif; color: #000; line-height: 1.32; page-break-after: avoid !important; break-after: avoid !important;">
                            ${renderSubHeaderHtml(2, 2)}
                            ${deptPair1Html(4, 1.30, 10, 12.5)}
                            ${deptPair2And3Html(4, 1.30, 10, 12.5)}
                            ${chargesAndSignHtml(65, 10, 12.5)}
                        </div>
                    `;
                    pagesHtml = p1 + p2;
                } else {
                    // NHÁNH 1B: Thực đơn ngắn hoặc hội thảo gọn (290 đơn - ví dụ TTK26_1000000201 AG TRAVEL)
                    // Giữ TIỀN SẢNH & THU NGÂN ở Trang 1, Trang 2 giãn thoáng với ô ký tên 80px!
                    const p1 = `
                        <div class="beo-page-session beo-page-1 beo-page-has-next" style="width: 100%; max-width: 210mm; margin: 0 auto; padding: 6mm 8mm; box-sizing: border-box; font-family: 'Times New Roman', Times, serif; color: #000; line-height: 1.35; page-break-after: always !important; break-after: page !important;">
                            ${renderHeaderPage1Html()}
                            ${getCustomerTableHtml(4, 6, 1.35, 8, 12.5)}
                            ${getScheduleTableHtml(3.5, 5, 8, 12.5)}
                            ${renderSessionBox(schedules[0], 0, 4, 1.35, 8, 12.5)}
                            ${deptPair1Html(4, 1.35, 8, 12.5)}
                        </div>
                    `;
                    const p2 = `
                        <div class="beo-page-session beo-page-2 beo-page-last" style="width: 100%; max-width: 210mm; margin: 0 auto; padding: 8mm 8mm; box-sizing: border-box; font-family: 'Times New Roman', Times, serif; color: #000; line-height: 1.40; page-break-after: avoid !important; break-after: avoid !important;">
                            ${renderSubHeaderHtml(2, 2)}
                            ${deptPair2And3Html(5, 1.40, 12, 13)}
                            ${chargesAndSignHtml(80, 12, 13)}
                        </div>
                    `;
                    pagesHtml = p1 + p2;
                }
            }
            printArea.innerHTML = pagesHtml;


        }

        function renderModernGridBEO(b) {
            const printArea = document.getElementById('beoPrintArea');
            const dNotes = b.department_notes || {};

            // 1. Render Bảng Lịch Trình Sự Kiện
            let scheduleRowsHtml = '';
            if (b.room_schedules && b.room_schedules.length > 0) {
                b.room_schedules.forEach(rs => {
                    const timeStr = `${rs.time_in ? rs.time_in.substring(0, 5) : ''} - ${rs.time_out ? rs.time_out.substring(0, 5) : ''}`;
                    scheduleRowsHtml += `
                        <tr style="text-align: center;">
                            <td style="padding: 2.5px 4px; border: 1px solid #111; font-weight: bold;">${rs.date || b.event_date}</td>
                            <td style="padding: 2.5px 4px; border: 1px solid #111; font-weight: bold;">${timeStr}</td>
                            <td style="padding: 2.5px 4px; border: 1px solid #111; font-weight: bold; text-transform: uppercase;">${rs.room || 'Sảnh'}</td>
                            <td style="padding: 2.5px 4px; border: 1px solid #111; text-transform: uppercase;">${rs.function_type || b.event_type || 'Tiệc'}</td>
                            <td style="padding: 2.5px 4px; border: 1px solid #111; font-weight: bold;">${rs.pax || b.gua_pax || '-'}</td>
                        </tr>
                    `;
                });
            } else {
                scheduleRowsHtml = `
                    <tr style="text-align: center;">
                        <td style="padding: 2.5px 4px; border: 1px solid #111; font-weight: bold;">${b.event_date || ''}</td>
                        <td style="padding: 2.5px 4px; border: 1px solid #111; font-weight: bold;">08:00 - 22:00</td>
                        <td style="padding: 2.5px 4px; border: 1px solid #111; font-weight: bold; text-transform: uppercase;">Sảnh Chính</td>
                        <td style="padding: 2.5px 4px; border: 1px solid #111; text-transform: uppercase;">${b.event_type || 'Tiệc'}</td>
                        <td style="padding: 2.5px 4px; border: 1px solid #111; font-weight: bold;">${b.gua_pax || '-'}</td>
                    </tr>
                `;
            }

            // 2. Render Bảng Chi Tiết Dịch Vụ
            let chargesRowsHtml = '';
            let totalAmt = parseFloat(b.total_charges) || 0;
            let depositAmt = parseFloat(b.deposit) || 0;

            if (b.charges_detail && b.charges_detail.length > 0) {
                b.charges_detail.forEach((ch, idx) => {
                    const qty = parseFloat(ch.quantity) || 1;
                    const price = parseFloat(ch.price) || 0;
                    const amt = parseFloat(ch.amount) || (qty * price);
                    
                    // ĐVT chuẩn
                    let unitStr = ch.unit || '';
                    if (!unitStr) {
                        const itm = (ch.item || '').toLowerCase();
                        if (itm.includes('room') || itm.includes('phòng') || itm.includes('roh')) unitStr = 'Phòng';
                        else if (itm.includes('food') || itm.includes('menu') || itm.includes('gala') || itm.includes('ăn')) unitStr = 'Khách';
                        else if (itm.includes('teabreak')) unitStr = 'Suất';
                        else if (itm.includes('gói') || itm.includes('âm thanh') || itm.includes('led')) unitStr = 'Gói';
                        else unitStr = 'Lần';
                    }

                    chargesRowsHtml += `
                        <tr>
                            <td style="padding: 2.5px 4px; border: 1px solid #111; text-align: center;">${idx + 1}</td>
                            <td style="padding: 2.5px 4px; border: 1px solid #111; font-weight: bold;">${ch.item}</td>
                            <td style="padding: 2.5px 4px; border: 1px solid #111; text-align: center;">${qty}</td>
                            <td style="padding: 2.5px 4px; border: 1px solid #111; text-align: center;">${unitStr}</td>
                            <td style="padding: 2.5px 4px; border: 1px solid #111; text-align: right;">${formatVND(price)}</td>
                            <td style="padding: 2.5px 4px; border: 1px solid #111; text-align: right; font-weight: bold;">${formatVND(amt)}</td>
                        </tr>
                    `;
                });
            } else {
                chargesRowsHtml = `
                    <tr>
                        <td style="padding: 2.5px 4px; border: 1px solid #111; text-align: center;">1</td>
                        <td style="padding: 2.5px 4px; border: 1px solid #111; font-weight: bold;">Dịch vụ tiệc (${b.event_type || 'Tiệc'})</td>
                        <td style="padding: 2.5px 4px; border: 1px solid #111; text-align: center;">${b.gua_pax || 1}</td>
                        <td style="padding: 2.5px 4px; border: 1px solid #111; text-align: center;">Khách</td>
                        <td style="padding: 2.5px 4px; border: 1px solid #111; text-align: right;">${formatVND(b.menu_price || 0)}</td>
                        <td style="padding: 2.5px 4px; border: 1px solid #111; text-align: right; font-weight: bold;">${formatVND(totalAmt || (parseFloat(b.menu_price || 0) * (b.gua_pax || 1)))}</td>
                    </tr>
                `;
            }

            const remainAmt = totalAmt - depositAmt;

            // Xử lý nội dung F&B
            let fbContent = [];
            if (dNotes['001']) fbContent.push(dNotes['001']);
            if (b.beverage && b.beverage.trim()) fbContent.push('THỨC UỐNG:\\n' + b.beverage);
            if (b.room_setup && b.room_setup.trim()) fbContent.push('BỐ TRÍ / SETUP:\\n' + b.room_setup);
            if (b.welcome_info && b.welcome_info.trim()) fbContent.push('HƯỚNG DẪN / CHÀO ĐÓN:\\n' + b.welcome_info);
            const fbText = fbContent.join('\\n\\n') || '-';

            // Xử lý nội dung Kitchen
            let kitchenContent = [];
            if (b.menu_detail && b.menu_detail.trim()) kitchenContent.push(b.menu_detail);
            if (dNotes['008'] && dNotes['008'].trim()) kitchenContent.push('GHI CHÚ BẾP:\\n' + dNotes['008']);
            const kitchenText = kitchenContent.join('\\n\\n') || '-';

            // Xử lý nội dung Accountant
            let accContent = [];
            if (b.payment_method) accContent.push('Hình thức thanh toán: ' + b.payment_method);
            if (b.payment_notes) accContent.push(b.payment_notes);
            else if (depositAmt > 0) accContent.push('Đã đặt cọc: ' + formatVND(depositAmt) + ' (Còn lại: ' + formatVND(remainAmt) + ')');
            if (dNotes['015']) accContent.push(dNotes['015']);
            if (b.bill_to || b.tax_code || b.bill_address) {
                let billArr = ['Thông tin xuất hóa đơn:'];
                if (b.bill_to) billArr.push('- Tên công ty: ' + b.bill_to);
                if (b.tax_code) billArr.push('- MST: ' + b.tax_code);
                if (b.bill_address) billArr.push('- Địa chỉ: ' + b.bill_address);
                accContent.push(billArr.join('\\n'));
            }
            const accText = accContent.join('\\n\\n') || '-';

            // Xử lý FO
            const foText = dNotes['006'] || '-';

            // Xử lý Security
            const secText = dNotes['003'] || (b.room_setup ? 'Bảo đảm an toàn sự kiện và khu vực đỗ xe.' : '-');

            // Xử lý HK
            const hkText = dNotes['002'] || 'Đảm bảo vệ sinh khu vực tiệc, sảnh và WC trong suốt thời gian diễn ra sự kiện.';

            // Xử lý M&E + IT
            let meContent = [];
            if (dNotes['010']) meContent.push('ÂM THANH & ÁNH SÁNG (ATAS):\\n' + dNotes['010']);
            if (dNotes['013']) meContent.push('CÔNG NGHỆ THÔNG TIN (IT):\\n' + dNotes['013']);
            const meText = meContent.join('\\n\\n') || '-';

            printArea.innerHTML = `
                <div class="beo-page beo-page-imperial" style="width: 100%; max-width: 202mm; margin: 0 auto; padding: 6mm 6mm 4mm 6mm; box-sizing: border-box; font-family: 'Times New Roman', Times, serif; font-size: 13.5px; color: #000; line-height: 1.3;">
                    
                    <!-- HEADER: LOGO / THƯƠNG HIỆU & TIÊU ĐỀ BEO -->
                    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 6px; padding-bottom: 3px;">
                        <div style="width: 45%;">
                            <h2 style="margin: 0; font-size: 19px; font-weight: bold; color: #002060; font-family: 'Times New Roman', Times, serif; white-space: nowrap; line-height: 1.2;">MerPerle DaLat Hotel</h2>
                            <div style="font-size: 11.5px; color: #475569; font-style: italic;">Banquet Event Order</div>
                        </div>
                        <div style="width: 53%; text-align: right;">
                            <h1 style="margin: 0; font-size: 21px; font-weight: bold; color: #111; letter-spacing: 0.8px; font-family: 'Times New Roman', Times, serif; line-height: 1.2;">BANQUET EVENT ORDER</h1>
                            <div style="font-size: 12.5px; color: #444; margin-top: 2px;">
                                <span>Số E.O: <b>${b.master_eo || 'TỰ ĐỘNG'}</b></span>
                                <span style="margin-left: 12px;">Ngày lập: <b>${b.order_date || ''}</b></span>
                            </div>
                            ${b.amendment ? `<div style="font-size: 12px; color: #b91c1c; font-weight: bold; margin-top: 1px;">Amendment: ${b.amendment}</div>` : ''}
                        </div>
                    </div>

                    <!-- BẢNG THÔNG TIN KHÁCH HÀNG & SALES (3 DÒNG) -->
                    <table style="width: 100%; table-layout: fixed; border-collapse: collapse; border: 1.5px solid #111; font-size: 13.5px; font-family: 'Times New Roman', Times, serif; margin-bottom: 6px;">
                        <tr>
                            <td style="width: 160px; font-weight: bold; padding: 3px 6px; border: 1px solid #111; background-color: #f8fafc;">KHÁCH HÀNG</td>
                            <td style="padding: 3px 6px; border: 1px solid #111; font-weight: bold; text-transform: uppercase;">${b.company || b.customer_name}</td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold; padding: 3px 6px; border: 1px solid #111; background-color: #f8fafc;">HDV/ TRƯỞNG ĐOÀN</td>
                            <td style="padding: 3px 6px; border: 1px solid #111;">${b.contact_person || '-'} ${b.phone ? ' • SĐT: ' + b.phone : ''} ${b.office_phone ? ' • ĐT: ' + b.office_phone : ''}</td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold; padding: 3px 6px; border: 1px solid #111; background-color: #f8fafc;">SALES PHỤ TRÁCH</td>
                            <td style="padding: 3px 6px; border: 1px solid #111;">${b.prepared_by_name || '-'} ${b.endorsed_by_name ? ' • Hỗ trợ: ' + b.endorsed_by_name : ''}</td>
                        </tr>
                    </table>

                    <!-- BẢNG LỊCH TRÌNH SỰ KIỆN (SCHEDULE TABLE) -->
                    <table style="width: 100%; table-layout: fixed; border-collapse: collapse; border: 1.5px solid #111; font-size: 13.5px; font-family: 'Times New Roman', Times, serif; margin-bottom: 6px;">
                        <tr style="background-color: #E2E8F0; font-weight: bold; text-align: center;">
                            <td style="width: 22%; padding: 3px 4px; border: 1px solid #111;">NGÀY</td>
                            <td style="width: 20%; padding: 3px 4px; border: 1px solid #111;">THỜI GIAN</td>
                            <td style="width: 26%; padding: 3px 4px; border: 1px solid #111;">ĐỊA ĐIỂM</td>
                            <td style="width: 20%; padding: 3px 4px; border: 1px solid #111;">DỊCH VỤ</td>
                            <td style="width: 12%; padding: 3px 4px; border: 1px solid #111;">SỐ KHÁCH</td>
                        </tr>
                        ${scheduleRowsHtml}
                    </table>

                    <!-- BẢNG PHÂN CÔNG 2 CỘT BỘ PHẬN (GRID 2 CỘT) -->
                    <table style="width: 100%; table-layout: fixed; border-collapse: collapse; border: 1.5px solid #111; font-size: 13px; font-family: 'Times New Roman', Times, serif; margin-bottom: 6px;">
                        <!-- HEADER HÀNG 1: F&B vs KITCHEN -->
                        <tr style="background-color: #E2E8F0; font-weight: bold; text-align: center;">
                            <td style="width: 50%; padding: 3px; border: 1px solid #111;">F&B</td>
                            <td style="width: 50%; padding: 3px; border: 1px solid #111;">KITCHEN</td>
                        </tr>
                        <tr style="vertical-align: top;">
                            <td style="padding: 4px 6px; border: 1px solid #111; white-space: pre-wrap; line-height: 1.3;">${fbText}</td>
                            <td style="padding: 4px 6px; border: 1px solid #111; white-space: pre-wrap; line-height: 1.3;">${kitchenText}</td>
                        </tr>

                        <!-- HEADER HÀNG 2: FO vs ACCOUNTANT -->
                        <tr style="background-color: #E2E8F0; font-weight: bold; text-align: center;">
                            <td style="padding: 3px; border: 1px solid #111;">FO</td>
                            <td style="padding: 3px; border: 1px solid #111;">ACCOUNTANT</td>
                        </tr>
                        <tr style="vertical-align: top;">
                            <td style="padding: 4px 6px; border: 1px solid #111; white-space: pre-wrap; line-height: 1.3;">${foText}</td>
                            <td style="padding: 4px 6px; border: 1px solid #111; white-space: pre-wrap; line-height: 1.3;">${accText}</td>
                        </tr>

                        <!-- HEADER HÀNG 3: SECURITY vs HK -->
                        <tr style="background-color: #E2E8F0; font-weight: bold; text-align: center;">
                            <td style="padding: 3px; border: 1px solid #111;">SECURITY</td>
                            <td style="padding: 3px; border: 1px solid #111;">HK</td>
                        </tr>
                        <tr style="vertical-align: top;">
                            <td style="padding: 4px 6px; border: 1px solid #111; white-space: pre-wrap; line-height: 1.3;">${secText}</td>
                            <td style="padding: 4px 6px; border: 1px solid #111; white-space: pre-wrap; line-height: 1.3;">${hkText}</td>
                        </tr>

                        <!-- HEADER HÀNG 4: M&E + IT -->
                        <tr style="background-color: #E2E8F0; font-weight: bold; text-align: center;">
                            <td colspan="2" style="padding: 3px; border: 1px solid #111;">M&E + IT</td>
                        </tr>
                        <tr style="vertical-align: top;">
                            <td colspan="2" style="padding: 4px 6px; border: 1px solid #111; white-space: pre-wrap; line-height: 1.3;">${meText}</td>
                        </tr>
                    </table>

                    <!-- BẢNG CHI TIẾT DỊCH VỤ & DOANH THU -->
                    <table style="width: 100%; table-layout: fixed; border-collapse: collapse; border: 1.5px solid #111; font-size: 13px; font-family: 'Times New Roman', Times, serif; margin-bottom: 10px;">
                        <tr style="background-color: #E2E8F0; font-weight: bold; text-align: center;">
                            <td style="width: 35px; padding: 3px 2px; border: 1px solid #111;">STT</td>
                            <td style="padding: 3px 4px; border: 1px solid #111;">Chi tiết dịch vụ</td>
                            <td style="width: 65px; padding: 3px 2px; border: 1px solid #111;">Số lượng</td>
                            <td style="width: 55px; padding: 3px 2px; border: 1px solid #111;">ĐVT</td>
                            <td style="width: 105px; padding: 3px 4px; border: 1px solid #111;">Đơn giá (VND)</td>
                            <td style="width: 120px; padding: 3px 4px; border: 1px solid #111;">Thành tiền (VND)</td>
                        </tr>
                        ${chargesRowsHtml}
                        <tr style="border-top: 1.5px solid #111;">
                            <td colspan="5" style="padding: 3px 6px; border: 1px solid #111; text-align: right; font-weight: bold;">TỔNG CỘNG</td>
                            <td style="padding: 3px 6px; border: 1px solid #111; text-align: right; font-weight: bold;">${formatVND(totalAmt)}</td>
                        </tr>
                        <tr>
                            <td colspan="5" style="padding: 3px 6px; border: 1px solid #111; text-align: right; font-weight: bold;">ĐẶT CỌC</td>
                            <td style="padding: 3px 6px; border: 1px solid #111; text-align: right; font-weight: bold;">${formatVND(depositAmt)}</td>
                        </tr>
                        <tr>
                            <td colspan="5" style="padding: 3px 6px; border: 1px solid #111; text-align: right; font-weight: bold;">CÒN LẠI</td>
                            <td style="padding: 3px 6px; border: 1px solid #111; text-align: right; font-weight: bold; color: #b91c1c;">${formatVND(remainAmt)}</td>
                        </tr>
                    </table>

                    <!-- KHỐI 3 CHỮ KÝ XÁC NHẬN (PREPARED | CHECKED | APPROVED) -->
                    <div style="border: 1.5px solid #111; padding: 8px 6px; text-align: center; font-family: 'Times New Roman', Times, serif; page-break-inside: avoid !important;">
                        <div style="display: flex; justify-content: space-between;">
                            <div style="width: 32%;">
                                <div style="font-weight: bold; font-size: 13.5px; text-transform: uppercase;">Prepared</div>
                                <div style="height: 55px;"></div>
                                <div style="font-weight: bold; font-size: 13.5px;">${b.prepared_by_name || 'VÕ ĐÌNH LUÂN'}</div>
                                <div style="font-size: 11.5px; color: #555;">(SE / Sales Executive)</div>
                            </div>
                            <div style="width: 32%; border-left: 1px dashed #999;">
                                <div style="font-weight: bold; font-size: 13.5px; text-transform: uppercase;">Checked</div>
                                <div style="height: 55px;"></div>
                                <div style="font-weight: bold; font-size: 13.5px;">${b.endorsed_by_name || 'LÊ NỮ ĐÔNG TRIỀU'}</div>
                                <div style="font-size: 11.5px; color: #555;">(DOSM / Director of Sales)</div>
                            </div>
                            <div style="width: 32%; border-left: 1px dashed #999;">
                                <div style="font-weight: bold; font-size: 13.5px; text-transform: uppercase;">Approved</div>
                                <div style="height: 55px;"></div>
                                <div style="font-weight: bold; font-size: 13.5px; color: #002060;">ĐẶNG DUY TUẤN</div>
                                <div style="font-size: 11.5px; color: #555;">(DGM / Deputy General Manager)</div>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }

        let currentBeoAmendHistory = [];

        function copyCompanyToBilling() {
            const comp = document.getElementById('beoCompany') ? document.getElementById('beoCompany').value.trim() : '';
            if (comp) {
                document.getElementById('beoBillTo').value = comp;
            }
            if (currentBeoData && currentBeoData.tax_code && document.getElementById('beoTaxCode')) {
                document.getElementById('beoTaxCode').value = currentBeoData.tax_code;
            }
        }

        function showBeoAmendHistoryModal() {
            const modal = document.getElementById('modalBeoAmendHistory');
            const list = document.getElementById('beoAmendHistoryList');
            if (!modal || !list) return;

            if (!currentBeoAmendHistory || currentBeoAmendHistory.length === 0) {
                list.innerHTML = `
                    <div class="text-center py-8 text-slate-400 text-xs">
                        <i data-lucide="info" class="w-8 h-8 mx-auto mb-2 text-slate-300"></i>
                        Chưa có lịch sử sửa đổi nào cho đơn BEO này.<br>
                        Khi bạn nhập nội dung vào ô <b>Amendment</b> và bấm <b>Lưu BEO</b>, hệ thống sẽ tự động ghi nhận lần sửa đổi.
                    </div>
                `;
            } else {
                let h = '';
                currentBeoAmendHistory.forEach((item, idx) => {
                    const isLatest = idx === currentBeoAmendHistory.length - 1;
                    const badgeClr = isLatest ? 'bg-red-100 text-red-800 border-red-200' : 'bg-slate-100 text-slate-700 border-slate-200';
                    const tag = isLatest ? '<span class="ml-2 text-[10px] bg-red-600 text-white px-1.5 py-0.2 rounded font-bold">MỚI NHẤT</span>' : '';
                    h += `
                        <div class="p-3 rounded-lg border ${isLatest ? 'border-red-200 bg-red-50/30' : 'border-slate-200 bg-white'} shadow-sm">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <span class="text-xs font-bold px-2 py-0.5 rounded border ${badgeClr}">LẦN ${item.rev_num}</span>
                                    ${tag}
                                </div>
                                <span class="text-[11px] text-slate-500 font-mono">${item.created_at || ''}</span>
                            </div>
                            <div class="mt-2 text-xs font-bold text-slate-800">
                                "${item.reason || item.full_text || ''}"
                            </div>
                            <div class="mt-1 flex items-center justify-between text-[11px] text-slate-500">
                                <span>Thực hiện bởi: <b>${item.created_by || 'Hệ thống'}</b></span>
                                <span class="font-mono text-slate-600">${item.full_text || ''}</span>
                            </div>
                        </div>
                    `;
                });
                list.innerHTML = h;
            }
            if (window.lucide) lucide.createIcons();
            modal.classList.remove('hidden');
        }

        function closeBeoAmendHistoryModal() {
            const modal = document.getElementById('modalBeoAmendHistory');
            if (modal) modal.classList.add('hidden');
        }

async function loadBeoData(bookId) {
            try {
                const res = await fetch(`/api/beo/${bookId}`);
                if (!res.ok) {
                    alert('Không thể tải thông tin BEO của booking này!');
                    return;
                }
                const data = await res.json();
                currentBeoData = data;
                updateBeoCurrentDisplay(data);

                // Đồng bộ các selector booking
                document.getElementById('beoBookId').value = bookId;
                const cboSel = document.getElementById('cboBeoBookingSelect');
                if (cboSel && cboSel.value !== bookId) cboSel.value = bookId;
                const qInp = document.getElementById('beoQuickSearchInput');
                if (qInp) qInp.value = bookId;

                // 1. Header Metadata
                try {
                    document.getElementById('beoMasterEO').value = data.master_eo || '';
                    if (document.getElementById('beoOrderDate')) {
                        document.getElementById('beoOrderDate').value = data.order_date || '';
                    }
                    document.getElementById('beoPreparedBy').value = data.prepared_by_name || data.prepared_by || '';
                    document.getElementById('beoEndorsedBy').value = data.endorsed_by_name || data.endorsed_by || '';
                    if (document.getElementById('beoAmendment')) {
                        document.getElementById('beoAmendment').value = data.amendment || '';
                    }
                    if (document.getElementById('beoEoTitle')) {
                        document.getElementById('beoEoTitle').value = data.eo_title || 'PHIẾU ĐẶT SỰ KIỆN';
                    }
                    currentBeoAmendHistory = data.amendment_history || [];
                    const amendBadge = document.getElementById('beoAmendCountBadge');
                    if (amendBadge) amendBadge.textContent = currentBeoAmendHistory.length;
                    const amendInp = document.getElementById('beoAmendment');
                    if (amendInp && !amendInp.value) {
                        const nRev = data.next_amendment_rev || (currentBeoAmendHistory.length + 1);
                        amendInp.placeholder = `Vd: Đổi menu chay (hệ thống sẽ tự gán lần ${nRev})`;
                    }
                } catch (eMeta) {
                    console.error("Meta parse error:", eMeta);
                }

                // 2. Client & Contract info
                try {
                    document.getElementById('beoEventDateStr').value = data.event_date || '';
                    const selET = document.getElementById('beoEventType');
                    if (selET) {
                        const targetType = data.event_type || 'Meeting';
                        const exists = Array.from(selET.options).some(o => o.value.toLowerCase() === targetType.toLowerCase());
                        if (!exists && targetType) {
                            const customOpt = document.createElement('option');
                            customOpt.value = targetType;
                            customOpt.textContent = targetType;
                            selET.appendChild(customOpt);
                        }
                        selET.value = targetType;
                    }
                    document.getElementById('beoCompany').value = data.company || '';
                    document.getElementById('beoContactPerson').value = data.contact_person || '';
                    document.getElementById('beoEndUser').value = data.end_user || '';
                    document.getElementById('beoPhone').value = data.phone || '';
                    document.getElementById('beoOfficePhone').value = data.office_phone || '';
                    document.getElementById('beoBookCode').value = data.book_code || '';
                    document.getElementById('beoAddress').value = data.address || '';
                    document.getElementById('beoBillTo').value = data.bill_to || '';
                    if (document.getElementById('beoTaxCode')) document.getElementById('beoTaxCode').value = data.tax_code || '';
                    if (document.getElementById('beoBillAddress')) document.getElementById('beoBillAddress').value = data.bill_address || data.address || '';
                } catch (eCli) {
                    console.error("Client parse error:", eCli);
                }

                // 3. Pricing & Deposit
                try {
                    document.getElementById('beoDeposit').value = data.deposit || 0;
                    document.getElementById('beoPaymentMethod').value = data.payment_method || '';
                    document.getElementById('beoPaymentNotes').value = data.payment_notes || '';
                    document.getElementById('beoBasePrice').value = data.base_price || '';
                } catch (ePr) {
                    console.error("Pricing parse error:", ePr);
                }

                // 4. Charges breakdown table & Master charges dropdown
                try {
                    renderBeoChargesTable();
                    await populateBeoMasterCharges();
                    if (document.getElementById('beoAddChargeQty')) {
                        document.getElementById('beoAddChargeQty').value = (data.gua_pax || data.pax || 1);
                    }
                } catch (eChg) {
                    console.error("Charges parse error:", eChg);
                }

                // 5. Department notes (All 9 standard hotel departments)
                try {
                    const dNotes = data.department_notes || {};
                    ['001', '002', '003', '004', '006', '008', '010', '013', '015'].forEach(code => {
                        const el = document.getElementById(`beoNote${code}`);
                        if (el) {
                            el.value = dNotes[code] || '';
                            autoResizeTextarea(el);
                        }
                    });
                } catch (eDept) {
                    console.error("Dept notes parse error:", eDept);
                }

                // 6. Right Column: Room Schedules
                try {
                    const tblRooms = document.getElementById('beoTblRoomsSchedule');
                    if (tblRooms) {
                        tblRooms.innerHTML = '';
                        if (data.room_schedules && data.room_schedules.length > 0) {
                            data.room_schedules.forEach(rs => {
                                const tr = document.createElement('tr');
                                const tIn = rs.time_in || '08:00';
                                const tOut = rs.time_out || '22:00';
                                const rName = rs.room || 'Sảnh Hội Nghị';
                                const fType = rs.function_type ? `<span class="text-[10px] font-semibold text-slate-500 ml-1">(${rs.function_type})</span>` : '';
                                tr.innerHTML = `
                                    <td class="p-2 font-mono font-bold text-slate-800">${tIn}</td>
                                    <td class="p-2 font-mono font-bold text-slate-800">${tOut}</td>
                                    <td class="p-2 font-bold text-blue-900">* ${rName} ${fType}</td>
                                `;
                                tblRooms.appendChild(tr);
                            });
                        } else {
                            tblRooms.innerHTML = `<tr><td colspan="3" class="p-3 text-center text-slate-400 italic">Chưa có lịch phòng cụ thể cho đơn tiệc này</td></tr>`;
                        }
                    }
                } catch (eSched) {
                    console.error("Room schedule render error:", eSched);
                }

                // 7. Setup, Beverage, Menus, Welcome banner, Pax
                try {
                    document.getElementById('beoWelcomeInfo').value = data.welcome_info || '';
                    document.getElementById('beoGuaPaxStr').value = data.gua_pax ? `${data.gua_pax} Pax` : '';
                    document.getElementById('beoExpPaxStr').value = data.exp_pax ? `${data.exp_pax} Pax` : '';
                    document.getElementById('beoRoomSetup').value = data.room_setup || '';
                    document.getElementById('beoBeverage').value = data.beverage || 'ÁP THEO BẢNG GIÁ TIỆC KS';
                    document.getElementById('beoMenuDetail').value = data.menu_detail || '';
                } catch (eFnb) {
                    console.error("F&B parse error:", eFnb);
                }

                // 8. Existing Notice Banner
                try {
                    const notice = document.getElementById('beoExistingNotice');
                    if (data.master_eo) {
                        notice.className = 'p-3 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-lg text-xs flex items-center justify-between';
                        notice.innerHTML = `
                            <div class="flex items-center gap-2">
                                <i data-lucide="check-circle" class="w-4 h-4 text-emerald-600"></i>
                                <span>Đơn tiệc đã phát hành Lệnh BEO chính thức: <strong>#${data.master_eo}</strong> (Ngày lập: ${data.order_date})</span>
                            </div>
                            <span class="text-[11px] font-bold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded">Người lập: ${data.prepared_by_name}</span>
                        `;
                    } else {
                        notice.className = 'p-3 bg-amber-50 border border-amber-200 text-amber-800 rounded-lg text-xs flex items-center justify-between';
                        notice.innerHTML = `
                            <div class="flex items-center gap-2">
                                <i data-lucide="alert-circle" class="w-4 h-4 text-amber-600"></i>
                                <span>Đơn tiệc này chưa phát hành BEO. Khi lưu, doanh thu sẽ tự động bảo lưu cho bạn!</span>
                            </div>
                        `;
                    }
                } catch (eNot) {
                    console.error("Notice banner error:", eNot);
                }

                lucide.createIcons();
            } catch (err) {
                console.error("Error loading BEO:", err);
            }
        }

        function renderBeoChargesTable() {
            const tblCharges = document.getElementById('beoTblCharges');
            if (!tblCharges) return;
            tblCharges.innerHTML = '';
            const list = (currentBeoData && currentBeoData.charges_detail) ? currentBeoData.charges_detail : [];
            let total = 0;
            if (list.length > 0) {
                list.forEach((ch, idx) => {
                    const amt = parseFloat(ch.amount) || 0;
                    total += amt;
                    const tr = document.createElement('tr');
                    tr.className = 'hover:bg-slate-50 transition border-b border-slate-100';
                    tr.innerHTML = `
                        <td class="p-2 font-bold text-slate-800">${ch.item}</td>
                        <td class="p-2 text-slate-600 font-mono text-[11px]">${ch.desc || (formatVND(ch.price) + ' x ' + (ch.quantity || 1))}</td>
                        <td class="p-2 text-right font-mono font-bold text-emerald-700">${formatVND(amt)}</td>
                        <td class="p-2 text-center no-print">
                            <button type="button" onclick="removeBeoCharge(${idx})" class="p-1 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded transition" title="Xóa dịch vụ">
                                <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                            </button>
                        </td>
                    `;
                    tblCharges.appendChild(tr);
                });
            } else {
                tblCharges.innerHTML = `<tr><td colspan="4" class="p-4 text-center text-slate-400 italic">Chưa có chi tiết giá dịch vụ. Bạn có thể thêm dịch vụ ở khung bên dưới.</td></tr>`;
            }
            if (currentBeoData) currentBeoData.total_charges = total;
            const lblTotal = document.getElementById('beoTotalCharges');
            if (lblTotal) lblTotal.textContent = formatVND(total);
            lucide.createIcons();
        }

        function removeBeoCharge(index) {
            if (!currentBeoData || !currentBeoData.charges_detail) return;
            currentBeoData.charges_detail.splice(index, 1);
            renderBeoChargesTable();
        }

        async function populateBeoMasterCharges() {
            const sel = document.getElementById('beoAddChargeLoai');
            if (!sel) return;
            if (!masterCharges || masterCharges.length === 0) {
                try {
                    const res = await fetch('/api/master/charges');
                    if (res.ok) masterCharges = await res.json();
                } catch (e) {
                    console.error("Failed to load master charges:", e);
                }
            }
            if (!masterCharges || masterCharges.length === 0) return;

            sel.innerHTML = '<option value="">-- Bấm chọn dịch vụ từ CSDL (87 loại) --</option>';

            const groupNames = {
                '02': 'Nước uống & Freeflow (Drinks)',
                '03': 'Phụ thu, Âm thanh, Ánh sáng & Trang trí',
                '04': 'Ẩm thực & Tiệc (Food & Teabreak)',
                '05': 'Phòng lưu trú & Phụ thu phòng',
                '06': 'Gói hội nghị trọn gói (Packages)'
            };

            const groups = {};
            masterCharges.forEach(ch => {
                const g = ch.group || 'OTHER';
                if (!groups[g]) groups[g] = [];
                groups[g].push(ch);
            });

            Object.keys(groups).sort().forEach(gKey => {
                const grpLabel = groupNames[gKey] || `Nhóm dịch vụ ${gKey}`;
                const optGroup = document.createElement('optgroup');
                optGroup.label = grpLabel;
                groups[gKey].forEach(ch => {
                    const opt = document.createElement('option');
                    opt.value = ch.code;
                    const priceTag = (ch.price && ch.price > 0) ? ` -- [${formatVND(ch.price)} / ${ch.unit || 'mục'}]` : '';
                    opt.textContent = `${ch.name}${priceTag}`;
                    optGroup.appendChild(opt);
                });
                sel.appendChild(optGroup);
            });
        }

        function onSelectBeoChargeMaster(sel) {
            if (!sel || !sel.value) return;
            const ch = masterCharges.find(x => x.code === sel.value);
            if (ch) {
                const nameEl = document.getElementById('beoAddChargeName');
                nameEl.value = ch.name;
                nameEl.dataset.selectedCode = ch.code;
                
                // BỎ ĐƠN GIÁ SẴN: NGƯỜI DÙNG TỰ NHẬP SỐ TIỀN THỰC TẾ
                const priceEl = document.getElementById('beoAddChargePrice');
                if (priceEl) {
                    priceEl.value = '';
                    priceEl.placeholder = 'Nhập số tiền (VNĐ)...';
                    priceEl.focus();
                }

                // TỰ ĐỘNG GÁN SỐ LƯỢNG THEO LOẠI DỊCH VỤ
                const qtyEl = document.getElementById('beoAddChargeQty');
                if (qtyEl) {
                    if (ch.per_pax) {
                        const pax = (currentBeoData && (currentBeoData.gua_pax || currentBeoData.pax)) || 1;
                        qtyEl.value = pax;
                    } else {
                        qtyEl.value = 1;
                    }
                }
            }
        }

        function quickSelectCharge(presetName, defaultPrice, defaultQty) {
            const nameEl = document.getElementById('beoAddChargeName');
            nameEl.value = presetName;
            
            // Người dùng tự nhập số tiền, chỉ gợi ý placeholder
            const priceEl = document.getElementById('beoAddChargePrice');
            if (priceEl) {
                priceEl.value = '';
                priceEl.placeholder = defaultPrice ? `Gợi ý: ${formatVND(defaultPrice)}` : 'Nhập đơn giá...';
                priceEl.focus();
            }

            const qtyEl = document.getElementById('beoAddChargeQty');
            if (qtyEl) {
                if (defaultQty) {
                    qtyEl.value = defaultQty;
                } else if (currentBeoData && (currentBeoData.gua_pax || currentBeoData.pax)) {
                    qtyEl.value = currentBeoData.gua_pax || currentBeoData.pax;
                } else {
                    qtyEl.value = 1;
                }
            }
        }

        function addBeoChargePreset(presetName, defaultPrice) {
            quickSelectCharge(presetName, defaultPrice);
        }

        function addBeoChargeItem() {
            if (!currentBeoData) {
                alert('Vui lòng chọn hoặc nạp một đơn tiệc trước khi thêm dịch vụ!');
                return;
            }
            const nameEl = document.getElementById('beoAddChargeName');
            const name = nameEl.value.trim();
            const qty = parseFloat(document.getElementById('beoAddChargeQty').value) || 1;
            const price = parseFloat(document.getElementById('beoAddChargePrice').value) || 0;

            if (!name) {
                alert('Vui lòng nhập tên dịch vụ hoặc diễn giải hạng mục!');
                return;
            }

            if (!currentBeoData.charges_detail) currentBeoData.charges_detail = [];

            const amt = qty * price;
            const desc = (price > 0 && qty > 1) ? `${formatVND(price)} x ${qty} khách` : (price > 0 ? formatVND(price) : '');
            
            const sel = document.getElementById('beoAddChargeLoai');
            let code = (sel && sel.value) ? sel.value : (nameEl.dataset.selectedCode || '');
            if (!code && masterCharges && masterCharges.length > 0) {
                const found = masterCharges.find(m => m.name.toLowerCase() === name.toLowerCase());
                if (found) code = found.code;
            }

            currentBeoData.charges_detail.push({
                item: name,
                charge_code: code || '50',
                desc: desc,
                quantity: qty,
                price: price,
                amount: amt,
                note: name
            });

            renderBeoChargesTable();

            // Clear inputs
            nameEl.value = '';
            delete nameEl.dataset.selectedCode;
            document.getElementById('beoAddChargePrice').value = '';
            document.getElementById('beoAddChargePrice').placeholder = '0';
            if (sel) sel.value = '';
        }

        async function saveBEO() {
            if (!currentUser) {
                openLoginModal();
                return;
            }
            const bookId = document.getElementById('beoBookId').value.trim();
            if (!bookId) {
                alert('Vui lòng nhập hoặc chọn mã booking!');
                return;
            }

            const guaRaw = document.getElementById('beoGuaPaxStr').value;
            const expRaw = document.getElementById('beoExpPaxStr').value;
            const parseNum = (str) => {
                const m = (str || '').match(/\d+/);
                return m ? parseInt(m[0]) : 0;
            };

            const payload = {
                title: document.getElementById('beoCompany').value.trim() || 'Hội nghị & Tiệc',
                event_date: document.getElementById('beoEventDateStr').value.trim(),
                event_type: document.getElementById('beoEventType').value.trim(),
                company: document.getElementById('beoCompany').value.trim(),
                contact_person: document.getElementById('beoContactPerson').value.trim(),
                end_user: document.getElementById('beoEndUser').value.trim(),
                book_code: document.getElementById('beoBookCode').value.trim(),
                phone: document.getElementById('beoPhone').value.trim(),
                office_phone: document.getElementById('beoOfficePhone').value.trim(),
                address: document.getElementById('beoAddress').value.trim(),
                bill_to: document.getElementById('beoBillTo').value.trim(),
                tax_code: document.getElementById('beoTaxCode') ? document.getElementById('beoTaxCode').value.trim() : '',
                bill_address: document.getElementById('beoAddress') ? document.getElementById('beoAddress').value.trim() : '',
                amendment: document.getElementById('beoAmendment') ? document.getElementById('beoAmendment').value.trim() : '',
                eo_title: document.getElementById('beoEoTitle') ? document.getElementById('beoEoTitle').value.trim() : 'PHIẾU ĐẶT SỰ KIỆN',
                deposit: parseFloat(document.getElementById('beoDeposit').value) || 0,
                payment_method: document.getElementById('beoPaymentMethod').value.trim(),
                payment_notes: document.getElementById('beoPaymentNotes').value.trim(),
                base_price: document.getElementById('beoBasePrice').value.trim(),
                guaranteed_pax: parseNum(guaRaw),
                expected_pax: parseNum(expRaw),
                welcome_info: document.getElementById('beoWelcomeInfo').value.trim(),
                room_setup: document.getElementById('beoRoomSetup').value.trim(),
                drinks_detail: document.getElementById('beoBeverage').value.trim(),
                menu_detail: document.getElementById('beoMenuDetail').value.trim(),
                beo_user: (currentUser ? currentUser.username : "ADMIN"),
                charges_detail: (currentBeoData && currentBeoData.charges_detail) ? currentBeoData.charges_detail : [],
                endorsed_by: document.getElementById('beoEndorsedBy').value.trim(),
                                department_notes: {
                    '001': document.getElementById('beoNote001') ? document.getElementById('beoNote001').value.trim() : '',
                    '002': document.getElementById('beoNote002') ? document.getElementById('beoNote002').value.trim() : '',
                    '003': document.getElementById('beoNote003') ? document.getElementById('beoNote003').value.trim() : '',
                    '004': document.getElementById('beoNote004') ? document.getElementById('beoNote004').value.trim() : '',
                    '006': document.getElementById('beoNote006') ? document.getElementById('beoNote006').value.trim() : '',
                    '008': document.getElementById('beoNote008') ? document.getElementById('beoNote008').value.trim() : '',
                    '010': document.getElementById('beoNote010') ? document.getElementById('beoNote010').value.trim() : '',
                    '013': document.getElementById('beoNote013') ? document.getElementById('beoNote013').value.trim() : '',
                    '015': document.getElementById('beoNote015') ? document.getElementById('beoNote015').value.trim() : ''
                }
            };

            try {
                const res = await fetch(`/api/beo/${bookId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (!res.ok) {
                    alert(data.detail || 'Lỗi lưu BEO!');
                    return;
                }

                alert(`LƯU & PHÁT HÀNH LỆNH BEO THÀNH CÔNG!\n\nSố Master EO: ${data.master_eo}\nDoanh thu sự kiện chính thức được bảo lưu cho: ${currentUser.full_name} (${currentUser.username})`);
                await loadBeoData(bookId);
            } catch (err) {
                alert('Lỗi kết nối khi lưu BEO!');
            }
        }

        function printCurrentBEO() {
            const bookId = document.getElementById('beoBookId').value.trim();
            if (!bookId) {
                alert('Vui lòng chọn hoặc nhập một mã đơn booking để in BEO!');
                return;
            }

            const selLayout = document.getElementById('selBeoPrintLayout');
            const layoutMode = selLayout ? selLayout.value : 'auto';

            const parseNum = (str) => {
                const m = (str || '').match(/\d+/);
                return m ? parseInt(m[0]) : 0;
            };

            const guaPax = parseNum(document.getElementById('beoGuaPaxStr').value);
            const expPax = parseNum(document.getElementById('beoExpPaxStr').value);

            // Gathers LIVE values directly from active on-screen form inputs
            const b = {
                book_id: bookId,
                master_eo: document.getElementById('beoMasterEO').value.trim(),
                order_date: document.getElementById('beoOrderDate') ? document.getElementById('beoOrderDate').value.trim() : ((currentBeoData && currentBeoData.order_date) || ''),
                prepared_by_name: document.getElementById('beoPreparedBy').value.trim() || (currentUser ? currentUser.full_name : ''),
                endorsed_by_name: document.getElementById('beoEndorsedBy').value.trim(),
                event_date: document.getElementById('beoEventDateStr').value.trim(),
                event_type: document.getElementById('beoEventType').value.trim(),
                company: document.getElementById('beoCompany').value.trim(),
                contact_person: document.getElementById('beoContactPerson').value.trim(),
                end_user: document.getElementById('beoEndUser').value.trim(),
                phone: document.getElementById('beoPhone').value.trim(),
                office_phone: document.getElementById('beoOfficePhone').value.trim(),
                book_code: document.getElementById('beoBookCode').value.trim(),
                address: document.getElementById('beoAddress').value.trim(),
                bill_to: document.getElementById('beoBillTo').value.trim(),
                tax_code: (document.getElementById('beoTaxCode') ? document.getElementById('beoTaxCode').value.trim() : '') || (currentBeoData && currentBeoData.tax_code) || '',
                bill_address: (document.getElementById('beoBillAddress') ? document.getElementById('beoBillAddress').value.trim() : '') || (currentBeoData && currentBeoData.bill_address) || (document.getElementById('beoAddress') ? document.getElementById('beoAddress').value.trim() : ''),
                amendment: document.getElementById('beoAmendment') ? document.getElementById('beoAmendment').value.trim() : ((currentBeoData && currentBeoData.amendment) || ''),
                eo_title: document.getElementById('beoEoTitle') ? document.getElementById('beoEoTitle').value.trim() : ((currentBeoData && currentBeoData.eo_title) || 'PHIẾU ĐẶT SỰ KIỆN'),
                deposit: parseFloat(document.getElementById('beoDeposit').value) || 0,
                payment_method: document.getElementById('beoPaymentMethod').value.trim(),
                payment_notes: document.getElementById('beoPaymentNotes').value.trim(),
                base_price: document.getElementById('beoBasePrice').value.trim(),
                menu_price: (currentBeoData && currentBeoData.menu_price) || 0,
                charges_detail: (currentBeoData && currentBeoData.charges_detail) || [],
                total_charges: (currentBeoData && currentBeoData.total_charges) || 0,
                charge_notes: (currentBeoData && currentBeoData.charge_notes) || 'Prices are in VND and inclusive VAT and service charge.',
                room_schedules: (currentBeoData && currentBeoData.room_schedules) || [],
                welcome_info: document.getElementById('beoWelcomeInfo').value.trim(),
                gua_pax: guaPax || (currentBeoData ? currentBeoData.gua_pax : 0),
                exp_pax: expPax || (currentBeoData ? currentBeoData.exp_pax : 0),
                room_setup: document.getElementById('beoRoomSetup').value.trim(),
                beverage: document.getElementById('beoBeverage').value.trim(),
                menu_detail: document.getElementById('beoMenuDetail').value.trim(),
                                department_notes: {
                    '001': document.getElementById('beoNote001') ? document.getElementById('beoNote001').value.trim() : '',
                    '002': document.getElementById('beoNote002') ? document.getElementById('beoNote002').value.trim() : '',
                    '003': document.getElementById('beoNote003') ? document.getElementById('beoNote003').value.trim() : '',
                    '004': document.getElementById('beoNote004') ? document.getElementById('beoNote004').value.trim() : '',
                    '006': document.getElementById('beoNote006') ? document.getElementById('beoNote006').value.trim() : '',
                    '008': document.getElementById('beoNote008') ? document.getElementById('beoNote008').value.trim() : '',
                    '010': document.getElementById('beoNote010') ? document.getElementById('beoNote010').value.trim() : '',
                    '013': document.getElementById('beoNote013') ? document.getElementById('beoNote013').value.trim() : '',
                    '015': document.getElementById('beoNote015') ? document.getElementById('beoNote015').value.trim() : ''
                }
            };

            if (layoutMode === 'grid2col') {
                renderModernGridBEO(b);
            } else if (layoutMode === '1page' || layoutMode === '2page') {
                renderAuthenticMerPerleBEO(b);
            } else {
                // Mặc định luôn là Mẫu Sự Kiện Từng Buổi chuẩn mới
                renderSessionGridBEO(b);
            }
            // Tạm thời xóa title để triệt tiêu hoàn toàn header rác của trình duyệt khi in
            const origTitle = document.title;
            document.title = "";
            window.print();
            setTimeout(() => { document.title = origTitle; }, 1000);
        }

        function renderAuthenticMerPerleBEO(b) {
            const printArea = document.getElementById('beoPrintArea');
            const dNotes = b.department_notes || {};

            // Render Charges rows (HIỂN THỊ CHUẨN TÊN DỊCH VỤ, SỐ TIỀN & DIỄN GIẢI)
            let chargesHtml = '';
            if (b.charges_detail && b.charges_detail.length > 0) {
                b.charges_detail.forEach(ch => {
                    const amt = parseFloat(ch.amount) || (parseFloat(ch.price || 0) * parseFloat(ch.quantity || 1));
                    const descText = ch.desc || ((ch.price && ch.quantity > 1) ? `${formatVND(ch.price)} x ${ch.quantity} khách` : (ch.price ? formatVND(ch.price) : ''));
                    chargesHtml += `
                        <tr>
                            <td style="padding: 2px 4px; border: 1px solid #111; font-weight: bold;">${ch.item}</td>
                            <td style="padding: 2px 4px; border: 1px solid #111; text-align: right; font-weight: bold; font-family: monospace;">${formatVND(amt)}</td>
                            <td style="padding: 2px 4px; border: 1px solid #111; font-size: 8.5px;">${descText}</td>
                        </tr>
                    `;
                });
            } else {
                const mPrice = parseFloat(b.menu_price || 0);
                const pCount = parseInt(b.gua_pax || 1);
                const totalM = mPrice * pCount;
                chargesHtml = `
                    <tr>
                        <td style="padding: 2px 4px; border: 1px solid #111; font-weight: bold;">Menu chính</td>
                        <td style="padding: 2px 4px; border: 1px solid #111; text-align: right; font-weight: bold; font-family: monospace;">${formatVND(totalM)}</td>
                        <td style="padding: 2px 4px; border: 1px solid #111; font-size: 8.5px;">${mPrice > 0 ? formatVND(mPrice) + ' x ' + pCount + ' khách' : ''}</td>
                    </tr>
                `;
            }

            // Render Rooms Schedule rows
            let roomsHtml = '';
            if (b.room_schedules && b.room_schedules.length > 0) {
                b.room_schedules.slice(0, 5).forEach(rs => {
                    roomsHtml += `
                        <tr>
                            <td style="padding: 2px 4px; border: 1px solid #111; text-align: center; font-weight: bold;">${rs.time_in}</td>
                            <td style="padding: 2px 4px; border: 1px solid #111; text-align: center; font-weight: bold;">${rs.time_out}</td>
                            <td style="padding: 2px 4px; border: 1px solid #111; font-weight: bold;">* ${rs.room}</td>
                        </tr>
                    `;
                });
            } else {
                roomsHtml = `
                    <tr>
                        <td style="padding: 2px 4px; border: 1px solid #111; text-align: center; font-weight: bold;">08:00:00</td>
                        <td style="padding: 2px 4px; border: 1px solid #111; text-align: center; font-weight: bold;">22:00:00</td>
                        <td style="padding: 2px 4px; border: 1px solid #111; font-weight: bold;">* Sảnh Chính</td>
                    </tr>
                `;
            }

            // Quyết định dàn trang: Tự động, ép 1 trang, hoặc dàn 2 trang
            const selLayout = document.getElementById('selBeoPrintLayout');
            const layoutMode = selLayout ? selLayout.value : 'auto';
            const menuLen = (b.menu_detail || '').length;
            const notesLen = Object.values(dNotes).join('').length;
            
            let isSinglePage = false;
            if (layoutMode === '1page') {
                isSinglePage = true;
            } else if (layoutMode === '2page') {
                isSinglePage = false;
            } else {
                // Tự động: tiệc ngắn gọn (dưới 600 ký tự menu & dưới 750 ký tự notes) -> Dàn đều 1 trang A4!
                isSinglePage = (menuLen < 600 && notesLen < 750);
            }

            if (isSinglePage) {
                // ==================== BẢN IN TRỌN VẸN 1 TRANG A4 (CHO TIỆC GỌN / AUTO-FIT) ====================
                printArea.innerHTML = `
                    <div class="beo-page beo-page-1page" style="width: 100%; max-width: 196mm; margin: 0 auto; padding: 2mm 3mm; box-sizing: border-box; font-family: Arial, Helvetica, sans-serif; font-size: 9.5px; color: #000; line-height: 1.2;">
                        <!-- HEADER -->
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 4px;">
                            <div style="width: 28%;">
                                <h2 style="margin: 0; font-size: 13px; font-weight: bold; color: #1e3a8a;">MerPerle DaLat Hotel</h2>
                            </div>
                            <div style="width: 40%; text-align: center;">
                                <h1 style="margin: 0; font-size: 14.5px; font-weight: bold; color: #dc2626; letter-spacing: 0.5px;">${b.eo_title || 'PHIẾU ĐẶT SỰ KIỆN'}</h1>
                                ${b.amendment ? `<div style="font-size: 8.5px; color: #b91c1c; font-weight: bold; margin-top: 1px;">Điều chỉnh: ${b.amendment}</div>` : ''}
                            </div>
                            <div style="width: 32%; font-size: 9px;">
                                <table style="width: 100%; border-collapse: collapse;">
                                    <tr>
                                        <td style="padding: 1px; font-weight: bold;">Số E.O:</td>
                                        <td style="padding: 1px; font-family: monospace; font-weight: bold;">${b.master_eo || 'TỰ ĐỘNG'}</td>
                                        <td style="padding: 1px; font-weight: bold;">Chuẩn bị bởi:</td>
                                        <td style="padding: 1px; font-weight: bold;">${b.prepared_by_name}</td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 1px; font-weight: bold;">NGÀY:</td>
                                        <td style="padding: 1px;">${b.order_date || ''}</td>
                                        <td style="padding: 1px; font-weight: bold;">Người hỗ trợ:</td>
                                        <td style="padding: 1px; font-weight: bold;">${b.endorsed_by_name || ''}</td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- 2-COLUMN MAIN BODY (1 TRANG) -->
                        <div style="display: flex; gap: 5px;">
                            <!-- CỘT TRÁI (WIDTH ~ 53%) -->
