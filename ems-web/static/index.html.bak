        if (el) el.classList.toggle('hidden', t !== tabId);
    });
    ['tabBtnDtl1', 'tabBtnDtl2', 'tabBtnDtl3', 'tabBtnDtl4'].forEach(b => {
        const el = document.getElementById(b);
        if (el) {
            const isActive = b === ('tabBtn' + tabId.replace('tab', ''));
            el.className = isActive 
                ? 'px-4 py-2.5 rounded-t-lg border-b-2 border-blue-600 text-blue-600 bg-white font-bold flex items-center gap-2'
                : 'px-4 py-2.5 rounded-t-lg border-b-2 border-transparent text-slate-500 hover:text-slate-800 flex items-center gap-2 font-bold';
        }
    });
}

