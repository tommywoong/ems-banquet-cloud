            <!-- VIEW 9: AUDIT TRAIL (NHẬT KÝ THAO TÁC - CHỈ ADMIN) -->
            <section id="viewAudit" class="hidden space-y-4">
                <!-- Unauthorized Warning (Shown if user is not admin) -->
                <div id="auditAccessDenied" class="hidden p-8 bg-amber-50 border border-amber-200 rounded-2xl text-center space-y-3">
                    <div class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-600 flex items-center justify-center mx-auto">
                        <i data-lucide="shield-alert" class="w-6 h-6"></i>
                    </div>
                    <h3 class="text-sm font-bold text-amber-900 uppercase">Quyền Truy Cập Bị Hạn Chế</h3>
                    <p class="text-xs text-amber-800 max-w-md mx-auto">
                        Chức năng xem Nhật Ký Thao Tác (Audit Trail) được phân quyền bảo mật <strong>chỉ dành riêng cho tài khoản Quản Trị Viên (ADMIN)</strong>. Tài khoản nhân viên thông thường không có quyền xem nhật ký này.
                    </p>
                </div>

                <!-- Admin Audit Container -->
                <div id="auditContent" class="space-y-4">
                    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm space-y-3">
                        <div class="flex flex-wrap items-center justify-between gap-4">
                            <div>
                                <h3 class="text-sm font-bold text-slate-800 flex items-center gap-2">
                                    <i data-lucide="shield-check" class="w-4 h-4 text-emerald-600"></i>
                                    <span>NHẬT KÝ THAO TÁC HỆ THỐNG (AUDIT TRAIL)</span>
                                </h3>
                                <p class="text-xs text-slate-500">Toàn bộ thao tác đăng nhập, tạo tiệc, dời lịch, sửa đổi và hủy tiệc được ghi bất biến vào cơ sở dữ liệu độc lập.</p>
                            </div>

                            <button onclick="loadAuditLogs()" class="px-3.5 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-bold transition flex items-center gap-1.5 shadow-sm">
                                <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i>
                                <span>Làm Mới</span>
                            </button>
                        </div>

                        <!-- Audit Filters -->
                        <div class="flex flex-wrap items-center gap-3 pt-2 border-t border-slate-100 text-xs">
                            <div class="flex items-center gap-1.5">
                                <label class="font-bold text-slate-600">Nhân viên:</label>
                                <select id="selAuditUser" onchange="loadAuditLogs()" class="p-1.5 border border-slate-200 rounded-lg font-medium text-slate-700"></select>
                            </div>

                            <div class="flex items-center gap-1.5">
                                <label class="font-bold text-slate-600">Hành động:</label>
                                <select id="selAuditAction" onchange="loadAuditLogs()" class="p-1.5 border border-slate-200 rounded-lg font-medium text-slate-700">
                                    <option value="ALL">Tất cả hành động</option>
                                    <option value="LOGIN">Đăng nhập (LOGIN)</option>
                                    <option value="CREATE_BOOKING">Tạo đơn tiệc (CREATE)</option>
                                    <option value="UPDATE_BOOKING">Sửa đơn tiệc (UPDATE)</option>
                                    <option value="CANCEL_BOOKING">Hủy đơn tiệc (CANCEL)</option>
                                    <option value="CONFIRM_BOOKING">Chốt tiệc (CONFIRM)</option>
                                    <option value="SAVE_BEO">Lập BEO (SAVE_BEO)</option>
                                </select>
                            </div>

                            <div class="flex items-center gap-1.5">
