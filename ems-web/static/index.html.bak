                const card = document.createElement('div');
                card.className = 'p-3 rounded-lg border border-slate-200 bg-slate-50 space-y-1';
                card.innerHTML = `
                    <div class="flex items-center justify-between font-bold text-slate-800">
                        <span class="text-blue-700">${dn.dept_name}</span>
                        <span class="text-[10px] text-slate-400 font-mono">${dn.dept_code}</span>
                    </div>
                    <p class="text-slate-600 whitespace-pre-line text-[11px]">${dn.note || 'Không có chỉ đạo'}</p>
                `;
                deptContainer.appendChild(card);
            });
        }

    } catch (err) {
        console.error(err);
        document.getElementById('dtlTitle').textContent = 'Lỗi: ' + err.message;
    }
}

function closeBookingDetailModal() {
    const modal = document.getElementById('modalBookingDetail');
    if (modal) modal.classList.add('hidden');
}

function printModalBookingDetail() {
    if (!currentBookingDetail) return;
    window.print();
}


// ==================== STICKY HORIZONTAL SCROLL SYNC & DRAG FOR WEB ====================
function initStickyTableScrollWeb() {
    const tableWrapper = document.getElementById('webBookingsTableWrapper');
    const scrollTrack = document.getElementById('webSyncedScrollTrack');
    const scrollDummy = document.getElementById('webSyncedScrollDummy');
    const controller = document.getElementById('stickyWebBookingsScrollController');

    if (!tableWrapper) return;

    // 1. Mouse Drag to Scroll (Giữ chuột trái để kéo trượt ngang bảng)
    if (!tableWrapper._dragInit) {
        tableWrapper._dragInit = true;
        let isDown = false;
        let startX = 0;
        let scrollStart = 0;
        let hasMoved = false;

        tableWrapper.style.cursor = 'grab';

        tableWrapper.addEventListener('mousedown', (e) => {
            // Chỉ nhận chuột trái (button 0)
            if (e.button !== 0) return;
            // Bỏ qua nếu bấm vào button, link, thẻ input, select
            if (e.target.closest('button, a, input, select, textarea, [onclick]')) return;

            isDown = true;
            hasMoved = false;
            tableWrapper.style.cursor = 'grabbing';
            tableWrapper.style.userSelect = 'none';
            startX = e.pageX - tableWrapper.offsetLeft;
            scrollStart = tableWrapper.scrollLeft;
        });

        window.addEventListener('mouseup', () => {
            if (!isDown) return;
            isDown = false;
            tableWrapper.style.cursor = 'grab';
            tableWrapper.style.removeProperty('user-select');
        });

        tableWrapper.addEventListener('mousemove', (e) => {
            if (!isDown) return;
            e.preventDefault();
            const x = e.pageX - tableWrapper.offsetLeft;
            const walk = (x - startX) * 1.6; // Hệ số cuộn nhanh mượt
            if (Math.abs(walk) > 4) {
                hasMoved = true;
            }
            tableWrapper.scrollLeft = scrollStart - walk;
        });

        // Ngăn click nhầm khi vừa kéo chuột
        tableWrapper.addEventListener('click', (e) => {
            if (hasMoved) {
                e.preventDefault();
                e.stopPropagation();
                hasMoved = false;
            }
        }, true);
    }

    if (!scrollTrack || !scrollDummy) return;

    function syncDimensions() {
        const scrollW = tableWrapper.scrollWidth;
        const clientW = tableWrapper.clientWidth;
        scrollDummy.style.width = scrollW + 'px';
        if (scrollW <= clientW + 10) {
            if (controller) controller.classList.add('hidden');
        } else {
            if (controller) controller.classList.remove('hidden');
        }
    }

    let isSyncingLeft = false;
    let isSyncingRight = false;

    tableWrapper.addEventListener('scroll', () => {
        if (!isSyncingLeft) {
            isSyncingRight = true;
            scrollTrack.scrollLeft = tableWrapper.scrollLeft;
            setTimeout(() => { isSyncingRight = false; }, 50);
        }
    });

    scrollTrack.addEventListener('scroll', () => {
        if (!isSyncingRight) {
            isSyncingLeft = true;
            tableWrapper.scrollLeft = scrollTrack.scrollLeft;
            setTimeout(() => { isSyncingLeft = false; }, 50);
        }
    });

    window.addEventListener('resize', syncDimensions);
    setTimeout(syncDimensions, 300);
}

function scrollWebBookingsTable(dir) {
    const tableWrapper = document.getElementById('webBookingsTableWrapper');
    if (!tableWrapper) return;
    if (dir === 'left') {
        tableWrapper.scrollTo({ left: 0, behavior: 'smooth' });
    } else if (dir === 'right') {
        tableWrapper.scrollTo({ left: tableWrapper.scrollWidth, behavior: 'smooth' });
    }
}

