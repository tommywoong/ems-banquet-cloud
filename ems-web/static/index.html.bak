    <!-- MODAL: GỘP KHÁCH HÀNG CRM TRÙNG (MERGE DUPLICATE CUSTOMERS) -->
    <div id="modalMergeCustomer" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-xl w-full p-6 border border-slate-200 space-y-5 animate-in fade-in zoom-in-95 duration-150">
            <div class="flex items-center justify-between border-b pb-3.5">
                <div class="flex items-center gap-2.5">
                    <div class="w-9 h-9 rounded-xl bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold">
                        <i data-lucide="git-merge" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold text-slate-800">HỢP NHẤT & GỘP KHÁCH HÀNG CRM</h3>
                        <p class="text-[11px] text-slate-500">Gộp các mã trùng MST / Tên công ty mà không ảnh hưởng số liệu báo cáo</p>
                    </div>
                </div>
                <button onclick="closeModal('modalMergeCustomer')" class="text-slate-400 hover:text-slate-700">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <div class="bg-indigo-50/70 border border-indigo-200 rounded-xl p-3 text-xs text-indigo-900 space-y-1">
                <div class="font-bold flex items-center gap-1.5 text-indigo-800">
                    <i data-lucide="shield-check" class="w-4 h-4 text-emerald-600"></i>
                    Cam Kết Bảo Toàn Dữ Liệu 100%:
                </div>
                <p class="text-[11px] text-indigo-800">
                    Toàn bộ lịch sử tiệc, doanh thu, cọc và báo cáo trong hệ thống EMS được chuyển giao nguyên vẹn sang mã khách hàng chính.
                </p>
            </div>

            <div class="space-y-4 text-xs">
                <!-- KHÁCH HÀNG CHÍNH (TARGET / GIỮ LẠI) -->
                <div>
                    <label class="block font-bold text-emerald-800 mb-1">
                        1. Khách Hàng CHÍNH (Đích đến - Mã được giữ lại trong hệ thống) *
                    </label>
                    <div class="flex gap-2">
                        <input type="text" id="mergeTargetCode" placeholder="Nhập mã khách chính (ví dụ: 20240617171939698)..." class="flex-1 p-2 border border-emerald-300 rounded-lg font-mono font-bold text-emerald-800 bg-emerald-50/30 text-xs focus:ring-2 focus:ring-emerald-500" />
                    </div>
                    <div id="mergeTargetInfo" class="mt-1 text-[11px] text-slate-500 italic"></div>
                </div>

                <!-- KHÁCH HÀNG CẦN GỘP (SOURCE / TRÙNG LẶP) -->
                <div>
                    <label class="block font-bold text-rose-800 mb-1">
                        2. Khách Hàng PHỤ (Nguồn trùng lặp - Sẽ gộp vào khách chính) *
                    </label>
                    <div class="flex gap-2">
                        <input type="text" id="mergeSourceCode" placeholder="Nhập mã khách phụ cần gộp..." class="flex-1 p-2 border border-rose-300 rounded-lg font-mono font-bold text-rose-800 bg-rose-50/30 text-xs focus:ring-2 focus:ring-rose-500" />
                    </div>
                    <div id="mergeSourceInfo" class="mt-1 text-[11px] text-slate-500 italic"></div>
                </div>
            </div>

            <div class="flex items-center justify-end gap-2.5 pt-3 border-t">
                <button type="button" onclick="closeModal('modalMergeCustomer')" class="px-4 py-2 border border-slate-200 rounded-lg font-semibold text-slate-600 hover:bg-slate-100 text-xs">
                    Hủy Bỏ
                </button>
                <button type="button" id="btnConfirmMerge" onclick="executeCustomerMerge()" class="px-5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-lg text-xs shadow-md transition flex items-center gap-1.5">
                    <i data-lucide="check" class="w-4 h-4"></i>
                    <span>Xác Nhận Hợp Nhất & Gộp Ngay</span>
                </button>
            </div>
        </div>
    </div>

    <script>
        // -------------------------------------------------------------
        // CRM MERGE CUSTOMER ENGINE
        // -------------------------------------------------------------
        function openMergeCustomerModal(sourceCode = '', sourceName = '', sourceTax = '') {
            document.getElementById('mergeTargetCode').value = '';
            document.getElementById('mergeSourceCode').value = sourceCode || '';
            document.getElementById('mergeTargetInfo').textContent = '';
            document.getElementById('mergeSourceInfo').textContent = sourceCode ? `Khách phụ: ${sourceName} (MST: ${sourceTax || 'Chưa có'})` : '';
            document.getElementById('modalMergeCustomer').classList.remove('hidden');
            lucide.createIcons();
        }

        async function executeCustomerMerge() {
            const target = document.getElementById('mergeTargetCode').value.trim();
            const source = document.getElementById('mergeSourceCode').value.trim();
            if (!target || !source) {
                alert('Vui lòng nhập đầy đủ Mã khách chính và Mã khách cần gộp!');
                return;
            }
            if (target === source) {
                alert('Mã khách chính và mã khách phụ không được trùng nhau!');
                return;
            }

            if (!confirm(`Bạn có chắc chắn muốn gộp mã khách phụ [${source}] vào mã khách chính [${target}]?\n\nToàn bộ đơn tiệc và doanh thu sẽ được bảo toàn 100%.`)) {
                return;
            }

            const btn = document.getElementById('btnConfirmMerge');
            btn.disabled = true;
            btn.innerHTML = '<i class="lucide-loader-2 animate-spin w-4 h-4 mr-1 inline-block"></i> Đang hợp nhất...';

            try {
                const res = await fetch('/api/customers/merge', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        target_code: target,
                        source_code: source,
                        username: (currentUser && currentUser.username) ? currentUser.username : 'Admin'
                    })
                });
                const data = await res.json();
                if (!res.ok) {
                    alert('Lỗi: ' + (data.detail || 'Không thể hợp nhất khách hàng!'));
                    return;
                }
                alert(data.message || 'Đã hợp nhất khách hàng thành công!');
                closeModal('modalMergeCustomer');
                searchCust();
            } catch (err) {
                alert('Lỗi kết nối khi gộp khách hàng: ' + err.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i data-lucide="check" class="w-4 h-4 mr-1 inline-block"></i> Xác Nhận Hợp Nhất & Gộp Ngay';
                lucide.createIcons();
            }
        }

        // Preload master charges on startup for instant 0ms BEO dropdown
        window.addEventListener('DOMContentLoaded', () => {
            if (typeof populateBeoMasterCharges === 'function') {
                populateBeoMasterCharges();
            }
        });
    </script>

    <!-- ==================== MODAL: EMERGENCY CUTOFF ALERT POPUP ==================== -->
    <div id="modalCutoffAlert" class="hidden fixed inset-0 z-50 bg-slate-900/80 backdrop-blur-sm flex items-center justify-center p-4 animate-in fade-in duration-200">
        <div class="bg-white rounded-2xl shadow-2xl border-2 border-rose-500 max-w-3xl w-full max-h-[90vh] flex flex-col overflow-hidden">
            <!-- Modal Header -->
            <div class="p-4 bg-gradient-to-r from-rose-600 to-amber-600 text-white flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-white/20 flex items-center justify-center text-white font-bold shrink-0 animate-pulse">
                        <i data-lucide="bell-ring" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-black tracking-wide uppercase">CẢNH BÁO: ĐƠN TIỆC SẮP HẾT HẠN KHÓA SẢNH (CUTOFF DATE)</h3>
                        <p class="text-xs text-rose-100">Phát hiện các đơn tiệc Giữ chỗ (Tentative) còn &le; 1 ngày hoặc đã quá hạn khóa sảnh!</p>
                    </div>
                </div>
                <button onclick="closeModal('modalCutoffAlert')" class="p-1.5 hover:bg-white/20 rounded-lg text-white transition cursor-pointer">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <!-- Modal Body Table -->
            <div class="p-4 overflow-y-auto flex-1 space-y-3">
                <p class="text-xs text-slate-600">
                    Vui lòng kiểm tra với khách hàng để chốt hợp đồng hoặc <strong>mở khóa sảnh (Hủy đơn)</strong> nhằm tránh chiếm dụng sảnh tiệc:
                </p>
                <div class="overflow-x-auto border border-slate-200 rounded-xl">
                    <table class="w-full text-left text-xs border-collapse">
                        <thead>
                            <tr class="bg-slate-50 border-b border-slate-200 text-[11px] font-bold text-slate-500 uppercase">
                                <th class="p-2.5 whitespace-nowrap">MÃ BOOKING</th>
                                <th class="p-2.5 whitespace-nowrap">SẢNH & NGÀY TIỆC</th>
                                <th class="p-2.5 min-w-[150px]">KHÁCH HÀNG</th>
                                <th class="p-2.5 whitespace-nowrap">NGƯỜI GIỮ</th>
                                <th class="p-2.5 text-center whitespace-nowrap">HẠN CUTOFF</th>
                                <th class="p-2.5 text-center whitespace-nowrap">THAO TÁC</th>
                            </tr>
                        </thead>
                        <tbody id="tblCutoffAlertPopupBody" class="divide-y divide-slate-100">
                            <!-- Populated dynamically -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="p-3 bg-slate-50 border-t border-slate-200 flex items-center justify-between gap-2">
                <button onclick="closeModal('modalCutoffAlert'); navTo('cutoff');" class="px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white rounded-lg text-xs font-bold transition flex items-center gap-1.5 shadow-xs cursor-pointer">
                    <i data-lucide="layers" class="w-4 h-4"></i>
                    <span>Đi Đến Trang Quản Lý Khóa Sảnh (Cutoff)</span>
                </button>
                <button onclick="closeModal('modalCutoffAlert')" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-lg text-xs font-bold transition cursor-pointer">
                    Đóng (Nhắc lại sau)
                </button>
            </div>
        </div>
    </div>

    <!-- ==================== MODAL: QUICK EXTEND CUTOFF DATE ==================== -->
    <div id="modalExtendCutoff" class="hidden fixed inset-0 z-50 bg-slate-900/70 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 max-w-md w-full p-5 space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                <div class="flex items-center gap-2">
                    <i data-lucide="calendar-plus" class="w-5 h-5 text-amber-600"></i>
                    <h3 class="text-sm font-bold text-slate-800" id="extCutoffModalTitle">GIA HẠN THỜI HẠN GIỮ CHỖ (CUTOFF DATE)</h3>
                </div>
                <button onclick="closeModal('modalExtendCutoff')" class="p-1 hover:bg-slate-100 rounded text-slate-400 cursor-pointer">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
            </div>
            <form onsubmit="handleExecuteExtendCutoff(event)" class="space-y-3 text-xs">
                <input type="hidden" id="extCutoffBookId" value="" />
                <div>
                    <label class="block font-bold text-slate-700 mb-1">Mã Booking & Tiệc</label>
                    <input type="text" id="extCutoffDisplayId" readonly class="w-full p-2 bg-slate-100 border border-slate-200 rounded-lg font-mono font-bold text-blue-700" />
                </div>
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label class="font-bold text-slate-700">Chọn Hạn Khóa Mới (Cutoff Date) *</label>
                        <span id="extCutoffEventDateMax" class="text-[10px] text-amber-700 font-semibold"></span>
                    </div>
                    <input type="date" id="extCutoffNewDate" required class="w-full p-2.5 border border-amber-300 rounded-lg font-bold text-amber-950 focus:ring-2 focus:ring-amber-500" />
                    
                    <!-- Quick Extension Buttons -->
                    <div class="flex items-center gap-1.5 mt-2">
                        <span class="text-[10px] font-bold text-slate-500">Cộng nhanh:</span>
                        <button type="button" onclick="addDaysToCutoffInput(3)" class="px-2 py-0.5 rounded bg-slate-100 hover:bg-amber-100 text-slate-700 hover:text-amber-800 font-bold text-[10px] transition border border-slate-200 cursor-pointer">+3 ngày</button>
                        <button type="button" onclick="addDaysToCutoffInput(7)" class="px-2 py-0.5 rounded bg-slate-100 hover:bg-amber-100 text-slate-700 hover:text-amber-800 font-bold text-[10px] transition border border-slate-200 cursor-pointer">+7 ngày</button>
                        <button type="button" onclick="addDaysToCutoffInput(14)" class="px-2 py-0.5 rounded bg-slate-100 hover:bg-amber-100 text-slate-700 hover:text-amber-800 font-bold text-[10px] transition border border-slate-200 cursor-pointer">+14 ngày</button>
                    </div>
                    <p class="text-[10px] text-slate-500 mt-1">Chỉ được chọn ngày tương lai và không vượt quá ngày tiệc.</p>
                </div>
                <div>
                    <label class="block font-bold text-slate-700 mb-1">Lý Do Gia Hạn (Tùy chọn)</label>
                    <input type="text" id="extCutoffReason" placeholder="VD: Khách xin thêm thời gian, Chờ chốt menu..." class="w-full p-2 border border-slate-200 rounded-lg text-slate-800 focus:ring-2 focus:ring-blue-500" />
                </div>
                <div class="flex items-center justify-end gap-2 pt-2 border-t">
                    <button type="button" onclick="closeModal('modalExtendCutoff')" class="px-3.5 py-1.5 border rounded-lg text-slate-600 hover:bg-slate-100 cursor-pointer font-semibold">Hủy</button>
                    <button type="submit" class="px-4 py-1.5 bg-amber-600 hover:bg-amber-700 text-white font-bold rounded-lg transition shadow-sm cursor-pointer flex items-center gap-1.5">
                        <i data-lucide="check" class="w-4 h-4"></i>
                        <span>Xác Nhận Gia Hạn</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        // =============================================================
        // CUTOFF & TENTATIVE LOCK ENGINE
        // =============================================================
        let cutoffItemsCache = [];

        function toggleNbCutoffField() {
            const st = document.getElementById('nbStatus') ? document.getElementById('nbStatus').value : '';
            const grp = document.getElementById('nbCutoffGroup');
            // CHỈ ÁP DỤNG KHI ĐƠN TIỆC ĐANG GIỮ CHỖ (TENTATIVE - T)
            if (grp) grp.style.display = (st === 'T') ? 'block' : 'none';
        }

        function toggleEbCutoffField() {
            const st = document.getElementById('ebStatus') ? document.getElementById('ebStatus').value : '';
            const grp = document.getElementById('ebCutoffGroup');
            // CHỈ ÁP DỤNG KHI ĐƠN TIỆC ĐANG GIỮ CHỖ (TENTATIVE - T)
            // KHI ĐÃ CHỐT (DEFINITE - D) HOẶC ĐÃ HỦY (CANCELLED - C) -> ẨN HOÀN TOÀN
            if (grp) grp.style.display = (st === 'T') ? 'block' : 'none';
        }

        async function checkCutoffAlerts(forceOpen = false) {
            try {
                const res = await fetch('/api/cutoff/alerts');
                const data = await res.json();
                const badge = document.getElementById('badgeCutoffAlertCount');
                if (badge) {
                    if (data.total > 0) {
                        badge.textContent = data.total;
                        badge.classList.remove('hidden');
                    } else {
                        badge.classList.add('hidden');
                    }
                }

                if (data.total > 0) {
                    const tbody = document.getElementById('tblCutoffAlertPopupBody');
                    if (tbody) {
                        let html = '';
                        data.alerts.forEach(b => {
                            let tag = '';
                            if (b.is_overdue) {
                                tag = `<span class="bg-rose-100 text-rose-800 font-extrabold px-2 py-0.5 rounded text-[10px] whitespace-nowrap">🚨 Quá hạn (${Math.abs(b.days_left)} ngày)</span>`;
                            } else if (b.is_today) {
                                tag = `<span class="bg-rose-100 text-rose-800 font-extrabold px-2 py-0.5 rounded text-[10px] whitespace-nowrap">⚠️ Hết hạn hôm nay!</span>`;
                            } else if (b.is_tomorrow) {
                                tag = `<span class="bg-amber-100 text-amber-800 font-bold px-2 py-0.5 rounded text-[10px] whitespace-nowrap">⚠️ Còn 1 ngày!</span>`;
                            }

                            html += `
                                <tr class="hover:bg-slate-50 transition border-b border-slate-100">
                                    <td class="p-2.5 font-mono font-bold text-blue-700 whitespace-nowrap">
                                        <button onclick="closeModal('modalCutoffAlert'); openBookingDetailModal('${b.book_id}')" class="hover:underline flex items-center gap-1 cursor-pointer">
                                            <span>${b.book_id}</span>
                                        </button>
                                    </td>
                                    <td class="p-2.5 whitespace-nowrap">
                                        <div class="font-bold text-slate-800">${b.room}</div>
                                        <div class="text-[11px] text-slate-500">${b.event_date}</div>
                                    </td>
                                    <td class="p-2.5 min-w-[150px]">
                                        <div class="font-bold text-slate-800">${b.guest_name || b.title}</div>
                                        <div class="text-[11px] text-slate-400">${b.phone || ''}</div>
                                    </td>
                                    <td class="p-2.5 font-bold text-blue-800 whitespace-nowrap">${b.sales_user || '-'}</td>
                                    <td class="p-2.5 text-center whitespace-nowrap">
                                        <div class="font-bold text-slate-800">${b.cutoff_date}</div>
                                        <div class="mt-0.5">${tag}</div>
                                    </td>
                                    <td class="p-2.5 text-center whitespace-nowrap">
                                        <div class="flex items-center justify-center gap-1.5">
                                            <button onclick="openExtendCutoffModal('${b.book_id}', '${b.cutoff_date}', '${b.event_date || ''}')" class="px-2 py-1 bg-amber-50 hover:bg-amber-600 hover:text-white text-amber-800 rounded font-bold transition text-xs shadow-2xs cursor-pointer">
                                                Gia hạn
                                            </button>
                                            <button onclick="closeModal('modalCutoffAlert'); openCancelBookingModal('${b.book_id}', '${b.title}')" class="px-2 py-1 bg-rose-50 hover:bg-rose-600 hover:text-white text-rose-700 rounded font-bold transition text-xs shadow-2xs cursor-pointer">
                                                Hủy sảnh
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            `;
                        });
                        tbody.innerHTML = html;
                    }

                    // Show modal if forced OR not dismissed this session
                    const alreadyShown = sessionStorage.getItem('ems_cutoff_popup_shown');
                    if (forceOpen || !alreadyShown) {
                        document.getElementById('modalCutoffAlert').classList.remove('hidden');
                        sessionStorage.setItem('ems_cutoff_popup_shown', '1');
                    }
                } else {
                    const tbody = document.getElementById('tblCutoffAlertPopupBody');
                    if (tbody) tbody.innerHTML = '';
                    closeModal('modalCutoffAlert');
                }
                lucide.createIcons();
            } catch (err) {
                console.error("Check cutoff alerts err:", err);
            }
        }

        async function loadCutoffManagement() {
            try {
                const res = await fetch('/api/cutoff/list');
                const data = await res.json();
                cutoffItemsCache = data.items || [];

                document.getElementById('statCutoffTotal').textContent = data.total || 0;
                document.getElementById('statCutoffUrgent').textContent = data.urgent_count || 0;
                document.getElementById('statCutoffOverdue').textContent = data.overdue_count || 0;
                document.getElementById('statCutoffSafe').textContent = data.safe_count || 0;

                renderCutoffTable(cutoffItemsCache);

                // Also load config
                const cfgRes = await fetch('/api/cutoff/config');
                const cfg = await cfgRes.json();
                if (cfg) {
                    if (document.getElementById('cfgCutoffEmails')) document.getElementById('cfgCutoffEmails').value = cfg.recipient_emails || '';
                    if (document.getElementById('cfgCutoffAlertTime')) document.getElementById('cfgCutoffAlertTime').value = cfg.alert_time || '08:00';
                    if (document.getElementById('cfgCutoffActive')) document.getElementById('cfgCutoffActive').value = cfg.is_active || 1;
                }
            } catch (err) {
                console.error("Load cutoff management err:", err);
            }
        }

        function filterCutoffTable() {
            const filter = document.getElementById('selCutoffFilter').value;
            const q = document.getElementById('txtCutoffSearch').value.toLowerCase().trim();

            let filtered = cutoffItemsCache.filter(item => {
                let matchType = true;
                if (filter === 'URGENT') matchType = (item.days_left !== null && item.days_left <= 1 && item.days_left >= 0);
                else if (filter === 'OVERDUE') matchType = (item.days_left !== null && item.days_left < 0);
                else if (filter === 'SAFE') matchType = (item.days_left !== null && item.days_left > 1);
                else if (filter === 'NOT_SET') matchType = (item.status_label === 'NOT_SET' || item.days_left === null);

                let matchText = true;
                if (q) {
                    matchText = (item.book_id && item.book_id.toLowerCase().includes(q)) ||
                                (item.guest_name && item.guest_name.toLowerCase().includes(q)) ||
                                (item.title && item.title.toLowerCase().includes(q)) ||
                                (item.room && item.room.toLowerCase().includes(q)) ||
                                (item.sales_user && item.sales_user.toLowerCase().includes(q));
                }
                return matchType && matchText;
            });

            renderCutoffTable(filtered);
        }

        function renderCutoffTable(list) {
            const tbody = document.getElementById('tblCutoffListBody');
            if (!tbody) return;

            if (!list || list.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" class="p-8 text-center text-slate-400">Không tìm thấy đơn khóa sảnh nào phù hợp!</td></tr>';
                return;
            }

            let html = '';
            list.forEach(b => {
                let tag = '';
                let cutoffDisplay = b.cutoff_date || '<span class="text-slate-400 font-normal italic">Chưa đặt</span>';
                let actionBtnText = 'Gia hạn';

                if (b.status_label === 'NOT_SET' || b.days_left === null || b.days_left === undefined) {
                    tag = `<span class="bg-slate-100 text-slate-600 font-bold px-2 py-0.5 rounded text-[10px]">⏳ Chưa đặt hạn</span>`;
                    actionBtnText = 'Đặt hạn';
                } else if (b.days_left < 0) {
                    tag = `<span class="bg-rose-100 text-rose-800 font-extrabold px-2 py-0.5 rounded text-[10px]">🚨 Quá hạn (${Math.abs(b.days_left)} ngày)</span>`;
                } else if (b.days_left === 0) {
                    tag = `<span class="bg-rose-100 text-rose-800 font-extrabold px-2 py-0.5 rounded text-[10px]">⚠️ Hết hạn hôm nay!</span>`;
                } else if (b.days_left === 1) {
                    tag = `<span class="bg-amber-100 text-amber-800 font-bold px-2 py-0.5 rounded text-[10px]">⚠️ Còn 1 ngày!</span>`;
                } else {
                    tag = `<span class="bg-emerald-100 text-emerald-800 font-bold px-2 py-0.5 rounded text-[10px]">🛡️ Còn ${b.days_left} ngày</span>`;
                }

                html += `
                    <tr class="hover:bg-slate-50 transition border-b border-slate-100">
                        <td class="p-2.5 font-mono font-bold text-blue-700 whitespace-nowrap">
                            <button onclick="openBookingDetailModal('${b.book_id}')" class="hover:underline flex items-center gap-1 cursor-pointer">
                                <span>${b.book_id}</span>
                            </button>
                        </td>
                        <td class="p-2.5 whitespace-nowrap">
                            <div class="font-bold text-slate-800">${b.room}</div>
                            <div class="text-[11px] text-slate-500">${b.event_date}</div>
                        </td>
                        <td class="p-2.5 min-w-[160px]">
                            <div class="font-bold text-slate-800">${b.guest_name || b.title}</div>
                            <div class="text-[11px] text-slate-400">${b.phone || ''}</div>
                        </td>
                        <td class="p-2.5 font-bold text-blue-800 whitespace-nowrap">${b.sales_user || '-'}</td>
                        <td class="p-2.5 font-bold text-slate-800 whitespace-nowrap">${b.cutoff_date}</td>
                        <td class="p-2.5 text-center whitespace-nowrap">${tag}</td>
                        <td class="p-2.5 text-center whitespace-nowrap">
                            <div class="flex items-center justify-center gap-1.5">
                                <button onclick="openExtendCutoffModal('${b.book_id}', '${b.cutoff_date}', '${b.event_date || ''}')" class="px-2.5 py-1 bg-amber-50 hover:bg-amber-600 hover:text-white text-amber-800 rounded font-bold transition text-xs cursor-pointer shadow-2xs">
                                    Gia hạn
                                </button>
                                <button onclick="openBookingDetailModal('${b.book_id}')" class="px-2 py-1 bg-blue-50 hover:bg-blue-600 hover:text-white text-blue-700 rounded font-bold transition text-xs cursor-pointer shadow-2xs">
                                    Chi tiết
                                </button>
                                <button onclick="openCancelBookingModal('${b.book_id}', '${b.title}')" class="px-2 py-1 bg-rose-50 hover:bg-rose-600 hover:text-white text-rose-700 rounded font-bold transition text-xs cursor-pointer shadow-2xs">
                                    Hủy sảnh
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            });
            tbody.innerHTML = html;
            lucide.createIcons();
        }

        function addDaysToCutoffInput(days) {
            const dateInput = document.getElementById('extCutoffNewDate');
            let baseDate = new Date();
            if (dateInput.value) {
                const parsed = new Date(dateInput.value);
                if (!isNaN(parsed.getTime()) && parsed >= baseDate) {
                    baseDate = parsed;
                }
            }
            baseDate.setDate(baseDate.getDate() + days);
            const resStr = baseDate.toISOString().split('T')[0];
            if (dateInput.max && resStr > dateInput.max) {
                dateInput.value = dateInput.max;
                alert(`Đã tự động khóa theo ngày tiệc tối đa (${dateInput.max})!`);
            } else {
                dateInput.value = resStr;
            }
        }

        function openExtendCutoffModal(bookId, currentCutoff = '', eventDate = '') {
            document.getElementById('extCutoffBookId').value = bookId;
            document.getElementById('extCutoffDisplayId').value = bookId;
            if (document.getElementById('extCutoffReason')) document.getElementById('extCutoffReason').value = '';
            
            const tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);
            const tomorrowStr = tomorrow.toISOString().split('T')[0];
            
            const dateInput = document.getElementById('extCutoffNewDate');
            dateInput.min = tomorrowStr;
            if (eventDate) {
                dateInput.max = eventDate;
                const maxInfo = document.getElementById('extCutoffEventDateMax');
                if (maxInfo) maxInfo.textContent = `(Tối đa ngày tiệc: ${eventDate})`;
            } else {
                dateInput.removeAttribute('max');
                const maxInfo = document.getElementById('extCutoffEventDateMax');
                if (maxInfo) maxInfo.textContent = '';
            }

            dateInput.value = (currentCutoff && currentCutoff >= tomorrowStr) ? currentCutoff : tomorrowStr;

            document.getElementById('modalExtendCutoff').classList.remove('hidden');
            lucide.createIcons();
        }

        async function handleExecuteExtendCutoff(e) {
            e.preventDefault();
            const bookId = document.getElementById('extCutoffBookId').value;
            const newDate = document.getElementById('extCutoffNewDate').value;
            const reason = document.getElementById('extCutoffReason') ? document.getElementById('extCutoffReason').value.trim() : '';
            if (!bookId || !newDate) return;

            const submitBtn = e.target.querySelector('button[type="submit"]');
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="lucide-loader-2 animate-spin w-4 h-4 mr-1 inline-block"></i> Đang lưu...';
            }

            try {
                const res = await fetch('/api/cutoff/update', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        book_id: bookId,
                        cutoff_date: newDate,
                        username: currentUser ? currentUser.username : 'Admin',
                        reason: reason
                    })
                });
                const data = await res.json();
                if (!res.ok) throw new Error(data.detail || 'Không thể cập nhật hạn Cutoff');

                // 1. Close extend modal
                closeModal('modalExtendCutoff');

                // 2. Tự động xóa dòng booking vừa gia hạn khỏi danh sách cảnh báo popup với hiệu ứng mượt mà
                const popupTbody = document.getElementById('tblCutoffAlertPopupBody');
                if (popupTbody) {
                    const rows = popupTbody.querySelectorAll('tr');
                    rows.forEach(tr => {
                        if (tr.innerHTML.includes(bookId)) {
                            tr.style.transition = 'all 0.35s ease';
                            tr.style.opacity = '0';
                            tr.style.transform = 'translateX(25px)';
                            setTimeout(() => {
                                tr.remove();
                                const remainingRows = popupTbody.querySelectorAll('tr');
                                if (remainingRows.length === 0) {
                                    closeModal('modalCutoffAlert');
                                }
                            }, 350);
                        }
                    });
                }

                // 3. Cập nhật lại số lượng badge và danh sách quản trị
                await checkCutoffAlerts(false);
                if (typeof loadCutoffManagement === 'function') {
                    loadCutoffManagement();
                }

                alert(`Đã gia hạn thành công đơn ${bookId} đến ngày ${newDate}!
Đơn đã được gỡ khỏi danh sách cảnh báo khẩn cấp.`);
            } catch (err) {
                alert('Lỗi: ' + err.message);
            } finally {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i data-lucide="check" class="w-4 h-4 mr-1 inline-block"></i> Xác Nhận Gia Hạn';
                    lucide.createIcons();
                }
            }
        }

        async function handleSaveCutoffConfig(e) {
            e.preventDefault();
            const emails = document.getElementById('cfgCutoffEmails').value.trim();
            const alertTime = document.getElementById('cfgCutoffAlertTime').value;
            const isActive = parseInt(document.getElementById('cfgCutoffActive').value) || 1;

            const btn = document.getElementById('btnSaveCutoffConfig');
            btn.disabled = true;
            btn.textContent = 'Đang lưu...';

            try {
                const res = await fetch('/api/cutoff/config', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        recipient_emails: emails,
                        alert_time: alertTime,
                        is_active: isActive
                    })
                });
                const data = await res.json();
                if (!res.ok) throw new Error(data.detail || 'Không thể lưu cấu hình');
                alert('Đã lưu cấu hình thông báo & email cảnh báo thành công!');
            } catch (err) {
                alert('Lỗi: ' + err.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i data-lucide="save" class="w-4 h-4 mr-1 inline-block"></i> Lưu Cấu Hình Thông Báo';
                lucide.createIcons();
            }
        }

        // Check cutoff alerts on startup
        window.addEventListener('DOMContentLoaded', () => {
            setTimeout(checkCutoffAlerts, 1000);
        });
    </script>
</body>
</html>
