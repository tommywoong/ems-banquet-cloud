                tr.className = 'hover:bg-slate-50 transition border-b border-slate-100';
                tr.innerHTML = `
                    <td class="p-3.5 font-mono font-bold text-blue-600">${m.code}</td>
                    <td class="p-3.5 font-bold text-slate-800">${m.name}</td>
