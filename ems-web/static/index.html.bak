                        <div class="flex flex-wrap items-center gap-4">
                            <div class="flex items-center gap-2.5">
                                <div class="w-7 h-7 rounded-lg bg-blue-600 text-white flex items-center justify-center font-bold text-xs shadow-sm">
                                    <i data-lucide="calendar" class="w-4 h-4"></i>
                                </div>
                                <div>
                                    <span class="text-xs font-bold text-slate-800" id="lblSchedHeaderTitle">Ma Trận Lịch Sảnh Tiệc (10/11/2026 - 16/11/2026)</span>
                                    <span id="lblSchedHeaderCount" class="ml-2 px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-600 text-white">0 đơn tiệc</span>
                                </div>
                            </div>

                            <!-- FLOOR / ZONE FILTER (BỘ LỌC CỤM SẢNH) -->
                            <div class="flex items-center gap-1 bg-white p-1 rounded-lg border border-slate-200 text-xs font-bold shadow-xs">
                                <span class="text-slate-400 px-1 text-[11px]">Khu vực:</span>
                                <button type="button" onclick="setFloorFilter('ALL')" id="btnFloorALL" class="px-2.5 py-0.5 rounded bg-blue-600 text-white shadow-xs">Tất cả (12 sảnh)</button>
                                <button type="button" onclick="setFloorFilter('G')" id="btnFloorG" class="px-2.5 py-0.5 rounded hover:bg-slate-100 text-slate-600">Tầng Trệt (G Floor)</button>
                                <button type="button" onclick="setFloorFilter('M')" id="btnFloorM" class="px-2.5 py-0.5 rounded hover:bg-slate-100 text-slate-600">Tầng Lửng (M Floor)</button>
                                <button type="button" onclick="setFloorFilter('10')" id="btnFloor10" class="px-2.5 py-0.5 rounded hover:bg-slate-100 text-slate-600">Tầng 10</button>
                            </div>
                        </div>
                        
                        <div class="flex flex-wrap items-center gap-3">
                            <!-- NÚT CUỘN NGANG VÀ DI CHUYỂN TUẦN -->
                            <div class="flex items-center gap-1 bg-white p-1 rounded-lg border border-slate-200 shadow-sm">
                                <button type="button" onclick="shiftSchedulerDays(-7)" title="Lùi 7 ngày về trước" class="px-2.5 py-1 bg-slate-50 hover:bg-slate-100 text-slate-700 rounded text-xs font-bold transition flex items-center gap-1">
                                    <i data-lucide="chevrons-left" class="w-3.5 h-3.5"></i>
                                    <span>-7 Ngày</span>
                                </button>
                                <button type="button" onclick="scrollMatrixSmooth(-450)" title="Cuộn bảng sang trái" class="px-3 py-1 bg-blue-600 hover:bg-blue-700 text-white rounded text-xs font-bold transition flex items-center gap-1 shadow-sm">
                                    <i data-lucide="chevron-left" class="w-4 h-4"></i>
                                    <span>Cuộn Trái</span>
                                </button>
                                <button type="button" onclick="scrollMatrixSmooth(450)" title="Cuộn bảng sang phải" class="px-3 py-1 bg-blue-600 hover:bg-blue-700 text-white rounded text-xs font-bold transition flex items-center gap-1 shadow-sm">
                                    <span>Cuộn Phải</span>
                                    <i data-lucide="chevron-right" class="w-4 h-4"></i>
                                </button>
                                <button type="button" onclick="shiftSchedulerDays(7)" title="Tiến 7 ngày tiếp theo" class="px-2.5 py-1 bg-slate-50 hover:bg-slate-100 text-slate-700 rounded text-xs font-bold transition flex items-center gap-1">
                                    <span>+7 Ngày</span>
                                    <i data-lucide="chevrons-right" class="w-3.5 h-3.5"></i>
                                </button>
                            </div>

                            <!-- QUY MÔ HIỂN THỊ CỘT NGÀY -->
                            <div class="flex items-center gap-1 bg-slate-100 p-1 rounded-lg text-[11px] font-bold">
                                <span class="text-slate-400 px-1">Khung nhìn:</span>
                                <button type="button" onclick="setMatrixSpan(3)" id="btnSpan3" class="px-2 py-0.5 rounded hover:bg-white text-slate-600">3 Ngày</button>
                                <button type="button" onclick="setMatrixSpan(7)" id="btnSpan7" class="px-2 py-0.5 rounded bg-white text-blue-700 shadow-xs">7 Ngày</button>
                                <button type="button" onclick="setMatrixSpan(14)" id="btnSpan14" class="px-2 py-0.5 rounded hover:bg-white text-slate-600">14 Ngày</button>
                                <button type="button" onclick="setMatrixSpan(30)" id="btnSpan30" class="px-2 py-0.5 rounded hover:bg-white text-slate-600">1 Tháng</button>
                            </div>
                        </div>

                        <div class="hidden text-[11px] text-slate-500 font-medium flex items-center gap-2">
                            <span>Bấm vào thẻ tiệc để <strong>Xem & Sửa</strong></span>
                            <span>&bull;</span>
                            <span>Bấm vào ô trống để <strong>Khóa Giữ Sảnh</strong></span>
                        </div>
                    </div>

                    <!-- Scrollable Table Container -->
                    
                    <div class="px-4 py-2 bg-blue-50/80 border-b border-blue-100 flex items-center justify-between text-xs text-blue-900">
                        <div class="flex items-center gap-2">
                            <i data-lucide="move" class="w-4 h-4 text-blue-600"></i>
                            <span><strong>Kéo Thả Tiệc:</strong> Giữ chuột vào thẻ tiệc và kéo sang sảnh/ngày khác. Hệ thống tự động <strong>kiểm tra trùng giờ</strong>, nếu trùng sẽ cảnh báo và hoàn lại vị trí cũ!</span>
                        </div>
                        <div class="text-[11px] text-emerald-700 font-bold">
                            <span>Bấm vào ô viền đứt nét để khóa nhanh ca còn trống</span>
                        </div>
                    </div>

                    <div id="schedScrollContainer" class="overflow-x-auto overflow-y-auto max-h-[calc(100vh-275px)] relative border border-slate-200 bg-white select-none">
                        <!-- 1. MULTI-DAY MATRIX VIEW (ALL DAYS SHOWN TOGETHER AS COLUMNS) -->
                        <table id="tblMultiDay" class="w-full text-left border-separate border-spacing-0 min-w-[1100px]">
                            <thead id="tblMultiDayHead">
                                <!-- Populated dynamically with Day columns -->
                            </thead>
                            <tbody id="tblMultiDayBody" class="divide-y divide-slate-100 text-xs">
                                <!-- Populated dynamically with 12 room rows x N days -->
                            </tbody>
                        </table>

                        <!-- 2. SINGLE DAY 3-SHIFT VIEW -->
                        <table id="tblSingleDay" class="hidden w-full text-left border-separate border-spacing-0 min-w-[950px]">
                            <thead id="tblSingleDayHead">
                                <tr class="bg-slate-50 border-b border-slate-200 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
                                    <th class="p-3.5 whitespace-nowrap">SẢNH TIỆC</th>
                                    <th class="p-3.5 text-center">SÁNG (08:00 - 12:00)</th>
                                    <th class="p-3.5 text-center">TRƯA (11:00 - 14:30)</th>
                                    <th class="p-3.5 text-center">TỐI (17:00 - 22:00)</th>
                                </tr>
                            </thead>
                            <tbody id="tblSingleDayBody" class="divide-y divide-slate-100 text-xs">
                                <!-- Populated dynamically with rooms x shifts -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- VIEW 2: BOOKINGS MANAGEMENT (QUẢN LÝ ĐƠN TIỆC) -->
            <section id="viewBookings" class="hidden space-y-4">
                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm space-y-3">
                    <div class="flex flex-wrap items-center gap-3">
                        <div class="flex items-center gap-2">
                            <label class="text-xs font-bold text-slate-600">Lọc theo:</label>
                            <select id="selBkDateType" class="border border-slate-200 rounded-lg px-2.5 py-1.5 text-xs font-medium text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500">
                                <option value="event">Ngày Tiệc (Event Date)</option>
                                <option value="booking">Ngày Tạo (Booking Date)</option>
                            </select>
                        </div>

                        <div class="flex items-center gap-1.5 bg-slate-50 px-3 py-1 rounded-lg border border-slate-200">
                            <span class="text-xs text-slate-500">Từ:</span>
                            <input type="date" id="txtBkDateFrom" value="2026-01-01" class="bg-transparent text-xs font-semibold text-slate-800 focus:outline-none" />
                            <span class="text-xs text-slate-500 ml-2">Đến:</span>
                            <input type="date" id="txtBkDateTo" value="2026-12-31" class="bg-transparent text-xs font-semibold text-slate-800 focus:outline-none" />
                        </div>

                        <div class="flex items-center gap-1 text-[11px]">
                            <button onclick="setBkPreset('all')" class="px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded transition font-medium">Tất cả</button>
                            <button onclick="setBkPreset('2026')" class="px-2 py-1 bg-blue-100 text-blue-700 hover:bg-blue-200 rounded transition font-bold">Năm 2026</button>
                            <button onclick="setBkPreset('m11_2026')" class="px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded transition font-medium">T11/2026</button>
                            <button onclick="setBkPreset('q4_2026')" class="px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded transition font-medium">Quý 4/2026</button>
                        </div>
                    </div>

                    <div class="flex flex-wrap items-center gap-3 pt-2 border-t border-slate-100">
                        <select id="selBkFilterRoom" class="border border-slate-200 rounded-lg px-2.5 py-1.5 text-xs font-medium text-slate-700">
                            <option value="ALL">Tất cả sảnh (12 sảnh)</option>
                        </select>

                        <select id="selBkFilterStatus" onchange="syncWebStatusSelectToChips()" class="border border-slate-200 rounded-lg px-2.5 py-1.5 text-xs font-medium text-slate-700">
                            <option value="ALL">Tất cả trạng thái</option>
                            <option value="D,T">Đang hoạt động (Chốt + Giữ chỗ)</option>
                            <option value="D">Chỉ xem: Đã chốt (Definite)</option>
                            <option value="T">Chỉ xem: Giữ chỗ (Tentative)</option>
                            <option value="C">Chỉ xem: Đã hủy (Cancelled)</option>
                        </select>

                        <select id="selBkFilterSales" class="border border-slate-200 rounded-lg px-2.5 py-1.5 text-xs font-medium text-slate-700">
                            <option value="ALL">Tất cả nhân viên</option>
                        </select>

                        <div class="flex-1 min-w-[200px] relative">
                            <i data-lucide="search" class="w-4 h-4 absolute left-3 top-2.5 text-slate-400"></i>
                            <input type="text" id="txtBkSearch" oninput="debounceSearchBookings()" placeholder="Tìm mã booking, tên khách, số ĐT, tên sự kiện..." class="w-full pl-9 pr-3 py-1.5 text-xs border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                        </div>

                        <button onclick="loadBookingsList()" class="px-4 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-bold shadow-sm transition cursor-pointer">
                            Lọc Đơn Tiệc
                        </button>
                    </div>
                </div>

                <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                    <!-- THANH TÁC VỤ KHI CHECK CHỌN ĐƠN TIỆC -->
                    <div id="barWebSelectedBookings" class="hidden p-2.5 bg-blue-50 border-b border-blue-200 flex flex-wrap items-center justify-between gap-3 text-xs animate-fadeIn">
                        <div class="flex items-center gap-2">
                            <span class="inline-flex items-center justify-center min-w-[22px] h-[22px] px-1.5 bg-blue-600 text-white rounded-full font-bold text-xs" id="lblWebSelectedCount">0</span>
                            <span class="font-bold text-blue-900">đơn tiệc được chọn để xem / xuất báo cáo</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <button type="button" onclick="exportWebBookingsToExcel(true)" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg font-bold shadow-xs transition flex items-center gap-1.5 cursor-pointer">
                                <i data-lucide="file-spreadsheet" class="w-3.5 h-3.5"></i>
                                <span>Xuất Excel các đơn đã chọn (<span id="btnExportSelectedCount">0</span>)</span>
                            </button>
                            <button type="button" onclick="clearWebBookingsSelection()" class="px-2.5 py-1.5 bg-white hover:bg-slate-100 text-slate-700 border border-slate-300 rounded-lg font-semibold transition cursor-pointer">
                                Bỏ chọn
                            </button>
                        </div>
                    </div>

                    <div class="p-3.5 border-b border-slate-100 bg-slate-50 flex flex-wrap items-center justify-between gap-3">
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="text-xs font-bold text-slate-700 flex items-center gap-1.5 mr-1">
                                <i data-lucide="list" class="w-4 h-4 text-blue-600"></i>
                                <span>Tổng cộng: </span>
                                <span id="lblBkCount" class="text-slate-900 font-bold">Đang tải...</span>
                            </span>
                            <!-- MULTI-SELECT CHIPS TRẠNG THÁI (CLICK ĐỂ CHECK / BỎ CHECK TRẠNG THÁI) -->
                            <button type="button" onclick="toggleWebStatusFilter('D')" id="btnFilterChipD" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-300 hover:bg-emerald-200 transition cursor-pointer" title="Bấm để bật/tắt lọc đơn Đã chốt">
                                <input type="checkbox" id="chkWebStatusD" checked class="pointer-events-none w-3.5 h-3.5 text-emerald-600 rounded" />
                                <span><span id="lblBkConfirmedCount">0</span> Chốt (D)</span>
                            </button>
                            <button type="button" onclick="toggleWebStatusFilter('T')" id="btnFilterChipT" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-100 text-amber-800 border border-amber-300 hover:bg-amber-200 transition cursor-pointer" title="Bấm để bật/tắt lọc đơn Giữ chỗ">
                                <input type="checkbox" id="chkWebStatusT" checked class="pointer-events-none w-3.5 h-3.5 text-amber-600 rounded" />
                                <span><span id="lblBkTentativeCount">0</span> Giữ chỗ (T)</span>
                            </button>
                            <button type="button" onclick="toggleWebStatusFilter('C')" id="btnFilterChipC" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-slate-100 text-slate-600 border border-slate-200 hover:bg-rose-50 hover:text-rose-700 transition cursor-pointer" title="Bấm để bật/tắt lọc đơn Đã hủy">
                                <input type="checkbox" id="chkWebStatusC" class="pointer-events-none w-3.5 h-3.5 text-rose-600 rounded" />
                                <span><span id="lblBkCancelledCount">0</span> Hủy (C)</span>
                            </button>
                        </div>
                        <div class="flex items-center gap-2">
                            <button onclick="exportWebBookingsToExcel()" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-bold transition flex items-center gap-1.5 shadow-sm cursor-pointer">
                                <i data-lucide="file-spreadsheet" class="w-3.5 h-3.5"></i>
                                <span id="lblExportExcelBtnText">Xuất File Excel</span>
                            </button>
                            <button onclick="openNewBookingModal()" class="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-bold transition flex items-center gap-1.5 shadow-sm cursor-pointer">
                                <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                                <span>Tạo Booking Mới</span>
                            </button>
                        </div>
                    </div>
                    <div class="overflow-x-auto custom-scrollbar" id="webBookingsTableWrapper">
                        <table class="w-full text-left border-collapse min-w-[1240px]">
                            <thead>
                                <tr class="bg-slate-50 border-b border-slate-200 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
                                    <th class="px-2.5 py-2.5 text-center w-9 whitespace-nowrap">
                                        <input type="checkbox" id="chkSelectAllWebBookings" onchange="toggleSelectAllWebBookings(this)" title="Chọn tất cả các đơn tiệc hiển thị" class="w-4 h-4 text-blue-600 rounded border-slate-300 focus:ring-blue-500 cursor-pointer" />
                                    </th>
                                    <th class="px-2.5 py-2.5 w-[115px] whitespace-nowrap">MÃ BOOKING</th>
                                    <th class="px-2.5 py-2.5 w-[95px] whitespace-nowrap">NGÀY TIỆC</th>
                                    <th class="px-2.5 py-2.5 w-[85px] whitespace-nowrap">NGÀY ĐẶT</th>
                                    <th id="thBkCustomerCol" class="px-2.5 py-2.5 min-w-[170px] max-w-[210px]">KHÁCH HÀNG / ĐƠN VỊ</th>
                                    <th class="px-2.5 py-2.5 w-[105px] max-w-[115px]">SẢNH TIỆC</th>
                                    <th class="px-2.5 py-2.5 w-[125px] max-w-[135px]">PHÂN KHÚC</th>
                                    <th class="px-2.5 py-2.5 w-[110px] max-w-[120px]">NGƯỜI LÀM BEO</th>
                                    <th class="px-2.5 py-2.5 text-center w-[90px] whitespace-nowrap">TRẠNG THÁI</th>
                                    <th class="px-2.5 py-2.5 text-right w-[50px] whitespace-nowrap">KHÁCH</th>
                                    <th class="px-2.5 py-2.5 text-right w-[85px] whitespace-nowrap">CỌC (VNĐ)</th>
                                    <th class="px-2.5 py-2.5 text-right text-emerald-700 w-[105px] whitespace-nowrap">DT TIỆC</th>
                                    <th class="px-2.5 py-2.5 text-right font-black text-blue-900 w-[105px] whitespace-nowrap">TỔNG DT</th>
                                    <th class="px-2.5 py-2.5 text-center w-[75px] whitespace-nowrap pr-3">THAO TÁC</th>
                                </tr>
                            </thead>
                            <tbody id="tblBkBody" class="divide-y divide-slate-100 text-xs">
                                <tr><td colspan="14" class="p-8 text-center text-slate-400">Đang nạp danh sách đơn tiệc...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- THANH CUỘN NGANG DÍNH DƯỚI ĐÁY (STICKY HORIZONTAL SCROLLBAR) CHO QUẢN LÝ ĐƠN TIỆC -->
                <div id="stickyWebBookingsScrollController" class="fixed bottom-0 left-0 md:left-64 right-0 z-30 bg-slate-900/95 backdrop-blur-md text-white py-2 px-5 border-t border-slate-700 flex items-center justify-between gap-4 shadow-2xl no-print">
                    <div class="flex items-center gap-2 text-xs font-semibold shrink-0">
                        <button type="button" onclick="scrollWebBookingsTable('left')" class="px-2.5 py-1 bg-white/10 hover:bg-white/20 rounded-lg text-slate-200 flex items-center gap-1 transition cursor-pointer">
                            <i data-lucide="chevron-left" class="w-3.5 h-3.5"></i>
                            <span>Đầu bảng</span>
                        </button>
                        <span class="text-[11px] text-slate-300 font-medium hidden sm:inline flex items-center gap-1.5">
                            <span class="text-amber-400 font-bold">💡 Trượt ngang:</span> Giữ chuột trái trên bảng để kéo, hoặc trượt thanh này:
                        </span>
                    </div>

                    <!-- Realtime Synced Scrollbar Track -->
                    <div id="webSyncedScrollTrack" class="flex-1 overflow-x-auto py-1 custom-scrollbar">
                        <div id="webSyncedScrollDummy" class="h-1" style="min-width: 1400px;"></div>
                    </div>

                    <div class="flex items-center gap-2 text-xs font-semibold shrink-0">
                        <button type="button" onclick="scrollWebBookingsTable('right')" class="px-3 py-1 bg-blue-600 hover:bg-blue-500 rounded-lg text-white font-bold flex items-center gap-1.5 shadow-md shadow-blue-600/30 transition cursor-pointer">
                            <span>Xem Doanh Thu & Thao Tác</span>
                            <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
                        </button>
                    </div>
                </div>
            </section>

            

<!-- VIEW 3: LẬP & IN LỆNH BEO -->
            <section id="viewBEO" class="hidden space-y-4">
                <!-- THANH THÔNG TIN & NÚT MỞ CỬA SỔ NẠP BEO -->
                <div class="bg-gradient-to-r from-blue-900 via-indigo-900 to-slate-900 p-4 rounded-xl shadow-lg border-2 border-amber-400 text-white flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-lg bg-amber-400 text-slate-950 flex items-center justify-center font-black shrink-0 shadow-sm">
                            <i data-lucide="file-text" class="w-5 h-5 text-slate-950"></i>
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="text-xs font-black text-amber-300 uppercase tracking-wider">LẬP & IN LỆNH BEO (BANQUET EVENT ORDER)</span>
                                <span id="beoCurrentStatusBadge" class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-blue-500/30 text-blue-200 border border-blue-400/30">Đang xem BEO</span>
                            </div>
                            <div id="beoCurrentBookingDisplay" class="text-xs text-blue-100 font-medium mt-0.5 flex flex-wrap items-center gap-2">
                                <span class="font-bold text-white text-sm" id="beoCurrentBookingTitle">Chưa chọn đơn tiệc</span>
                                <span class="text-amber-300 font-mono font-bold bg-slate-950 px-2 py-0.5 rounded border border-slate-700" id="beoCurrentBookingId"></span>
                                <span class="text-[11px] text-blue-300" id="beoCurrentBookingExtra"></span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="flex items-center gap-2.5 shrink-0">
                        <span id="beoStatusNotification" class="text-xs font-bold text-emerald-300 hidden items-center gap-1.5 bg-emerald-950/80 px-3 py-1.5 rounded-lg border border-emerald-500/50">
                            <i data-lucide="check-circle" class="w-3.5 h-3.5 text-emerald-400 inline-block"></i>
                            <span id="beoStatusNotificationText">Đã nạp BEO thành công!</span>
                        </span>
                        <button type="button" id="btnOpenSearchBeoModal" onclick="openSearchBeoModal()" class="px-5 py-2.5 bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 font-black text-xs rounded-lg shadow-md transition flex items-center gap-2 cursor-pointer active:scale-95">
                            <i data-lucide="search" class="w-4 h-4"></i>
                            <span>Nạp BEO (Tìm Kiếm)</span>
                        </button>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm space-y-4">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="px-2.5 py-0.5 rounded text-[11px] font-bold bg-blue-100 text-blue-800">CHUẨN MERPERLE DALAT</span>
                                <h3 class="text-sm font-bold text-slate-800 uppercase tracking-wide">PHIẾU ĐẶT SỰ KIỆN (BANQUET EVENT ORDER - BEO)</h3>
                            </div>
                            <p class="text-xs text-slate-500 mt-0.5">Biểu mẫu chuẩn 1-to-1 theo tiêu chuẩn khách sạn MerPerle DaLat Hotel. Doanh thu bảo lưu cho người lập BEO.</p>
                        </div>
                        <div class="flex flex-wrap items-center gap-2">
                            <!-- BỘ CHỌN DÀN TRANG BEO (1 TRANG / 2 TRANG / AUTO) -->
                            <div class="flex items-center gap-1.5 bg-slate-100 px-2 py-1.5 rounded-lg border border-slate-300 text-xs">
                                <label for="selBeoPrintLayout" class="text-slate-700 font-bold flex items-center gap-1">
                                    <i data-lucide="layout" class="w-3.5 h-3.5 text-blue-600"></i>
                                    <span>Dàn trang:</span>
                                </label>
                                <select id="selBeoPrintLayout" class="bg-white text-slate-800 font-bold text-xs rounded border border-slate-300 px-2 py-0.5 focus:outline-none focus:ring-1 focus:ring-blue-500 cursor-pointer">
                                    <option value="gridSession" selected>📋 Mẫu Sự Kiện Từng Buổi (Chuẩn CSV Mới - Mặc định)</option>
                                    <option value="auto">⚡ Tự động (Auto-fit chuẩn)</option>
                                    <option value="grid2col">📋 Mẫu Sự Kiện Lịch Trình (2 Cột Bộ Phận)</option>
                                    <option value="1page">📄 Ép 1 Trang A4 (Tiệc gọn)</option>
                                    <option value="2page">📑 Dàn 2 Trang A4 (Nhiều thực đơn)</option>
                                </select>
                            </div>

                            <button onclick="printCurrentBEO()" class="px-4 py-2 bg-slate-900 hover:bg-black text-white rounded-lg text-xs font-bold flex items-center gap-2 shadow-sm transition cursor-pointer">
                                <i data-lucide="printer" class="w-4 h-4"></i>
                                <span>In Phiếu BEO (Chuẩn MerPerle A4)</span>
                            </button>
                            <button onclick="saveBEO()" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-bold flex items-center gap-2 shadow-sm transition">
                                <i data-lucide="check-circle" class="w-4 h-4"></i>
                                <span>Lưu & Phát Hành BEO</span>
                            </button>
                        </div>
                    </div>

                    <!-- BEO Notice Banner -->
                    <div id="beoExistingNotice" class="hidden"></div>

                    <!-- HEADER METADATA (Số EO, Ngày, Người lập, Người hỗ trợ) -->
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-3 text-xs bg-slate-50 p-3.5 rounded-lg border border-slate-200">
                        <div>
                            <label class="block font-bold text-slate-700 mb-1">Mã Đơn Tiệc (Booking ID) *</label>
                            <input type="text" id="beoBookId" onchange="loadBeoByInput()" placeholder="Nhập mã booking..." class="w-full p-2 border border-slate-300 rounded-lg font-mono font-bold text-blue-700 bg-white" />
                        </div>
                        <div>
                            <label class="block font-bold text-slate-700 mb-1">Số E.O (Master EO) *</label>
                            <input type="text" id="beoMasterEO" readonly placeholder="Tự sinh khi lưu BEO" class="w-full p-2 border border-slate-200 rounded-lg font-mono font-bold text-slate-600 bg-slate-100" />
                        </div>
                        <div>
                            <label class="block font-bold text-slate-700 mb-1">Người Chuẩn Bị (Prepared By) *</label>
                            <input type="text" id="beoPreparedBy" readonly class="w-full p-2 bg-slate-100 border border-slate-200 rounded-lg font-bold text-emerald-700" />
                        </div>
                        <div>
                            <label class="block font-bold text-slate-700 mb-1">Người Hỗ Trợ (Endorsed By / Sales)</label>
                            <input type="text" id="beoEndorsedBy" class="w-full p-2 border border-slate-300 rounded-lg font-bold text-slate-700 bg-white" />
                        </div>
                        <div class="md:col-span-2">
                            <div class="flex items-center justify-between mb-1">
                                <label class="block font-bold text-slate-700">Amendment (Lần sửa đổi)</label>
                                <button type="button" id="btnBeoAmendHistory" onclick="showBeoAmendHistoryModal()" class="text-xs text-blue-600 font-bold hover:underline flex items-center gap-1">
                                    <span>📜 Lịch sử</span>
                                    <span id="beoAmendCountBadge" class="bg-blue-100 text-blue-800 text-[10px] px-1.5 py-0.2 rounded-full font-bold">0</span>
                                </button>
                            </div>
                            <input type="text" id="beoAmendment" placeholder="Vd: Bổ sung 2 suất ăn chay đặc biệt (lần 2)" class="w-full p-2 border border-amber-300 bg-amber-50/50 rounded-lg font-bold text-amber-900 focus:bg-white" />
                        </div>
                        <div class="md:col-span-2">
                            <label class="block font-bold text-slate-700 mb-1">Tiêu Đề BEO (Title)</label>
                            <input type="text" id="beoEoTitle" value="PHIẾU ĐẶT SỰ KIỆN" class="w-full p-2 border border-slate-300 rounded-lg font-bold text-red-700 bg-white" />
                        </div>
                    </div>

                    <!-- 2-COLUMN FORM CORRESPONDING TO MERPERLE STANDARD -->
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 text-xs">
                        <!-- LEFT COLUMN: KHÁCH HÀNG, HỢP ĐỒNG, TÀI CHÍNH & PHÂN CÔNG BỘ PHẬN -->
                        <div class="lg:col-span-6 space-y-4">
                            <!-- Khối Pháp Lý & Khách Hàng -->
                            <div class="border border-slate-200 rounded-lg p-3.5 bg-white space-y-3">
                                <h4 class="font-bold text-slate-800 uppercase tracking-wider text-[11px] border-b pb-1 flex items-center justify-between text-blue-900">
                                    <span>I. THÔNG TIN KHÁCH HÀNG & HỢP ĐỒNG</span>
                                    <span class="text-[10px] text-slate-400 font-normal">Cột Trái BEO</span>
                                </h4>
                                <div class="grid grid-cols-2 gap-3">
                                    <div>
                                        <label class="block font-semibold text-slate-600 mb-0.5">Ngày Sự Kiện *</label>
                                        <input type="text" id="beoEventDateStr" placeholder="e.g. Wednesday, Nov 11, 2026" class="w-full p-1.5 border border-slate-200 rounded" />
                                    </div>
                                    <div>
                                        <label class="block font-semibold text-slate-600 mb-0.5">Loại Hình (Event Type) *</label>
                                        <select id="beoEventType" class="w-full p-1.5 border border-slate-200 rounded bg-white font-bold text-slate-800 text-xs cursor-pointer">
                                            <option value="Dinner (E)">Dinner (E)</option>
                                            <option value="Gala Dinner (E)">Gala Dinner (E)</option>
                                            <option value="Meeting">Meeting</option>
                                            <option value="Wedding (W)">Wedding (W)</option>
                                            <option value="Birthday (E)">Birthday (E)</option>
                                            <option value="Lunch (E)">Lunch (E)</option>
                                            <option value="TEABREAK">TEABREAK</option>
                                            <option value="Food Tasting">Food Tasting</option>
                                            <option value="Seminar">Seminar</option>
                                            <option value="Breakfast">Breakfast</option>
                                            <option value="Buffet (E)">Buffet (E)</option>
                                            <option value="Set Menu- Event (E)">Set Menu- Event (E)</option>
                                            <option value="Hall Rental-Event (E)">Hall Rental-Event (E)</option>
                                            <option value="YEP (E)">YEP (E)</option>
                                            <option value="Others">Others</option>
                                        </select>
                                    </div>
                                </div>
                                <div>
                                    <label class="block font-semibold text-slate-600 mb-0.5">Tên Đơn Vị / Công Ty (Company) *</label>
                                    <input type="text" id="beoCompany" class="w-full p-1.5 border border-slate-200 rounded font-bold text-slate-800" />
                                </div>
                                <div class="grid grid-cols-2 gap-3">
                                    <div>
                                        <label class="block font-semibold text-slate-600 mb-0.5">Người Liên Hệ</label>
                                        <input type="text" id="beoContactPerson" class="w-full p-1.5 border border-slate-200 rounded" />
                                    </div>
                                    <div>
                                        <label class="block font-semibold text-slate-600 mb-0.5">Người Dùng Cuối (End User) *</label>
                                        <input type="text" id="beoEndUser" class="w-full p-1.5 border border-blue-300 rounded font-bold text-blue-800 bg-blue-50/30" />
                                    </div>
                                </div>
                                <div class="grid grid-cols-3 gap-2">
                                    <div>
                                        <label class="block font-semibold text-slate-600 mb-0.5">Điện Thoại</label>
                                        <input type="text" id="beoPhone" class="w-full p-1.5 border border-slate-200 rounded" />
                                    </div>
                                    <div>
                                        <label class="block font-semibold text-slate-600 mb-0.5">ĐT Văn Phòng</label>
                                        <input type="text" id="beoOfficePhone" class="w-full p-1.5 border border-slate-200 rounded" />
                                    </div>
                                    <div>
                                        <label class="block font-semibold text-slate-600 mb-0.5">Mã Đặt Phòng (Code)</label>
                                        <input type="text" id="beoBookCode" class="w-full p-1.5 border border-slate-200 rounded font-mono font-bold" />
                                    </div>
                                </div>
                                <div>
                                    <label class="block font-semibold text-slate-600 mb-0.5">Địa Chỉ</label>
                                    <input type="text" id="beoAddress" class="w-full p-1.5 border border-slate-200 rounded" />
                                </div>
                                <!-- Box THÔNG TIN XUẤT HÓA ĐƠN VAT (BILL TO / VAT INVOICE) -->
                                <div class="p-3 bg-amber-50/60 border border-amber-200 rounded-lg space-y-2.5">
                                    <div class="flex items-center justify-between">
                                        <label class="font-bold text-amber-950 text-xs flex items-center gap-1.5">
                                            <i data-lucide="file-text" class="w-4 h-4 text-amber-700"></i>
                                            <span>THÔNG TIN XUẤT HÓA ĐƠN VAT (BILL TO / VAT INVOICE)</span>
                                        </label>
                                        <button type="button" onclick="copyCompanyToBilling()" class="text-[11px] text-blue-600 hover:text-blue-800 font-bold flex items-center gap-1">
                                            <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                                            <span>Lấy theo thông tin Công ty</span>
                                        </button>
                                    </div>
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-2.5">
                                        <div>
                                            <label class="block font-semibold text-slate-700 mb-0.5">Tên Đơn Vị / Công Ty Xuất Hóa Đơn *</label>
                                            <input type="text" id="beoBillTo" class="w-full p-1.5 border border-amber-300 bg-white rounded font-bold text-slate-800" />
                                        </div>
                                        <div>
                                            <label class="block font-semibold text-slate-700 mb-0.5">Mã Số Thuế (MST / Tax Code) *</label>
                                            <input type="text" id="beoTaxCode" class="w-full p-1.5 border border-amber-300 bg-white rounded font-mono font-bold text-amber-950" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Khối Tài Chính & Bảng Phí Chi Tiết -->
                            <div class="border border-slate-200 rounded-lg p-3.5 bg-white space-y-3">
                                <h4 class="font-bold text-slate-800 uppercase tracking-wider text-[11px] border-b pb-1 flex items-center justify-between text-emerald-900">
                                    <span>II. ĐẶT CỌC, THANH TOÁN & GIÁ CHI TIẾT</span>
                                    <span class="text-[10px] text-slate-400 font-normal">Pricing & Charges</span>
                                </h4>
                                <div class="grid grid-cols-3 gap-2">
                                    <div>
                                        <label class="block font-semibold text-slate-600 mb-0.5">Tiền Đặt Cọc (VND)</label>
                                        <input type="number" id="beoDeposit" class="w-full p-1.5 border border-slate-200 rounded font-mono font-bold text-emerald-700" />
                                    </div>
                                    <div>
                                        <label class="block font-semibold text-slate-600 mb-0.5">Phương Thức TT</label>
                                        <input type="text" id="beoPaymentMethod" placeholder="Chuyển khoản, tiền mặt..." class="w-full p-1.5 border border-slate-200 rounded" />
                                    </div>
                                    <div>
                                        <label class="block font-semibold text-slate-600 mb-0.5">Giá Menu Cơ Bản</label>
                                        <input type="text" id="beoBasePrice" placeholder="270,000" class="w-full p-1.5 border border-slate-200 rounded font-mono" />
                                    </div>
                                </div>
                                <div>
                                    <label class="block font-semibold text-slate-600 mb-0.5">Ghi Chú Thanh Toán (GHI CHÚ TT)</label>
                                    <input type="text" id="beoPaymentNotes" placeholder="Quy định thanh toán, đặt cọc đợt 2..." class="w-full p-1.5 border border-slate-200 rounded" />
                                </div>

                                <!-- Bảng Kê Chi Tiết Phí (Full-day room rental, Teabreak, Food...) -->
                                <div>
                                    <label class="block font-bold text-slate-700 mb-1">BẢNG KÊ GIÁ CHI TIẾT (Services & Charges Breakdown)</label>
                                    <div class="border border-slate-200 rounded overflow-hidden">
                                        <table class="w-full text-left border-collapse text-[11px]">
                                            <thead class="bg-slate-100 font-bold text-slate-700 border-b border-slate-200">
                                                <tr>
                                                    <th class="p-1.5">Hạng Mục</th>
                                                    <th class="p-1.5">Diễn Giải (Đơn giá x Số khách)</th>
                                                    <th class="p-1.5 text-right">Thành Tiền (VNĐ)</th>
                                                </tr>
                                            </thead>
                                            <tbody id="beoTblCharges" class="divide-y divide-slate-100">
                                                <tr><td colspan="4" class="p-4 text-center text-slate-400 italic text-xs">Chưa có chi tiết dịch vụ. Bấm các nút chọn nhanh hoặc khung bên dưới để thêm!</td></tr>
                                            </tbody>
                                            <tfoot class="bg-slate-50 border-t border-slate-200 font-bold">
                                                <tr>
                                                    <td colspan="2" class="p-1.5 text-right">TỔNG CỘNG :</td>
                                                    <td class="p-1.5 text-right font-mono text-emerald-700" id="beoTotalCharges">0 VND</td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                    <!-- THÊM DỊCH VỤ / HẠNG MỤC VÀO BEO (87 LOẠI DỊCH VỤ TỪ CSDL) -->
                                <div class="p-3 bg-blue-50/50 rounded-lg border border-blue-200/80 space-y-3">
                                    <div class="flex flex-wrap items-center justify-between gap-2">
                                        <span class="text-xs font-bold text-blue-900 flex items-center gap-1.5">
                                            <i data-lucide="plus-circle" class="w-4 h-4 text-blue-600"></i>
                                            <span>THÊM DỊCH VỤ / HẠNG MỤC VÀO BEO (87 LOẠI DỊCH VỤ TỪ CSDL)</span>
                                        </span>
                                        <!-- Fast Preset Pills -->
                                        <div class="flex flex-wrap items-center gap-1 text-[10px]">
                                            <span class="text-slate-500 font-medium mr-1">Chọn nhanh:</span>
                                            <button type="button" onclick="quickSelectCharge('Teabreak', 130000)" class="px-2 py-0.5 bg-white border border-slate-200 hover:bg-blue-50 text-slate-700 rounded font-semibold transition shadow-xs">+ Teabreak (130k)</button>
                                            <button type="button" onclick="quickSelectCharge('Full-day room rental', 40000000, 1)" class="px-2 py-0.5 bg-white border border-slate-200 hover:bg-blue-50 text-slate-700 rounded font-semibold transition shadow-xs">+ Thuê sảnh nguyên ngày</button>
                                            <button type="button" onclick="quickSelectCharge('Half-day room rental', 20000000, 1)" class="px-2 py-0.5 bg-white border border-slate-200 hover:bg-blue-50 text-slate-700 rounded font-semibold transition shadow-xs">+ Thuê sảnh 1/2 ngày</button>
                                            <button type="button" onclick="quickSelectCharge('Food', 380000)" class="px-2 py-0.5 bg-white border border-slate-200 hover:bg-blue-50 text-slate-700 rounded font-semibold transition shadow-xs">+ Thực đơn Food (380k)</button>
                                            <button type="button" onclick="quickSelectCharge('Freeflow', 50000)" class="px-2 py-0.5 bg-white border border-slate-200 hover:bg-blue-50 text-slate-700 rounded font-semibold transition shadow-xs">+ Freeflow nước</button>
                                            <button type="button" onclick="quickSelectCharge('Màn hình LED P3 sân khấu', 3500000, 1)" class="px-2 py-0.5 bg-white border border-slate-200 hover:bg-blue-50 text-slate-700 rounded font-semibold transition shadow-xs">+ Màn LED P3</button>
                                        </div>
                                    </div>

                                    <!-- HÀNG 1: CHỌN DANH MỤC & TÊN DIỄN GIẢI -->
                                    <div class="grid grid-cols-1 sm:grid-cols-12 gap-2.5 text-xs">
                                        <div class="sm:col-span-7">
                                            <label class="block text-[11px] text-slate-700 font-bold mb-1">1. Chọn danh mục dịch vụ từ SQL Server (87 loại):</label>
                                            <select id="beoAddChargeLoai" onchange="onSelectBeoChargeMaster(this)" class="w-full p-2 border border-slate-300 rounded-lg text-xs bg-white font-medium focus:ring-2 focus:ring-blue-500 shadow-xs">
                                                <option value="">-- Bấm chọn dịch vụ từ CSDL (87 loại) --</option>
                                            </select>
                                        </div>
                                        <div class="sm:col-span-5">
                                            <label class="block text-[11px] text-slate-700 font-bold mb-1">2. Tên diễn giải hạng mục *:</label>
                                            <input type="text" id="beoAddChargeName" placeholder="VD: Màn hình LED P3 sân khấu" class="w-full p-2 border border-slate-300 rounded-lg text-xs bg-white font-medium focus:ring-2 focus:ring-blue-500 shadow-xs" />
                                        </div>
                                    </div>

                                    <!-- HÀNG 2: SỐ LƯỢNG, ĐƠN GIÁ & NÚT THÊM NẰM RIÊNG BIỆT -->
                                    <div class="grid grid-cols-1 sm:grid-cols-12 gap-2.5 text-xs items-end">
                                        <div class="sm:col-span-3">
                                            <label class="block text-[11px] text-slate-700 font-bold mb-1">3. Số lượng / Khách:</label>
                                            <input type="number" id="beoAddChargeQty" value="1" min="1" class="w-full p-2 border border-slate-300 rounded-lg text-xs bg-white text-center font-bold focus:ring-2 focus:ring-blue-500 shadow-xs" />
                                        </div>
                                        <div class="sm:col-span-5">
                                            <label class="block text-[11px] text-slate-700 font-bold mb-1">4. Đơn giá (VNĐ):</label>
                                            <input type="number" id="beoAddChargePrice" placeholder="0" step="any" class="w-full p-2 border border-slate-300 rounded-lg text-xs bg-white font-mono font-bold text-emerald-700 focus:ring-2 focus:ring-blue-500 shadow-xs" />
                                        </div>
                                        <div class="sm:col-span-4">
                                            <button type="button" onclick="addBeoChargeItem()" class="w-full p-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-bold transition flex items-center justify-center gap-1.5 shadow-sm cursor-pointer">
                                                <i data-lucide="plus" class="w-4 h-4"></i>
                                                <span>+ Thêm Vào BEO</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <p class="text-[10px] text-slate-500 italic mt-1" id="beoChargeNotes">Prices are in VND and inclusive VAT and service charge.</p>
                                </div>
                            </div>

                            <!-- Khối Phân Công Bộ Phận (6 Bộ Phận Chuẩn) -->
                            
                        </div>

                        <!-- RIGHT COLUMN: LỊCH SẢNH ĐA PHÒNG, SETUP, THỨC UỐNG & CHI TIẾT THỰC ĐƠN -->
                        <div class="lg:col-span-6 space-y-4">
                            <!-- Bảng Lịch Sảnh Đa Phòng (VÀO / RA / VỊ TRÍ SẢNH) -->
                            <div class="border border-slate-200 rounded-lg p-3.5 bg-white space-y-3">
                                <h4 class="font-bold text-slate-800 uppercase tracking-wider text-[11px] border-b pb-1 flex items-center justify-between text-blue-900">
                                    <span>IV. LỊCH SẢNH ĐA PHÒNG & KHUNG GIỜ (SCHEDULE & ROOMS)</span>
                                    <span class="text-[10px] text-slate-400 font-normal">Cột Phải BEO</span>
                                </h4>
                                <div class="border border-slate-200 rounded overflow-hidden">
                                    <table class="w-full text-left border-collapse text-[11px]">
                                        <thead class="bg-slate-100 font-bold text-slate-700 border-b border-slate-200">
                                            <tr>
                                                <th class="p-1.5 w-24">VÀO</th>
                                                <th class="p-1.5 w-24">RA</th>
                                                <th class="p-1.5">VỊ TRÍ SẢNH</th>
                                            </tr>
                                        </thead>
                                        <tbody id="beoTblRoomsSchedule" class="divide-y divide-slate-100 font-mono">
                                            <tr><td colspan="3" class="p-3 text-center text-slate-400 italic text-xs">Chưa có lịch phòng cụ thể cho đơn tiệc này</td></tr>
                                        </tbody>
                                    </table>
                                </div>

                                <!-- Thông tin chào đón & Pax -->
                                <div>
                                    <label class="block font-semibold text-slate-600 mb-0.5">Thông Tin Hướng Dẫn - Chào Đón (Welcome Banner / LED)</label>
                                    <input type="text" id="beoWelcomeInfo" placeholder="Nội dung màn hình chào sảnh / standee..." class="w-full p-1.5 border border-slate-200 rounded" />
                                </div>
                                <div class="grid grid-cols-2 gap-3">
                                    <div>
                                        <label class="block font-semibold text-slate-600 mb-0.5">Số Khách Xác Nhận (GUA Pax) *</label>
                                        <input type="text" id="beoGuaPaxStr" placeholder="118 Pax" class="w-full p-1.5 border border-slate-200 rounded font-bold text-blue-700" />
                                    </div>
                                    <div>
                                        <label class="block font-semibold text-slate-600 mb-0.5">Số Khách Dự Kiến (EXP Pax) *</label>
                                        <input type="text" id="beoExpPaxStr" placeholder="118 Pax" class="w-full p-1.5 border border-slate-200 rounded font-bold text-slate-700" />
                                    </div>
                                </div>
                            </div>

                            <!-- Cách Sắp Xếp (Room Setup) -->
                            <div class="border border-slate-200 rounded-lg p-3.5 bg-white space-y-2">
                                <label class="block font-bold text-slate-800 uppercase tracking-wider text-[11px]">
                                    V. CÁCH SẮP XẾP SẢNH (ROOM SETUP SPECIFICATION)
                                </label>
                                <textarea id="beoRoomSetup" rows="6" placeholder="Bố trí chi tiết theo từng sảnh (Classic: Rạp hát, tone màu, hoa bàn, flipchart... Romance: Bàn tròn 10 người...)" class="w-full p-2 border border-slate-200 rounded font-sans text-xs"></textarea>
                            </div>

                            <!-- Thức Uống (Beverage) -->
                            <div class="border border-slate-200 rounded-lg p-3.5 bg-white space-y-2">
                                <label class="block font-bold text-slate-800 uppercase tracking-wider text-[11px]">
                                    VI. THỨC UỐNG (BEVERAGE DIRECTIVES)
                                </label>
                                <input type="text" id="beoBeverage" value="ÁP THEO BẢNG GIÁ TIỆC KS" class="w-full p-1.5 border border-slate-200 rounded font-bold text-slate-800" />
                            </div>

                            <!-- Thực Đơn Chi Tiết (F&B Menus) -->
                            <div class="border border-slate-200 rounded-lg p-3.5 bg-white space-y-2">
                                <div class="flex items-center justify-between">
                                    <label class="block font-bold text-slate-800 uppercase tracking-wider text-[11px]">
                                        VII. THỰC ĐƠN CHI TIẾT (FULL F&B MENUS - ALL SESSIONS)
                                    </label>
                                    <span class="text-[10px] text-slate-400">Tea-Break, Trưa, Tối, Mặn, Chay</span>
                                </div>
                                <textarea id="beoMenuDetail" rows="14" placeholder="Chi tiết các menu thực đơn: MENU TEA - BREAK, MENU MẶN - TRƯA, MENU CHAY - TRƯA, MENU MẶN - TỐI, MENU CHAY - TỐI..." class="w-full p-2.5 border border-slate-200 rounded font-sans text-xs"></textarea>
                            </div>
                        </div>
                    </div>
                    <!-- III. PHÂN CÔNG CHỈ ĐẠO CÁC BỘ PHẬN (FULL WIDTH 3 CỘT X 3 HÀNG RỘNG RÃI - CHUẨN KHÁCH SẠN MERPERLE) -->
                    <div class="border-2 border-purple-200/80 rounded-xl p-4 bg-gradient-to-b from-purple-50/30 to-white shadow-sm space-y-3.5">
                        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between border-b border-purple-100 pb-2.5 gap-2">
                            <div class="flex items-center gap-2.5">
                                <span class="w-7 h-7 rounded-lg bg-purple-600 text-white flex items-center justify-center font-black text-xs shadow-sm">
                                    <i data-lucide="clipboard-list" class="w-4 h-4"></i>
                                </span>
