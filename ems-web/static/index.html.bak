        async function renderMasterSegments() {
            try {
                const [segRes, chanRes] = await Promise.all([
                    fetch('/api/master/segments'),
                    fetch('/api/master/channels')
                ]);
                const segments = await segRes.json();
                const channels = await chanRes.json();

                const listSeg = document.getElementById('listSegments');
                listSeg.innerHTML = '';
                segments.forEach(s => {
                    const div = document.createElement('div');
